//@doc
 * @brief ROLLING SHUTTER PROPELLER: a rapidly turning photo exposed row by row: every row sees it at another moment and bends it into propeller blades and spirals.  Nothing is drawn: every pixel integrates the photo over a path in time (a single reading per row, each row at its own moment of a turn), so the picture is a long exposure of
 * the photo in its own colours, over the whole frame.
 *
 * Audio Reactivity (structure, not only light):
 *   audioSwell      -> the exposure lengthens as the music swells
 *   audioAdvance    -> the turn (integrated, never a jump)
 *
 * Knobs: lengthP (the base length of the exposure), reachP (the path's reach or the pivot's wandering), hueP.
//@params lengthP reachP
//@audio audioSwell audioAdvance
//@body
/**  The path of the exposure: a turn that differs by row.
 *
 * @param p  The pixel's place. (in)
 * @param u  The point on the path, -0.5..0.5. (in)
 * @param t  The clock. (in)
 *
 * @return
 *   The place to read.
 **/
vec2 expPath(vec2 p, float u, float t)
{
    float L = (0.45 + 0.9 * clamp(lengthP, 0.0, 1.0)) * (0.5 + 0.9 * clamp(audioSwell, 0.0, 1.0));
    float R = 0.1 + 0.6 * clamp(reachP, 0.0, 1.0);
    float ph = 0.25 * t * 4.0 + (p.y + 0.5) * (1.5 + 2.0 * L);
    return rot2(ph + 0.1 * u) * p;
}
void main()
{
    vec2 p = screenP();
    float t = sceneTime * 0.15 + 1.2 * audioPhase;
    finish(expAccum(p, t, 0, 1.5) * 1.05);
}
