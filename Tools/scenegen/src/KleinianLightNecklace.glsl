//@doc
 * @brief KLEINIAN LIGHT NECKLACE: the limit set of a Kleinian group in Maskit's slice -- generated by the translation
 * z -> z + 2 and z -> t + 1/z -- as a necklace of glowing circles that lead into themselves, pearl inside pearl,
 * between two lines that the necklace touches; the eye travels along it without end (the translation is one of the
 * group's own moves, so the necklace repeats every two units) while the view breathes in and out of the pearls.
 * A point is wrapped into the fundamental strip and inverted until it leaves it; the derivative gathered on the way
 * turns the leaving distance into a distance to the limit set (after Jos Leys).  One colour family from the photo.
 *
 * Audio Reactivity (structure, not only light):
 *   audioHarmAdvance -> the trace parameter t wanders with the chord changes: the pearls swell, shrink and lean
 *   audioAdvance     -> the travel along the necklace (integrated)
 *   audioSwell       -> the pearls' glow widens
 *
 * Knobs: zoomP (how deep the view breathes into the pearls), lineP (the glow's sharpness), hueP.
//@params zoomP lineP
//@audio audioHarmAdvance audioSwell
//@body
/**  The distance to the Maskit limit set (Jos Leys' algorithm with the derivative carried along).
 *
 * @param z   The point. (in)
 * @param a   The trace parameter's imaginary part (about 2). (in)
 * @param b   Its real part (small). (in)
 * @param n   Returns how many inversions it took to leave the strip. (out)
 *
 * @return
 *   The distance estimate.
 **/
float maskit(vec2 z, float a, float b, out float n)
{
    float f = sign(b);
    float dz = 1.0;
    n = 0.0;
    vec2 lz = z + vec2(1.0), llz = z - vec2(1.0);
    for (int i = 0; i < 70; ++i) {
        // into the strip -1 <= x < 1 (sheared along with the group's translation)
        z.x += b / a * z.y;
        z.x = z.x - 2.0 * floor(0.5 * (z.x + 1.0));
        z.x -= b / a * z.y;
        // above the separating curve: the half turn about (-b/2, a/2)
        float sep = a * 0.5 + f * (2.0 * a - 1.95) / 4.0 * sign(z.x + b * 0.5)
                    * (1.0 - exp(-(7.2 - (1.95 - a) * 15.0) * abs(z.x + b * 0.5)));
        if (z.y >= sep) z = vec2(-b, a) - z;
        // z -> t + 1/z
        float r2 = dot(z, z);
        z = vec2(-b + z.x / r2, a - z.y / r2);
        dz /= r2;
        n += 1.0;
        if (z.y < 0.0 || z.y > a) break;
        if (dot(z - llz, z - llz) < 1e-7) break;
        llz = lz;
        lz = z;
    }
    float out_ = z.y < 0.0 ? -z.y : z.y > a ? z.y - a : min(z.y, a - z.y);
    return out_ / max(dz, 1e-9);
}

void main()
{
    vec2 p = screenP();
    float fh = famHue();
    float h = max(audioHarmAdvance, 0.0);
    float a = 1.955 + 0.035 * sin(0.8 * h) + 0.01 * sin(0.37 * h + 1.0);
    float b = 0.04 * sin(0.53 * h + 0.5);
    float sharp = 1.2 + 1.2 * clamp(lineP, 0.0, 1.0);
    float swell = clamp(audioSwell, 0.0, 1.0);
    // the view: travelling along the strip, breathing in toward a pearl and out again
    float travel = 0.05 * sceneTime + 0.25 * audioAdvance;
    float breath = 0.5 - 0.5 * cos(0.045 * sceneTime);
    float zoom = mix(1.15, mix(0.5, 0.18, clamp(zoomP, 0.0, 1.0)), breath);
    vec2 centre = vec2(2.0 * travel, 0.5 * a + 0.32 * a * sin(0.031 * sceneTime) * breath);
    vec2 z = centre + p * a * zoom;
    float n;
    float d = maskit(z, a, b, n);
    float px = a * zoom / resolution.y;
    float g = exp(-pow(d / (px * sharp * (1.5 + 2.0 * swell)), 1.4));
    float halo = 0.25 * exp(-d / (px * 30.0));
    vec3 col = famLight(fh, clamp(n / 30.0, 0.0, 1.0), 0.5 * g) * (g + halo);
    col += famCol(fh, 0.5) * 0.012;
    finish(famExpose(col, 2.77, 1.00, 0.03, fh));
}
