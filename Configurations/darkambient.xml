<?xml version="1.0" encoding="utf-8" ?>
<!--
  darkambient.xml
  ============================================================
  Configuration for dark ambient and drone music visualisation.
  Designed for: Christoph Heemann, Thomas Köner, Lustmord,
                Trobar de Morte, Robert Rich, Raison d'être, etc.

  Key differences from standard configs:
  - Very long solo times (90–300 s) and long interpolations (60–180 s)
    so visuals breathe slowly rather than cutting rapidly.
  - New dark-ambient-specific shaders:
      DarkAmbientTunnel.frag  – sub-bass vignette, flux-driven motion
      HarmonicRings.frag      – concentric frequency-band glow rings
  - Classic Tunnel and Kaleidoscope also included (at very slow speed
    params so the audio mapping controls all motion).
  - Combine shaders: plain blending only (no multi-copy or colour filter)
    to keep the dark, minimalist aesthetic.
  ============================================================
-->
<configuration
    ImageDirectory="C:\\Users\\rene\\Desktop\\BilderPhotoechoes"
    ConfigurationName="DarkAmbient"
    timeTextureSoloMin="90"
    timeTextureSoloMax="300"
    timeTextureInterpolationMin="60"
    timeTextureInterpolationMax="180" >

  <!--
  ===============================================================
  TEXTURE EFFECTS
  ===============================================================
  -->

  <!-- Dark Ambient Tunnel (primary dark-ambient shader) -->
  <TextureShader
      minTimeSolo="120" maxTimeSolo="360"
      minTimeInterpolation="90" maxTimeInterpolation="200"
      file="..\\DarkAmbientTunnel.frag"
      type="KaleidoscopeBase"
      probability="1.0"
      complexity="1">
    <!-- Very slow rotation – audio flux controls actual motion -->
    <float name="speedTunnel" minValue="0.0002" maxValue="0.0020"></float>
    <float name="speed"       minValue="0.0002" maxValue="0.0015"></float>
    <int   name="sides"       minValue="4"      maxValue="8"></int>
    <float name="power"       minValue="1.0"    maxValue="1.4"></float>
    <bool  name="rotate"      probability="0.6"></bool>
  </TextureShader>

  <!-- Dark Ambient Tunnel (second instance – different param range) -->
  <TextureShader
      minTimeSolo="120" maxTimeSolo="360"
      minTimeInterpolation="90" maxTimeInterpolation="200"
      file="..\\DarkAmbientTunnel.frag"
      type="KaleidoscopeBase"
      probability="0.8"
      complexity="1">
    <float name="speedTunnel" minValue="0.0001" maxValue="0.0010"></float>
    <float name="speed"       minValue="0.0001" maxValue="0.0008"></float>
    <int   name="sides"       minValue="3"      maxValue="6"></int>
    <float name="power"       minValue="1.0"    maxValue="1.8"></float>
    <bool  name="rotate"      probability="0.3"></bool>
  </TextureShader>

  <!-- Harmonic Rings (visual spectrograph for drone overtones) -->
  <TextureShader
      minTimeSolo="90" maxTimeSolo="300"
      minTimeInterpolation="60" maxTimeInterpolation="180"
      file="..\\HarmonicRings.frag"
      type="KaleidoscopeBase"
      probability="1.0"
      complexity="1">
    <!-- Speed only drives ring rotation; flux drives ring brightness -->
    <float name="speed" minValue="0.0003" maxValue="0.0025"></float>
    <float name="power" minValue="1.0"    maxValue="1.3"></float>
    <bool  name="rotate" probability="0.5"></bool>
  </TextureShader>

  <!-- Harmonic Rings (second instance – slightly faster rotation) -->
  <TextureShader
      minTimeSolo="90" maxTimeSolo="300"
      minTimeInterpolation="60" maxTimeInterpolation="180"
      file="..\\HarmonicRings.frag"
      type="KaleidoscopeBase"
      probability="0.7"
      complexity="1">
    <float name="speed" minValue="0.0005" maxValue="0.0040"></float>
    <float name="power" minValue="1.0"    maxValue="1.2"></float>
    <bool  name="rotate" probability="0.7"></bool>
  </TextureShader>

  <!-- Classic Kaleidoscope at very slow speeds (let audio drive motion) -->
  <TextureShader
      minTimeSolo="120" maxTimeSolo="400"
      minTimeInterpolation="90" maxTimeInterpolation="240"
      file="..\\Kaleidoscope.frag"
      type="KaleidoscopeBase"
      probability="0.6"
      complexity="1">
    <bool  name="rotate"  probability="0.8"></bool>
    <int   name="sides"   minValue="3"      maxValue="10"></int>
    <float name="speed"   minValue="0.0003" maxValue="0.0020"></float>
    <float name="power"   minValue="1.0"    maxValue="1.5"></float>
  </TextureShader>

  <!-- Classic Tunnel at very slow speeds -->
  <TextureShader
      minTimeSolo="120" maxTimeSolo="400"
      minTimeInterpolation="90" maxTimeInterpolation="240"
      file="..\\Tunnel.frag"
      type="KaleidoscopeBase"
      probability="0.5"
      complexity="1">
    <bool  name="rotate"      probability="0.7"></bool>
    <float name="speedTunnel" minValue="0.0001" maxValue="0.0012"></float>
    <int   name="sides"       minValue="3"      maxValue="12"></int>
    <float name="speed"       minValue="0.0002" maxValue="0.0015"></float>
    <float name="power"       minValue="1.0"    maxValue="1.4"></float>
  </TextureShader>


  <!-- Curl Aurora (flowing mood-coloured curtains) -->
  <TextureShader
      minTimeSolo="120" maxTimeSolo="360"
      minTimeInterpolation="80" maxTimeInterpolation="200"
      file="..\\CurlAurora.frag"
      type="normal"
      probability="0.9"
      complexity="1">
  </TextureShader>

  <!-- Fractal KIFS (kaleidoscopic fractal centrepiece) -->
  <TextureShader
      minTimeSolo="100" maxTimeSolo="300"
      minTimeInterpolation="70" maxTimeInterpolation="180"
      file="..\\FractalKIFS.frag"
      type="normal"
      probability="0.8"
      complexity="1">
  </TextureShader>

  <!-- Lava Lamp (slow rising metaball wax) -->
  <TextureShader
      minTimeSolo="120" maxTimeSolo="360"
      minTimeInterpolation="80" maxTimeInterpolation="200"
      file="..\\LavaLamp.frag"
      type="normal"
      probability="0.8"
      complexity="1">
  </TextureShader>

  <!-- Oil Projector (Mathmos-style liquid light show) -->
  <TextureShader
      minTimeSolo="120" maxTimeSolo="360"
      minTimeInterpolation="80" maxTimeInterpolation="200"
      file="..\\OilProjector.frag"
      type="normal"
      probability="0.8"
      complexity="2">
  </TextureShader>

  <!--
  ===============================================================
  COMBINE SHADERS
  Plain blending only – no multi-copy or colour filters for the
  dark ambient aesthetic. Long times, slow cross-fades.
  ===============================================================
  -->

  <CombineShader
      minTimeSolo="120" maxTimeSolo="480"
      minTimeInterpolation="120" maxTimeInterpolation="300"
      file="..\\CombinePlain.frag"
      type="normal"
      probability="1.0"
      complexity="1">
  </CombineShader>

  <CombineShader
      minTimeSolo="120" maxTimeSolo="480"
      minTimeInterpolation="120" maxTimeInterpolation="300"
      file="..\\CombinePlain.frag"
      type="normal"
      probability="1.0"
      complexity="1">
  </CombineShader>

  <CombineShader
      minTimeSolo="120" maxTimeSolo="480"
      minTimeInterpolation="120" maxTimeInterpolation="300"
      file="..\\CombinePlain.frag"
      type="normal"
      probability="1.0"
      complexity="1">
  </CombineShader>

</configuration>
