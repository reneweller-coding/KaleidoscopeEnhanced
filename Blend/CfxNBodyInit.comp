#version 430
// CfxNBodyInit.comp — two rotating disc galaxies on a collision course.
layout(local_size_x = 256) in;

layout(std430, binding = 1) buffer Pos { vec4 pos[]; };   // xyz + mass
layout(std430, binding = 2) buffer Vel { vec4 vel[]; };   // xyz + colour index

uniform uint count;
uniform uint seed;

uint pcg(inout uint s)
{
    s = s * 747796405u + 2891336453u;
    uint w = ((s >> ((s >> 28) + 4u)) ^ s) * 277803737u;
    return (w >> 22) ^ w;
}
float rnd(inout uint s) { return float(pcg(s)) * (1.0 / 4294967296.0); }

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= count) return;
    uint rs = i * 2654435761u + seed * 2246822519u + 7u;
    pcg(rs); pcg(rs);

    bool second = (i >= count / 2u);

    // Exponential-ish disc: sqrt keeps the surface density falling outward.
    float r  = 0.28 + 1.05 * sqrt(rnd(rs));
    float th = rnd(rs) * 6.2831853;
    float zj = (rnd(rs) - 0.5) * 0.10 * r;          // thin disc

    // The two discs ORBIT each other on a slowly decaying path instead of
    // meeting head-on.  A head-on course merged them in ~10 s and left a
    // permanent blown-out starburst; a grazing mutual orbit spends minutes in
    // the interesting phase, growing tidal bridges and tails.
    vec3 centre = second ? vec3( 1.55, 0.42, -0.25)
                         : vec3(-1.55, -0.42, 0.25);
    // Tangential to the line joining them, just under circular speed.
    vec3 driftV = second ? vec3(-0.075,  0.285, 0.0)
                         : vec3( 0.075, -0.285, 0.0);

    // Tilt the two discs differently so the collision is not a flat mirror.
    float tilt = second ? 0.55 : -0.30;
    vec3 local = vec3(r * cos(th), r * sin(th), zj);
    local = vec3(local.x,
                 local.y * cos(tilt) - local.z * sin(tilt),
                 local.y * sin(tilt) + local.z * cos(tilt));

    // Circular orbit speed for the enclosed mass (softened at the core).
    float vmag = 0.62 * sqrt(1.0 / (r + 0.22));
    vec3 tang = vec3(-sin(th), cos(th), 0.0);
    tang = vec3(tang.x,
                tang.y * cos(tilt) - tang.z * sin(tilt),
                tang.y * sin(tilt) + tang.z * cos(tilt));

    // Per-body mass keeps the TOTAL gravitating mass independent of the star
    // count, so the orbital speeds below stay valid if the count changes.
    pos[i] = vec4(centre + local, 32768.0 / float(count));
    vel[i] = vec4(driftV + tang * vmag, second ? 0.62 : 0.14);
}
