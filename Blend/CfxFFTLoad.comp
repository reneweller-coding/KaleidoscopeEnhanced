#version 430
// CfxFFTLoad.comp — photo luminance -> complex field, ready for the FFT.
// The checkerboard sign flip centres the zero frequency in the middle of the
// spectrum, so the radial mask in CfxFFTMask can be a plain distance test.
layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, binding = 0) buffer Data { vec2 z[]; };
uniform sampler2D texSrc;
uniform int N;

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= N || p.y >= N) return;

    vec3 c = texture(texSrc, (vec2(p) + 0.5) / float(N)).rgb;
    float l = dot(c, vec3(0.299, 0.587, 0.114));

    float sign = (((p.x + p.y) & 1) == 0) ? 1.0 : -1.0;
    z[p.y * N + p.x] = vec2(l * sign, 0.0);
}
