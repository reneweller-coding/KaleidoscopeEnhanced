#version 430
// CfxShardInit.comp — cut the frame into shards and give each one a launch.
// vec4 A: xy = current offset from home, z = rotation, w = spin
// vec4 B: xy = velocity, z = angular velocity, w = seed
layout(local_size_x = 256) in;

layout(std430, binding = 1) buffer ShardA { vec4 sa[]; };
layout(std430, binding = 2) buffer ShardB { vec4 sb[]; };

uniform uint  count;
uniform uint  seed;
uniform float burst;

uint pcg(inout uint s)
{
    s = s * 747796405u + 2891336453u;
    uint w = ((s >> ((s >> 28) + 4u)) ^ s) * 277803737u;
    return (w >> 22) ^ w;
}
float rnd(inout uint s) { return float(pcg(s)) * (1.0 / 4294967296.0); }

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= count) return;

    uint rs = i * 2654435761u + seed * 2246822519u + 5u;
    pcg(rs);

    float a = rnd(rs) * 6.2831853;
    float sp = burst * (0.35 + 0.9 * rnd(rs));

    sa[i] = vec4(0.0, 0.0, 0.0, 0.0);
    sb[i] = vec4(cos(a) * sp, sin(a) * sp,
                 (rnd(rs) - 0.5) * burst * 5.0, rnd(rs));
}
