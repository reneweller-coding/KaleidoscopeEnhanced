#version 430 core
/**
 * @file SuperconductingFluxVortex.comp
 * @brief GPU compute shader simulating quantized Abrikosov magnetic flux
 * vortex ribbons in a Type-II high-temperature superconductor lattice.
 *
 * 3,584 invocations build 112 flux tubes of 32 ribbon segments each; the
 * remaining 512 emit the camera-facing quads of the Meissner haze that
 * carries the far field (placed in FRUSTUM coordinates by the vertex stage,
 * which is the one that knows the aspect ratio).
 *
 * The lattice used to be a 64-tube patch barely 3.5 units across in front of
 * a camera 6.5 units back -- roughly a quarter of the picture wide, and the
 * rest of the frame stayed black.  The slab is now wide enough, and the tubes
 * long enough, that the silhouette stays frame-filling through the whole slow
 * Y rotation: the lattice's x extent becomes DEPTH when the slab turns
 * edge-on, and the tube length becomes the picture's width, so the two are
 * deliberately matched.
 */

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

layout(std430, binding = 0) buffer Verts { float verts[]; };
layout(std430, binding = 1) buffer Cmd   { uint cmd[];   };

uniform uint  maxVertices;
uniform float time;

uniform float audioPhase;
uniform float audioAdvance;
uniform float audioSwell;
uniform float audioLevel;
uniform float audioKick;
uniform float audioCentroid;
uniform float audioValence;
uniform float audioSubBass;
uniform float audioBass;
uniform float audioMid;
uniform float audioHigh;
uniform float audioFlux;
uniform float audioChromaHue;

uniform float fluxP;
uniform float kelvinP;
uniform float speedP;
uniform float hueP;

float hash11(float p) {
    p = fract(p * 0.1031);
    p *= p + 33.33;
    p *= p + p;
    return fract(p);
}

void main() {
    uvec3 g = gl_GlobalInvocationID;
    uint gid = g.x + 64u * (g.y + 64u * g.z);
    if (gid >= 4096u) return;

    float flx = (fluxP   > 0.0) ? fluxP   : 1.0;
    float klv = (kelvinP > 0.0) ? kelvinP : 1.0;
    float spd = (speedP  > 0.0) ? speedP  : 1.0;

    float t = time * 0.4 * spd + audioAdvance * 0.2;
    float fGid = float(gid);

    // ---- MEISSNER HAZE -------------------------------------------------
    // The last 512 invocations are not tubes at all: they are the expelled
    // field, a cloud of soft camera-facing motes.  Only the seeds travel
    // through the vertex buffer -- the vertex stage places them across the
    // frustum, because it is the stage that knows the aspect ratio.
    if (gid >= 3584u)
    {
        float fh = fGid - 3584.0;
        float hx = hash11(fh * 1.113 + 0.37);
        float hy = hash11(fh * 2.371 + 5.11);
        float hz = hash11(fh * 0.733 + 9.73);
        float hs = hash11(fh * 3.191 + 2.29);

        uint hbase = atomicAdd(cmd[4], 6u);
        if (hbase + 6u > maxVertices) return;

        vec2 cn[6] = vec2[6](vec2(0.0, 0.0), vec2(1.0, 0.0), vec2(0.0, 1.0),
                             vec2(1.0, 0.0), vec2(1.0, 1.0), vec2(0.0, 1.0));
        for (uint i = 0u; i < 6u; ++i)
        {
            uint off = (hbase + i) * 8u;
            verts[off + 0u] = hx;
            verts[off + 1u] = hy;
            verts[off + 2u] = hz;
            verts[off + 3u] = -1.0;   // haze marker, read by the vertex stage
            verts[off + 4u] = hs;
            verts[off + 5u] = 0.0;
            verts[off + 6u] = cn[i].x;
            verts[off + 7u] = cn[i].y;
        }
        return;
    }

    // 112 vortex flux tubes x 32 segments per tube
    float vortexID = floor(fGid / 32.0);
    float segID = mod(fGid, 32.0);

    float u1 = segID / 32.0;
    float u2 = (segID + 1.0) / 32.0;

    // Hexagonal Abrikosov lattice equilibrium coordinates: 16 columns x 7
    // rows.  fluxP still sets the pinning density, but only at 45% leverage --
    // at full leverage its 0.5..2.0 preset range swung the slab between a
    // quarter of the frame and well past its edges.
    float sp = 1.0 + 0.45 * (flx - 1.0);
    float row = floor(vortexID / 16.0) - 3.0;
    float col = mod(vortexID, 16.0) - 7.5;
    vec2 hexPinning = vec2(col * 1.25 + mod(row, 2.0) * 0.625, row * 2.30) * sp;

    // Height along the superconductor slab -- the tube axis.  Matched to the
    // lattice's own x extent so the rotating slab never turns "thin".
    float z1 = (u1 - 0.5) * 18.0;
    float z2 = (u2 - 0.5) * 18.0;

    // Kelvin helical wave excitation on flux tube (same wave count along the
    // now much longer tube, so the spatial frequency drops with the stretch)
    float kelvinWave1 = sin(z1 * 1.35 - t * 4.0 + vortexID * 0.5) * 0.42 * klv;
    float kelvinWave2 = sin(z2 * 1.35 - t * 4.0 + vortexID * 0.5) * 0.42 * klv;

    // Vortex avalanche displacement on kick
    float avalanche = sin(length(hexPinning) * 0.9 - time * 8.0) * audioKick * 0.75;

    vec3 pA = vec3(hexPinning.x + kelvinWave1 + avalanche, hexPinning.y + cos(z1 * 1.35 - t * 4.0) * 0.42 * klv, z1);
    vec3 pB = vec3(hexPinning.x + kelvinWave2 + avalanche, hexPinning.y + cos(z2 * 1.35 - t * 4.0) * 0.42 * klv, z2);

    // Ribbon width vectors.  Widened with the slab: a 0.02-wide ribbon at the
    // new camera distance would have been a sub-pixel thread.
    vec3 forward = normalize(pB - pA);

    // ...and made to FACE THE CAMERA even though the slab is rotated later.
    // The old binormal, (-forward.y, forward.x, 0), does lie in the screen
    // plane -- but SuperconductingFluxVortex.vert then spins the whole slab
    // about Y, which tips part of that vector into DEPTH.  A ribbon whose
    // width vector points along the view axis is edge-on and rasterises to
    // nothing, so tubes kept blinking out as the lattice turned.  Build the
    // screen-plane side vector in the ROTATED frame and carry it back, so
    // what the camera finally sees is always the ribbon's full width.
    // (Both stages read the same `time` and `audioPhase`, so both compute the
    // same rotation for a given frame.)
    float rotY = time * 0.25 + audioPhase * 0.1;
    float cy = cos(rotY), sy = sin(rotY);
    vec3  fR = vec3(forward.x * cy - forward.z * sy, forward.y,
                    forward.x * sy + forward.z * cy);
    vec3  sR = cross(fR, vec3(0.0, 0.0, 1.0));
    float sl = length(sR);
    sR = (sl > 1e-4) ? sR / sl : vec3(1.0, 0.0, 0.0);
    vec3 binormal = vec3(sR.x * cy + sR.z * sy, sR.y, -sR.x * sy + sR.z * cy);

    float ribbonWidth = (0.075 + 0.050 * audioHigh);

    // 4 ribbon quad corners
    vec3 v0 = pA - binormal * ribbonWidth;
    vec3 v1 = pA + binormal * ribbonWidth;
    vec3 v2 = pB - binormal * ribbonWidth;
    vec3 v3 = pB + binormal * ribbonWidth;

    // Allocate 6 vertices (2 triangles = 1 ribbon segment)
    uint base = atomicAdd(cmd[4], 6u);
    if (base + 6u > maxVertices) return;

    vec3 pList[6] = vec3[6](v0, v1, v2,  v1, v3, v2);
    vec2 uvList[6] = vec2[6](
        vec2(0.0, u1), vec2(1.0, u1), vec2(0.0, u2),
        vec2(1.0, u1), vec2(1.0, u2), vec2(0.0, u2)
    );

    for (uint i = 0u; i < 6u; ++i) {
        uint off = (base + i) * 8u;
        verts[off + 0u] = pList[i].x;
        verts[off + 1u] = pList[i].y;
        verts[off + 2u] = pList[i].z;
        verts[off + 3u] = vortexID;
        verts[off + 4u] = hash11(vortexID);
        verts[off + 5u] = u1;
        verts[off + 6u] = uvList[i].x;
        verts[off + 7u] = uvList[i].y;
    }
}
