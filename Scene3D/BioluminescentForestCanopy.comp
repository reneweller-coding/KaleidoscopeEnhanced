#version 430
layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

/**
 * @file BioluminescentForestCanopy.comp
 * @brief Compute shader generating 3D bioluminescent rainforest fronds, vines, and airborne glowing spores
 */

layout(std430, binding = 0) buffer Verts {
    float verts[]; // 8 floats per vertex: attrA.xyzw (pos, floraType), attrB.xyzw (pad, bioGlow)
};

// DrawArraysIndirectCommand + our own counter:
//   [0] count  [1] instanceCount  [2] first  [3] baseInstance  [4] rawCount
layout(std430, binding = 1) buffer Cmd { uint cmd[]; };

uniform uint  maxVertices;
uniform float time;
uniform float audioPhase;
uniform float audioAdvance;
uniform float audioKick;
uniform float audioBass;
uniform float audioMid;
uniform float audioHigh;
uniform float audioSwell;

float hash11(float p) {
    p = fract(p * 0.1031);
    p *= p + 93.13;
    p *= p + p;
    return fract(p);
}

void writeVertex(uint slot, vec3 p, float e1, float e2) {
    uint o = slot * 8u;
    verts[o + 0u] = p.x;  verts[o + 1u] = p.y;  verts[o + 2u] = p.z;
    verts[o + 3u] = e1;
    verts[o + 4u] = 0.0;  verts[o + 5u] = 0.0;  verts[o + 6u] = 0.0;
    verts[o + 7u] = e2;
}

// A "frond" is a line from A to B; GL_TRIANGLES needs a real triangle, so it
// is emitted as a thin two-triangle ribbon facing an arbitrary perpendicular.
void emitSegment(vec3 pA, vec3 pB, float e1, float e2, float thickness) {
    uint base = atomicAdd(cmd[4], 6u);
    if (base + 6u > maxVertices) return;

    vec3 dir = pB - pA;
    float len = length(dir);
    dir = (len > 1e-5) ? dir / len : vec3(0.0, 1.0, 0.0);
    vec3 upv = (abs(dir.y) > 0.95) ? vec3(1.0, 0.0, 0.0) : vec3(0.0, 1.0, 0.0);
    vec3 side = normalize(cross(dir, upv)) * thickness;

    vec3 a0 = pA - side, a1 = pA + side, b0 = pB - side, b1 = pB + side;
    writeVertex(base + 0u, a0, e1, e2);
    writeVertex(base + 1u, a1, e1, e2);
    writeVertex(base + 2u, b0, e1, e2);
    writeVertex(base + 3u, a1, e1, e2);
    writeVertex(base + 4u, b1, e1, e2);
    writeVertex(base + 5u, b0, e1, e2);
}

void main() {
    uvec3 g = gl_GlobalInvocationID;
    uint id = g.x + 64u * (g.y + 64u * g.z);
    const uint TOTAL_FLORA = 4096u;
    if (id >= TOTAL_FLORA) return;

    float seed = float(id);
    float rand1 = hash11(seed);
    float rand2 = hash11(seed + 100.0);
    float rand3 = hash11(seed + 200.0);

    // Tree branch cluster position
    float treeID = floor(seed / 128.0);
    float treeAngle = hash11(treeID) * 6.2831853;
    float treeDist = (0.5 + 0.5 * hash11(treeID + 50.0)) * 3.5;
    float treeY = (hash11(treeID + 100.0) - 0.5) * 2.5;

    vec3 branchBase = vec3(treeDist * cos(treeAngle), treeY, treeDist * sin(treeAngle));

    // Frond arching trajectory & wind sway driven by audioBass
    float t = time * 0.3 + audioAdvance * 0.15;
    float sway = sin(t * 2.0 + seed * 0.05) * 0.25 * (0.8 + 0.6 * audioBass);

    float frondLen = 0.4 + 0.4 * rand1;
    float frondAngle = rand2 * 6.2831853 + sway;
    vec3 frondTip = branchBase + vec3(frondLen * cos(frondAngle), -0.2 + sway * 0.5, frondLen * sin(frondAngle));

    // Bioluminescent glow pulse on beat kicks
    float bioGlow = (0.4 + 0.6 * sin(seed * 0.2 + time * 3.0)) * (1.0 + audioKick * 2.5);
    float floraType = rand1;

    emitSegment(branchBase, frondTip, floraType, bioGlow, 0.03);
}
