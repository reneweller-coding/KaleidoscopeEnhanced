#version 430
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// BioluminescentForestCanopy.comp
// Compute shader generating 3D bioluminescent rainforest fronds, vines, and airborne glowing spores

layout(std430, binding = 0) buffer Verts {
    float verts[]; // 6 floats per vertex: px, py, pz, nx, ny, nz (where n holds floraType, bioGlow, frondID)
};

layout(std430, binding = 1) buffer Cmd {
    uint count;
    uint instanceCount;
    uint first;
    uint baseInstance;
    uint vertCount;
};

uniform float time;
uniform float audioPhase;
uniform float audioAdvance;
uniform float audioKick;
uniform float audioBass;
uniform float audioMid;
uniform float audioHigh;
uniform float audioSwell;

float hash11(float p) {
    p = fract(p * 0.1031);
    p *= p + 93.13;
    p *= p + p;
    return fract(p);
}

void main() {
    uint id = gl_GlobalInvocationID.x;
    const uint TOTAL_FLORA = 4096u;
    if (id >= TOTAL_FLORA) return;

    if (id == 0u) {
        count = TOTAL_FLORA * 2u;
        instanceCount = 1u;
        first = 0u;
        baseInstance = 0u;
        vertCount = TOTAL_FLORA * 2u;
    }
    barrier();

    float seed = float(id);
    float rand1 = hash11(seed);
    float rand2 = hash11(seed + 100.0);
    float rand3 = hash11(seed + 200.0);

    // Tree branch cluster position
    float treeID = floor(seed / 128.0);
    float treeAngle = hash11(treeID) * 6.2831853;
    float treeDist = (0.5 + 0.5 * hash11(treeID + 50.0)) * 3.5;
    float treeY = (hash11(treeID + 100.0) - 0.5) * 2.5;

    vec3 branchBase = vec3(treeDist * cos(treeAngle), treeY, treeDist * sin(treeAngle));

    // Frond arching trajectory & wind sway driven by audioBass
    float t = time * 0.3 + audioAdvance * 0.15;
    float sway = sin(t * 2.0 + seed * 0.05) * 0.25 * (0.8 + 0.6 * audioBass);

    float frondLen = 0.4 + 0.4 * rand1;
    float frondAngle = rand2 * 6.2831853 + sway;
    vec3 frondTip = branchBase + vec3(frondLen * cos(frondAngle), -0.2 + sway * 0.5, frondLen * sin(frondAngle));

    // Bioluminescent glow pulse on beat kicks
    float bioGlow = (0.4 + 0.6 * sin(seed * 0.2 + time * 3.0)) * (1.0 + audioKick * 2.5);
    float floraType = rand1;

    uint vIdx = id * 12u;

    // Vertex 1: Branch base
    verts[vIdx + 0u] = branchBase.x;
    verts[vIdx + 1u] = branchBase.y;
    verts[vIdx + 2u] = branchBase.z;
    verts[vIdx + 3u] = floraType;
    verts[vIdx + 4u] = bioGlow;
    verts[vIdx + 5u] = 1.0;

    // Vertex 2: Frond tip
    verts[vIdx + 6u] = frondTip.x;
    verts[vIdx + 7u] = frondTip.y;
    verts[vIdx + 8u] = frondTip.z;
    verts[vIdx + 9u] = floraType;
    verts[vIdx + 10u] = bioGlow;
    verts[vIdx + 11u] = 1.0;
}
