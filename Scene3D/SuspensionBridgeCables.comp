#version 430 core
/*****************************************************************************\
 *                              SuspensionBridgeCables.comp
\*****************************************************************************/
/*! @file
 *
 *  @brief
 *  SUSPENSION BRIDGE CABLES: flying under the deck of a suspension bridge.
 *
 *  Two towers stand ahead, the main cables sweep down from them in their catenary, and the vertical hangers drop
 *  from the cables to the deck girder overhead.  Everything is emitted as camera-facing quads: the cable and hanger
 *  runs as short segments, the towers as boxes, the deck as a long slab, plus lamp beads along the cable.  The
 *  flight down the bridge runs on the scene clock alone -- steady, never on a beat.
 *
 *  Kinds: -1 sky, -2 water, 0 main cable, 1 hanger, 2 tower, 3 deck, 4 lamp.
 *
 *  Per-instance: spanP, lampP, hueP.
 *
 *  @author René Weller
 */
/// Layout qualifiers of this stage (work-group size, or the primitive in or out).
layout( local_size_x = 4, local_size_y = 4, local_size_z = 4 ) in;
/// The output vertex buffer: eight floats per vertex (attribute A, attribute B) that the scene draws.
layout( std430, binding = 0 ) buffer Verts
{
    float verts[];
};
/// The indirect draw command: [0] the vertex count (counted up atomically), then the other draw arguments.
layout( std430, binding = 1 ) buffer Cmd
{
    uint cmd[];
};

uniform uint  maxVertices;       ///< Capacity of the vertex buffer (compute stage).
uniform float time;              ///< Seconds since the program started (never reset; see sceneTime).
uniform float sceneAdvance;      ///< The music's advance since this scene was activated (integrated, never jumps).
uniform float sceneTime;         ///< Seconds since this scene was activated.
uniform float audioSpectrum[32]; ///< Spectrum bands, 0..1.
uniform float audioSwell;        ///< Slow loudness envelope, 0..1 (seconds).

uniform float spanP; ///< Span knob, 0..1.
uniform float lampP; ///< Lamp knob, 0..1.
uniform float hueP;  ///< Hue knob (radians), usually the music's chroma hue plus a rolled offset.

/**  Pseudo-random number 0..1 from a float.
 *
 * @param p  The input value. (in)
 *
 * @return
 *   A pseudo-random number 0..1.
 **/
float hash11( float p )
{
    p = fract( p * 0.1031 );
    p *= p + 33.33;
    p *= p + p;
    return fract( p );
}

/**  Appends a camera-facing quad (two triangles) to the output buffer (compute stage).
 *
 * @param c     Centre of the quad. (in)
 * @param ax    Half the quad's extent along its first axis. (in)
 * @param ay    Half its extent along the second axis. (in)
 * @param id    Element id written to every vertex. (in)
 * @param lit   Lighting weight written to every vertex. (in)
 * @param kind  Element kind written to every vertex. (in)
 * @param uv0   Texture coordinate of the first corner. (in)
 * @param uv1   Texture coordinate of the opposite corner. (in)
 **/
void emitQuad( vec3 c, vec3 ax, vec3 ay, float id, float lit, float kind, vec2 uv0, vec2 uv1 )
{
    uint base = atomicAdd( cmd[4], 6u );
    if ( base + 6u > maxVertices )
        return;
    vec3 p0 = c - ax - ay, p1 = c + ax - ay, p2 = c + ax + ay, p3 = c - ax + ay;
    vec3 p_list[6] = vec3[6]( p0, p1, p2, p0, p2, p3 );
    vec2 uv_list[6] = vec2[6]( vec2( uv0.x, uv0.y ), vec2( uv1.x, uv0.y ), vec2( uv1.x, uv1.y ), vec2( uv0.x, uv0.y ),
                               vec2( uv1.x, uv1.y ), vec2( uv0.x, uv1.y ) );
    for ( uint i = 0u; i < 6u; ++i )
    {
        uint off = ( base + i ) * 8u;
        verts[off + 0u] = p_list[i].x;
        verts[off + 1u] = p_list[i].y;
        verts[off + 2u] = p_list[i].z;
        verts[off + 3u] = id;
        verts[off + 4u] = lit;
        verts[off + 5u] = kind;
        verts[off + 6u] = uv_list[i].x;
        verts[off + 7u] = uv_list[i].y;
    }
}

/**  A segment as a camera-facing ribbon of the given half-width.
 *
 * @param a     Start of the segment. (in)
 * @param b     End of the segment. (in)
 * @param w     Width of the ribbon. (in)
 * @param id    Per-vertex value written to the buffer (the vertex stage gives it its meaning). (in)
 * @param lit   Per-vertex value written to the buffer (the vertex stage gives it its meaning). (in)
 * @param kind  Per-vertex value written to the buffer (the vertex stage gives it its meaning). (in)
 **/
void emitSeg( vec3 a, vec3 b, float w, float id, float lit, float kind )
{
    vec3 mid = 0.5 * ( a + b );
    vec3 half_ = 0.5 * ( b - a );
    // Face the camera (at the origin, looking down +z): the ribbon's width
    // axis is perpendicular to the segment and to the view direction.
    vec3 view = normalize( mid );
    vec3 raw = cross( half_, view );
    // Guard BEFORE normalising: a segment running almost along the view has a
    // vanishing cross product, and normalising that gives a NaN ribbon that
    // the rasteriser silently drops.
    if ( dot( raw, raw ) < 1e-8 )
        raw = cross( half_, vec3( 0.0, 1.0, 0.0 ) );
    if ( dot( raw, raw ) < 1e-8 )
        raw = vec3( 1.0, 0.0, 0.0 );
    vec3 side = normalize( raw );
    emitQuad( mid, half_, side * w, id, lit, kind, vec2( 0.0 ), vec2( 1.0 ) );
}

const float DeckY = 2.4;    ///< the deck girder overhead
const float TowerTop = 9.5; ///< Height of the bridge towers' tops.
const float RoadHalf = 4.2; ///< half the deck width
/// The cables hang OUTSIDE the deck edge.  At the deck width they sit exactly
/// behind the slab, which -- looking up from under the bridge -- hides them
/// completely; the first cut of this scene showed a bare deck and two towers.
const float CableX = 6.6;

/**  The main cable's height at distance z from the near tower, for a span S.
 *
 * @param z  Distance from the near tower. (in)
 * @param S  The span. (in)
 *
 * @return
 *   The height.
 **/
float cableY( float z, float S )
{
    float u = clamp( z / S, 0.0, 1.0 );
    float sag = 4.0 * u * ( 1.0 - u ); // 0 at the towers, 1 at mid-span
    return mix( TowerTop, DeckY + 0.6, sag );
}

/** Entry point of this shader stage (the file description says what it draws). */
void main()
{
    uvec3 g = gl_GlobalInvocationID;
    uint  id = g.x + 64u * ( g.y + 64u * g.z );
    float span = 44.0 + 22.0 * clamp( spanP, 0.0, 1.0 );
    float clock = sceneAdvance * 0.5 + sceneTime * 0.1;
    float fly = clock * 3.2; // the flight, steady

    if ( id == 0u )
    {
        // Sky and water.  +z is forward, so both sit well ahead.
        emitQuad( vec3( 0.0, 6.0, 70.0 ), vec3( 120.0, 0.0, 0.0 ), vec3( 0.0, 46.0, 0.0 ), 0.0, 0.0, -1.0, vec2( 0.0 ),
                  vec2( 1.0 ) );
        emitQuad( vec3( 0.0, -6.0, 55.0 ), vec3( 120.0, 0.0, 0.0 ), vec3( 0.0, 0.0, 60.0 ), 0.0, 0.0, -2.0, vec2( 0.0 ),
                  vec2( 1.0 ) );
        return;
    }
    // The deck girder overhead: a long slab down the whole visible run,
    // scrolling with the flight so its ribs move past.
    if ( id == 1u )
    {
        emitQuad( vec3( 0.0, DeckY, 34.0 ), vec3( RoadHalf, 0.0, 0.0 ), vec3( 0.0, 0.0, 34.0 ), 0.0, 0.0, 3.0,
                  vec2( 0.0 ), vec2( 1.0 ) );
        return;
    }
    uint k = id - 2u;

    // Towers: two per span, at z = tower spacing, on both sides.
    if ( k < 8u )
    {
        uint  ti = k / 2u; // which tower along the run
        float side_s = ( k % 2u == 0u ) ? -1.0 : 1.0;
        float zt = mod( float( ti ) * span - fly, span * 4.0 ) - span * 0.5;
        if ( zt < 1.0 || zt > 120.0 )
            return;
        vec3 c = vec3( side_s * CableX, ( TowerTop - 4.0 ) * 0.5, zt );
        emitQuad( c, vec3( 0.55, 0.0, 0.0 ), vec3( 0.0, ( TowerTop + 4.0 ) * 0.5, 0.0 ), float( ti ), 0.0, 2.0,
                  vec2( 0.0 ), vec2( 1.0 ) );
        // The cross beam near the top.
        if ( k % 2u == 0u )
            emitQuad( vec3( 0.0, TowerTop - 1.2, zt ), vec3( CableX, 0.0, 0.0 ), vec3( 0.0, 0.4, 0.0 ), float( ti ),
                      0.0, 2.0, vec2( 0.0 ), vec2( 1.0 ) );
        return;
    }
    k -= 8u;
    // Main cables: sampled catenary segments, both sides, over four spans.
    if ( k < 320u )
    {
        uint  seg_i = k % 40u;
        uint  rest = k / 40u;
        float side_s = ( rest % 2u == 0u ) ? -1.0 : 1.0;
        uint  span_i = rest / 2u; // 0..3
        float z0 = float( span_i ) * span - mod( fly, span );
        float u0 = float( seg_i ) / 40.0, u1 = float( seg_i + 1u ) / 40.0;
        vec3  a = vec3( side_s * CableX, cableY( u0 * span, span ), z0 + u0 * span );
        vec3  b = vec3( side_s * CableX, cableY( u1 * span, span ), z0 + u1 * span );
        if ( a.z < 0.8 || a.z > 120.0 )
            return;
        emitSeg( a, b, 0.26, float( seg_i ), u0, 0.0 );
        // A lamp bead every fifth segment, its brightness from a band.
        if ( seg_i % 5u == 0u
             && hash11( float( span_i ) * 3.1 + float( seg_i ) ) < 0.6 + 0.4 * clamp( lampP, 0.0, 1.0 ) )
            emitQuad( a + vec3( 0.0, -0.4, 0.0 ), vec3( 0.3, 0.0, 0.0 ), vec3( 0.0, 0.3, 0.0 ),
                      float( seg_i ), u0, 4.0, vec2( 0.0 ), vec2( 1.0 ) );
        return;
    }
    k -= 320u;
    // Hangers: verticals from the cable down to the deck.
    if ( k < 160u )
    {
        uint  hi = k % 20u;
        uint  rest = k / 20u;
        float side_s = ( rest % 2u == 0u ) ? -1.0 : 1.0;
        uint  span_i = rest / 2u; // 0..3
        float z0 = float( span_i ) * span - mod( fly, span );
        float u = ( float( hi ) + 0.5 ) / 20.0;
        float z = z0 + u * span;
        if ( z < 0.8 || z > 120.0 )
            return;
        float top = cableY( u * span, span );
        vec3  a = vec3( side_s * CableX, top, z );
        vec3  b = vec3( side_s * CableX, DeckY - 0.2, z );
        if ( top <= DeckY + 0.15 )
            return;
        emitSeg( a, b, 0.075, float( hi ), u, 1.0 );
        return;
    }
}
