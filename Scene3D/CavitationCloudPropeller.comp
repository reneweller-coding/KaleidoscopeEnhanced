#version 430 core
/**
 * @file CavitationCloudPropeller.comp
 * @brief CAVITATION CLOUD PROPELLER: a ship propeller turning under water,
 * and the cloud of cavitation bubbles that streams off its blade tips --
 * born in the low pressure behind each blade, carried downstream in a
 * helix, growing, then collapsing.  The propeller turns on the scene
 * clock; every bubble lives on a continuous phase (no state); the collapse
 * at the end of a life is a flash the fragment stage lights with the kick.
 * The camera never moves.
 *
 * Audio Reactivity (generator stage):
 *   sceneAdvance -> rotation and bubble travel (continuous)
 *   audioSwell   -> bubble count fraction / cloud density (slow)
 *
 * Per-instance: bladesP, densP, hueP.
 */
layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;
layout(std430, binding = 0) buffer Verts { float verts[]; };
layout(std430, binding = 1) buffer Cmd   { uint cmd[];   };

uniform uint  maxVertices;
uniform float time;
uniform float sceneAdvance;
uniform float sceneTime;
uniform float audioSwell;

uniform float bladesP;
uniform float densP;
uniform float hueP;

float hash11(float p) { p = fract(p * 0.1031); p *= p + 33.33; p *= p + p; return fract(p); }
vec3  hash31(float n) { return vec3(hash11(n), hash11(n + 17.3), hash11(n + 41.7)); }

void emitQuad(vec3 c, vec3 ax, vec3 ay, float id, float lit, float kind, vec2 uv0, vec2 uv1)
{
    uint base = atomicAdd(cmd[4], 6u);
    if (base + 6u > maxVertices) return;
    vec3 p0 = c - ax - ay, p1 = c + ax - ay, p2 = c + ax + ay, p3 = c - ax + ay;
    vec3 pList[6]  = vec3[6](p0, p1, p2, p0, p2, p3);
    vec2 uvList[6] = vec2[6](vec2(uv0.x, uv0.y), vec2(uv1.x, uv0.y), vec2(uv1.x, uv1.y), vec2(uv0.x, uv0.y), vec2(uv1.x, uv1.y), vec2(uv0.x, uv1.y));
    for (uint i = 0u; i < 6u; ++i)
    {
        uint off = (base + i) * 8u;
        verts[off + 0u] = pList[i].x; verts[off + 1u] = pList[i].y; verts[off + 2u] = pList[i].z;
        verts[off + 3u] = id; verts[off + 4u] = lit; verts[off + 5u] = kind;
        verts[off + 6u] = uvList[i].x; verts[off + 7u] = uvList[i].y;
    }
}

void main()
{
    uvec3 g = gl_GlobalInvocationID;
    uint id = g.x + 64u * (g.y + 64u * g.z);
    const uint kBubbles = 6000u;
    const vec3 hub = vec3(-3.2, 0.0, 9.0);
    float blades = floor(3.0 + 2.0 * clamp(bladesP, 0.0, 1.0));
    float clock = sceneAdvance * 1.2 + sceneTime * 0.3;
    float rot = clock * 2.0;

    if (id == 0u)
    {
        emitQuad(vec3(0.0, 0.0, 30.0), vec3(50.0, 0.0, 0.0), vec3(0.0, 28.0, 0.0), 0.0, 0.0, -1.0, vec2(0.0), vec2(1.0));
        // Hub and blades (kind 3): each blade a twisted quad from the hub outward.
        emitQuad(hub, vec3(0.0, 0.35, 0.0), vec3(0.0, 0.0, 0.35), 0.0, 0.0, 3.0, vec2(0.0), vec2(1.0));
        emitQuad(hub + vec3(-0.6, 0.0, 0.0), vec3(0.8, 0.0, 0.0), vec3(0.0, 0.22, 0.0), 0.0, 0.5, 3.0, vec2(0.0), vec2(1.0));   // shaft
        for (int b = 0; b < 5; ++b)
        {
            if (float(b) >= blades) break;
            float a = rot + float(b) / blades * 6.2831853;
            vec3 radial = vec3(0.0, cos(a), sin(a));
            vec3 tangent = vec3(0.0, -sin(a), cos(a));
            for (int s = 0; s < 4; ++s)
            {
                float r0 = 0.35 + float(s) * 0.45, r1 = r0 + 0.45;
                float twist0 = 0.9 - float(s) * 0.18, twist1 = twist0 - 0.18;
                vec3 c = hub + radial * (r0 + r1) * 0.5;
                vec3 ax = radial * (r1 - r0) * 0.5;
                vec3 chord = normalize(tangent * cos(twist0) + vec3(1.0, 0.0, 0.0) * sin(twist0)) * (0.35 - float(s) * 0.05);
                emitQuad(c, ax, chord, float(b), 0.2 + 0.2 * float(s), 3.0, vec2(0.0), vec2(1.0));
            }
        }
        return;
    }
    float frac = (densP > 0.01) ? densP : 1.0;
    float dens = clamp(frac, 0.3, 1.0) * (0.55 + 0.45 * clamp(audioSwell, 0.0, 1.0));
    if (id > uint(float(kBubbles) * dens)) return;

    float fid = float(id);
    vec3 h = hash31(fid);
    vec3 h2 = hash31(fid * 7.7 + 3.0);
    // Birth: at a blade tip, at the blade angle of the birth instant; life
    // is a continuous phase; downstream travel is +x with the helical
    // wake (the tip vortex) and the bubble grows then collapses.
    float life = fract(clock * (0.35 + 0.15 * h.x) + h.y);
    float birthClock = clock - life / (0.35 + 0.15 * h.x);
    float blade = floor(h.z * blades);
    float birthA = birthClock * 2.0 + blade / blades * 6.2831853;
    float rTip = 2.0 + 0.25 * h2.x;
    // Helical wake: the tip vortex screws downstream at the rotation rate.
    float wakeA = birthA + life * 4.0 * (0.8 + 0.4 * h2.y);
    float travel = life * 7.5;
    float spread = 1.0 + 0.6 * life;
    vec3 pos = hub + vec3(travel, cos(wakeA) * rTip * spread * (1.0 - 0.25 * life), sin(wakeA) * rTip * spread * (1.0 - 0.25 * life));
    pos += vec3(0.0, (h2.z - 0.5) * 0.4 * life, (h.x - 0.5) * 0.4 * life);
    // Size: grows, then collapses near the end of life.
    float grow = smoothstep(0.0, 0.25, life);
    float collapse = 1.0 - smoothstep(0.82, 0.96, life);
    float sz = (0.03 + 0.09 * h2.x) * grow * collapse + 0.004;
    emitQuad(pos, vec3(sz, 0.0, 0.0), vec3(0.0, sz, 0.0), fid, life, 0.0, vec2(0.0), vec2(1.0));
}
