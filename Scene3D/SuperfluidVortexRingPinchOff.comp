#version 430
/*****************************************************************************\
 *                              SuperfluidVortexRingPinchOff.comp
\*****************************************************************************/
/*! @file
 *
 *  @brief
 *  Compute generator companion to SuperfluidVortexRingPinchOff.frag -- generates 3D quantized vortex filaments
 *  undergoing Crow instability pinch-off into propagating toroidal vortex rings in superfluid liquid Helium-II.
 *
 *  SCREEN-FILL PASS.  Three faults kept this scene to occ 0.11:
 *    1. every ring was concentric about the view axis, so the whole tangle was one
 *       small disc in the middle of the frame;
 *    2. emitSegment built its width vector as cross(dir, (0,1,0)) -- for a ring
 *       lying in the XY plane that comes out along +z, i.e. EDGE ON to the camera,
 *       so the filaments rendered as near-zero-width slivers;
 *    3. the companion .vert tilted the scene AFTER pushing it down the view axis,
 *       which swung the whole tangle below the bottom edge (fixed there).
 *  The rings are now laid out on a jittered 14 x 12 lattice in FRUSTUM coordinates
 *  -- lateral slot, ring radius and filament thickness all scale with depth -- and
 *  each ring carries its own axis, so the ring gas fills the picture at every
 *  distance.  The width vector is billboarded against the view direction.
 *
 *  @author René Weller
 */
/// Layout qualifiers of this stage (work-group size, or the primitive in or out).
layout( local_size_x = 4, local_size_y = 4, local_size_z = 4 ) in;

/// The output vertex buffer: eight floats per vertex (attribute A, attribute B) that the scene draws.
layout( std430, binding = 0 ) buffer Verts
{
    float verts[]; // 8 floats per vertex: attrA.xyzw (pos, depth), attrB.xyzw (pad, pinchGlow)
};

/// DrawArraysIndirectCommand: [0] count, [1] instanceCount, [2] first, [3] baseInstance, [4] rawCount
layout( std430, binding = 1 ) buffer Cmd
{
    uint cmd[];
};

uniform uint  maxVertices;  ///< Capacity of the vertex buffer (compute stage).
uniform float time;         ///< Seconds since this activation, plus a rolled start (see sceneTime).
uniform float audioPhase;   ///< Rotation phase driven by the music (integrated, never jumps).
uniform float audioAdvance; ///< The music's advance: integrated tempo-weighted energy (never jumps, never runs
                            ///< backwards).
uniform float audioKick;    ///< Kick-drum envelope, 0..1 (fast attack, short decay).
uniform float audioBass;    ///< Bass band level, 0..1.
uniform float audioMid;     ///< Mid band level, 0..1.
uniform float audioHigh;    ///< High band level, 0..1.
uniform float audioSwell;   ///< Slow loudness envelope, 0..1 (seconds).
/// Documented in the .frag's per-activation block but read by nobody until now:
/// the Kelvin-wave cascade is a property of the FILAMENT, so it belongs here.
uniform float kelvinP;

// The scene projection: 55 deg vertical FOV, and the camera distance the
// companion .vert applies (vp.z += Cam).  No `resolution` uniform reaches a
// generator program, so the layout assumes a 16:9 frame; a narrower frame simply
// pushes the outermost lattice column past the edge.
const float TanY = 0.5206;   ///< Tangent of half the vertical field of view (the scene projection's 55 degrees).
const float Aspect = 1.7778; ///< Assumed screen aspect (16:9; this stage does not know the real one).
const float Cam = 4.5;       ///< Distance the vertex stage pushes the scene back from the camera.

const uint Cols = 14u;          ///< Columns of the vortex-ring grid.
const uint Rows = 12u;          ///< Rows of the vortex-ring grid.
const uint Rings = Cols * Rows; ///< 168 rings
const uint Segs = 64u;          ///< Segments per loop.

/**  Pseudo-random number 0..1 from a float.
 *
 * @param p  The input value. (in)
 *
 * @return
 *   A pseudo-random number 0..1.
 **/
float hash11( float p )
{
    p = fract( p * 0.1031 );
    p *= p + 47.19;
    p *= p + p;
    return fract( p );
}

/**  Writes one vertex into the output buffer (compute stage).
 *
 * @param slot  Index of the vertex in the buffer. (in)
 * @param p     Position. (in)
 * @param e1    Extra value (attribute A's w). (in)
 * @param e2    Extra value (attribute B's w). (in)
 **/
void writeVertex( uint slot, vec3 p, float e1, float e2 )
{
    uint o = slot * 8u;
    verts[o + 0u] = p.x;
    verts[o + 1u] = p.y;
    verts[o + 2u] = p.z;
    verts[o + 3u] = e1;
    verts[o + 4u] = 0.0;
    verts[o + 5u] = 0.0;
    verts[o + 6u] = 0.0;
    verts[o + 7u] = e2;
}

/**  Appends a thick line segment (two triangles) to the output buffer (compute stage).
 *
 * @param pA         Start of the segment. (in)
 * @param pB         End of the segment. (in)
 * @param e1         Extra value written to every vertex (first slot). (in)
 * @param e2         Extra value written to every vertex (second slot). (in)
 * @param thickness  Width of the ribbon. (in)
 **/
void emitSegment( vec3 pA, vec3 pB, float e1, float e2, float thickness )
{
    uint base = atomicAdd( cmd[4], 6u );
    if ( base + 6u > maxVertices )
        return;

    vec3  dir = pB - pA;
    float len = length( dir );
    dir = ( len > 1e-5 ) ? dir / len : vec3( 0.0, 1.0, 0.0 );
    // BILLBOARD the width against the view direction (+z away from the camera),
    // never against a fixed up-vector: a filament lying in the XY plane would
    // otherwise get a width vector pointing straight at the camera and vanish.
    vec3 view = vec3( 0.0, 0.0, 1.0 );
    vec3 side = cross( dir, view );
    if ( dot( side, side ) < 1e-6 )
        side = cross( dir, vec3( 0.0, 1.0, 0.0 ) );
    side = normalize( side ) * thickness;

    vec3 a0 = pA - side, a1 = pA + side, b0 = pB - side, b1 = pB + side;
    writeVertex( base + 0u, a0, e1, e2 );
    writeVertex( base + 1u, a1, e1, e2 );
    writeVertex( base + 2u, b0, e1, e2 );
    writeVertex( base + 3u, a1, e1, e2 );
    writeVertex( base + 4u, b1, e1, e2 );
    writeVertex( base + 5u, b0, e1, e2 );
}

/** Entry point of this shader stage (the file description says what it draws). */
void main()
{
    uvec3 g = gl_GlobalInvocationID;
    uint  idx = g.x + 64u * ( g.y + 64u * g.z );

    uint ring_idx = idx / Segs;
    uint seg_idx = idx % Segs;
    if ( ring_idx >= Rings )
        return;

    float t = time * 0.45 + audioAdvance * 0.4;
    float fi = float( ring_idx );
    float h0 = hash11( fi * 31.17 );
    float h1 = hash11( fi * 12.71 + 5.30 );
    float h2 = hash11( fi * 7.93 + 11.10 );
    float h3 = hash11( fi * 23.41 + 3.70 );
    float h4 = hash11( fi * 3.19 + 19.70 );

    // ---- FRUSTUM PLACEMENT --------------------------------------------
    float dz = 2.7 + 8.6 * h0; // view-space depth of this ring
    float half_h = dz * TanY;
    float half_w = half_h * Aspect;

    uint  gx = ring_idx % Cols;
    uint  gy = ( ring_idx / Cols ) % Rows;
    float fx = ( ( float( gx ) + 0.5 ) / float( Cols ) - 0.5 ) * 2.0 + ( h1 - 0.5 ) * 0.13;
    float fy = ( ( float( gy ) + 0.5 ) / float( Rows ) - 0.5 ) * 2.0 + ( h2 - 0.5 ) * 0.15;

    vec3 ctr = vec3( fx * half_w * 1.02, fy * half_h * 1.02, dz - Cam );

    // Toroidal ring, sized as a constant fraction of the frame at its own depth.
    float ring_r = half_h * ( 0.085 + 0.155 * h3 );

    // Each ring carries its own circulation axis and self-propels along it.
    float a_th = h3 * 3.14159265;
    float a_ph = h4 * 6.2831853;
    vec3  axis = vec3( sin( a_th ) * cos( a_ph ), sin( a_th ) * sin( a_ph ), cos( a_th ) );
    vec3  ref = ( abs( axis.z ) > 0.9 ) ? vec3( 1.0, 0.0, 0.0 ) : vec3( 0.0, 0.0, 1.0 );
    vec3  u_ax = normalize( cross( axis, ref ) );
    vec3  w_ax = cross( axis, u_ax );

    // Self-induced drift along the ring's own axis, wrapping through its slot.
    float travel = ( fract( h0 + t * 0.26 * ( 0.6 + 0.8 * h4 ) ) - 0.5 ) * half_h * 0.85;
    vec3  base = ctr + axis * travel;

    float s0 = float( seg_idx ) / float( Segs );
    float s1 = float( seg_idx + 1u ) / float( Segs );

    float ang0 = s0 * 6.2831853;
    float ang1 = s1 * 6.2831853;

    // Crow instability azimuthal wavy perturbations: delta R = epsilon * cos(m * phi)
    float kelvin = clamp( ( kelvinP > 0.01 ? kelvinP : 1.0 ), 0.6, 2.2 );
    float crow0 = sin( ang0 * 5.0 - t * 4.0 + fi ) * 0.11 * ring_r * kelvin;
    float crow1 = sin( ang1 * 5.0 - t * 4.0 + fi ) * 0.11 * ring_r * kelvin;

    vec3 p0 = base + ( u_ax * cos( ang0 ) + w_ax * sin( ang0 ) ) * ( ring_r + crow0 );
    vec3 p1 = base + ( u_ax * cos( ang1 ) + w_ax * sin( ang1 ) ) * ( ring_r + crow1 );

    // Pinch-off reconnection flash.  Clamped at BOTH ends: the top so a loud
    // beat cannot flatten all 168 rings to white, the bottom because the old
    // expression went negative over a quarter of every ring's circumference and
    // clamped to black there -- a quantized vortex filament is continuous, and
    // the gaps were throwing away a quarter of the scene's coverage.
    float pinch_flash = clamp( ( 1.0 + sin( ang0 * 5.0 - t * 4.0 + fi ) * 1.5 )
                                   * ( 1.0 + 3.0 * audioKick ),
                               0.22, 2.2 );
    float thick = half_h * 0.0065 * ( 1.0 + 0.3 * audioSwell );

    emitSegment( p0, p1, s0, pinch_flash, thick );
}
