#version 430
layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

/**
 * @file RadiolarianMicrotubuleExoskeleton.comp
 * @brief Compute generator companion to RadiolarianMicrotubuleExoskeleton.frag --
 * generates 3D porous icosahedral biosilica skeletons and radial axopodia spicules.
 */

layout(std430, binding = 0) buffer Verts {
    float verts[]; // 8 floats per vertex: attrA.xyzw (pos, radius), attrB.xyzw (pad, silicaGlow)
};

// DrawArraysIndirectCommand: [0] count, [1] instanceCount, [2] first, [3] baseInstance, [4] rawCount
layout(std430, binding = 1) buffer Cmd { uint cmd[]; };

uniform uint  maxVertices;
uniform float time;
uniform float audioPhase;
uniform float audioAdvance;
uniform float audioKick;
uniform float audioBass;
uniform float audioMid;
uniform float audioHigh;
uniform float audioSwell;

float hash11(float p) {
    p = fract(p * 0.1031);
    p *= p + 53.19;
    p *= p + p;
    return fract(p);
}

void writeVertex(uint slot, vec3 p, float e1, float e2) {
    uint o = slot * 8u;
    verts[o + 0u] = p.x;  verts[o + 1u] = p.y;  verts[o + 2u] = p.z;
    verts[o + 3u] = e1;
    verts[o + 4u] = 0.0;  verts[o + 5u] = 0.0;  verts[o + 6u] = 0.0;
    verts[o + 7u] = e2;
}

void emitSegment(vec3 pA, vec3 pB, float e1, float e2, float thickness) {
    uint base = atomicAdd(cmd[4], 6u);
    if (base + 6u > maxVertices) return;

    vec3 dir = pB - pA;
    float len = length(dir);
    dir = (len > 1e-5) ? dir / len : vec3(0.0, 1.0, 0.0);
    vec3 upv = (abs(dir.y) > 0.95) ? vec3(1.0, 0.0, 0.0) : vec3(0.0, 1.0, 0.0);
    vec3 side = normalize(cross(dir, upv)) * thickness;

    vec3 a0 = pA - side, a1 = pA + side, b0 = pB - side, b1 = pB + side;
    writeVertex(base + 0u, a0, e1, e2);
    writeVertex(base + 1u, a1, e1, e2);
    writeVertex(base + 2u, b0, e1, e2);
    writeVertex(base + 3u, a1, e1, e2);
    writeVertex(base + 4u, b1, e1, e2);
    writeVertex(base + 5u, b0, e1, e2);
}

void main() {
    uvec3 g = gl_GlobalInvocationID;
    uint idx = g.x + 64u * (g.y + 64u * g.z);
    
    // 64 radial spicules and 64 concentric strut segments = 4096 invocations
    uint strutIdx = idx / 64u;
    uint segIdx   = idx % 64u;
    if (strutIdx >= 64u) return;

    float t = time * 0.35 + audioAdvance * 0.3;
    float seed = hash11(float(strutIdx) * 23.41);
    
    // Golden spiral sphere distribution of strut anchors
    float phi0 = acos(1.0 - 2.0 * (float(strutIdx) + 0.5) / 64.0);
    float theta0 = 3.14159265 * (1.0 + sqrt(5.0)) * float(strutIdx) + audioPhase * 0.2;
    
    vec3 dir0 = vec3(sin(phi0) * cos(theta0), sin(phi0) * sin(theta0), cos(phi0));
    
    float s0 = float(segIdx) / 64.0;
    float s1 = float(segIdx + 1u) / 64.0;

    // Shell radius with undulating breathing
    float rShell = (1.2 + 0.3 * sin(t * 0.5 + float(strutIdx) * 0.1)) * (1.0 + 0.3 * audioSwell);
    float rSpicule = rShell + s0 * 1.5;
    float rSpicule1 = rShell + s1 * 1.5;

    vec3 p0 = dir0 * rSpicule;
    vec3 p1 = dir0 * rSpicule1;

    // Silica glass glow and kick pulse
    float glow = (1.0 - s0 * 0.5) * (1.0 + 2.5 * audioKick);
    float thick = (0.015 * (1.0 - s0 * 0.5)) * (1.0 + 0.4 * audioSwell);

    emitSegment(p0, p1, rSpicule / 2.7, glow, thick);
}
