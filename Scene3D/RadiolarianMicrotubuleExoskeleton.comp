#version 430
/*****************************************************************************\
 *                              RadiolarianMicrotubuleExoskeleton.comp
\*****************************************************************************/
/*! @file
 *
 *  @brief
 *  Compute generator companion to RadiolarianMicrotubuleExoskeleton.frag -- generates 3D porous icosahedral
 *  biosilica skeletons and radial axopodia spicules.
 *
 *  Builds a PLANKTON FIELD of seven radiolaria spread through the view frustum,
 *  plus a fine silica-dust haze.  Previously one skeleton sat on the origin and
 *  consisted of nothing but 64 radial hairlines -- the porous shell the header
 *  promises was never actually generated -- so the frame was a small spiky ball
 *  adrift in black (measured occ 0.34, luma 0.013).
 *
 *  @author René Weller
 */
/// Layout qualifiers of this stage (work-group size, or the primitive in or out).
layout( local_size_x = 4, local_size_y = 4, local_size_z = 4 ) in;

/// The output vertex buffer: eight floats per vertex (attribute A, attribute B) that the scene draws.
layout( std430, binding = 0 ) buffer Verts
{
    float verts[]; // 8 floats per vertex: attrA.xyzw (pos, radius), attrB.xyzw (pad, silicaGlow)
};

/// DrawArraysIndirectCommand: [0] count, [1] instanceCount, [2] first, [3] baseInstance, [4] rawCount
layout( std430, binding = 1 ) buffer Cmd
{
    uint cmd[];
};

uniform uint  maxVertices;  ///< Capacity of the vertex buffer (compute stage).
uniform float time;         ///< Seconds since this activation, plus a rolled start (see sceneTime).
uniform float audioPhase;   ///< Rotation phase driven by the music (integrated, never jumps).
uniform float audioAdvance; ///< The music's advance: integrated tempo-weighted energy (never jumps, never runs
                            ///< backwards).
uniform float audioKick;    ///< Kick-drum envelope, 0..1 (fast attack, short decay).
uniform float audioBass;    ///< Bass band level, 0..1.
uniform float audioMid;     ///< Mid band level, 0..1.
uniform float audioHigh;    ///< High band level, 0..1.
uniform float audioSwell;   ///< Slow loudness envelope, 0..1 (seconds).

// The scene projection: 55 deg vertical FOV (see Scene3DShader::draw), and the
// camera distance the companion .vert applies.  A generator program gets no
// `resolution` uniform, so the layout assumes 16:9 -- the house fallback.
const float TanY = 0.5206;   ///< Tangent of half the vertical field of view (the scene projection's 55 degrees).
const float Aspect = 1.7778; ///< Assumed screen aspect (16:9; this stage does not know the real one).
const float Cam = 4.8;       ///< Distance the vertex stage pushes the scene back from the camera.

const uint Orgs = 7u;                 ///< Number of skeletons.
const uint SpicN = 48u;               ///< radial axopodia per skeleton
const uint SpicS = 32u;               ///< segments per spicule
const uint SpicTot = SpicN * SpicS;   ///< 1536
const uint ArcN = 72u;                ///< great-circle shell struts
const uint ArcS = 24u;                ///< segments per strut
const uint ArcTot = ArcN * ArcS;      ///< 1728
const uint PerOrg = SpicTot + ArcTot; ///< 3264
const uint OrgTot = PerOrg * Orgs;    ///< 22848
const uint Dust = 5000u;              ///< silica dust motes
const uint Total = OrgTot + Dust;     ///< 27848 segs = 167088 vertices

/**  Pseudo-random number 0..1 from a float.
 *
 * @param p  The input value. (in)
 *
 * @return
 *   A pseudo-random number 0..1.
 **/
float hash11( float p )
{
    p = fract( p * 0.1031 );
    p *= p + 53.19;
    p *= p + p;
    return fract( p );
}

/**  Each skeleton turns on its own two axes, about ITS OWN centre.
 *
 * @param p  The point relative to the skeleton's centre. (in)
 * @param a  Turn about y (radians). (in)
 * @param b  Turn about x (radians). (in)
 *
 * @return
 *   The turned point.
 *
 * The spin used to live in the vertex stage, where it rotated every position about the world origin -- harmless for a
 * single skeleton sitting there, but it would swing a whole field of them right out of the frustum.
 **/
vec3 spin( vec3 p, float a, float b )
{
    float ca = cos( a ), sa = sin( a );
    p = vec3( p.x * ca - p.z * sa, p.y, p.x * sa + p.z * ca );
    float cb = cos( b ), sb = sin( b );
    p = vec3( p.x, p.y * cb - p.z * sb, p.y * sb + p.z * cb );
    return p;
}

/**  Writes one vertex into the output buffer (compute stage).
 *
 * @param slot  Index of the vertex in the buffer. (in)
 * @param p     Position. (in)
 * @param e1    Extra value (attribute A's w). (in)
 * @param e2    Extra value (attribute B's w). (in)
 **/
void writeVertex( uint slot, vec3 p, float e1, float e2 )
{
    uint o = slot * 8u;
    verts[o + 0u] = p.x;
    verts[o + 1u] = p.y;
    verts[o + 2u] = p.z;
    verts[o + 3u] = e1;
    verts[o + 4u] = 0.0;
    verts[o + 5u] = 0.0;
    verts[o + 6u] = 0.0;
    verts[o + 7u] = e2;
}

/**  Appends a thick line segment (two triangles) to the output buffer (compute stage).
 *
 * @param pA         Start of the segment. (in)
 * @param pB         End of the segment. (in)
 * @param e1         Extra value written to every vertex (first slot). (in)
 * @param e2         Extra value written to every vertex (second slot). (in)
 * @param thickness  Width of the ribbon. (in)
 **/
void emitSegment( vec3 pA, vec3 pB, float e1, float e2, float thickness )
{
    uint base = atomicAdd( cmd[4], 6u );
    if ( base + 6u > maxVertices )
        return;

    vec3  dir = pB - pA;
    float len = length( dir );
    dir = ( len > 1e-5 ) ? dir / len : vec3( 0.0, 1.0, 0.0 );

    // The ribbon has to be widened ACROSS THE SCREEN, not along the view axis.
    // Crossing dir with world UP -- as this did -- points the side vector
    // straight down +Z for every strut that happens to lie in the XY plane, and
    // those quads come out exactly edge-on to the camera: roughly half the
    // skeleton was drawn as zero-width slivers whatever thickness was asked
    // for.  Crossing with the VIEW axis faces every ribbon at the lens.
    vec3  side = cross( dir, vec3( 0.0, 0.0, 1.0 ) );
    float sl = length( side );
    side = ( sl > 1e-4 ) ? side * ( thickness / sl ) : vec3( thickness, 0.0, 0.0 );

    vec3 a0 = pA - side, a1 = pA + side, b0 = pB - side, b1 = pB + side;
    writeVertex( base + 0u, a0, e1, e2 );
    writeVertex( base + 1u, a1, e1, e2 );
    writeVertex( base + 2u, b0, e1, e2 );
    writeVertex( base + 3u, a1, e1, e2 );
    writeVertex( base + 4u, b1, e1, e2 );
    writeVertex( base + 5u, b0, e1, e2 );
}

/** Entry point of this shader stage (the file description says what it draws). */
void main()
{
    uvec3 g = gl_GlobalInvocationID;
    uint  idx = g.x + 64u * ( g.y + 64u * g.z );
    if ( idx >= Total )
        return;

    float t = time * 0.35 + audioAdvance * 0.3;

    // ------------------------------------------------------------------
    // SILICA DUST -- shed spicule fragments drifting through the whole water
    // volume, spread evenly over the FRUSTUM so the space between the
    // skeletons reads as ocean rather than as nothing.  The fragment stage
    // shades these dimmer via a low silicaGlow.
    // ------------------------------------------------------------------
    if ( idx >= OrgTot )
    {
        float fi = float( idx - OrgTot );
        float d0 = hash11( fi * 1.731 + 0.13 );
        float d1 = hash11( fi * 3.917 + 4.71 );
        float d2 = hash11( fi * 7.311 + 9.27 );
        float d3 = hash11( fi * 5.109 + 2.53 );

        float dz = 3.0 + 15.0 * d0;
        float half_h = dz * TanY;
        float half_w = half_h * Aspect;

        // Slow sink with a lateral sway; the wrap keeps the field uniform.
        // Only CONSTANT per-mote factors ever multiply the clock.
        float fall = fract( d1 + t * 0.030 * ( 0.5 + d3 ) );
        float sway = sin( t * 0.5 + d2 * 6.2831853 ) * 0.05;

        vec3  c = vec3( ( d2 * 2.0 - 1.0 + sway ) * half_w * 1.05,
                        ( 1.05 - 2.10 * fall ) * half_h,
                        dz - Cam );
        float ang = d3 * 6.2831853 + t * 0.4;
        vec3  dd = vec3( cos( ang ), sin( ang ), 0.0 );
        float hl = half_h * 0.0065;
        emitSegment( c - dd * hl, c + dd * hl,
                     d1, 0.30 * ( 0.6 + 0.8 * d3 ) * ( 1.0 + 0.6 * audioKick ),
                     half_h * 0.0035 );
        return;
    }

    // ------------------------------------------------------------------
    // ONE SKELETON OF THE BLOOM
    // ------------------------------------------------------------------
    uint org = idx / PerOrg;
    uint li = idx % PerOrg;

    float fo = float( org );
    float o0 = hash11( fo * 13.77 + 2.10 );
    float o1 = hash11( fo * 6.41 + 8.30 );
    float o2 = hash11( fo * 21.09 + 1.70 );
    float o3 = hash11( fo * 4.63 + 5.90 );
    float o4 = hash11( fo * 17.23 + 3.30 );

    // FRUSTUM placement: a skeleton's size is a fixed fraction of the frame at
    // ITS depth, so a far one reads the same size as a near one instead of
    // shrinking away into the dark.
    float dz = 4.0 + 13.0 * o0;
    float half_h = dz * TanY;
    float half_w = half_h * Aspect;
    vec3  ctr = vec3( ( o1 * 2.0 - 1.0 ) * half_w * 0.86,
                      ( o2 * 2.0 - 1.0 ) * half_h * 0.80,
                      dz - Cam );
    float scale = half_h * ( 0.30 + 0.20 * o3 );

    float sa = time * ( 0.10 + 0.10 * o3 ) + o4 * 6.2831853 + audioAdvance * 0.10;
    float sb = time * ( 0.07 + 0.06 * o4 ) + o1 * 6.2831853;

    // Shell radius with undulating breathing (in units of `scale`).
    float r_shell = ( 0.62 + 0.10 * sin( t * 0.5 + fo * 1.7 ) ) * ( 1.0 + 0.3 * audioSwell );

    vec3  p0, p1;
    float radius_out, glow, thick;

    if ( li < SpicTot )
    {
        // ---- RADIAL AXOPODIA SPICULES --------------------------------
        uint strut_idx = li / SpicS;
        uint seg_idx = li % SpicS;

        float phi0 = acos( 1.0 - 2.0 * ( float( strut_idx ) + 0.5 ) / float( SpicN ) );
        float theta0 = 3.14159265 * ( 1.0 + sqrt( 5.0 ) ) * float( strut_idx )
                       + audioPhase * 0.2 + fo * 1.13;
        vec3  dir0 = vec3( sin( phi0 ) * cos( theta0 ), sin( phi0 ) * sin( theta0 ), cos( phi0 ) );

        float s0 = float( seg_idx ) / float( SpicS );
        float s1 = float( seg_idx + 1u ) / float( SpicS );
        float r_a = r_shell + s0 * 0.75;
        float r_b = r_shell + s1 * 0.75;

        p0 = dir0 * r_a;
        p1 = dir0 * r_b;
        radius_out = r_a / 1.4;
        glow = ( 1.0 - s0 * 0.5 ) * ( 1.0 + 2.5 * audioKick );
        thick = half_h * 0.0062 * ( 1.0 - s0 * 0.5 ) * ( 1.0 + 0.4 * audioSwell );
    }
    else
    {
        // ---- POROUS SHELL LATTICE ------------------------------------
        // Great circles woven around the shell.  This is the "concentric
        // icosahedral lattice" the scene is named for and it was simply never
        // built: without it the skeleton is a bare sea-urchin of hairlines
        // with nothing between the spines.
        uint a = ( li - SpicTot ) / ArcS;
        uint sg = ( li - SpicTot ) % ArcS;

        float phi_a = acos( 1.0 - 2.0 * ( float( a ) + 0.5 ) / float( ArcN ) );
        float theta_a = 3.14159265 * ( 1.0 + sqrt( 5.0 ) ) * float( a ) + fo * 2.31;
        vec3  axis = vec3( sin( phi_a ) * cos( theta_a ), sin( phi_a ) * sin( theta_a ), cos( phi_a ) );
        vec3  ref = ( abs( axis.z ) > 0.9 ) ? vec3( 1.0, 0.0, 0.0 ) : vec3( 0.0, 0.0, 1.0 );
        vec3  e1 = normalize( cross( axis, ref ) );
        vec3  e2 = cross( axis, e1 );

        float u0 = ( float( sg ) / float( ArcS ) ) * 6.2831853;
        float u1 = ( float( sg + 1u ) / float( ArcS ) ) * 6.2831853;
        // A slow ripple over the shell keeps the lattice breathing rather than
        // reading as a rigid wire globe.
        float rr0 = r_shell * ( 1.0 + 0.055 * sin( u0 * 3.0 + t * 0.8 + fo ) );
        float rr1 = r_shell * ( 1.0 + 0.055 * sin( u1 * 3.0 + t * 0.8 + fo ) );

        p0 = ( e1 * cos( u0 ) + e2 * sin( u0 ) ) * rr0;
        p1 = ( e1 * cos( u1 ) + e2 * sin( u1 ) ) * rr1;
        radius_out = r_shell / 1.4;
        glow = 0.70 * ( 1.0 + 1.6 * audioKick );
        thick = half_h * 0.0042 * ( 1.0 + 0.4 * audioSwell );
    }

    p0 = ctr + spin( p0, sa, sb ) * scale;
    p1 = ctr + spin( p1, sa, sb ) * scale;

    emitSegment( p0, p1, radius_out, glow, thick );
}
