#version 430 core
/**
 * @file BorromeanRingsOrbit.comp
 * @brief BORROMEAN RINGS ORBIT: three rings, no two of which are linked,
 * yet inseparable -- built as three tori in mutually perpendicular
 * planes, each displaced along its own axis so they interlock the
 * Borromean way; the whole turns slowly on the scene clock.  Translucent
 * glass rings (OIT), each lit by a band group (fragment).  Torus normals
 * are packed as xy in the uv slots with the z sign in kind.  No state.
 * Camera still.
 *
 * Per-instance: sizeP, thickP, hueP.
 */
layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;
layout(std430, binding = 0) buffer Verts { float verts[]; };
layout(std430, binding = 1) buffer Cmd   { uint cmd[];   };

uniform uint  maxVertices;
uniform float time;
uniform float sceneAdvance;
uniform float sceneTime;

uniform float sizeP;
uniform float thickP;
uniform float hueP;

void emitQuadN(vec3 p0, vec3 p1, vec3 p2, vec3 p3, vec3 n0, vec3 n1, vec3 n2, vec3 n3, float id, float aux, float kind)
{
    uint base = atomicAdd(cmd[4], 6u);
    if (base + 6u > maxVertices) return;
    vec3 pList[6]  = vec3[6](p0, p1, p2, p0, p2, p3);
    vec3 nList[6]  = vec3[6](n0, n1, n2, n0, n2, n3);
    for (uint i = 0u; i < 6u; ++i)
    {
        uint off = (base + i) * 8u;
        verts[off + 0u] = pList[i].x; verts[off + 1u] = pList[i].y; verts[off + 2u] = pList[i].z;
        verts[off + 3u] = id; verts[off + 4u] = aux; verts[off + 5u] = kind;
        verts[off + 6u] = nList[i].x; verts[off + 7u] = nList[i].y;
    }
}

void main()
{
    uvec3 g = gl_GlobalInvocationID;
    uint id = g.x + 64u * (g.y + 64u * g.z);
    const uint kSeg = 64u, kSide = 14u;
    const uint quadsPer = kSeg * kSide;
    float clock = sceneAdvance * 0.3 + sceneTime * 0.06;
    float R = 2.2 * (sizeP > 0.05 ? sizeP : 1.0);
    float r = (0.18 + 0.22 * clamp(thickP, 0.0, 1.0)) * (sizeP > 0.05 ? sizeP : 1.0);
    const vec3 centre = vec3(0.0, 0.0, 9.0);
    float ry = clock, rx = 0.6 + 0.3 * sin(clock * 0.4);
    mat3 RY = mat3(cos(ry), 0.0, -sin(ry), 0.0, 1.0, 0.0, sin(ry), 0.0, cos(ry));
    mat3 RX = mat3(1.0, 0.0, 0.0, 0.0, cos(rx), sin(rx), 0.0, -sin(rx), cos(rx));
    mat3 M = RX * RY;

    if (id == 0u)
    {
        // The wall behind (kind -1), opaque.
        uint base = atomicAdd(cmd[4], 6u);
        if (base + 6u <= maxVertices)
        {
            vec3 c = vec3(0.0, 0.0, 30.0), ax = vec3(50.0, 0.0, 0.0), ay = vec3(0.0, 28.0, 0.0);
            vec3 p0 = c - ax - ay, p1 = c + ax - ay, p2 = c + ax + ay, p3 = c - ax + ay;
            vec3 pList[6]  = vec3[6](p0, p1, p2, p0, p2, p3);
            vec2 uvList[6] = vec2[6](vec2(0.0, 0.0), vec2(1.0, 0.0), vec2(1.0, 1.0), vec2(0.0, 0.0), vec2(1.0, 1.0), vec2(0.0, 1.0));
            for (uint i = 0u; i < 6u; ++i)
            {
                uint off = (base + i) * 8u;
                verts[off + 0u] = pList[i].x; verts[off + 1u] = pList[i].y; verts[off + 2u] = pList[i].z;
                verts[off + 3u] = 0.0; verts[off + 4u] = 0.0; verts[off + 5u] = -1.0;
                verts[off + 6u] = uvList[i].x; verts[off + 7u] = uvList[i].y;
            }
        }
        return;
    }
    uint q = id - 1u;
    if (q >= 3u * quadsPer) return;
    uint ring = q / quadsPer;
    uint qi = q - ring * quadsPer;
    uint si = qi / kSide, ti = qi - si * kSide;
    // Ring frames: ring 0 in the xy plane offset along x, ring 1 in yz offset
    // along y, ring 2 in zx offset along z -- the Borromean arrangement
    // (each ring is an ellipse elongated along the axis it is offset on).
    vec3 e1, e2, offAxis;
    if (ring == 0u) { e1 = vec3(1.0, 0.0, 0.0); e2 = vec3(0.0, 1.0, 0.0); offAxis = vec3(0.0, 0.0, 0.0); }
    else if (ring == 1u) { e1 = vec3(0.0, 1.0, 0.0); e2 = vec3(0.0, 0.0, 1.0); offAxis = vec3(0.0, 0.0, 0.0); }
    else { e1 = vec3(0.0, 0.0, 1.0); e2 = vec3(1.0, 0.0, 0.0); offAxis = vec3(0.0, 0.0, 0.0); }
    // Elongate along e1 (golden-rectangle Borromean rings).
    float a0 = float(si) / float(kSeg) * 6.2831853, a1 = float(si + 1u) / float(kSeg) * 6.2831853;
    float b0 = float(ti) / float(kSide) * 6.2831853, b1 = float(ti + 1u) / float(kSide) * 6.2831853;
    vec3 P[4]; vec3 N[4];
    float aa[4] = float[4](a0, a1, a1, a0);
    float bb[4] = float[4](b0, b0, b1, b1);
    vec3 e3 = cross(e1, e2);
    for (int k = 0; k < 4; ++k)
    {
        vec3 ringDir = normalize(e1 * cos(aa[k]) * 1.618 + e2 * sin(aa[k]));
        vec3 centreLine = e1 * cos(aa[k]) * R * 1.618 + e2 * sin(aa[k]) * R;
        vec3 n = ringDir * cos(bb[k]) + e3 * sin(bb[k]);
        P[k] = centre + M * (centreLine + n * r);
        N[k] = M * n;
    }
    emitQuadN(P[0], P[1], P[2], P[3], N[0], N[1], N[2], N[3], float(ring), float(si) / float(kSeg), (N[0].z >= 0.0) ? 0.0 : 1.0);
}
