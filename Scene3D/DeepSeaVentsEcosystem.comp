#version 430
layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

// DeepSeaVentsEcosystem.comp
// Compute shader generating 3D hydrothermal black smoker mineral plumes and bioluminescent organisms

layout(std430, binding = 0) buffer Verts {
    float verts[]; // 8 floats per vertex: attrA.xyzw (pos, species), attrB.xyzw (pad, bioGlow)
};

// DrawArraysIndirectCommand + our own counter:
//   [0] count  [1] instanceCount  [2] first  [3] baseInstance  [4] rawCount
layout(std430, binding = 1) buffer Cmd { uint cmd[]; };

uniform uint  maxVertices;
uniform float time;
uniform float audioPhase;
uniform float audioAdvance;
uniform float audioKick;
uniform float audioBass;
uniform float audioMid;
uniform float audioHigh;
uniform float audioSwell;

float hash11(float p) {
    p = fract(p * 0.1031);
    p *= p + 41.13;
    p *= p + p;
    return fract(p);
}

void writeVertex(uint slot, vec3 p, float e1, float e2) {
    uint o = slot * 8u;
    verts[o + 0u] = p.x;  verts[o + 1u] = p.y;  verts[o + 2u] = p.z;
    verts[o + 3u] = e1;
    verts[o + 4u] = 0.0;  verts[o + 5u] = 0.0;  verts[o + 6u] = 0.0;
    verts[o + 7u] = e2;
}

// A plume/organism streamer is a line from A to B; GL_TRIANGLES needs a real
// triangle, so it is emitted as a thin two-triangle ribbon.
void emitSegment(vec3 pA, vec3 pB, float e1, float e2, float thickness) {
    uint base = atomicAdd(cmd[4], 6u);
    if (base + 6u > maxVertices) return;

    vec3 dir = pB - pA;
    float len = length(dir);
    dir = (len > 1e-5) ? dir / len : vec3(0.0, 1.0, 0.0);
    vec3 upv = (abs(dir.y) > 0.95) ? vec3(1.0, 0.0, 0.0) : vec3(0.0, 1.0, 0.0);
    vec3 side = normalize(cross(dir, upv)) * thickness;

    vec3 a0 = pA - side, a1 = pA + side, b0 = pB - side, b1 = pB + side;
    writeVertex(base + 0u, a0, e1, e2);
    writeVertex(base + 1u, a1, e1, e2);
    writeVertex(base + 2u, b0, e1, e2);
    writeVertex(base + 3u, a1, e1, e2);
    writeVertex(base + 4u, b1, e1, e2);
    writeVertex(base + 5u, b0, e1, e2);
}

void main() {
    uvec3 g = gl_GlobalInvocationID;
    uint id = g.x + 64u * (g.y + 64u * g.z);
    const uint TOTAL_ORGANISMS = 4096u;
    if (id >= TOTAL_ORGANISMS) return;

    float seed = float(id);
    float rand1 = hash11(seed);
    float rand2 = hash11(seed + 100.0);
    float rand3 = hash11(seed + 200.0);

    float t = time * 0.3 + audioAdvance * 0.15;

    // Plume column convection & organism swirling
    float plumeHeight = mod(rand1 * 10.0 + t * (1.5 + 2.0 * rand2), 6.0) - 2.5;
    float plumeRadius = (0.3 + 0.35 * (plumeHeight + 2.5)) * (0.8 + 0.4 * rand3);

    float angle = rand2 * 6.2831853 + t * (0.5 + rand1 * 0.5);

    // Turbulence curl noise offset
    float curlX = sin(plumeHeight * 3.0 + t * 2.0 + rand1 * 6.28) * 0.2;
    float curlZ = cos(plumeHeight * 2.5 + t * 1.8 + rand2 * 6.28) * 0.2;

    float x1 = plumeRadius * cos(angle) + curlX;
    float y1 = plumeHeight + audioKick * 0.4 * (1.0 - rand1);
    float z1 = plumeRadius * sin(angle) + curlZ;

    // Second vertex of organism / plume streamer
    float x2 = x1 + (rand1 - 0.5) * 0.15;
    float y2 = y1 + 0.1 + rand2 * 0.15;
    float z2 = z1 + (rand3 - 0.5) * 0.15;

    float species = rand1; // 0..1 determines tube worm vs hydrothermal bacteria vs mineral particle
    float bioGlow = 0.5 + 0.5 * sin(seed * 0.1 + time * 3.0 + audioKick * 4.0);

    emitSegment(vec3(x1, y1, z1), vec3(x2, y2, z2), species, bioGlow, 0.025);
}
