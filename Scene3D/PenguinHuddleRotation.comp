#version 430 core
/**
 * @file PenguinHuddleRotation.comp
 * @brief PENGUIN HUDDLE ROTATION: emperor penguins in the blizzard,
 * packed in a huddle that slowly rotates -- the birds on the windward
 * edge peel off and shuffle round to the lee, so the whole mass turns
 * like a very slow wheel.  Each bird sits on a spiral of the huddle
 * whose angle advances on the scene clock; the storm strength is the
 * swell (fragment: snow, visibility).  No state.  Camera fixed on the ice.
 *
 * Per-instance: colonyP, packP, hueP.
 */
layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;
layout(std430, binding = 0) buffer Verts { float verts[]; };
layout(std430, binding = 1) buffer Cmd   { uint cmd[];   };

uniform uint  maxVertices;
uniform float time;
uniform float sceneAdvance;
uniform float sceneTime;

uniform float colonyP;
uniform float packP;
uniform float hueP;

float hash11(float p) { p = fract(p * 0.1031); p *= p + 33.33; p *= p + p; return fract(p); }
vec3  hash31(float n) { return vec3(hash11(n), hash11(n + 17.3), hash11(n + 41.7)); }

void emitQuad(vec3 c, vec3 ax, vec3 ay, float id, float lit, float kind, vec2 uv0, vec2 uv1)
{
    uint base = atomicAdd(cmd[4], 6u);
    if (base + 6u > maxVertices) return;
    vec3 p0 = c - ax - ay, p1 = c + ax - ay, p2 = c + ax + ay, p3 = c - ax + ay;
    vec3 pList[6]  = vec3[6](p0, p1, p2, p0, p2, p3);
    vec2 uvList[6] = vec2[6](vec2(uv0.x, uv0.y), vec2(uv1.x, uv0.y), vec2(uv1.x, uv1.y), vec2(uv0.x, uv0.y), vec2(uv1.x, uv1.y), vec2(uv0.x, uv1.y));
    for (uint i = 0u; i < 6u; ++i)
    {
        uint off = (base + i) * 8u;
        verts[off + 0u] = pList[i].x; verts[off + 1u] = pList[i].y; verts[off + 2u] = pList[i].z;
        verts[off + 3u] = id; verts[off + 4u] = lit; verts[off + 5u] = kind;
        verts[off + 6u] = uvList[i].x; verts[off + 7u] = uvList[i].y;
    }
}

void main()
{
    uvec3 g = gl_GlobalInvocationID;
    uint id = g.x + 64u * (g.y + 64u * g.z);
    uint nBirds = 400u + uint(clamp(colonyP, 0.0, 1.0) * 500.0);
    float pack = 0.6 + 0.3 * clamp(packP, 0.0, 1.0);
    float clock = sceneAdvance * 0.08 + sceneTime * 0.015;
    const vec3 centre = vec3(0.0, -1.2, 12.0);
    const float ICE_Y = -1.6;

    if (id == 0u)
    {
        emitQuad(vec3(0.0, 4.0, 60.0), vec3(90.0, 0.0, 0.0), vec3(0.0, 40.0, 0.0), 0.0, 0.0, -1.0, vec2(0.0), vec2(1.0));
        emitQuad(vec3(0.0, ICE_Y, 25.0), vec3(90.0, 0.0, 0.0), vec3(0.0, 0.0, 25.0), 0.0, 0.0, -2.0, vec2(0.0), vec2(1.0));
        return;
    }
    uint b = id - 1u;
    if (b >= nBirds) return;
    float fb = float(b);
    vec3 h = hash31(fb * 3.7 + 1.0);
    // Huddle layout: a sunflower spiral (golden angle) so the packing is
    // even; the whole spiral rotates on the clock, and the outermost ring
    // rotates a little faster (the shuffle round the edge).
    float k = fb + 0.5;
    float rr = sqrt(k / float(nBirds)) * 4.8 / pack;
    float edge = smoothstep(0.75, 1.0, rr / (4.8 / pack));
    float ang = k * 2.39996 + clock * (1.0 + 1.5 * edge);
    vec3 pos = centre + vec3(cos(ang) * rr, 0.0, sin(ang) * rr * 0.7);
    // Height and size by depth (nearer = larger); a slow rock of the body.
    float sz = 0.42 + 0.08 * h.x;
    float rock = 0.02 * sin(clock * 20.0 + fb);
    // A bird: a tall rounded quad (kind 0), facing the camera, with its
    // back to the wind; the outer birds carry more snow (lit = edge).
    emitQuad(pos + vec3(rock, sz * 0.9, 0.0), vec3(sz * 0.55, 0.0, 0.0), vec3(0.0, sz * 0.95, 0.0), fb, edge, 0.0, vec2(0.0), vec2(1.0));
}
