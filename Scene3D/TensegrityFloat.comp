#version 430 core
/**
 * @file TensegrityFloat.comp
 * @brief TENSEGRITY FLOAT: a six-strut tensegrity -- rigid struts that
 * touch nothing, held in the air by a net of cables in pure tension --
 * floating in front of the camera, turning and swaying gently on the
 * scene clock.  The struts carry the photo; each cable belongs to a
 * pitch class and lights with it (fragment).  Geometry: the expanded
 * octahedron (three parallel strut pairs), each strut end tied to its
 * four nearest foreign ends.  No state.  The camera never moves.
 *
 * Per-instance: sizeP, swayP, hueP.
 */
layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;
layout(std430, binding = 0) buffer Verts { float verts[]; };
layout(std430, binding = 1) buffer Cmd   { uint cmd[];   };

uniform uint  maxVertices;
uniform float time;
uniform float sceneAdvance;
uniform float sceneTime;

uniform float sizeP;
uniform float swayP;
uniform float hueP;

void emitQuad(vec3 c, vec3 ax, vec3 ay, float id, float lit, float kind, vec2 uv0, vec2 uv1)
{
    uint base = atomicAdd(cmd[4], 6u);
    if (base + 6u > maxVertices) return;
    vec3 p0 = c - ax - ay, p1 = c + ax - ay, p2 = c + ax + ay, p3 = c - ax + ay;
    vec3 pList[6]  = vec3[6](p0, p1, p2, p0, p2, p3);
    vec2 uvList[6] = vec2[6](vec2(uv0.x, uv0.y), vec2(uv1.x, uv0.y), vec2(uv1.x, uv1.y), vec2(uv0.x, uv0.y), vec2(uv1.x, uv1.y), vec2(uv0.x, uv1.y));
    for (uint i = 0u; i < 6u; ++i)
    {
        uint off = (base + i) * 8u;
        verts[off + 0u] = pList[i].x; verts[off + 1u] = pList[i].y; verts[off + 2u] = pList[i].z;
        verts[off + 3u] = id; verts[off + 4u] = lit; verts[off + 5u] = kind;
        verts[off + 6u] = uvList[i].x; verts[off + 7u] = uvList[i].y;
    }
}

// Strut endpoints of the expanded octahedron: strut s (0..5), end e (0/1).
vec3 strutEnd(int s, int e)
{
    float L = 1.0, w = 0.5;
    float sgn = (e == 0) ? -1.0 : 1.0;
    float side = (s % 2 == 0) ? 1.0 : -1.0;
    int axis = s / 2;
    if (axis == 0) return vec3(sgn * L, 0.0, side * w);
    if (axis == 1) return vec3(side * w, sgn * L, 0.0);
    return vec3(0.0, side * w, sgn * L);
}

void main()
{
    uvec3 g = gl_GlobalInvocationID;
    uint id = g.x + 64u * (g.y + 64u * g.z);
    float clock = sceneAdvance * 0.35 + sceneTime * 0.07;
    float size = 3.2 * (sizeP > 0.05 ? sizeP : 1.0);
    float sway = 0.15 + 0.25 * clamp(swayP, 0.0, 1.0);
    // Rigid motion: slow rotation about a tilted axis, a gentle bob.
    float ry = clock, rx = 0.5 + sway * sin(clock * 0.7), rz = sway * sin(clock * 0.5 + 1.0);
    mat3 RY = mat3(cos(ry), 0.0, -sin(ry), 0.0, 1.0, 0.0, sin(ry), 0.0, cos(ry));
    mat3 RX = mat3(1.0, 0.0, 0.0, 0.0, cos(rx), sin(rx), 0.0, -sin(rx), cos(rx));
    mat3 RZ = mat3(cos(rz), sin(rz), 0.0, -sin(rz), cos(rz), 0.0, 0.0, 0.0, 1.0);
    mat3 R = RZ * RX * RY;
    vec3 centre = vec3(0.0, 0.25 * sin(clock * 0.4), 9.0);

    if (id == 0u)
    {
        emitQuad(vec3(0.0, 0.0, 30.0), vec3(50.0, 0.0, 0.0), vec3(0.0, 28.0, 0.0), 0.0, 0.0, -1.0, vec2(0.0), vec2(1.0));
        return;
    }
    if (id <= 6u)
    {
        // A strut: a box of four faces along its axis (kind 1), the photo on it.
        int s = int(id - 1u);
        vec3 a = centre + R * (strutEnd(s, 0) * size);
        vec3 b = centre + R * (strutEnd(s, 1) * size);
        vec3 mid = (a + b) * 0.5, half_ = (b - a) * 0.5;
        vec3 dir = normalize(half_);
        vec3 t1 = normalize(cross(dir, vec3(0.3, 1.0, 0.2)));
        vec3 t2 = cross(dir, t1);
        float w = 0.12 * size / 3.2;
        emitQuad(mid + t1 * w, half_, t2 * w, float(s), 0.9, 1.0, vec2(0.0, 0.0), vec2(1.0, 0.25));
        emitQuad(mid - t1 * w, half_, t2 * w, float(s), 0.5, 1.0, vec2(0.0, 0.25), vec2(1.0, 0.5));
        emitQuad(mid + t2 * w, half_, t1 * w, float(s), 0.7, 1.0, vec2(0.0, 0.5), vec2(1.0, 0.75));
        emitQuad(mid - t2 * w, half_, t1 * w, float(s), 0.4, 1.0, vec2(0.0, 0.75), vec2(1.0, 1.0));
        return;
    }
    uint c = id - 7u;
    if (c >= 48u) return;
    // Cable c: from end (s, e) to its k-th nearest foreign end.
    int endIdx = int(c / 4u); int k = int(c % 4u);
    int s = endIdx / 2, e = endIdx % 2;
    vec3 a0 = strutEnd(s, e);
    // Find the k-th nearest among the 10 foreign ends (selection by rank).
    float best = 1e9; vec3 bpos = a0; 
    for (int rank = 0; rank <= k; ++rank)
    {
        float cand = 1e9; vec3 cpos = a0;
        for (int s2 = 0; s2 < 6; ++s2) for (int e2 = 0; e2 < 2; ++e2)
        {
            if (s2 == s) continue;
            vec3 q = strutEnd(s2, e2);
            float d = distance(q, a0) + 0.001 * float(s2 * 2 + e2);
            if (d < cand && d > best) { cand = d; cpos = q; }
        }
        best = cand; bpos = cpos;
    }
    vec3 a = centre + R * (a0 * size);
    vec3 b = centre + R * (bpos * size);
    vec3 mid = (a + b) * 0.5, half_ = (b - a) * 0.5;
    vec3 toEye = normalize(-mid);
    vec3 side = normalize(cross(half_, toEye)) * 0.032 * size / 3.2;
    emitQuad(mid, half_, side, mod(float(c), 12.0), 0.0, 2.0, vec2(0.0), vec2(1.0));
}
