#version 430 core
/**
 * @file GlacierCalvingFront.comp
 * @brief GLACIER CALVING FRONT: the ice cliff where a glacier meets the
 * sea.  Along the face, slabs of ice break away on continuous phases --
 * each slab (a photo-textured block) tilts out, falls, hits the water in
 * a burst of round spray and floats off as a growler -- while the cliff
 * itself stands.  No state: every slab and spray drop is a function of
 * its seed and the scene clock.  The swell sets how many slabs are in
 * flight (the calving rate as a smooth fraction).  Camera on the water.
 *
 * Per-instance: rateP, sizeP, hueP.
 */
layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;
layout(std430, binding = 0) buffer Verts { float verts[]; };
layout(std430, binding = 1) buffer Cmd   { uint cmd[];   };

uniform uint  maxVertices;
uniform float time;
uniform float sceneAdvance;
uniform float sceneTime;
uniform float audioSwell;

uniform float rateP;
uniform float sizeP;
uniform float hueP;

float hash11(float p) { p = fract(p * 0.1031); p *= p + 33.33; p *= p + p; return fract(p); }
vec3  hash31(float n) { return vec3(hash11(n), hash11(n + 17.3), hash11(n + 41.7)); }

void emitQuad(vec3 c, vec3 ax, vec3 ay, float id, float lit, float kind, vec2 uv0, vec2 uv1)
{
    uint base = atomicAdd(cmd[4], 6u);
    if (base + 6u > maxVertices) return;
    vec3 p0 = c - ax - ay, p1 = c + ax - ay, p2 = c + ax + ay, p3 = c - ax + ay;
    vec3 pList[6]  = vec3[6](p0, p1, p2, p0, p2, p3);
    vec2 uvList[6] = vec2[6](vec2(uv0.x, uv0.y), vec2(uv1.x, uv0.y), vec2(uv1.x, uv1.y), vec2(uv0.x, uv0.y), vec2(uv1.x, uv1.y), vec2(uv0.x, uv1.y));
    for (uint i = 0u; i < 6u; ++i)
    {
        uint off = (base + i) * 8u;
        verts[off + 0u] = pList[i].x; verts[off + 1u] = pList[i].y; verts[off + 2u] = pList[i].z;
        verts[off + 3u] = id; verts[off + 4u] = lit; verts[off + 5u] = kind;
        verts[off + 6u] = uvList[i].x; verts[off + 7u] = uvList[i].y;
    }
}

void main()
{
    uvec3 g = gl_GlobalInvocationID;
    uint id = g.x + 64u * (g.y + 64u * g.z);
    const uint kSlabs = 60u;
    const uint kSprayPer = 40u;
    const float CLIFF_Z = 22.0, CLIFF_H = 9.0, SEA_Y = -2.0;
    float clock = sceneAdvance * 0.3 + sceneTime * 0.06;
    float rate = (0.3 + 0.7 * clamp(rateP, 0.0, 1.0)) * (0.5 + 0.5 * clamp(audioSwell, 0.0, 1.0));

    if (id == 0u)
    {
        // Sky (kind -1), the cliff face as a big quad of photo ice (kind 2),
        // the sea as a quad (kind -2).
        emitQuad(vec3(0.0, 8.0, 60.0), vec3(80.0, 0.0, 0.0), vec3(0.0, 40.0, 0.0), 0.0, 0.0, -1.0, vec2(0.0), vec2(1.0));
        emitQuad(vec3(0.0, SEA_Y + CLIFF_H * 0.5, CLIFF_Z), vec3(40.0, 0.0, 0.0), vec3(0.0, CLIFF_H * 0.5, 0.0), 0.0, 0.0, 2.0, vec2(0.0), vec2(1.0));
        emitQuad(vec3(0.0, SEA_Y, 12.0), vec3(60.0, 0.0, 0.0), vec3(0.0, 0.0, 12.0), 0.0, 0.0, -2.0, vec2(0.0), vec2(1.0));
        return;
    }
    uint s = (id - 1u) / (1u + kSprayPer);
    uint part = (id - 1u) % (1u + kSprayPer);
    if (s >= kSlabs) return;
    float fs = float(s);
    vec3 h = hash31(fs * 3.7 + 1.0);
    // Only a fraction of slabs are active at a time (the rate); the rest
    // wait in the face.  Life: a continuous phase.
    if (h.z > 0.15 + 0.6 * rate) return;
    float period = 6.0 + 6.0 * h.x;
    float life = fract(clock / period * 2.0 + h.y);
    float x = (h.x - 0.5) * 60.0;
    float size = (1.2 + 1.8 * hash11(fs * 5.1)) * (sizeP > 0.05 ? sizeP : 1.0);
    float top = SEA_Y + CLIFF_H * (0.55 + 0.45 * hash11(fs * 7.3));
    // Phases: 0..0.15 lean out, 0.15..0.4 fall, 0.4..0.55 splash, 0.55..1 float away.
    float lean = smoothstep(0.0, 0.15, life);
    float fall = smoothstep(0.15, 0.4, life);
    float floatAway = smoothstep(0.55, 1.0, life);
    float tilt = lean * 0.5 + fall * 1.2;
    float y = mix(top, SEA_Y + size * 0.3, fall) - floatAway * 0.0;
    float z = CLIFF_Z - lean * 0.8 - fall * 3.0 - floatAway * 8.0;
    float drift = floatAway * (h.z - 0.5) * 6.0;
    vec3 c = vec3(x + drift, y, z);
    if (part == 0u)
    {
        // The slab: a quad tilted about x, photo ice; hidden at the very end
        // (it has floated out of sight) via a smooth shrink.
        float shrink = 1.0 - smoothstep(0.9, 1.0, life);
        vec3 ax = vec3(size, 0.0, 0.0) * shrink;
        vec3 ay = vec3(0.0, cos(tilt), -sin(tilt)) * size * 0.8 * shrink;
        emitQuad(c, ax, ay, fs, life, 0.0, vec2(hash11(fs * 2.1) * 0.7, 0.0), vec2(hash11(fs * 2.1) * 0.7 + 0.3, 0.3));
        return;
    }
    // Spray: round drops bursting at the splash phase from the impact point.
    float sp = smoothstep(0.38, 0.4, life) * (1.0 - smoothstep(0.4, 0.7, life));
    if (sp <= 0.0) return;
    float fp = float(part);
    vec3 hp = hash31(fs * 19.0 + fp * 3.3);
    float t = (life - 0.4) / 0.3;                                  // 0..1 through the splash
    vec3 dir = normalize(vec3(hp.x - 0.5, 0.8 + hp.y, (hp.z - 0.5) * 0.6));
    vec3 pos = vec3(x, SEA_Y, CLIFF_Z - 3.0) + dir * t * (3.0 + 4.0 * hp.z) * size * 0.5 - vec3(0.0, 9.0 * t * t, 0.0) * size * 0.3;
    float dsz = 0.08 + 0.1 * hp.y * (1.0 - t);
    emitQuad(pos, vec3(dsz, 0.0, 0.0), vec3(0.0, dsz, 0.0), fs, 1.0 - t, 1.0, vec2(0.0), vec2(1.0));
}
