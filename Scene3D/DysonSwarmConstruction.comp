#version 430 core
/**
 * @file DysonSwarmConstruction.comp
 * @brief DYSON SWARM CONSTRUCTION: twenty-four thousand collector panels
 * assemble around a star over the scene's arc.  Each panel has a launch
 * point in a scattered cloud and a berth on a Fibonacci sphere; it leaves
 * on its own cue along the arc (sceneProgress), flies a bowed path and
 * docks -- so the sphere closes panel by panel, thickest at the end, and the
 * host's drop regie can time that closing to the drop.  The finished shell
 * breathes: a slow travelling wave lifts and lowers bands of panels, and a
 * harmonic change swells that wave.  No particle state: every panel is a
 * function of its id and the clocks, so nothing drifts.
 *
 * Audio Reactivity (generator stage):
 *   sceneProgress   -> the assembly (staged; drop regie can bend it)
 *   sceneAdvance    -> the whole swarm orbits the star (music-paced)
 *   audioHarmChange -> the shell's breathing wave swells (envelope)
 *   audioKick       -> panels flare their backs for a beat (fragment stage)
 *   audioSwell      -> the camera closes in
 *
 * Per-instance: panelsP (fraction of the 24k drawn), radiusP (shell size),
 *               tiltP (shell axis tilt), hueP.
 */
layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;
layout(std430, binding = 0) buffer Verts { float verts[]; };
layout(std430, binding = 1) buffer Cmd   { uint cmd[];   };

uniform uint  maxVertices;
uniform float time;
uniform float sceneAdvance;
uniform float sceneTime;
uniform float sceneProgress;
uniform float audioHarmChange;
uniform float audioSwell;
uniform float audioLevel;
uniform float audioKick;

uniform float panelsP;
uniform float radiusP;
uniform float tiltP;
uniform float hueP;

float hash11(float p) { p = fract(p * 0.1031); p *= p + 33.33; p *= p + p; return fract(p); }
vec3  hash31(float n) { return vec3(hash11(n), hash11(n + 17.3), hash11(n + 41.7)); }

mat3 rotY(float a) { float c = cos(a), s = sin(a); return mat3(c, 0.0, s, 0.0, 1.0, 0.0, -s, 0.0, c); }
mat3 rotX(float a) { float c = cos(a), s = sin(a); return mat3(1.0, 0.0, 0.0, 0.0, c, -s, 0.0, s, c); }

void emitQuad(vec3 a, vec3 b, vec3 c, vec3 d, float id, float lit, float kind)
{
    uint base = atomicAdd(cmd[4], 6u);
    if (base + 6u > maxVertices) return;
    vec3 pList[6]  = vec3[6](a, b, c, a, c, d);
    vec2 uvList[6] = vec2[6](vec2(0.0, 0.0), vec2(1.0, 0.0), vec2(1.0, 1.0), vec2(0.0, 0.0), vec2(1.0, 1.0), vec2(0.0, 1.0));
    for (uint i = 0u; i < 6u; ++i)
    {
        uint off = (base + i) * 8u;
        verts[off + 0u] = pList[i].x; verts[off + 1u] = pList[i].y; verts[off + 2u] = pList[i].z;
        verts[off + 3u] = id;  verts[off + 4u] = lit;  verts[off + 5u] = kind;
        verts[off + 6u] = uvList[i].x; verts[off + 7u] = uvList[i].y;
    }
}

void main()
{
    uvec3 g = gl_GlobalInvocationID;
    uint id = g.x + 64u * (g.y + 64u * g.z);
    const uint kPanels = 24000u;

    // The world turns slowly around the star; the shell axis is tilted.
    float tilt = 0.35 + 0.5 * clamp(tiltP, 0.0, 1.0);
    mat3 world = rotX(tilt) * rotY(sceneAdvance * 0.12 + sceneTime * 0.02);

    // Sky quad (kind -1) and the star disc (kind 2), from the first threads.
    if (id == 0u)
    {
        emitQuad(vec3(-16.0, -9.0, 9.0), vec3(16.0, -9.0, 9.0), vec3(16.0, 9.0, 9.0), vec3(-16.0, 9.0, 9.0), 0.0, 0.0, -1.0);
        return;
    }
    if (id == 1u)
    {
        float s = 1.25;
        emitQuad(vec3(-s, -s, 0.0), vec3(s, -s, 0.0), vec3(s, s, 0.0), vec3(-s, s, 0.0), 1.0, 1.0, 2.0);
        return;
    }
    float frac = (panelsP > 0.01) ? panelsP : 1.0;
    if (id >= uint(float(kPanels) * clamp(frac, 0.05, 1.0))) return;

    float fid = float(id);
    vec3 h = hash31(fid);
    float R = 2.1 * ((radiusP > 0.05) ? radiusP : 1.0);

    // Berth: Fibonacci sphere point, lifted by the breathing wave.
    float n = float(kPanels);
    float y = 1.0 - 2.0 * (fid + 0.5) / n;
    float rxz = sqrt(max(0.0, 1.0 - y * y));
    float phi = fid * 2.39996323;
    vec3 berthDir = vec3(cos(phi) * rxz, y, sin(phi) * rxz);
    float breathe = 0.04 + 0.04 * clamp(audioHarmChange, 0.0, 1.0);
    float wave = sin(y * 5.0 + sceneAdvance * 0.7 + sceneTime * 0.15);
    vec3 berth = berthDir * R * (1.0 + breathe * wave);

    // Launch point: a scattered cloud far out, biased to one side (the
    // shipyard), so the panels stream in from a direction.
    // Biased away from the camera (+z is far) so no panel drifts past the
    // lens as a giant square.
    vec3 launch = normalize(h * 2.0 - 1.0 + vec3(1.2, 0.3, 2.2)) * (5.0 + 2.0 * h.x);

    // Each panel leaves on its own cue along the arc and takes a while.
    float cue = h.y * 0.7;
    float f = smoothstep(cue, cue + 0.28, clamp(sceneProgress, 0.0, 1.0));
    // Bowed path so the stream arcs instead of shooting straight.
    vec3 bow = normalize(cross(launch, vec3(0.0, 1.0, 0.0)) + vec3(1e-4)) * 2.0 * (h.z - 0.5);
    vec3 pos = mix(launch, berth, f) + bow * sin(f * 3.14159265);

    // Panel orientation: docked panels face the star; in flight they align
    // to their path.  Blend continuously.
    vec3 toStar = normalize(-pos + vec3(1e-4));
    vec3 pathDir = normalize(berth - launch);
    vec3 nrm = normalize(mix(pathDir, toStar, f) + vec3(1e-4));
    vec3 tan1 = normalize(cross(nrm, vec3(0.0, 1.0, 0.0)) + vec3(1e-4, 0.0, 1e-4));
    vec3 tan2 = cross(nrm, tan1);

    float size = 0.045 + 0.02 * h.x;
    vec3 c = world * pos;
    vec3 t1 = world * tan1 * size, t2 = world * tan2 * size * 0.7;
    // Lit: how squarely the panel faces the star (its inner face), and
    // whether it is still in flight (glows its thrusters).
    float lit = clamp(dot(nrm, toStar), 0.0, 1.0) * 0.8 + (1.0 - f) * 0.5;
    emitQuad(c - t1 - t2, c + t1 - t2, c + t1 + t2, c - t1 + t2, fid, lit, f);
}
