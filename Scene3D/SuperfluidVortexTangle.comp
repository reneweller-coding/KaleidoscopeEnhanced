#version 430
/// Layout qualifiers of this stage (work-group size, or the primitive in or out).
layout( local_size_x = 4, local_size_y = 4, local_size_z = 4 ) in;

/**
 * @file SuperfluidVortexTangle.comp
 * @brief Compute shader simulating quantum vortex tangle filaments, quantized circulation,
 * and Kelvin wave cascades in superfluid Helium-II.
 */

layout( std430, binding = 0 ) buffer Verts
{
    float verts[]; // 8 floats per vertex: attrA.xyzw (pos, circulation), attrB.xyzw (pad, ringID)
};

layout( std430, binding = 1 ) buffer Cmd
{
    uint cmd[];
};

uniform uint  maxVertices;  ///< Capacity of the vertex buffer (compute stage).
uniform float time;         ///< Seconds since the program started (never reset; see sceneTime).
uniform float audioPhase;   ///< Rotation phase driven by the music (integrated, never jumps).
uniform float audioAdvance; ///< The music's advance: integrated tempo-weighted energy (never jumps, never runs
                            ///< backwards).
uniform float audioKick;    ///< Kick-drum envelope, 0..1 (fast attack, short decay).
uniform float audioBass;    ///< Bass band level, 0..1.
uniform float audioMid;     ///< Mid band level, 0..1.
uniform float audioHigh;    ///< High band level, 0..1.
uniform float audioSwell;   ///< Slow loudness envelope, 0..1 (seconds).

/**  Pseudo-random number 0..1 from a float.
 *
 * @param p  The input value. (in)
 *
 * @return
 *   A pseudo-random number 0..1.
 **/
float hash11( float p )
{
    p = fract( p * 0.1031 );
    p *= p + 33.33;
    p *= p + p;
    return fract( p );
}

/**  Writes one vertex into the output buffer (compute stage).
 *
 * @param slot    Index of the vertex in the buffer. (in)
 * @param p       Position. (in)
 * @param circ    Per-vertex value written to the buffer (the vertex stage gives it its meaning). (in)
 * @param ringID  Per-vertex value written to the buffer (the vertex stage gives it its meaning). (in)
 **/
void writeVertex( uint slot, vec3 p, float circ, float ringID )
{
    uint o = slot * 8u;
    verts[o + 0u] = p.x;
    verts[o + 1u] = p.y;
    verts[o + 2u] = p.z;
    verts[o + 3u] = circ;
    verts[o + 4u] = 0.0;
    verts[o + 5u] = 0.0;
    verts[o + 6u] = 0.0;
    verts[o + 7u] = ringID;
}

/**  Appends a thick line segment (two triangles) to the output buffer (compute stage).
 *
 * @param pA         Start of the segment. (in)
 * @param pB         End of the segment. (in)
 * @param circ       Per-vertex value written to the buffer (the vertex stage gives it its meaning). (in)
 * @param ringID     Per-vertex value written to the buffer (the vertex stage gives it its meaning). (in)
 * @param thickness  Width of the ribbon. (in)
 **/
void emitSegment( vec3 pA, vec3 pB, float circ, float ringID, float thickness )
{
    uint base = atomicAdd( cmd[4], 6u );
    if ( base + 6u > maxVertices )
        return;

    vec3  dir = pB - pA;
    float len = length( dir );
    dir = ( len > 1e-5 ) ? dir / len : vec3( 0.0, 1.0, 0.0 );
    // Widen the ribbon ACROSS THE SCREEN, not along the view axis.
    // The old `cross(dir, worldUp)` (with a (1,0,0) fallback for near-vertical
    // segments) always returns a vector with y == 0, i.e. one that lies in the
    // xz plane -- and this scene's vert only pushes the world down +z (vp.z += 6.5), so the
    // camera looks along (0,0,1). A segment
    // running along x therefore got side = (0,0,1) and a vertical one got the
    // fallback (0,0,-1): both point straight at the lens, so those quads
    // rasterised edge-on and drew nothing at all, however thick they were set.
    // Most filaments in this scene are vertical or horizontal, so a large part
    // of the geometry was simply invisible.
    const vec3 ViewAxis = vec3( 0.0, 0.0, 1.0 );
    vec3       side = cross( dir, ViewAxis );
    float      sl = length( side );
    // Degenerate only when the segment runs straight at the lens, where any
    // perpendicular is equally good.
    side = ( sl > 1e-4 ) ? side * ( thickness / sl )
                         : normalize( cross( dir, vec3( 1.0, 0.0, 0.0 ) ) ) * thickness;

    vec3 a0 = pA - side, a1 = pA + side, b0 = pB - side, b1 = pB + side;
    writeVertex( base + 0u, a0, circ, ringID );
    writeVertex( base + 1u, a1, circ, ringID );
    writeVertex( base + 2u, b0, circ, ringID );
    writeVertex( base + 3u, a1, circ, ringID );
    writeVertex( base + 4u, b1, circ, ringID );
    writeVertex( base + 5u, b0, circ, ringID );
}

/** Entry point of this shader stage (the file description says what it draws). */
void main()
{
    uvec3      g = gl_GlobalInvocationID;
    uint       id = g.x + 64u * ( g.y + 64u * g.z );
    const uint TotalSegments = 4096u;
    if ( id >= TotalSegments )
        return;

    uint ring_idx = id / 64u; // 64 quantized vortex rings
    uint step_idx = id % 64u; // 64 segments per ring

    float ring_seed = float( ring_idx );
    float ring_r = 0.8 + 1.8 * hash11( ring_seed * 3.7 );

    // Ring center translation through superfluid volume
    float trans_speed = 0.5 / ring_r;
    vec3  ring_center = vec3(
        sin( ring_seed * 7.1 + time * 0.2 ) * 2.2,
        cos( ring_seed * 13.3 + time * 0.15 ) * 1.6,
        mod( ring_seed * 1.5 + ( time * trans_speed + audioAdvance * 0.1 ) * 3.0, 12.0 ) - 6.0 );

    float t0 = ( float( step_idx ) / 64.0 ) * 6.2831853;
    float t1 = ( float( step_idx + 1u ) / 64.0 ) * 6.2831853;

    // Kelvin waves (helical perturbations along quantized vortex cores)
    float k_modes = 5.0 + floor( hash11( ring_seed * 9.1 ) * 4.0 );
    float kelvin_amp = ( 0.12 + 0.15 * audioHigh ) * ( 1.0 + 0.5 * audioKick );

    float wave0 = sin( t0 * k_modes + time * 4.0 ) * kelvin_amp;
    float wave1 = sin( t1 * k_modes + time * 4.0 ) * kelvin_amp;

    // Evaluate segment endpoints
    float r0 = ring_r + wave0;
    float r1 = ring_r + wave1;

    vec3 pA = ring_center + vec3( cos( t0 ) * r0, sin( t0 ) * r0, cos( t0 * k_modes ) * kelvin_amp );
    vec3 pB = ring_center + vec3( cos( t1 ) * r1, sin( t1 ) * r1, cos( t1 * k_modes ) * kelvin_amp );

    // Circulation speed & quantum energy
    float circulation = ( 1.0 / ring_r ) * ( 0.8 + 0.6 * audioBass );
    float thickness = ( 0.025 + 0.015 * audioKick );

    emitSegment( pA, pB, circulation, ring_seed, thickness );
}
