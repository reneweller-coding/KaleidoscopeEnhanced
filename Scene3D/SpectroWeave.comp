#version 430
// SpectroWeave.comp — the spectrogram as a braided cable of light.
// -----------------------------------------------------------------------
// SpectroCanyon reads the same texture as one continuous surface.  This reads
// it as thirty-two SEPARATE strands, one per band, braided around a common
// axis — so instead of a landscape whose shape is the spectrum, you fly
// through a bundle in which each frequency is its own visible thread that
// swells where its band was loud.
//
// Every strand's path is closed-form (a helix in z), so unlike FlowRibbons
// there is nothing to integrate and a thread can own a single SEGMENT.  That is
// the better split whenever the curve has a formula: 4096 threads doing one
// step each beats 32 threads doing 128.
// -----------------------------------------------------------------------
layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

layout(std430, binding = 0) buffer Verts { float verts[]; };
layout(std430, binding = 1) buffer Cmd   { uint  cmd[]; };

uniform uint  maxVertices;
uniform float time;
uniform float sceneSeed;
uniform float audioAdvance;
uniform float audioLevel;
uniform float audioKick;
uniform float audioSubBass;

uniform sampler2D texSpectro;
uniform float spectroHead;
uniform float spectroFill;

uniform float twistP;       // preset: how hard the bundle braids
uniform float spreadP;      // preset: bundle radius
uniform float thickP;       // preset: strand thickness

const int BANDS = 32;
const int SEGS  = 128;
const int SIDES = 5;
const float DEPTH    = 170.0;
const float AGE_SPAN = 0.84;

// Energy of band b at the given age, straight from the ring.
float energyAt(int b, float age)
{
    float t = spectroHead - age * AGE_SPAN;
    float e = texture(texSpectro, vec2((float(b) + 0.5) / float(BANDS), fract(t))).r;
    return e * smoothstep(0.0, 0.12, spectroFill);
}

// Where strand b sits at depth z.  A helix whose radius comes from a
// golden-ratio spread of the band index, so neighbouring bands are NOT
// neighbouring strands — that is what makes the bundle look woven instead of
// like a rolled-up sheet.
vec3 strandAt(int b, float z)
{
    float r = spreadP * (1.6 + 4.6 * fract(float(b) * 0.6180339));
    float th = float(b) * 2.39996323 + twistP * z * 0.055 + audioAdvance * 0.11;
    return vec3(r * cos(th), r * sin(th), z);
}

void writeVertex(uint slot, vec3 p, vec3 n, float energy, float band)
{
    uint o = slot * 8u;
    verts[o + 0u] = p.x;  verts[o + 1u] = p.y;  verts[o + 2u] = p.z;
    verts[o + 3u] = energy;
    verts[o + 4u] = n.x;  verts[o + 5u] = n.y;  verts[o + 6u] = n.z;
    verts[o + 7u] = band;
}

void main()
{
    uvec3 g = gl_GlobalInvocationID;
    uint id = g.x + 64u * (g.y + 64u * g.z);
    if (id >= uint(BANDS * SEGS))
        return;

    int band = int(id) % BANDS;
    int seg  = int(id) / BANDS;

    float a0 = float(seg)     / float(SEGS);
    float a1 = float(seg + 1) / float(SEGS);
    // The bundle starts well ahead of the eye; a strand passing through the
    // near plane fills the screen with one flat facet.
    float z0 = a0 * DEPTH + 6.0;
    float z1 = a1 * DEPTH + 6.0;

    vec3 p0 = strandAt(band, z0);
    vec3 p1 = strandAt(band, z1);

    float e0 = energyAt(band, a0);
    float e1 = energyAt(band, a1);

    // A strand always has a hairline body so the weave's geometry stays
    // readable through a silent bar; the energy swells it from there.
    // Kept thin.  A strand's job is to be one thread among thirty-two, and at
    // the thickness a single tube would want, the near ones swallow the frame
    // and the braid stops being visible at all.
    float r0 = thickP * (0.020 + 0.155 * e0) * (1.0 + 0.25 * audioKick);
    float r1 = thickP * (0.020 + 0.155 * e1) * (1.0 + 0.25 * audioKick);

    vec3 dir = p1 - p0;
    float L = length(dir);
    if (L < 1e-5)
        return;
    dir /= L;

    vec3 up = abs(dir.z) < 0.9 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    vec3 u = normalize(cross(dir, up));
    vec3 v = cross(dir, u);

    uint need = uint(SIDES) * 6u;
    uint base = atomicAdd(cmd[4], need);
    if (base + need > maxVertices)
        return;

    float bandN = float(band) / float(BANDS - 1);
    for (int s = 0; s < SIDES; ++s)
    {
        float t0 = 6.2831853 * float(s)     / float(SIDES);
        float t1 = 6.2831853 * float(s + 1) / float(SIDES);
        vec3 n0 = u * cos(t0) + v * sin(t0);
        vec3 n1 = u * cos(t1) + v * sin(t1);

        vec3 a = p0 + n0 * r0, b = p0 + n1 * r0;
        vec3 c = p1 + n1 * r1, d = p1 + n0 * r1;

        uint o = base + uint(s) * 6u;
        writeVertex(o + 0u, a, n0, e0, bandN);
        writeVertex(o + 1u, b, n1, e0, bandN);
        writeVertex(o + 2u, c, n1, e1, bandN);
        writeVertex(o + 3u, a, n0, e0, bandN);
        writeVertex(o + 4u, c, n1, e1, bandN);
        writeVertex(o + 5u, d, n0, e1, bandN);
    }
}
