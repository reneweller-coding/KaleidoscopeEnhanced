#version 430 core
/**
 * @file KaleidocycleFold.comp
 * @brief KALEIDOCYCLE FOLD: the paper toy -- a ring of six tetrahedra
 * hinged edge to edge that turns endlessly through its own centre, each
 * face coming round to the top in turn.  The ring is built from the
 * hinge geometry: hinge k lies on a circle of radius R at angle k*60,
 * alternately horizontal and tilted; the fold angle advances on the scene
 * clock so the ring rotates through itself; each tetrahedron's four faces
 * are photo triangles (fragment lights them by band).  No state.  Camera
 * fixed above the table.
 *
 * Per-instance: sizeP, speedP, hueP.
 */
layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;
layout(std430, binding = 0) buffer Verts { float verts[]; };
layout(std430, binding = 1) buffer Cmd   { uint cmd[];   };

uniform uint  maxVertices;
uniform float time;
uniform float sceneAdvance;
uniform float sceneTime;

uniform float sizeP;
uniform float speedP;
uniform float hueP;

void emitTri(vec3 a, vec3 b, vec3 c, float id, float lit, float kind, vec2 ua, vec2 ub, vec2 uc)
{
    uint base = atomicAdd(cmd[4], 3u);
    if (base + 3u > maxVertices) return;
    vec3 pl[3] = vec3[3](a, b, c);
    vec2 ul[3] = vec2[3](ua, ub, uc);
    for (uint i = 0u; i < 3u; ++i)
    {
        uint off = (base + i) * 8u;
        verts[off + 0u] = pl[i].x; verts[off + 1u] = pl[i].y; verts[off + 2u] = pl[i].z;
        verts[off + 3u] = id; verts[off + 4u] = lit; verts[off + 5u] = kind;
        verts[off + 6u] = ul[i].x; verts[off + 7u] = ul[i].y;
    }
}

void emitQuad(vec3 c, vec3 ax, vec3 ay, float id, float lit, float kind, vec2 uv0, vec2 uv1)
{
    vec3 p0 = c - ax - ay, p1 = c + ax - ay, p2 = c + ax + ay, p3 = c - ax + ay;
    emitTri(p0, p1, p2, id, lit, kind, vec2(uv0.x, uv0.y), vec2(uv1.x, uv0.y), vec2(uv1.x, uv1.y));
    emitTri(p0, p2, p3, id, lit, kind, vec2(uv0.x, uv0.y), vec2(uv1.x, uv1.y), vec2(uv0.x, uv1.y));
}

// Hinge k (0..5): a short edge on a circle, its direction alternating
// between "radial-tilted" and "horizontal", the tilt advancing with the
// fold phase; the classic kaleidocycle parametrisation.
void hinge(int k, float phase, float R, float h, out vec3 a, out vec3 b)
{
    float ang = float(k) * 1.0471976;
    vec3 radial = vec3(cos(ang), 0.0, sin(ang));
    vec3 tangent = vec3(-sin(ang), 0.0, cos(ang));
    // The hinge tilts about the tangent by the fold phase, alternating sign.
    float s = (k % 2 == 0) ? 1.0 : -1.0;
    float t = phase * s;
    vec3 dir = normalize(tangent * cos(t) + vec3(0.0, 1.0, 0.0) * sin(t));
    // Its centre rises and falls opposite to the tilt so the ring stays closed.
    vec3 centre = radial * (R * (0.8 + 0.2 * cos(t))) + vec3(0.0, h * 0.5 * sin(t) * s, 0.0);
    a = centre - dir * h * 0.5;
    b = centre + dir * h * 0.5;
}

void main()
{
    uvec3 g = gl_GlobalInvocationID;
    uint id = g.x + 64u * (g.y + 64u * g.z);
    float size = 3.0 * (sizeP > 0.05 ? sizeP : 1.0);
    float speed = 0.4 + 0.6 * clamp(speedP, 0.0, 1.0);
    float phase = (sceneAdvance * 0.6 + sceneTime * 0.12) * speed;    // the fold angle, unbounded and continuous
    const vec3 centre = vec3(0.0, -0.3, 8.0);
    // A slow turntable rotation so all sides show.
    float ry = sceneAdvance * 0.1;
    mat3 RY = mat3(cos(ry), 0.0, -sin(ry), 0.0, 1.0, 0.0, sin(ry), 0.0, cos(ry));
    float rx = 0.55;
    mat3 RX = mat3(1.0, 0.0, 0.0, 0.0, cos(rx), sin(rx), 0.0, -sin(rx), cos(rx));

    if (id == 0u)
    {
        emitQuad(vec3(0.0, 0.0, 30.0), vec3(50.0, 0.0, 0.0), vec3(0.0, 28.0, 0.0), 0.0, 0.0, -1.0, vec2(0.0), vec2(1.0));
        // The table (kind -2).
        emitQuad(vec3(0.0, -2.2, 12.0), vec3(14.0, 0.0, 0.0), vec3(0.0, 0.0, 8.0), 0.0, 0.0, -2.0, vec2(0.0), vec2(1.0));
        return;
    }
    if (id > 6u) return;
    int k = int(id - 1u);
    // Tetrahedron k spans hinges k and k+1: its four vertices are the two
    // ends of each hinge; its four faces are the four triangles.
    vec3 a0, a1, b0, b1;
    hinge(k, phase, size, size * 0.9, a0, a1);
    hinge((k + 1) % 6, phase, size, size * 0.9, b0, b1);
    vec3 v[4] = vec3[4](a0, a1, b0, b1);
    for (int i = 0; i < 4; ++i) v[i] = centre + RX * RY * v[i];
    float fk = float(k);
    emitTri(v[0], v[1], v[2], fk, 0.0, 0.0, vec2(0.0, 0.0), vec2(1.0, 0.0), vec2(0.5, 1.0));
    emitTri(v[0], v[1], v[3], fk, 1.0, 0.0, vec2(0.0, 0.0), vec2(1.0, 0.0), vec2(0.5, 1.0));
    emitTri(v[0], v[2], v[3], fk, 2.0, 0.0, vec2(0.0, 0.0), vec2(1.0, 0.0), vec2(0.5, 1.0));
    emitTri(v[1], v[2], v[3], fk, 3.0, 0.0, vec2(0.0, 0.0), vec2(1.0, 0.0), vec2(0.5, 1.0));
}
