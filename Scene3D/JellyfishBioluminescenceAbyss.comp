#version 430
/*****************************************************************************\
 *                              JellyfishBioluminescenceAbyss.comp
\*****************************************************************************/
/*! @file
 *
 *  @brief
 *  Compute shader generating 3D pulsating deep-sea medusae bells and bioluminescent tentacle curtains
 *
 *  @author René Weller
 */
/// Layout qualifiers of this stage (work-group size, or the primitive in or out).
layout( local_size_x = 4, local_size_y = 4, local_size_z = 4 ) in;

/// The output vertex buffer: eight floats per vertex (attribute A, attribute B) that the scene draws.
layout( std430, binding = 0 ) buffer Verts
{
    float verts[]; // 8 floats per vertex: attrA.xyzw (pos, tentacleIdx), attrB.xyzw (pad, bio_glow)
};

/// DrawArraysIndirectCommand + our own counter:
///   [0] count  [1] instanceCount  [2] first  [3] baseInstance  [4] rawCount
layout( std430, binding = 1 ) buffer Cmd
{
    uint cmd[];
};

uniform uint  maxVertices;  ///< Capacity of the vertex buffer (compute stage).
uniform float time;         ///< Seconds since the program started (never reset; see sceneTime).
uniform float audioPhase;   ///< Rotation phase driven by the music (integrated, never jumps).
uniform float audioAdvance; ///< The music's advance: integrated tempo-weighted energy (never jumps, never runs
                            ///< backwards).
uniform float audioKick;    ///< Kick-drum envelope, 0..1 (fast attack, short decay).
uniform float audioBass;    ///< Bass band level, 0..1.
uniform float audioMid;     ///< Mid band level, 0..1.
uniform float audioHigh;    ///< High band level, 0..1.
uniform float audioSwell;   ///< Slow loudness envelope, 0..1 (seconds).

/**  Pseudo-random number 0..1 from a float.
 *
 * @param p  The input value. (in)
 *
 * @return
 *   A pseudo-random number 0..1.
 **/
float hash11( float p )
{
    p = fract( p * 0.1031 );
    p *= p + 81.37;
    p *= p + p;
    return fract( p );
}

/**  Writes one vertex into the output buffer (compute stage).
 *
 * @param slot  Index of the vertex in the buffer. (in)
 * @param p     Position. (in)
 * @param e1    Extra value (attribute A's w). (in)
 * @param e2    Extra value (attribute B's w). (in)
 **/
void writeVertex( uint slot, vec3 p, float e1, float e2 )
{
    uint o = slot * 8u;
    verts[o + 0u] = p.x;
    verts[o + 1u] = p.y;
    verts[o + 2u] = p.z;
    verts[o + 3u] = e1;
    verts[o + 4u] = 0.0;
    verts[o + 5u] = 0.0;
    verts[o + 6u] = 0.0;
    verts[o + 7u] = e2;
}

/**  A tentacle is a line from the bell rim to its trailing tip; GL_TRIANGLES needs a real triangle, so it is emitted
 * as a thin two-triangle ribbon.
 *
 * @param pA         Start of the segment. (in)
 * @param pB         End of the segment. (in)
 * @param e1         Extra value written to every vertex (first slot). (in)
 * @param e2         Extra value written to every vertex (second slot). (in)
 * @param thickness  Width of the ribbon. (in)
 **/
void emitSegment( vec3 pA, vec3 pB, float e1, float e2, float thickness )
{
    uint base = atomicAdd( cmd[4], 6u );
    if ( base + 6u > maxVertices )
        return;

    vec3  dir = pB - pA;
    float len = length( dir );
    dir = ( len > 1e-5 ) ? dir / len : vec3( 0.0, 1.0, 0.0 );
    // Widen the ribbon ACROSS THE SCREEN, not along the view axis.
    // The old `cross(dir, worldUp)` (with a (1,0,0) fallback for near-vertical
    // segments) always returns a vector with y == 0, i.e. one that lies in the
    // xz plane -- and this scene's vert only pushes the world down +z (vp.z += 5.5), so the
    // camera looks along (0,0,1). A segment
    // running along x therefore got side = (0,0,1) and a vertical one got the
    // fallback (0,0,-1): both point straight at the lens, so those quads
    // rasterised edge-on and drew nothing at all, however thick they were set.
    // Most filaments in this scene are vertical or horizontal, so a large part
    // of the geometry was simply invisible.
    const vec3 ViewAxis = vec3( 0.0, 0.0, 1.0 );
    vec3       side = cross( dir, ViewAxis );
    float      sl = length( side );
    // Degenerate only when the segment runs straight at the lens, where any
    // perpendicular is equally good.
    side = ( sl > 1e-4 ) ? side * ( thickness / sl )
                         : normalize( cross( dir, vec3( 1.0, 0.0, 0.0 ) ) ) * thickness;

    vec3 a0 = pA - side, a1 = pA + side, b0 = pB - side, b1 = pB + side;
    writeVertex( base + 0u, a0, e1, e2 );
    writeVertex( base + 1u, a1, e1, e2 );
    writeVertex( base + 2u, b0, e1, e2 );
    writeVertex( base + 3u, a1, e1, e2 );
    writeVertex( base + 4u, b1, e1, e2 );
    writeVertex( base + 5u, b0, e1, e2 );
}

/** Entry point of this shader stage (the file description says what it draws). */
void main()
{
    uvec3      g = gl_GlobalInvocationID;
    uint       id = g.x + 64u * ( g.y + 64u * g.z );
    const uint TotalSegments = 4096u;
    if ( id >= TotalSegments )
        return;

    float seed = float( id );
    float medusa_id = floor( seed / 128.0 ); // 32 individual jellyfish
    float unit = mod( seed, 128.0 );

    // Medusa colony roaming paths -- closer and slower than the old build,
    // so each animal reads as a body instead of an edge-on smear.
    float m_angle = hash11( medusa_id ) * 6.2831853 + time * 0.06;
    float m_radius = ( hash11( medusa_id + 50.0 ) * 0.65 + 0.25 ) * 3.3;
    float m_height = sin( time * 0.35 + medusa_id * 2.0 ) * 1.8;

    vec3 medusa_center = vec3( m_radius * cos( m_angle ), m_height, m_radius * sin( m_angle ) );

    // Jellyfish bell pulsating contraction pump driven by sub-bass
    float pump_phase = time * 1.6 + medusa_id * 1.5 + audioAdvance * 0.5;
    float contraction = pow( max( sin( pump_phase ), 0.0 ), 3.0 ) * ( 0.7 + 0.4 * audioBass );

    if ( unit < 88.0 )
    {
        // BELL DOME: 8 latitude rings x 11 ribbon segments.  The old build
        // emitted tentacles ONLY -- the medusae had no visible body at all,
        // which is why the recording showed nothing but vertical streaks.
        float ring = floor( unit / 11.0 );
        float seg_i = mod( unit, 11.0 );
        float lat = ( ring + 0.15 ) / 8.0 * 1.45;
        float bell_r = ( 0.52 - 0.13 * contraction )
                       * ( 0.9 + 0.2 * hash11( medusa_id + 7.0 ) );
        float squeeze = 1.0 + 0.45 * contraction;
        float rr = bell_r * cos( lat );
        float yy = 0.30 + bell_r * sin( lat ) * squeeze * 0.85;
        float phi0 = ( seg_i / 11.0 ) * 6.2831853 + ring * 0.30;
        float phi1 = ( ( seg_i + 1.0 ) / 11.0 ) * 6.2831853 + ring * 0.30;
        vec3  pA = medusa_center + vec3( rr * cos( phi0 ), yy, rr * sin( phi0 ) );
        vec3  pB = medusa_center + vec3( rr * cos( phi1 ), yy, rr * sin( phi1 ) );
        // Rim rings glow with the pump; upper rings stay glassy-cyan.
        float rim_glow = exp( -ring * 0.45 ) * ( 0.35 + 0.65 * contraction )
                         * ( 1.0 + audioKick * 1.5 );
        // Per-medusa hue base: the whole colony rendered one flat green.
        emitSegment( pA, pB, fract( medusa_id * 0.317 ) * 0.85 + 0.012 * ring,
                     rim_glow, 0.022 - 0.0014 * ring );
    }
    else
    {
        // TENTACLES: 40 per medusa, thin, trailing from the bell rim.
        float tid = unit - 88.0;
        float t_angle = ( tid / 40.0 ) * 6.2831853;
        float bell_r = 0.52 - 0.13 * contraction;
        vec3  rim_p = medusa_center
                      + vec3( bell_r * 0.92 * cos( t_angle ), 0.32, bell_r * 0.92 * sin( t_angle ) );

        float tentacle_len = 1.1 + 0.7 * hash11( seed );
        float wave_x = sin( pump_phase - tentacle_len * 2.0 + t_angle ) * 0.22;
        float wave_z = cos( pump_phase - tentacle_len * 2.0 + t_angle ) * 0.22;
        vec3  tip = rim_p - vec3( wave_x, tentacle_len, wave_z );

        // Bioluminescent pulse travelling down the tentacle
        float bio_glow = exp( -abs( tentacle_len * 0.5 - mod( time * 2.2 + audioKick * 2.0, 1.6 ) ) * 6.0 );
        bio_glow *= ( 1.0 + audioKick * 2.5 );

        emitSegment( rim_p, tip, fract( medusa_id * 0.317 + 0.45 ), bio_glow, 0.012 );
    }
}
