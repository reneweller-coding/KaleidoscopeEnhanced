#version 430
layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

/**
 * @file JellyfishBioluminescenceAbyss.comp
 * @brief Compute shader generating 3D pulsating deep-sea medusae bells and bioluminescent tentacle curtains
 */

layout(std430, binding = 0) buffer Verts {
    float verts[]; // 8 floats per vertex: attrA.xyzw (pos, tentacleIdx), attrB.xyzw (pad, bioGlow)
};

// DrawArraysIndirectCommand + our own counter:
//   [0] count  [1] instanceCount  [2] first  [3] baseInstance  [4] rawCount
layout(std430, binding = 1) buffer Cmd { uint cmd[]; };

uniform uint  maxVertices;
uniform float time;
uniform float audioPhase;
uniform float audioAdvance;
uniform float audioKick;
uniform float audioBass;
uniform float audioMid;
uniform float audioHigh;
uniform float audioSwell;

float hash11(float p) {
    p = fract(p * 0.1031);
    p *= p + 81.37;
    p *= p + p;
    return fract(p);
}

void writeVertex(uint slot, vec3 p, float e1, float e2) {
    uint o = slot * 8u;
    verts[o + 0u] = p.x;  verts[o + 1u] = p.y;  verts[o + 2u] = p.z;
    verts[o + 3u] = e1;
    verts[o + 4u] = 0.0;  verts[o + 5u] = 0.0;  verts[o + 6u] = 0.0;
    verts[o + 7u] = e2;
}

// A tentacle is a line from the bell rim to its trailing tip; GL_TRIANGLES
// needs a real triangle, so it is emitted as a thin two-triangle ribbon.
void emitSegment(vec3 pA, vec3 pB, float e1, float e2, float thickness) {
    uint base = atomicAdd(cmd[4], 6u);
    if (base + 6u > maxVertices) return;

    vec3 dir = pB - pA;
    float len = length(dir);
    dir = (len > 1e-5) ? dir / len : vec3(0.0, 1.0, 0.0);
    // Widen the ribbon ACROSS THE SCREEN, not along the view axis.
    // The old `cross(dir, worldUp)` (with a (1,0,0) fallback for near-vertical
    // segments) always returns a vector with y == 0, i.e. one that lies in the
    // xz plane -- and this scene's vert only pushes the world down +z (vp.z += 5.5), so the
    // camera looks along (0,0,1). A segment
    // running along x therefore got side = (0,0,1) and a vertical one got the
    // fallback (0,0,-1): both point straight at the lens, so those quads
    // rasterised edge-on and drew nothing at all, however thick they were set.
    // Most filaments in this scene are vertical or horizontal, so a large part
    // of the geometry was simply invisible.
    const vec3 kViewAxis = vec3(0.0, 0.0, 1.0);
    vec3 side = cross(dir, kViewAxis);
    float sl = length(side);
    // Degenerate only when the segment runs straight at the lens, where any
    // perpendicular is equally good.
    side = (sl > 1e-4) ? side * (thickness / sl)
                       : normalize(cross(dir, vec3(1.0, 0.0, 0.0))) * thickness;

    vec3 a0 = pA - side, a1 = pA + side, b0 = pB - side, b1 = pB + side;
    writeVertex(base + 0u, a0, e1, e2);
    writeVertex(base + 1u, a1, e1, e2);
    writeVertex(base + 2u, b0, e1, e2);
    writeVertex(base + 3u, a1, e1, e2);
    writeVertex(base + 4u, b1, e1, e2);
    writeVertex(base + 5u, b0, e1, e2);
}

void main() {
    uvec3 g = gl_GlobalInvocationID;
    uint id = g.x + 64u * (g.y + 64u * g.z);
    const uint TOTAL_SEGMENTS = 4096u;
    if (id >= TOTAL_SEGMENTS) return;

    float seed = float(id);
    float medusaID = floor(seed / 128.0); // 32 individual jellyfish
    float unit = mod(seed, 128.0);

    // Medusa colony roaming paths -- closer and slower than the old build,
    // so each animal reads as a body instead of an edge-on smear.
    float mAngle = hash11(medusaID) * 6.2831853 + time * 0.06;
    float mRadius = (hash11(medusaID + 50.0) * 0.65 + 0.25) * 3.3;
    float mHeight = sin(time * 0.35 + medusaID * 2.0) * 1.8;

    vec3 medusaCenter = vec3(mRadius * cos(mAngle), mHeight, mRadius * sin(mAngle));

    // Jellyfish bell pulsating contraction pump driven by sub-bass
    float pumpPhase = time * 1.6 + medusaID * 1.5 + audioAdvance * 0.5;
    float contraction = pow(max(sin(pumpPhase), 0.0), 3.0) * (0.7 + 0.4 * audioBass);

    if (unit < 88.0) {
        // BELL DOME: 8 latitude rings x 11 ribbon segments.  The old build
        // emitted tentacles ONLY -- the medusae had no visible body at all,
        // which is why the recording showed nothing but vertical streaks.
        float ring = floor(unit / 11.0);
        float segI = mod(unit, 11.0);
        float lat = (ring + 0.15) / 8.0 * 1.45;
        float bellR = (0.52 - 0.13 * contraction)
                    * (0.9 + 0.2 * hash11(medusaID + 7.0));
        float squeeze = 1.0 + 0.45 * contraction;
        float rr = bellR * cos(lat);
        float yy = 0.30 + bellR * sin(lat) * squeeze * 0.85;
        float phi0 = (segI        / 11.0) * 6.2831853 + ring * 0.30;
        float phi1 = ((segI + 1.0) / 11.0) * 6.2831853 + ring * 0.30;
        vec3 pA = medusaCenter + vec3(rr * cos(phi0), yy, rr * sin(phi0));
        vec3 pB = medusaCenter + vec3(rr * cos(phi1), yy, rr * sin(phi1));
        // Rim rings glow with the pump; upper rings stay glassy-cyan.
        float rimGlow = exp(-ring * 0.45) * (0.35 + 0.65 * contraction)
                      * (1.0 + audioKick * 1.5);
        // Per-medusa hue base: the whole colony rendered one flat green.
        emitSegment(pA, pB, fract(medusaID * 0.317) * 0.85 + 0.012 * ring,
                    rimGlow, 0.022 - 0.0014 * ring);
    } else {
        // TENTACLES: 40 per medusa, thin, trailing from the bell rim.
        float tid = unit - 88.0;
        float tAngle = (tid / 40.0) * 6.2831853;
        float bellR = 0.52 - 0.13 * contraction;
        vec3 rimP = medusaCenter
                  + vec3(bellR * 0.92 * cos(tAngle), 0.32, bellR * 0.92 * sin(tAngle));

        float tentacleLen = 1.1 + 0.7 * hash11(seed);
        float waveX = sin(pumpPhase - tentacleLen * 2.0 + tAngle) * 0.22;
        float waveZ = cos(pumpPhase - tentacleLen * 2.0 + tAngle) * 0.22;
        vec3 tip = rimP - vec3(waveX, tentacleLen, waveZ);

        // Bioluminescent pulse travelling down the tentacle
        float bioGlow = exp(-abs(tentacleLen * 0.5 - mod(time * 2.2 + audioKick * 2.0, 1.6)) * 6.0);
        bioGlow *= (1.0 + audioKick * 2.5);

        emitSegment(rimP, tip, fract(medusaID * 0.317 + 0.45), bioGlow, 0.012);
    }
}
