#version 430
layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

// JellyfishBioluminescenceAbyss.comp
// Compute shader generating 3D pulsating deep-sea medusae bells and bioluminescent tentacle curtains

layout(std430, binding = 0) buffer Verts {
    float verts[]; // 8 floats per vertex: attrA.xyzw (pos, tentacleIdx), attrB.xyzw (pad, bioGlow)
};

// DrawArraysIndirectCommand + our own counter:
//   [0] count  [1] instanceCount  [2] first  [3] baseInstance  [4] rawCount
layout(std430, binding = 1) buffer Cmd { uint cmd[]; };

uniform uint  maxVertices;
uniform float time;
uniform float audioPhase;
uniform float audioAdvance;
uniform float audioKick;
uniform float audioBass;
uniform float audioMid;
uniform float audioHigh;
uniform float audioSwell;

float hash11(float p) {
    p = fract(p * 0.1031);
    p *= p + 81.37;
    p *= p + p;
    return fract(p);
}

void writeVertex(uint slot, vec3 p, float e1, float e2) {
    uint o = slot * 8u;
    verts[o + 0u] = p.x;  verts[o + 1u] = p.y;  verts[o + 2u] = p.z;
    verts[o + 3u] = e1;
    verts[o + 4u] = 0.0;  verts[o + 5u] = 0.0;  verts[o + 6u] = 0.0;
    verts[o + 7u] = e2;
}

// A tentacle is a line from the bell rim to its trailing tip; GL_TRIANGLES
// needs a real triangle, so it is emitted as a thin two-triangle ribbon.
void emitSegment(vec3 pA, vec3 pB, float e1, float e2, float thickness) {
    uint base = atomicAdd(cmd[4], 6u);
    if (base + 6u > maxVertices) return;

    vec3 dir = pB - pA;
    float len = length(dir);
    dir = (len > 1e-5) ? dir / len : vec3(0.0, 1.0, 0.0);
    vec3 upv = (abs(dir.y) > 0.95) ? vec3(1.0, 0.0, 0.0) : vec3(0.0, 1.0, 0.0);
    vec3 side = normalize(cross(dir, upv)) * thickness;

    vec3 a0 = pA - side, a1 = pA + side, b0 = pB - side, b1 = pB + side;
    writeVertex(base + 0u, a0, e1, e2);
    writeVertex(base + 1u, a1, e1, e2);
    writeVertex(base + 2u, b0, e1, e2);
    writeVertex(base + 3u, a1, e1, e2);
    writeVertex(base + 4u, b1, e1, e2);
    writeVertex(base + 5u, b0, e1, e2);
}

void main() {
    uvec3 g = gl_GlobalInvocationID;
    uint id = g.x + 64u * (g.y + 64u * g.z);
    const uint TOTAL_SEGMENTS = 4096u;
    if (id >= TOTAL_SEGMENTS) return;

    float seed = float(id);
    float medusaID = floor(seed / 128.0); // 32 individual jellyfish
    float tentacleID = mod(seed, 128.0);

    // Medusa colony roaming paths
    float mAngle = hash11(medusaID) * 6.2831853 + time * 0.1;
    float mRadius = (hash11(medusaID + 50.0) * 0.7 + 0.3) * 3.5;
    float mHeight = sin(time * 0.4 + medusaID * 2.0) * 1.8;

    vec3 medusaCenter = vec3(mRadius * cos(mAngle), mHeight, mRadius * sin(mAngle));

    // Jellyfish bell pulsating contraction pump driven by sub-bass
    float pumpPhase = time * 2.0 + medusaID * 1.5 + audioAdvance * 0.5;
    float contraction = pow(max(sin(pumpPhase), 0.0), 3.0) * (0.8 + 0.5 * audioBass);

    // Bell umbrella rim coordinates
    float bellAngle = (tentacleID / 128.0) * 6.2831853;
    float bellR = (0.45 - 0.15 * contraction);
    float bellY = 0.25 * sin(bellAngle * 8.0) * (1.0 - contraction);

    vec3 bellVertex = medusaCenter + vec3(bellR * cos(bellAngle), bellY + 0.2, bellR * sin(bellAngle));

    // Trailing tentacle tip waving in current
    float tentacleLen = 1.2 + 0.6 * hash11(seed);
    float waveX = sin(pumpPhase - tentacleLen * 2.0 + bellAngle) * 0.2;
    float waveZ = cos(pumpPhase - tentacleLen * 2.0 + bellAngle) * 0.2;

    vec3 tentacleTip = bellVertex - vec3(waveX, tentacleLen, waveZ);

    // Bioluminescent pulse wave traveling down tentacle
    float bioGlow = exp(-abs(tentacleLen * 0.5 - mod(time * 3.0 + audioKick * 2.0, 1.5)) * 6.0);
    bioGlow *= (1.0 + audioKick * 2.5);

    emitSegment(bellVertex, tentacleTip, tentacleID / 128.0, bioGlow, 0.02);
}
