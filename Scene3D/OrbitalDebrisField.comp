#version 430 core
/*****************************************************************************\
 *                              OrbitalDebrisField.comp
\*****************************************************************************/
/*! @file
 *
 *  @brief
 *  ORBITAL DEBRIS FIELD: twenty thousand fragments in low orbit around a derelict station, the camera parked in the
 *  stream.
 *
 *  Every fragment is a function of its id and the scene clock -- an orbit (radius, inclination, phase) plus a
 *  tumble -- so the stream flows past without state and without drift, and nothing ever pops in or out.  Collisions
 *  are light: an onset flashes a family of fragments as if they had just struck; the roughness of the sound is the
 *  glint of the metal.  The camera never moves; the debris does.
 *
 *  Audio Reactivity (generator stage):
 *    sceneAdvance   -> orbital motion and tumble (music-paced, continuous)
 *    audioOnset     -> collision flashes on a family of fragments (light)
 *    audioRoughness -> glint (light, fragment stage)
 *    audioSwell     -> the station lights up (slow)
 *
 *  Per-instance: densP (fraction of the 20k drawn), radiusP (stream radius),
 *                tumbleP (tumble rate), hueP.
 *
 *  @author René Weller
 */
/// Layout qualifiers of this stage (work-group size, or the primitive in or out).
layout( local_size_x = 4, local_size_y = 4, local_size_z = 4 ) in;
/// The output vertex buffer: eight floats per vertex (attribute A, attribute B) that the scene draws.
layout( std430, binding = 0 ) buffer Verts
{
    float verts[];
};
/// The indirect draw command: [0] the vertex count (counted up atomically), then the other draw arguments.
layout( std430, binding = 1 ) buffer Cmd
{
    uint cmd[];
};

uniform uint  maxVertices;  ///< Capacity of the vertex buffer (compute stage).
uniform float time;         ///< Seconds since this activation, plus a rolled start (see sceneTime).
uniform float sceneAdvance; ///< The music's advance since this scene was activated (integrated, never jumps).
uniform float sceneTime;    ///< Seconds since this scene was activated.
uniform float audioOnset;   ///< Onset envelope (any instrument), 0..1.
uniform float audioSwell;   ///< Slow loudness envelope, 0..1 (seconds).
uniform float audioLevel;   ///< Overall loudness, 0..1.

uniform float densP;   ///< Density knob, 0..1.
uniform float radiusP; ///< Radius knob, 0..1.
uniform float tumbleP; ///< Tumble knob: tumble rate, 0.5..1.5.
uniform float hueP;    ///< Hue knob (radians), usually the music's chroma hue plus a rolled offset.

/**  Pseudo-random number 0..1 from a float.
 *
 * @param p  The input value. (in)
 *
 * @return
 *   A pseudo-random number 0..1.
 **/
float hash11( float p )
{
    p = fract( p * 0.1031 );
    p *= p + 33.33;
    p *= p + p;
    return fract( p );
}
/**  Three pseudo-random numbers 0..1 from a float.
 *
 * @param n  The input value. (in)
 *
 * @return
 *   Three pseudo-random numbers 0..1.
 **/
vec3 hash31( float n )
{
    return vec3( hash11( n ), hash11( n + 17.3 ), hash11( n + 41.7 ) );
}

/**  Rotation matrix about the y axis.
 *
 * @param a  The angle in radians. (in)
 *
 * @return
 *   The rotation matrix.
 **/
mat3 rotY( float a )
{
    float c = cos( a ), s = sin( a );
    return mat3( c, 0.0, s, 0.0, 1.0, 0.0, -s, 0.0, c );
}
/**  Rotation matrix about the x axis.
 *
 * @param a  The angle in radians. (in)
 *
 * @return
 *   The rotation matrix.
 **/
mat3 rotX( float a )
{
    float c = cos( a ), s = sin( a );
    return mat3( 1.0, 0.0, 0.0, 0.0, c, -s, 0.0, s, c );
}
/**  Rotation matrix about the z axis.
 *
 * @param a  The angle in radians. (in)
 *
 * @return
 *   The rotation matrix.
 **/
mat3 rotZ( float a )
{
    float c = cos( a ), s = sin( a );
    return mat3( c, -s, 0.0, s, c, 0.0, 0.0, 0.0, 1.0 );
}

/**  Appends a camera-facing quad (two triangles) to the output buffer (compute stage).
 *
 * @param a     First corner (the corners run around the quad). (in)
 * @param b     Second corner. (in)
 * @param c     Third corner. (in)
 * @param d     Fourth corner. (in)
 * @param id    Element id written to every vertex. (in)
 * @param lit   Lighting weight written to every vertex. (in)
 * @param kind  Element kind written to every vertex. (in)
 **/
void emitQuad( vec3 a, vec3 b, vec3 c, vec3 d, float id, float lit, float kind )
{
    uint base = atomicAdd( cmd[4], 6u );
    if ( base + 6u > maxVertices )
        return;
    vec3 p_list[6] = vec3[6]( a, b, c, a, c, d );
    vec2 uv_list[6] = vec2[6]( vec2( 0.0, 0.0 ), vec2( 1.0, 0.0 ), vec2( 1.0, 1.0 ), vec2( 0.0, 0.0 ), vec2( 1.0, 1.0 ),
                               vec2( 0.0, 1.0 ) );
    for ( uint i = 0u; i < 6u; ++i )
    {
        uint off = ( base + i ) * 8u;
        verts[off + 0u] = p_list[i].x;
        verts[off + 1u] = p_list[i].y;
        verts[off + 2u] = p_list[i].z;
        verts[off + 3u] = id;
        verts[off + 4u] = lit;
        verts[off + 5u] = kind;
        verts[off + 6u] = uv_list[i].x;
        verts[off + 7u] = uv_list[i].y;
    }
}

/**  A box as six quads.
 *
 * @param c     Centre of the box. (in)
 * @param h     Half extents. (in)
 * @param R     Orientation of the box. (in)
 * @param id    Per-vertex value written to the buffer (the vertex stage gives it its meaning). (in)
 * @param lit   Per-vertex value written to the buffer (the vertex stage gives it its meaning). (in)
 * @param kind  Per-vertex value written to the buffer (the vertex stage gives it its meaning). (in)
 **/
void emitBox( vec3 c, vec3 h, mat3 R, float id, float lit, float kind )
{
    vec3 x = R * vec3( h.x, 0.0, 0.0 ), y = R * vec3( 0.0, h.y, 0.0 ), z = R * vec3( 0.0, 0.0, h.z );
    emitQuad( c - x - y - z, c + x - y - z, c + x + y - z, c - x + y - z, id, lit, kind );
    emitQuad( c - x - y + z, c - x + y + z, c + x + y + z, c + x - y + z, id, lit * 0.8, kind );
    emitQuad( c - x - y - z, c - x + y - z, c - x + y + z, c - x - y + z, id, lit * 0.9, kind );
    emitQuad( c + x - y - z, c + x - y + z, c + x + y + z, c + x + y - z, id, lit * 0.7, kind );
    emitQuad( c - x + y - z, c + x + y - z, c + x + y + z, c - x + y + z, id, lit, kind );
    emitQuad( c - x - y - z, c - x - y + z, c + x - y + z, c + x - y - z, id, lit * 0.6, kind );
}

/** Entry point of this shader stage (the file description says what it draws). */
void main()
{
    uvec3      g = gl_GlobalInvocationID;
    uint       id = g.x + 64u * ( g.y + 64u * g.z );
    const uint Debris = 20000u;

    if ( id == 0u )
    {
        // Sky quad (kind -1), the planet limb below (kind 3: a big quad the
        // frag paints as an atmosphere gradient), and the station (kind 2).
        emitQuad( vec3( -18.0, -10.0, 12.0 ), vec3( 18.0, -10.0, 12.0 ), vec3( 18.0, 10.0, 12.0 ),
                  vec3( -18.0, 10.0, 12.0 ), 0.0, 0.0, -1.0 );
        emitQuad( vec3( -18.0, -9.0, 11.0 ), vec3( 18.0, -9.0, 11.0 ), vec3( 18.0, -2.2, 11.0 ),
                  vec3( -18.0, -2.2, 11.0 ), 0.0, 0.0, 3.0 );
        float lit = 0.5 + 0.5 * clamp( audioSwell, 0.0, 1.0 );
        mat3  R = rotY( sceneAdvance * 0.03 ) * rotX( 0.3 );
        emitBox( vec3( 0.0, 0.2, 6.0 ), vec3( 1.4, 0.25, 0.25 ), R, 1.0, lit, 2.0 );
        emitBox( vec3( 0.0, 0.2, 6.0 ), vec3( 0.25, 1.1, 0.25 ), R, 2.0, lit, 2.0 );
        emitBox( vec3( 0.0, 0.2, 6.0 ), vec3( 0.5, 0.5, 0.9 ), R, 3.0, lit, 2.0 );
        return;
    }
    float frac = ( densP > 0.01 ) ? densP : 1.0;
    if ( id >= uint( float( Debris ) * clamp( frac, 0.05, 1.0 ) ) )
        return;

    float fid = float( id );
    vec3  h = hash31( fid );
    vec3  h2 = hash31( fid * 7.7 + 3.0 );
    float rs = ( radiusP > 0.05 ? radiusP : 1.0 );

    // Orbit: radius, inclination, phase; the stream flows on the scene clock,
    // inner fragments faster.  The whole field surrounds the station at
    // z = 3 and the camera at the origin sits in it.
    float r = ( 2.6 + 6.0 * h.x ) * rs;
    float inc = ( h.y - 0.5 ) * 0.7;
    float omega = 0.5 / pow( r, 1.2 ) + 0.05;
    float ph = h.z * 6.2831853 + ( sceneAdvance * 0.9 + sceneTime * 0.15 ) * omega;
    vec3  pos = rotZ( inc ) * vec3( r * cos( ph ), 0.0, r * sin( ph ) ) + vec3( 0.0, 0.2, 6.0 );
    pos.y += ( h2.x - 0.5 ) * 1.6;

    // Tumble on the scene clock.
    float tr = ( tumbleP > 0.05 ? tumbleP : 1.0 );
    mat3  T = rotX( ph * 3.0 * tr + h2.y * 6.28 ) * rotY( ph * 2.0 * tr + h2.z * 6.28 );

    // Size: mostly small, a few big plates.
    float big = step( 0.96, h2.z );
    // (named hs, not half: half is a reserved word in GLSL and killed the generator)
    vec3 hs = vec3( 0.03 + 0.05 * h2.x, 0.02 + 0.03 * h2.y, 0.01 + 0.02 * h.z ) * ( 1.0 + 4.0 * big ) * 0.6;

    // Collision flash: an onset lights the family whose hash matches.
    float family = step( 0.7, hash11( fid * 2.9 ) );
    float flash = clamp( audioOnset, 0.0, 1.0 ) * family;
    float lit = 0.35 + 0.65 * h2.y + flash * 2.0;

    // Only the two biggest faces to save vertices (a plate reads as a plate).
    vec3 x = T * vec3( hs.x, 0.0, 0.0 ), y = T * vec3( 0.0, hs.y, 0.0 ), z = T * vec3( 0.0, 0.0, hs.z );
    emitQuad( pos - x - y - z, pos + x - y - z, pos + x + y - z, pos - x + y - z, fid, lit, 0.0 );
    emitQuad( pos - x - y + z, pos - x + y + z, pos + x + y + z, pos + x - y + z, fid, lit * 0.8, 0.0 );
}
