#version 430
layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

/**
 * @file SuperfluidHeliumVortexTurbulence.comp
 * @brief Compute shader generating 3D quantum vortex tangle filaments in superfluid Helium-II
 */

layout(std430, binding = 0) buffer Verts {
    float verts[]; // 8 floats per vertex: attrA.xyzw (pos, kelvinAmp), attrB.xyzw (pad, circulation)
};

// DrawArraysIndirectCommand + our own counter:
//   [0] count  [1] instanceCount  [2] first  [3] baseInstance  [4] rawCount
layout(std430, binding = 1) buffer Cmd { uint cmd[]; };

uniform uint  maxVertices;
uniform float time;
uniform float audioPhase;
uniform float audioAdvance;
uniform float audioKick;
uniform float audioBass;
uniform float audioMid;
uniform float audioHigh;
uniform float audioSwell;

float hash11(float p) {
    p = fract(p * 0.1031);
    p *= p + 107.19;
    p *= p + p;
    return fract(p);
}

void writeVertex(uint slot, vec3 p, float e1, float e2) {
    uint o = slot * 8u;
    verts[o + 0u] = p.x;  verts[o + 1u] = p.y;  verts[o + 2u] = p.z;
    verts[o + 3u] = e1;
    verts[o + 4u] = 0.0;  verts[o + 5u] = 0.0;  verts[o + 6u] = 0.0;
    verts[o + 7u] = e2;
}

// Where the eye sits in this scene's world space: the vertex stage pushes the
// tangle away with vp.z += 5.5, which puts the camera at z = -5.5.
const vec3 CAMERA = vec3(0.0, 0.0, -5.5);

// A vortex-ring segment is a line from p1 to p2; GL_TRIANGLES needs a real
// triangle, so it is emitted as a thin two-triangle ribbon.
void emitSegment(vec3 pA, vec3 pB, float e1, float e2, float thickness) {
    uint base = atomicAdd(cmd[4], 6u);
    if (base + 6u > maxVertices) return;

    vec3 dir = pB - pA;
    float len = length(dir);
    dir = (len > 1e-5) ? dir / len : vec3(0.0, 1.0, 0.0);

    // The ribbon has to FACE THE CAMERA.  Widening it along cross(dir, +Y)
    // put it in the same plane as the ring it belongs to -- and these rings
    // lie in the xz plane, so every ribbon was presented to the eye EDGE ON
    // and rasterised to a hairline or to nothing at all.  Four thousand
    // filaments were being drawn and almost none of them covered a pixel;
    // that, not the palette, is why this scene measured near-black.
    vec3 toCam = CAMERA - 0.5 * (pA + pB);
    vec3 sd = cross(dir, toCam);
    float sl = length(sd);
    vec3 upv = (abs(dir.y) > 0.95) ? vec3(1.0, 0.0, 0.0) : vec3(0.0, 1.0, 0.0);
    vec3 side = ((sl > 1e-5) ? sd / sl : normalize(cross(dir, upv))) * thickness;

    vec3 a0 = pA - side, a1 = pA + side, b0 = pB - side, b1 = pB + side;
    writeVertex(base + 0u, a0, e1, e2);
    writeVertex(base + 1u, a1, e1, e2);
    writeVertex(base + 2u, b0, e1, e2);
    writeVertex(base + 3u, a1, e1, e2);
    writeVertex(base + 4u, b1, e1, e2);
    writeVertex(base + 5u, b0, e1, e2);
}

void main() {
    uvec3 g = gl_GlobalInvocationID;
    uint id = g.x + 64u * (g.y + 64u * g.z);
    // 96 vortex rings of 64 segments.  A denser tangle spread over a wider
    // volume: 64 rings inside a 2-unit box left the frame's corners empty.
    const uint TOTAL_SEGMENTS = 6144u;
    if (id >= TOTAL_SEGMENTS) return;

    float seed = float(id);
    float ringID = floor(seed / 64.0);
    float segIdx = mod(seed, 64.0);

    // Vortex ring parameters
    float ringRadius = (0.45 + 0.75 * hash11(ringID)) * 2.0;
    float ringAngle = (segIdx / 64.0) * 6.2831853;

    // Self-induced translational motion of vortex ring along its axis
    float ringSpeed = 1.0 / max(ringRadius, 0.2);
    float t = time * 0.4 * ringSpeed + audioAdvance * 0.2;

    vec3 ringCenter = vec3(sin(ringID * 2.0) * 3.4,
                           mod(t * 2.0 + ringID * 0.5, 5.2) - 2.6,
                           cos(ringID * 3.0) * 2.6);

    // Helical Kelvin wave excitations along the vortex core
    float kelvinAmp = (0.10 + 0.07 * audioHigh) * sin(ringAngle * 12.0 - time * 8.0);
    float r = ringRadius + kelvinAmp;

    vec3 p1 = ringCenter + vec3(r * cos(ringAngle), sin(ringAngle * 6.0) * 0.25, r * sin(ringAngle));

    // Next segment endpoint
    float nextAngle = ringAngle + (6.2831853 / 64.0);
    float r2 = ringRadius + (0.10 + 0.07 * audioHigh) * sin(nextAngle * 12.0 - time * 8.0);
    vec3 p2 = ringCenter + vec3(r2 * cos(nextAngle), sin(nextAngle * 6.0) * 0.25, r2 * sin(nextAngle));

    float circulation = 0.5 + 0.5 * sin(ringID + time * 3.0 + audioKick * 3.0);

    // Ribbon width.  0.015 was a hairline at the ~5.5-unit camera distance,
    // and worse, the ribbon used to be built EDGE ON to the eye (see
    // emitSegment), which threw most of even that away.  Widening and
    // camera-facing multiply, so this sits well below the ~0.042 that width
    // alone would want: at that combination 6144 filaments cover more than the
    // whole frame and the tangle rasterises into one solid mat with no gaps
    // between the vortex lines to read as depth.
    emitSegment(p1, p2, kelvinAmp, circulation, 0.026);
}
