#version 430
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// SuperfluidHeliumVortexTurbulence.comp
// Compute shader generating 3D quantum vortex tangle filaments in superfluid Helium-II

layout(std430, binding = 0) buffer Verts {
    float verts[]; // 6 floats per vertex: px, py, pz, nx, ny, nz (where n holds kelvinWave, circulation, filamentID)
};

layout(std430, binding = 1) buffer Cmd {
    uint count;
    uint instanceCount;
    uint first;
    uint baseInstance;
    uint vertCount;
};

uniform float time;
uniform float audioPhase;
uniform float audioAdvance;
uniform float audioKick;
uniform float audioBass;
uniform float audioMid;
uniform float audioHigh;
uniform float audioSwell;

float hash11(float p) {
    p = fract(p * 0.1031);
    p *= p + 107.19;
    p *= p + p;
    return fract(p);
}

void main() {
    uint id = gl_GlobalInvocationID.x;
    const uint TOTAL_SEGMENTS = 4096u;
    if (id >= TOTAL_SEGMENTS) return;

    if (id == 0u) {
        count = TOTAL_SEGMENTS * 2u;
        instanceCount = 1u;
        first = 0u;
        baseInstance = 0u;
        vertCount = TOTAL_SEGMENTS * 2u;
    }
    barrier();

    float seed = float(id);
    float ringID = floor(seed / 64.0); // 64 vortex rings
    float segIdx = mod(seed, 64.0);

    // Vortex ring parameters
    float ringRadius = (0.5 + 0.5 * hash11(ringID)) * 1.5;
    float ringAngle = (segIdx / 64.0) * 6.2831853;

    // Self-induced translational motion of vortex ring along its axis
    float ringSpeed = 1.0 / max(ringRadius, 0.2);
    float t = time * 0.4 * ringSpeed + audioAdvance * 0.2;

    vec3 ringCenter = vec3(sin(ringID * 2.0) * 2.0, mod(t * 2.0 + ringID * 0.5, 6.0) - 3.0, cos(ringID * 3.0) * 2.0);

    // Helical Kelvin wave excitations along the vortex core
    float kelvinAmp = (0.08 + 0.05 * audioHigh) * sin(ringAngle * 12.0 - time * 8.0);
    float r = ringRadius + kelvinAmp;

    vec3 p1 = ringCenter + vec3(r * cos(ringAngle), sin(ringAngle * 6.0) * 0.1, r * sin(ringAngle));

    // Next segment endpoint
    float nextAngle = ringAngle + (6.2831853 / 64.0);
    float r2 = ringRadius + (0.08 + 0.05 * audioHigh) * sin(nextAngle * 12.0 - time * 8.0);
    vec3 p2 = ringCenter + vec3(r2 * cos(nextAngle), sin(nextAngle * 6.0) * 0.1, r2 * sin(nextAngle));

    float circulation = 0.5 + 0.5 * sin(ringID + time * 3.0 + audioKick * 3.0);

    uint vIdx = id * 12u;

    // Vertex 1
    verts[vIdx + 0u] = p1.x;
    verts[vIdx + 1u] = p1.y;
    verts[vIdx + 2u] = p1.z;
    verts[vIdx + 3u] = kelvinAmp;
    verts[vIdx + 4u] = circulation;
    verts[vIdx + 5u] = 1.0;

    // Vertex 2
    verts[vIdx + 6u] = p2.x;
    verts[vIdx + 7u] = p2.y;
    verts[vIdx + 8u] = p2.z;
    verts[vIdx + 9u] = kelvinAmp;
    verts[vIdx + 10u] = circulation;
    verts[vIdx + 11u] = 1.0;
}
