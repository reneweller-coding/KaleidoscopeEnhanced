#version 430
/// Layout qualifiers of this stage (work-group size, or the primitive in or out).
layout( local_size_x = 4, local_size_y = 4, local_size_z = 4 ) in;

/**
 * @file SuperfluidHeliumVortexTurbulence.comp
 * @brief Compute shader generating 3D quantum vortex tangle filaments in superfluid Helium-II
 */

/// The output vertex buffer: eight floats per vertex (attribute A, attribute B) that the scene draws.
layout( std430, binding = 0 ) buffer Verts
{
    float verts[]; // 8 floats per vertex: attrA.xyzw (pos, kelvin_amp), attrB.xyzw (pad, circulation)
};

/// DrawArraysIndirectCommand + our own counter:
///   [0] count  [1] instanceCount  [2] first  [3] baseInstance  [4] rawCount
layout( std430, binding = 1 ) buffer Cmd
{
    uint cmd[];
};

uniform uint  maxVertices;  ///< Capacity of the vertex buffer (compute stage).
uniform float time;         ///< Seconds since the program started (never reset; see sceneTime).
uniform float audioPhase;   ///< Rotation phase driven by the music (integrated, never jumps).
uniform float audioAdvance; ///< The music's advance: integrated tempo-weighted energy (never jumps, never runs
                            ///< backwards).
uniform float audioKick;    ///< Kick-drum envelope, 0..1 (fast attack, short decay).
uniform float audioBass;    ///< Bass band level, 0..1.
uniform float audioMid;     ///< Mid band level, 0..1.
uniform float audioHigh;    ///< High band level, 0..1.
uniform float audioSwell;   ///< Slow loudness envelope, 0..1 (seconds).

/**  Pseudo-random number 0..1 from a float.
 *
 * @param p  The input value. (in)
 *
 * @return
 *   A pseudo-random number 0..1.
 **/
float hash11( float p )
{
    p = fract( p * 0.1031 );
    p *= p + 107.19;
    p *= p + p;
    return fract( p );
}

/**  Writes one vertex into the output buffer (compute stage).
 *
 * @param slot  Index of the vertex in the buffer. (in)
 * @param p     Position. (in)
 * @param e1    Extra value (attribute A's w). (in)
 * @param e2    Extra value (attribute B's w). (in)
 **/
void writeVertex( uint slot, vec3 p, float e1, float e2 )
{
    uint o = slot * 8u;
    verts[o + 0u] = p.x;
    verts[o + 1u] = p.y;
    verts[o + 2u] = p.z;
    verts[o + 3u] = e1;
    verts[o + 4u] = 0.0;
    verts[o + 5u] = 0.0;
    verts[o + 6u] = 0.0;
    verts[o + 7u] = e2;
}

/// Where the eye sits in this scene's world space: the vertex stage pushes the
/// tangle away with vp.z += 5.5, which puts the camera at z = -5.5.
const vec3 Camera = vec3( 0.0, 0.0, -5.5 );

/**  A vortex-ring segment is a line from p1 to p2; GL_TRIANGLES needs a real triangle, so it is emitted as a thin
 * two-triangle ribbon.
 *
 * @param pA         Start of the segment. (in)
 * @param pB         End of the segment. (in)
 * @param e1         Extra value written to every vertex (first slot). (in)
 * @param e2         Extra value written to every vertex (second slot). (in)
 * @param thickness  Width of the ribbon. (in)
 **/
void emitSegment( vec3 pA, vec3 pB, float e1, float e2, float thickness )
{
    uint base = atomicAdd( cmd[4], 6u );
    if ( base + 6u > maxVertices )
        return;

    vec3  dir = pB - pA;
    float len = length( dir );
    dir = ( len > 1e-5 ) ? dir / len : vec3( 0.0, 1.0, 0.0 );

    // The ribbon has to FACE THE CAMERA.  Widening it along cross(dir, +Y)
    // put it in the same plane as the ring it belongs to -- and these rings
    // lie in the xz plane, so every ribbon was presented to the eye EDGE ON
    // and rasterised to a hairline or to nothing at all.  Four thousand
    // filaments were being drawn and almost none of them covered a pixel;
    // that, not the palette, is why this scene measured near-black.
    vec3  to_cam = Camera - 0.5 * ( pA + pB );
    vec3  sd = cross( dir, to_cam );
    float sl = length( sd );
    vec3  upv = ( abs( dir.y ) > 0.95 ) ? vec3( 1.0, 0.0, 0.0 ) : vec3( 0.0, 1.0, 0.0 );
    vec3  side = ( ( sl > 1e-5 ) ? sd / sl : normalize( cross( dir, upv ) ) ) * thickness;

    vec3 a0 = pA - side, a1 = pA + side, b0 = pB - side, b1 = pB + side;
    writeVertex( base + 0u, a0, e1, e2 );
    writeVertex( base + 1u, a1, e1, e2 );
    writeVertex( base + 2u, b0, e1, e2 );
    writeVertex( base + 3u, a1, e1, e2 );
    writeVertex( base + 4u, b1, e1, e2 );
    writeVertex( base + 5u, b0, e1, e2 );
}

/** Entry point of this shader stage (the file description says what it draws). */
void main()
{
    uvec3 g = gl_GlobalInvocationID;
    uint  id = g.x + 64u * ( g.y + 64u * g.z );
    // 96 vortex rings of 64 segments.  A denser tangle spread over a wider
    // volume: 64 rings inside a 2-unit box left the frame's corners empty.
    const uint TotalSegments = 6144u;
    if ( id >= TotalSegments )
        return;

    float seed = float( id );
    float ring_id = floor( seed / 64.0 );
    float seg_idx = mod( seed, 64.0 );

    // Vortex ring parameters
    float ring_radius = ( 0.45 + 0.75 * hash11( ring_id ) ) * 2.0;
    float ring_angle = ( seg_idx / 64.0 ) * 6.2831853;

    // Self-induced translational motion of vortex ring along its axis
    float ring_speed = 1.0 / max( ring_radius, 0.2 );
    float t = time * 0.4 * ring_speed + audioAdvance * 0.2;

    vec3 ring_center = vec3( sin( ring_id * 2.0 ) * 3.4,
                             mod( t * 2.0 + ring_id * 0.5, 5.2 ) - 2.6,
                             cos( ring_id * 3.0 ) * 2.6 );

    // Helical Kelvin wave excitations along the vortex core
    float kelvin_amp = ( 0.10 + 0.07 * audioHigh ) * sin( ring_angle * 12.0 - time * 8.0 );
    float r = ring_radius + kelvin_amp;

    vec3 p1 = ring_center + vec3( r * cos( ring_angle ), sin( ring_angle * 6.0 ) * 0.25, r * sin( ring_angle ) );

    // Next segment endpoint
    float next_angle = ring_angle + ( 6.2831853 / 64.0 );
    float r2 = ring_radius + ( 0.10 + 0.07 * audioHigh ) * sin( next_angle * 12.0 - time * 8.0 );
    vec3  p2 = ring_center + vec3( r2 * cos( next_angle ), sin( next_angle * 6.0 ) * 0.25, r2 * sin( next_angle ) );

    float circulation = 0.5 + 0.5 * sin( ring_id + time * 3.0 + audioKick * 3.0 );

    // Ribbon width.  0.015 was a hairline at the ~5.5-unit camera distance,
    // and worse, the ribbon used to be built EDGE ON to the eye (see
    // emitSegment), which threw most of even that away.  Widening and
    // camera-facing multiply, so this sits well below the ~0.042 that width
    // alone would want: at that combination 6144 filaments cover more than the
    // whole frame and the tangle rasterises into one solid mat with no gaps
    // between the vortex lines to read as depth.
    emitSegment( p1, p2, kelvin_amp, circulation, 0.026 );
}
