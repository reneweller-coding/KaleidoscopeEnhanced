#version 430
/*****************************************************************************\
 *                              SPHFluidSplash.comp
\*****************************************************************************/
/*! @file
 *
 *  @brief
 *  Real SPH (Smoothed Particle Hydrodynamics) fluid: 3000 particles in a box, density/pressure computed from actual
 *  neighbours found via a 3D spatial hash grid (same binning technique ComputeFX's Boids uses in 2D, here extended
 *  to 3D), then meshed as one small tetrahedron per particle.
 *
 *  Five genPass stages (see Scene3DShader::runGenerator()'s genPassCount
 *  extension -- this is the first generator in the engine that needs more
 *  than the original "advance state, then mesh" two passes):
 *    0: clear the grid's per-cell particle counts
 *    1: bin every particle into its grid cell (atomic slot reservation)
 *    2: density + pressure per particle (sum a smoothing kernel over the
 *       27 neighbouring cells)
 *    3: pressure-gradient + viscosity forces, gravity, integrate velocity
 *       and position, bounce off the container's floor/walls
 *    4: emit a tetrahedron per particle into the indirect vertex buffer
 *
 *  The particle array and the grid share ONE persistent SSBO (m_stateBuf,
 *  sized via setGenPassCount()'s sibling setStateBytes()) as two array
 *  members of the same std430 block -- simplest way to get two differently-
 *  typed persistent regions out of the one buffer binding runGenerator()
 *  already provides, no engine change needed for a second buffer.
 *
 *  @author René Weller
 */
/// Layout qualifiers of this stage (work-group size, or the primitive in or out).
layout( local_size_x = 4, local_size_y = 4, local_size_z = 4 ) in;

const int   N = 3000;                                       ///< particles
const int   GridRes = 16;                                   ///< Cells per side of the particle grid.
const int   CellCap = 12;                                   ///< max particles tracked per cell
const float Domain = 3.2;                                   ///< box half-width: [-DOMAIN, DOMAIN]^3
const float FloorY = -3.0;                                  ///< particles rest on this plane
const float CellSize = ( 2.0 * Domain ) / float( GridRes ); ///< Size of a grid cell.
const float H = CellSize;                                   ///< SPH smoothing radius
const float RestDens = 6.0;                                 ///< target rest density
const float Stiffness = 2.4;                                ///< pressure = STIFFNESS*(density-RestDens)
const float ParticleM = 1.0;                                ///< Mass of a particle.
const float Viscosity = 0.8;                                ///< Viscosity of the fluid.
const float Grav = -9.0;                                    ///< Gravity (downward acceleration).

/// std430: particles first (N*8 floats: pos.xyz, density, vel.xyz, pressure),
/// then the grid (GridRes^3 cells * (1 count + CellCap indices) uints).
layout( std430, binding = 2 ) buffer StateBuf
{
    float particles[N * 8];
    uint  grid[GridRes * GridRes * GridRes * ( 1 + CellCap )];
};

/// Output: the shared indirect vertex/command contract every geom="indirect"
/// generator writes (see Scene3DShader.h) -- attrA.xyz = vertex position,
/// attrA.w = particle index (for per-particle colour/seed lookups in the
/// fragment stage via imgPalette-style hashing); attrB unused here.
struct Vertex
{
    vec4 attrA; ///< Attribute A (position, or u/v and an index, by the scene's kind).
    vec4 attrB; ///< Attribute B (normal, or per-element values).
};
/// The output vertex buffer: one Vertex (attribute A, attribute B) per vertex that the scene draws.
layout( std430, binding = 0 ) buffer VBO
{
    Vertex verts[];
};
/// The indirect draw command: [0] the vertex count, [4] the raw count before clamping (atomic).
layout( std430, binding = 1 ) buffer CmdBuf
{
    uint cmd[];
}; // [0]=count [4]=rawCount (atomic)

uniform float genPass; ///< 1 while the generation pass runs (it fills the state buffer once), 0 in the frames after.
uniform float time;         ///< Seconds since this activation, plus a rolled start (see sceneTime).
uniform float sceneSeed;    ///< A random number fixed per activation.
uniform float audioKick;    ///< Kick-drum envelope, 0..1 (fast attack, short decay).
uniform float audioLevel;   ///< Overall loudness, 0..1.
uniform float audioSubBass; ///< Sub-bass band level, 0..1.
uniform uint  maxVertices;  ///< Capacity of the vertex buffer (compute stage).

/**  Pseudo-random number 0..1 from a float.
 *
 * @param x  The input value. (in)
 *
 * @return
 *   A pseudo-random number 0..1.
 **/
float hash11( float x )
{
    return fract( sin( x * 127.1 + sceneSeed * 311.7 ) * 43758.5453 );
}
/**  Three pseudo-random numbers 0..1 from a float.
 *
 * @param x  The input value. (in)
 *
 * @return
 *   Three pseudo-random numbers 0..1.
 **/
vec3 hash13( float x )
{
    return vec3( hash11( x ), hash11( x + 71.17 ), hash11( x + 143.71 ) );
}

/**  Linear index of a grid cell.
 *
 * @param c  The cell. (in)
 *
 * @return
 *   The index, or -1 outside the grid.
 **/
int cellIndex( ivec3 c )
{
    c = clamp( c, ivec3( 0 ), ivec3( GridRes - 1 ) );
    return ( c.z * GridRes + c.y ) * GridRes + c.x;
}
/**  The grid cell a point falls in.
 *
 * @param p  The point. (in)
 *
 * @return
 *   The cell.
 **/
ivec3 cellOf( vec3 p )
{
    return ivec3( floor( ( p - vec3( -Domain, FloorY, -Domain ) ) / CellSize ) );
}

/**  Position of particle i.
 *
 * @param i  Index of the particle. (in)
 *
 * @return
 *   The position.
 **/
vec3 posOf( int i )
{
    int b = i * 8;
    return vec3( particles[b + 0], particles[b + 1], particles[b + 2] );
}
/**  Density of particle i.
 *
 * @param i  Index of the particle. (in)
 *
 * @return
 *   The density.
 **/
float densOf( int i )
{
    return particles[i * 8 + 3];
}
/**  Velocity of particle i.
 *
 * @param i  Index of the particle. (in)
 *
 * @return
 *   The velocity.
 **/
vec3 velOf( int i )
{
    int b = i * 8;
    return vec3( particles[b + 4], particles[b + 5], particles[b + 6] );
}
/**  Pressure of particle i.
 *
 * @param i  Index of the particle. (in)
 *
 * @return
 *   The pressure.
 **/
float presOf( int i )
{
    return particles[i * 8 + 7];
}
/**  Stores the position of particle i.
 *
 * @param i  Index of the particle. (in)
 * @param p  The position. (in)
 **/
void setPos( int i, vec3 p )
{
    int b = i * 8;
    particles[b + 0] = p.x;
    particles[b + 1] = p.y;
    particles[b + 2] = p.z;
}
/**  Stores the density of particle i.
 *
 * @param i  Index of the particle. (in)
 * @param d  The density. (in)
 **/
void setDens( int i, float d )
{
    particles[i * 8 + 3] = d;
}
/**  Stores the velocity of particle i.
 *
 * @param i  Index of the particle. (in)
 * @param v  The velocity. (in)
 **/
void setVel( int i, vec3 v )
{
    int b = i * 8;
    particles[b + 4] = v.x;
    particles[b + 5] = v.y;
    particles[b + 6] = v.z;
}
/**  Stores the pressure of particle i.
 *
 * @param i  Index of the particle. (in)
 * @param p  The pressure. (in)
 **/
void setPres( int i, float p )
{
    particles[i * 8 + 7] = p;
}

/**  Poly6 (density) and spiky-gradient (pressure force) kernels -- the standard SPH pair, chosen because poly6 is
 * smooth (good for a scalar density sum) while spiky avoids poly6's vanishing gradient at short range (which would
 * let particles pile up with no repulsion).
 *
 * @param r2  Squared distance. (in)
 * @param h2  Squared smoothing radius. (in)
 *
 * @return
 *   The kernel weight.
 **/
float poly6( float r2, float h2 )
{
    if ( r2 >= h2 )
        return 0.0;
    float t = h2 - r2;
    return 1.5666814711 / pow( sqrt( h2 ), 9.0 ) * t * t * t; // 315/(64*pi) folded in
}
/**  Gradient of the spiky kernel (the direction of the pressure force).
 *
 * @param rij  Vector between the two particles. (in)
 * @param r    Its length. (in)
 * @param h    Smoothing radius. (in)
 *
 * @return
 *   The gradient.
 **/
vec3 spikyGrad( vec3 rij, float r, float h )
{
    if ( r <= 1e-5 || r >= h )
        return vec3( 0.0 );
    float t = h - r;
    float coeff = -14.32394487 / pow( h, 6.0 ) * t * t; // -45/pi folded in
    return coeff * ( rij / r );
}

/** Entry point of this shader stage (the file description says what it draws). */
void main()
{
    uint gid = gl_GlobalInvocationID.x
               + gl_GlobalInvocationID.y * 64u
               + gl_GlobalInvocationID.z * 64u * 64u;
    int  i = int( gid );

    if ( genPass < 0.5 )
    {
        // Pass 0: clear grid counts (one invocation per cell; extra
        // invocations beyond the grid size simply have nothing to clear).
        int cells = GridRes * GridRes * GridRes;
        if ( i < cells )
            grid[i * ( 1 + CellCap )] = 0u;
        return;
    }

    if ( genPass < 1.5 )
    {
        // Pass 1: seed on frame 0 (time==0 never recurs once running, so a
        // oneshot "not yet seeded" flag isn't needed -- the very first bake
        // always has i's slot at the origin, which every subsequent frame
        // immediately moves away from), then bin every particle into its cell.
        if ( i >= N )
            return;
        vec3 p = posOf( i );
        // First-ever touch for this particle: the persistent buffer starts
        // zeroed, and gravity guarantees velocity.y != 0 after this particle's
        // very first integrate pass -- so "still exactly at rest at the
        // origin" only ever happens once, regardless of what "time" (a
        // per-activation-offset value, NOT seconds-since-seed) happens to be.
        if ( p == vec3( 0.0 ) && velOf( i ) == vec3( 0.0 ) )
        {
            vec3 h3 = hash13( float( i ) );
            p = ( h3 - 0.5 ) * vec3( Domain * 1.2, 1.0, Domain * 1.2 )
                + vec3( 0.0, Domain * 0.6, 0.0 ); // drop from a loose cloud up top
            setPos( i, p );
            setVel( i, vec3( 0.0 ) );
        }
        int  ci = cellIndex( cellOf( p ) );
        uint slot = atomicAdd( grid[ci * ( 1 + CellCap )], 1u );
        if ( slot < uint( CellCap ) )
            grid[ci * ( 1 + CellCap ) + 1u + slot] = uint( i );
        return;
    }

    if ( genPass < 2.5 )
    {
        // Pass 2: density (poly6 sum over the 27 neighbouring cells) and the
        // resulting pressure (a stiff equation of state -- simple, stable
        // enough at this particle count, not a physically exact gas law).
        if ( i >= N )
            return;
        vec3  pi = posOf( i );
        ivec3 c = cellOf( pi );
        float dens = 0.0;
        for ( int dz = -1; dz <= 1; ++dz )
            for ( int dy = -1; dy <= 1; ++dy )
                for ( int dx = -1; dx <= 1; ++dx )
                {
                    int  ci = cellIndex( c + ivec3( dx, dy, dz ) );
                    uint cnt = min( grid[ci * ( 1 + CellCap )], uint( CellCap ) );
                    for ( uint s = 0u; s < cnt; ++s )
                    {
                        int   j = int( grid[ci * ( 1 + CellCap ) + 1u + s] );
                        float r2 = dot( pi - posOf( j ), pi - posOf( j ) );
                        dens += ParticleM * poly6( r2, H * H );
                    }
                }
        setDens( i, dens );
        setPres( i, max( Stiffness * ( dens - RestDens ), 0.0 ) );
        return;
    }

    if ( genPass < 3.5 )
    {
        // Pass 3: pressure-gradient + a simple velocity-averaging viscosity,
        // gravity, semi-implicit Euler integration, box collision.
        if ( i >= N )
            return;
        vec3  pi = posOf( i ), vi = velOf( i );
        float rho_i = max( densOf( i ), 1e-3 ), pres_i = presOf( i );
        ivec3 c = cellOf( pi );
        vec3  f_press = vec3( 0.0 ), f_visc = vec3( 0.0 );
        for ( int dz = -1; dz <= 1; ++dz )
            for ( int dy = -1; dy <= 1; ++dy )
                for ( int dx = -1; dx <= 1; ++dx )
                {
                    int  ci = cellIndex( c + ivec3( dx, dy, dz ) );
                    uint cnt = min( grid[ci * ( 1 + CellCap )], uint( CellCap ) );
                    for ( uint s = 0u; s < cnt; ++s )
                    {
                        int j = int( grid[ci * ( 1 + CellCap ) + 1u + s] );
                        if ( j == i )
                            continue;
                        vec3  rij = pi - posOf( j );
                        float r = length( rij );
                        float rho_j = max( densOf( j ), 1e-3 );
                        f_press -= ParticleM * ( pres_i / ( rho_i * rho_i ) + presOf( j ) / ( rho_j * rho_j ) )
                                   * spikyGrad( rij, r, H );
                        if ( r < H )
                            f_visc += Viscosity * ParticleM * ( velOf( j ) - vi ) / rho_j * ( 1.0 - r / H );
                    }
                }
        vec3 accel = f_press + f_visc + vec3( 0.0, Grav, 0.0 );
        // A kick punches the whole pool upward from underneath -- a splash,
        // not just a colour change (photosensitivity-safe: bounded impulse,
        // not a brightness spike).
        accel.y += audioKick * 5.0 * exp( -max( pi.y - FloorY, 0.0 ) * 0.8 );

        float dt = 0.016; // fixed step: independent of the host frame rate,
                          // which would otherwise feed back into the sim
        vi += accel * dt;
        vi *= 0.999; // tiny numerical damping, keeps long runs stable
        pi += vi * dt;

        // Box collision: reflect + damp on any wall/floor penetration.
        if ( pi.x < -Domain )
        {
            pi.x = -Domain;
            vi.x *= -0.4;
        }
        if ( pi.x > Domain )
        {
            pi.x = Domain;
            vi.x *= -0.4;
        }
        if ( pi.z < -Domain )
        {
            pi.z = -Domain;
            vi.z *= -0.4;
        }
        if ( pi.z > Domain )
        {
            pi.z = Domain;
            vi.z *= -0.4;
        }
        if ( pi.y < FloorY )
        {
            pi.y = FloorY;
            vi.y *= -0.35;
        }
        if ( pi.y > Domain * 2.0 )
        {
            pi.y = Domain * 2.0;
            vi.y *= -0.2;
        } // soft lid

        setPos( i, pi );
        setVel( i, vi );
        return;
    }

    // Pass 4: mesh -- one small tetrahedron per particle, scaled slightly by
    // local density (denser = fuller droplet) and audioLevel (breathing
    // size with the music). 4 triangles = 12 vertices reserved atomically,
    // same slot-reservation contract every geom="indirect" generator uses.
    if ( i >= N )
        return;
    vec3  p = posOf( i );
    float r = 0.052 * ( 0.7 + 0.25 * clamp( densOf( i ) / RestDens, 0.0, 2.0 ) )
              * ( 1.0 + 0.15 * audioLevel );

    vec3 h3 = hash13( float( i ) + 91.3 );
    vec3 a = vec3( 0.0, r, 0.0 );
    vec3 b = vec3( r, -r * 0.6, r );
    vec3 cc = vec3( -r, -r * 0.6, r );
    vec3 d = vec3( 0.0, -r * 0.6, -r * 1.3 );
    // 4 outward-wound faces of the tetrahedron.
    vec3 verts9[12] = vec3[](
        a, cc, b, // top-front
        a, b, d,  // top-right
        a, d, cc, // top-left
        b, cc, d  // bottom
    );

    uint base = atomicAdd( cmd[4], 12u );
    if ( base + 12u > maxVertices )
        return;
    for ( int v = 0; v < 12; ++v )
    {
        verts[base + uint( v )].attrA = vec4( p + verts9[v], float( i ) );
        verts[base + uint( v )].attrB = vec4( h3, densOf( i ) / max( RestDens, 1e-3 ) );
    }
}
