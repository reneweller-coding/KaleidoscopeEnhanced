#version 430 core
layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

struct Vertex {
    vec4 pos;
    vec4 norm;
};

layout(std430, binding = 0) buffer VertexBuffer {
    Vertex verts[];
};

layout(std430, binding = 1) buffer DrawElementsBuffer {
    uint cmd[4];
};

uniform float time;
uniform float audioAdvance;
uniform float audioKick;
uniform float audioBass;
uniform float audioHigh;
uniform float dynamoP;
uniform float coriolisP;
uniform float speedP;

void main() {
    uint idx = gl_GlobalInvocationID.x +
               gl_GlobalInvocationID.y * 16u +
               gl_GlobalInvocationID.z * 256u;

    if (idx >= 4096u) return;

    float pNorm = float(idx) / 4096.0;
    float t = time * 0.4 * (speedP > 0.0 ? speedP : 1.0) + audioAdvance * 0.2;

    // 64 helical convective columns with 64 points each
    uint columnID = idx / 64u;
    float zNorm = float(idx % 64u) / 64.0;
    float z = (zNorm - 0.5) * 4.5;

    float colAngle = float(columnID) * 0.09817477;
    float rCore = (0.8 + 0.5 * sin(float(columnID) * 1.8)) * (dynamoP > 0.0 ? dynamoP : 1.0);

    // Coriolis helical column rotation: theta(z) = omega * z
    float coriolisTheta = z * 2.5 * (coriolisP > 0.0 ? coriolisP : 1.0) + t * 2.0;
    float columnRadius = 0.25 + 0.1 * sin(z * 4.0 + t * 3.0);

    float x = cos(colAngle + t * 0.3) * rCore + cos(coriolisTheta) * columnRadius;
    float y = sin(colAngle + t * 0.3) * rCore + sin(coriolisTheta) * columnRadius;

    vec3 pos = vec3(x, y, z);
    vec3 normal = normalize(vec3(cos(coriolisTheta), sin(coriolisTheta), 0.5));

    verts[idx].pos = vec4(pos, 1.0);
    verts[idx].norm = vec4(normal, pNorm);

    if (idx == 0u) {
        cmd[0] = 4096u;
        cmd[1] = 1u;
        cmd[2] = 0u;
        cmd[3] = 0u;
    }
}
