#version 430
layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

/**
 * @file MagnetoRotationalHypernovaInstability.comp
 * @brief Compute generator companion to MagnetoRotationalHypernovaInstability.frag --
 * generates 3D helical magnetic flux tubes and collimated relativistic plasma jets.
 */

layout(std430, binding = 0) buffer Verts {
    float verts[]; // 8 floats per vertex: attrA.xyzw (pos, fluxIdx), attrB.xyzw (pad, fieldEnergy)
};

// DrawArraysIndirectCommand: [0] count, [1] instanceCount, [2] first, [3] baseInstance, [4] rawCount
layout(std430, binding = 1) buffer Cmd { uint cmd[]; };

uniform uint  maxVertices;
uniform float time;
uniform float audioPhase;
uniform float audioAdvance;
uniform float audioKick;
uniform float audioBass;
uniform float audioMid;
uniform float audioHigh;
uniform float audioSwell;

float hash11(float p) {
    p = fract(p * 0.1031);
    p *= p + 81.37;
    p *= p + p;
    return fract(p);
}

void writeVertex(uint slot, vec3 p, float e1, float e2) {
    uint o = slot * 8u;
    verts[o + 0u] = p.x;  verts[o + 1u] = p.y;  verts[o + 2u] = p.z;
    verts[o + 3u] = e1;
    verts[o + 4u] = 0.0;  verts[o + 5u] = 0.0;  verts[o + 6u] = 0.0;
    verts[o + 7u] = e2;
}

void emitSegment(vec3 pA, vec3 pB, float e1, float e2, float thickness) {
    uint base = atomicAdd(cmd[4], 6u);
    if (base + 6u > maxVertices) return;

    vec3 dir = pB - pA;
    float len = length(dir);
    dir = (len > 1e-5) ? dir / len : vec3(0.0, 1.0, 0.0);
    vec3 upv = (abs(dir.y) > 0.95) ? vec3(1.0, 0.0, 0.0) : vec3(0.0, 1.0, 0.0);
    vec3 side = normalize(cross(dir, upv)) * thickness;

    vec3 a0 = pA - side, a1 = pA + side, b0 = pB - side, b1 = pB + side;
    writeVertex(base + 0u, a0, e1, e2);
    writeVertex(base + 1u, a1, e1, e2);
    writeVertex(base + 2u, b0, e1, e2);
    writeVertex(base + 3u, a1, e1, e2);
    writeVertex(base + 4u, b1, e1, e2);
    writeVertex(base + 5u, b0, e1, e2);
}

void main() {
    uvec3 g = gl_GlobalInvocationID;
    uint idx = g.x + 64u * (g.y + 64u * g.z);
    
    // We simulate 64 flux tube streamlines with 64 segments each = 4096 strands
    uint strandIdx = idx / 64u;
    uint segIdx    = idx % 64u;
    if (strandIdx >= 64u) return;

    float t = time * 0.45 + audioAdvance * 0.35;
    float strandSeed = hash11(float(strandIdx) * 17.31);
    
    float s0 = float(segIdx) / 64.0;
    float s1 = float(segIdx + 1u) / 64.0;

    // Helical relativistic jet trajectory along z-axis
    float jetSign = (strandIdx % 2u == 0u) ? 1.0 : -1.0;
    float baseAngle = strandSeed * 6.2831853;
    
    // Position 0
    float z0 = (s0 * 3.5 - 0.2) * jetSign;
    float r0 = (0.15 + s0 * 0.8) * (1.0 + 0.3 * audioBass);
    float theta0 = baseAngle + s0 * 18.0 + t * 2.0 * jetSign;
    vec3 p0 = vec3(cos(theta0) * r0, sin(theta0) * r0, z0);

    // Position 1
    float z1 = (s1 * 3.5 - 0.2) * jetSign;
    float r1 = (0.15 + s1 * 0.8) * (1.0 + 0.3 * audioBass);
    float theta1 = baseAngle + s1 * 18.0 + t * 2.0 * jetSign;
    vec3 p1 = vec3(cos(theta1) * r1, sin(theta1) * r1, z1);

    // Magnetic energy & reconnection glow
    float energy = (1.0 - s0 * 0.6) * (1.0 + 2.5 * audioKick);
    float thick = (0.015 + 0.02 * (1.0 - s0)) * (1.0 + 0.5 * audioSwell);

    emitSegment(p0, p1, float(strandIdx) / 64.0, energy, thick);
}
