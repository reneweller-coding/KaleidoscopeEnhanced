#version 430
layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

/**
 * @file TokamakFusionCore.comp
 * @brief Compute shader generating 3D magnetic flux surfaces & toroidal plasma filaments inside a tokamak
 */

layout(std430, binding = 0) buffer Verts {
    float verts[]; // 8 floats per vertex: attrA.xyzw (pos, heat), attrB.xyzw (pad, specBand)
};

// DrawArraysIndirectCommand + our own counter:
//   [0] count  [1] instanceCount  [2] first  [3] baseInstance  [4] rawCount
layout(std430, binding = 1) buffer Cmd { uint cmd[]; };

uniform uint  maxVertices;
uniform float time;
uniform float audioPhase;
uniform float audioAdvance;
uniform float audioKick;
uniform float audioBass;
uniform float audioMid;
uniform float audioHigh;
uniform float audioSwell;

float hash11(float p) {
    p = fract(p * 0.1031);
    p *= p + 33.33;
    p *= p + p;
    return fract(p);
}

void writeVertex(uint slot, vec3 p, float e1, float e2) {
    uint o = slot * 8u;
    verts[o + 0u] = p.x;  verts[o + 1u] = p.y;  verts[o + 2u] = p.z;
    verts[o + 3u] = e1;
    verts[o + 4u] = 0.0;  verts[o + 5u] = 0.0;  verts[o + 6u] = 0.0;
    verts[o + 7u] = e2;
}

// A magnetic-field-line filament segment is a line from p1 to p2;
// GL_TRIANGLES needs a real triangle, so it is emitted as a thin
// two-triangle ribbon.
void emitSegment(vec3 pA, vec3 pB, float e1, float e2, float thickness) {
    uint base = atomicAdd(cmd[4], 6u);
    if (base + 6u > maxVertices) return;

    vec3 dir = pB - pA;
    float len = length(dir);
    dir = (len > 1e-5) ? dir / len : vec3(0.0, 1.0, 0.0);
    vec3 upv = (abs(dir.y) > 0.95) ? vec3(1.0, 0.0, 0.0) : vec3(0.0, 1.0, 0.0);
    vec3 side = normalize(cross(dir, upv)) * thickness;

    vec3 a0 = pA - side, a1 = pA + side, b0 = pB - side, b1 = pB + side;
    writeVertex(base + 0u, a0, e1, e2);
    writeVertex(base + 1u, a1, e1, e2);
    writeVertex(base + 2u, b0, e1, e2);
    writeVertex(base + 3u, a1, e1, e2);
    writeVertex(base + 4u, b1, e1, e2);
    writeVertex(base + 5u, b0, e1, e2);
}

void main() {
    uvec3 g = gl_GlobalInvocationID;
    uint id = g.x + 64u * (g.y + 64u * g.z);
    const uint TOTAL_FILAMENTS = 4096u;
    if (id >= TOTAL_FILAMENTS) return;

    float seed = float(id);
    float strand = hash11(seed);
    float strandIdx = float(id % 32u);
    float ringIdx = float(id / 32u);

    // Major and minor radius of D-shaped tokamak torus
    float R0 = 3.5; // Major radius
    float a0 = 1.3 + 0.3 * audioBass; // Minor radius

    // Poloidal & toroidal angles
    float q_safety = 3.0 + 0.5 * sin(audioAdvance * 0.1); // Safety factor q = m/n
    float phi = (ringIdx / 128.0) * 6.2831853 + time * 0.3; // Toroidal angle
    float theta = phi * q_safety + (strandIdx / 32.0) * 6.2831853 + audioPhase * 0.5; // Poloidal angle

    // D-shaped elongation (elongation kappa ~ 1.7, triangularity delta ~ 0.3)
    float kappa = 1.7;
    float delta = 0.3;

    // Segment start position
    float r1 = a0 * (0.4 + 0.6 * strand);
    float x1 = (R0 + r1 * cos(theta + delta * sin(theta))) * cos(phi);
    float y1 = r1 * kappa * sin(theta);
    float z1 = (R0 + r1 * cos(theta + delta * sin(theta))) * sin(phi);

    // Segment end position (extending along magnetic field line)
    float dPhi = 0.05 + 0.02 * audioKick;
    float phi2 = phi + dPhi;
    float theta2 = theta + dPhi * q_safety;

    float x2 = (R0 + r1 * cos(theta2 + delta * sin(theta2))) * cos(phi2);
    float y2 = r1 * kappa * sin(theta2);
    float z2 = (R0 + r1 * cos(theta2 + delta * sin(theta2))) * sin(phi2);

    // Color/energy data
    float heat = 0.5 + 0.5 * sin(strandIdx * 0.5 + time * 4.0 + audioKick * 3.0);
    float specBand = strand;

    emitSegment(vec3(x1, y1, z1), vec3(x2, y2, z2), heat, specBand, 0.025);
}
