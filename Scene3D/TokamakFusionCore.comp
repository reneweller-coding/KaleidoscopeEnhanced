#version 430
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// TokamakFusionCore.comp
// Compute shader generating 3D magnetic flux surfaces & toroidal plasma filaments inside a tokamak

layout(std430, binding = 0) buffer Verts {
    float verts[]; // 6 floats per vertex: px, py, pz, nx, ny, nz (where n holds color/intensity)
};

layout(std430, binding = 1) buffer Cmd {
    uint count;
    uint instanceCount;
    uint first;
    uint baseInstance;
    uint vertCount;
};

uniform float time;
uniform float audioPhase;
uniform float audioAdvance;
uniform float audioKick;
uniform float audioBass;
uniform float audioMid;
uniform float audioHigh;
uniform float audioSwell;

float hash11(float p) {
    p = fract(p * 0.1031);
    p *= p + 33.33;
    p *= p + p;
    return fract(p);
}

void main() {
    uint id = gl_GlobalInvocationID.x;
    const uint TOTAL_FILAMENTS = 4096u;
    if (id >= TOTAL_FILAMENTS) return;

    if (id == 0u) {
        count = TOTAL_FILAMENTS * 2u;
        instanceCount = 1u;
        first = 0u;
        baseInstance = 0u;
        vertCount = TOTAL_FILAMENTS * 2u;
    }
    barrier();

    float seed = float(id);
    float strand = hash11(seed);
    float strandIdx = float(id % 32u);
    float ringIdx = float(id / 32u);

    // Major and minor radius of D-shaped tokamak torus
    float R0 = 3.5; // Major radius
    float a0 = 1.3 + 0.3 * audioBass; // Minor radius

    // Poloidal & toroidal angles
    float q_safety = 3.0 + 0.5 * sin(audioAdvance * 0.1); // Safety factor q = m/n
    float phi = (ringIdx / 128.0) * 6.2831853 + time * 0.3; // Toroidal angle
    float theta = phi * q_safety + (strandIdx / 32.0) * 6.2831853 + audioPhase * 0.5; // Poloidal angle

    // D-shaped elongation (elongation kappa ~ 1.7, triangularity delta ~ 0.3)
    float kappa = 1.7;
    float delta = 0.3;

    // Segment start position
    float r1 = a0 * (0.4 + 0.6 * strand);
    float x1 = (R0 + r1 * cos(theta + delta * sin(theta))) * cos(phi);
    float y1 = r1 * kappa * sin(theta);
    float z1 = (R0 + r1 * cos(theta + delta * sin(theta))) * sin(phi);

    // Segment end position (extending along magnetic field line)
    float dPhi = 0.05 + 0.02 * audioKick;
    float phi2 = phi + dPhi;
    float theta2 = theta + dPhi * q_safety;

    float x2 = (R0 + r1 * cos(theta2 + delta * sin(theta2))) * cos(phi2);
    float y2 = r1 * kappa * sin(theta2);
    float z2 = (R0 + r1 * cos(theta2 + delta * sin(theta2))) * sin(phi2);

    // Color/energy data encoded in normals
    float heat = 0.5 + 0.5 * sin(strandIdx * 0.5 + time * 4.0 + audioKick * 3.0);
    float specBand = strand;

    uint vIdx = id * 12u; // 2 vertices * 6 floats

    // Vertex 1
    verts[vIdx + 0u] = x1;
    verts[vIdx + 1u] = y1;
    verts[vIdx + 2u] = z1;
    verts[vIdx + 3u] = heat;
    verts[vIdx + 4u] = specBand;
    verts[vIdx + 5u] = 1.0;

    // Vertex 2
    verts[vIdx + 6u] = x2;
    verts[vIdx + 7u] = y2;
    verts[vIdx + 8u] = z2;
    verts[vIdx + 9u] = heat;
    verts[vIdx + 10u] = specBand;
    verts[vIdx + 11u] = 1.0;
}
