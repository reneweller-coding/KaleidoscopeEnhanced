#version 430 core
/**
 * @file ProteinFoldingChain.comp
 * @brief PROTEIN FOLDING CHAIN: a polypeptide folding.  A chain of 240
 * residues -- round beads on a tube -- starts the scene as a loose random
 * coil and over the arc pulls into a compact fold: helices wind up, then
 * the helices pack together.  Every residue position is a blend, by the
 * arc, between three closed-form conformations (coil, helical, packed),
 * so the folding is continuous; a slow breathing on the scene clock keeps
 * it alive.  Hydrophobic residues (a fixed per-residue flag) are the ones
 * that glow with the bass in the fragment.  No state.  Camera still.
 *
 * Per-instance: lengthP, packP, hueP.
 */
layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;
layout(std430, binding = 0) buffer Verts { float verts[]; };
layout(std430, binding = 1) buffer Cmd   { uint cmd[];   };

uniform uint  maxVertices;
uniform float time;
uniform float sceneAdvance;
uniform float sceneTime;
uniform float sceneProgress;

uniform float lengthP;
uniform float packP;
uniform float hueP;

float hash11(float p) { p = fract(p * 0.1031); p *= p + 33.33; p *= p + p; return fract(p); }
vec3  hash31(float n) { return vec3(hash11(n), hash11(n + 17.3), hash11(n + 41.7)); }

void emitQuad(vec3 c, vec3 ax, vec3 ay, float id, float lit, float kind, vec2 uv0, vec2 uv1)
{
    uint base = atomicAdd(cmd[4], 6u);
    if (base + 6u > maxVertices) return;
    vec3 p0 = c - ax - ay, p1 = c + ax - ay, p2 = c + ax + ay, p3 = c - ax + ay;
    vec3 pList[6]  = vec3[6](p0, p1, p2, p0, p2, p3);
    vec2 uvList[6] = vec2[6](vec2(uv0.x, uv0.y), vec2(uv1.x, uv0.y), vec2(uv1.x, uv1.y), vec2(uv0.x, uv0.y), vec2(uv1.x, uv1.y), vec2(uv0.x, uv1.y));
    for (uint i = 0u; i < 6u; ++i)
    {
        uint off = (base + i) * 8u;
        verts[off + 0u] = pList[i].x; verts[off + 1u] = pList[i].y; verts[off + 2u] = pList[i].z;
        verts[off + 3u] = id; verts[off + 4u] = lit; verts[off + 5u] = kind;
        verts[off + 6u] = uvList[i].x; verts[off + 7u] = uvList[i].y;
    }
}

// Residue i of N: three conformations.
vec3 coilPos(float i, float N, float breathe)
{
    // A random-walk-like coil from sums of sines (smooth in i).
    float s = i / N * 6.2831853;
    return vec3(sin(s * 1.7 + 1.0) * 2.6 + sin(s * 4.3) * 0.8, sin(s * 2.3 + 2.0) * 1.8 + cos(s * 5.1) * 0.6, sin(s * 1.3 + 0.5) * 1.4 + sin(s * 3.7 + breathe) * 0.5);
}
vec3 helixPos(float i, float N, float breathe)
{
    // Four helices in a row along x, 3.6 residues per turn.
    float seg = floor(i / (N / 4.0));
    float j = i - seg * (N / 4.0);
    float ang = j * 1.745 + breathe * 0.3;
    vec3 axis0 = vec3(-3.0 + seg * 2.0, 0.0, 0.0);
    return axis0 + vec3(0.0, cos(ang) * 0.45, sin(ang) * 0.45) + vec3(0.0, j * 0.055 - (N / 8.0) * 0.055, 0.0) * 1.0 + vec3(0.0, 0.0, 0.0);
}
vec3 packedPos(float i, float N, float pack, float breathe)
{
    // The four helices packed into a bundle: axes on a small circle, tilted.
    float seg = floor(i / (N / 4.0));
    float j = i - seg * (N / 4.0);
    float ang = j * 1.745 + breathe * 0.3;
    float bundleA = seg * 1.5708 + 0.4;
    vec3 axis0 = vec3(cos(bundleA), 0.0, sin(bundleA)) * (0.75 + 0.5 * (1.0 - pack));
    float tilt = 0.25 * (seg == 0.0 || seg == 2.0 ? 1.0 : -1.0);
    vec3 up = normalize(vec3(sin(tilt) * cos(bundleA), cos(tilt), sin(tilt) * sin(bundleA)));
    vec3 t1 = normalize(cross(up, vec3(1.0, 0.0, 0.0) + vec3(0.0, 0.01, 0.0)));
    vec3 t2 = cross(up, t1);
    return axis0 + up * (j * 0.055 - (N / 8.0) * 0.055) + (t1 * cos(ang) + t2 * sin(ang)) * 0.45;
}

void main()
{
    uvec3 g = gl_GlobalInvocationID;
    uint id = g.x + 64u * (g.y + 64u * g.z);
    float N = floor(160.0 + 80.0 * clamp(lengthP, 0.0, 1.0));
    float pack = 0.5 + 0.5 * clamp(packP, 0.0, 1.0);
    float breathe = sceneAdvance * 0.4 + sceneTime * 0.08;
    float prog = clamp(sceneProgress, 0.0, 1.0);
    float f1 = smoothstep(0.05, 0.45, prog);        // coil -> helices
    float f2 = smoothstep(0.45, 0.85, prog);        // helices -> packed
    const vec3 centre = vec3(0.0, 0.0, 8.5);
    float ry = breathe * 0.25;
    mat3 RY = mat3(cos(ry), 0.0, -sin(ry), 0.0, 1.0, 0.0, sin(ry), 0.0, cos(ry));

    if (id == 0u)
    {
        emitQuad(vec3(0.0, 0.0, 30.0), vec3(50.0, 0.0, 0.0), vec3(0.0, 28.0, 0.0), 0.0, 0.0, -1.0, vec2(0.0), vec2(1.0));
        return;
    }
    uint i = id - 1u;
    if (float(i) >= N) return;
    float fi = float(i);
    vec3 a = mix(mix(coilPos(fi, N, breathe), helixPos(fi, N, breathe), f1), packedPos(fi, N, pack, breathe), f2);
    vec3 b = mix(mix(coilPos(fi + 1.0, N, breathe), helixPos(fi + 1.0, N, breathe), f1), packedPos(fi + 1.0, N, pack, breathe), f2);
    a = centre + RY * (a * 1.9); b = centre + RY * (b * 1.9);
    float hydrophobic = step(0.6, hash11(fi * 3.7));
    // Bead (kind 0) and the bond to the next residue (kind 1, a thin quad).
    float sz = 0.17;
    emitQuad(a, vec3(sz, 0.0, 0.0), vec3(0.0, sz, 0.0), fi, hydrophobic, 0.0, vec2(0.0), vec2(1.0));
    if (fi < N - 1.0)
    {
        vec3 mid = (a + b) * 0.5, half_ = (b - a) * 0.5;
        vec3 side = normalize(cross(half_, normalize(-mid))) * 0.05;
        emitQuad(mid, half_, side, fi, hydrophobic, 1.0, vec2(0.0), vec2(1.0));
    }
}
