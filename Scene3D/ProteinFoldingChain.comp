#version 430 core
/*****************************************************************************\
 *                              ProteinFoldingChain.comp
\*****************************************************************************/
/*! @file
 *
 *  @brief
 *  PROTEIN FOLDING CHAIN: a polypeptide folding.
 *
 *  A chain of 240 residues -- round beads on a tube -- starts the scene as a loose random coil and over the arc
 *  pulls into a compact fold: helices wind up, then the helices pack together.  Every residue position is a blend,
 *  by the arc, between three closed-form conformations (coil, helical, packed), so the folding is continuous; a
 *  slow breathing on the scene clock keeps it alive.  Hydrophobic residues (a fixed per-residue flag) are the ones
 *  that glow with the bass in the fragment.  No state.  Camera still.
 *
 *  Per-instance: lengthP, packP, hueP.
 *
 *  @author René Weller
 */
/// Layout qualifiers of this stage (work-group size, or the primitive in or out).
layout( local_size_x = 4, local_size_y = 4, local_size_z = 4 ) in;
/// The output vertex buffer: eight floats per vertex (attribute A, attribute B) that the scene draws.
layout( std430, binding = 0 ) buffer Verts
{
    float verts[];
};
/// The indirect draw command: [0] the vertex count (counted up atomically), then the other draw arguments.
layout( std430, binding = 1 ) buffer Cmd
{
    uint cmd[];
};

uniform uint  maxVertices;   ///< Capacity of the vertex buffer (compute stage).
uniform float time;          ///< Seconds since the program started (never reset; see sceneTime).
uniform float sceneAdvance;  ///< The music's advance since this scene was activated (integrated, never jumps).
uniform float sceneTime;     ///< Seconds since this scene was activated.
uniform float sceneProgress; ///< Progress through this scene's solo time, 0..1.

uniform float lengthP; ///< Length knob, 0..1.
uniform float packP;   ///< Pack knob, 0..1.
uniform float hueP;    ///< Hue knob (radians), usually the music's chroma hue plus a rolled offset.

/**  Pseudo-random number 0..1 from a float.
 *
 * @param p  The input value. (in)
 *
 * @return
 *   A pseudo-random number 0..1.
 **/
float hash11( float p )
{
    p = fract( p * 0.1031 );
    p *= p + 33.33;
    p *= p + p;
    return fract( p );
}
/**  Three pseudo-random numbers 0..1 from a float.
 *
 * @param n  The input value. (in)
 *
 * @return
 *   Three pseudo-random numbers 0..1.
 **/
vec3 hash31( float n )
{
    return vec3( hash11( n ), hash11( n + 17.3 ), hash11( n + 41.7 ) );
}

/**  Appends a camera-facing quad (two triangles) to the output buffer (compute stage).
 *
 * @param c     Centre of the quad. (in)
 * @param ax    Half the quad's extent along its first axis. (in)
 * @param ay    Half its extent along the second axis. (in)
 * @param id    Element id written to every vertex. (in)
 * @param lit   Lighting weight written to every vertex. (in)
 * @param kind  Element kind written to every vertex. (in)
 * @param uv0   Texture coordinate of the first corner. (in)
 * @param uv1   Texture coordinate of the opposite corner. (in)
 **/
void emitQuad( vec3 c, vec3 ax, vec3 ay, float id, float lit, float kind, vec2 uv0, vec2 uv1 )
{
    uint base = atomicAdd( cmd[4], 6u );
    if ( base + 6u > maxVertices )
        return;
    vec3 p0 = c - ax - ay, p1 = c + ax - ay, p2 = c + ax + ay, p3 = c - ax + ay;
    vec3 p_list[6] = vec3[6]( p0, p1, p2, p0, p2, p3 );
    vec2 uv_list[6] = vec2[6]( vec2( uv0.x, uv0.y ), vec2( uv1.x, uv0.y ), vec2( uv1.x, uv1.y ), vec2( uv0.x, uv0.y ),
                               vec2( uv1.x, uv1.y ), vec2( uv0.x, uv1.y ) );
    for ( uint i = 0u; i < 6u; ++i )
    {
        uint off = ( base + i ) * 8u;
        verts[off + 0u] = p_list[i].x;
        verts[off + 1u] = p_list[i].y;
        verts[off + 2u] = p_list[i].z;
        verts[off + 3u] = id;
        verts[off + 4u] = lit;
        verts[off + 5u] = kind;
        verts[off + 6u] = uv_list[i].x;
        verts[off + 7u] = uv_list[i].y;
    }
}

/**  Residue i of N: three conformations.
 *
 * @param i        Index of the residue. (in)
 * @param N        Number of residues. (in)
 * @param breathe  Breathing phase. (in)
 *
 * @return
 *   The position.
 **/
vec3 coilPos( float i, float N, float breathe )
{
    // A random-walk-like coil from sums of sines (smooth in i).
    float s = i / N * 6.2831853;
    return vec3( sin( s * 1.7 + 1.0 ) * 2.6 + sin( s * 4.3 ) * 0.8, sin( s * 2.3 + 2.0 ) * 1.8 + cos( s * 5.1 ) * 0.6,
                 sin( s * 1.3 + 0.5 ) * 1.4 + sin( s * 3.7 + breathe ) * 0.5 );
}
/**  Residue i in the helix conformation: four helices in a row along x.
 *
 * @param i        Index of the residue. (in)
 * @param N        Number of residues. (in)
 * @param breathe  Breathing phase. (in)
 *
 * @return
 *   The position.
 **/
vec3 helixPos( float i, float N, float breathe )
{
    // Four helices in a row along x, 3.6 residues per turn.
    float seg = floor( i / ( N / 4.0 ) );
    float j = i - seg * ( N / 4.0 );
    float ang = j * 1.745 + breathe * 0.3;
    vec3  axis0 = vec3( -3.0 + seg * 2.0, 0.0, 0.0 );
    return axis0 + vec3( 0.0, cos( ang ) * 0.45, sin( ang ) * 0.45 )
           + vec3( 0.0, j * 0.055 - ( N / 8.0 ) * 0.055, 0.0 ) * 1.0 + vec3( 0.0, 0.0, 0.0 );
}
/**  Residue i in the packed conformation: the four helices bundled.
 *
 * @param i        Index of the residue. (in)
 * @param N        Number of residues. (in)
 * @param pack     Packing progress, 0..1. (in)
 * @param breathe  Breathing phase. (in)
 *
 * @return
 *   The position.
 **/
vec3 packedPos( float i, float N, float pack, float breathe )
{
    // The four helices packed into a bundle: axes on a small circle, tilted.
    float seg = floor( i / ( N / 4.0 ) );
    float j = i - seg * ( N / 4.0 );
    float ang = j * 1.745 + breathe * 0.3;
    float bundle_a = seg * 1.5708 + 0.4;
    vec3  axis0 = vec3( cos( bundle_a ), 0.0, sin( bundle_a ) ) * ( 0.75 + 0.5 * ( 1.0 - pack ) );
    float tilt = 0.25 * ( seg == 0.0 || seg == 2.0 ? 1.0 : -1.0 );
    vec3  up = normalize( vec3( sin( tilt ) * cos( bundle_a ), cos( tilt ), sin( tilt ) * sin( bundle_a ) ) );
    vec3  t1 = normalize( cross( up, vec3( 1.0, 0.0, 0.0 ) + vec3( 0.0, 0.01, 0.0 ) ) );
    vec3  t2 = cross( up, t1 );
    return axis0 + up * ( j * 0.055 - ( N / 8.0 ) * 0.055 ) + ( t1 * cos( ang ) + t2 * sin( ang ) ) * 0.45;
}

/** Entry point of this shader stage (the file description says what it draws). */
void main()
{
    uvec3      g = gl_GlobalInvocationID;
    uint       id = g.x + 64u * ( g.y + 64u * g.z );
    float      N = floor( 160.0 + 80.0 * clamp( lengthP, 0.0, 1.0 ) );
    float      pack = 0.5 + 0.5 * clamp( packP, 0.0, 1.0 );
    float      breathe = sceneAdvance * 0.4 + sceneTime * 0.08;
    float      prog = clamp( sceneProgress, 0.0, 1.0 );
    float      f1 = smoothstep( 0.05, 0.45, prog ); // coil -> helices
    float      f2 = smoothstep( 0.45, 0.85, prog ); // helices -> packed
    const vec3 centre = vec3( 0.0, 0.0, 8.5 );
    float      ry = breathe * 0.25;
    mat3       RY = mat3( cos( ry ), 0.0, -sin( ry ), 0.0, 1.0, 0.0, sin( ry ), 0.0, cos( ry ) );

    if ( id == 0u )
    {
        emitQuad( vec3( 0.0, 0.0, 30.0 ), vec3( 50.0, 0.0, 0.0 ), vec3( 0.0, 28.0, 0.0 ), 0.0, 0.0, -1.0, vec2( 0.0 ),
                  vec2( 1.0 ) );
        return;
    }
    uint i = id - 1u;
    if ( float( i ) >= N )
        return;
    float fi = float( i );
    vec3  a = mix( mix( coilPos( fi, N, breathe ), helixPos( fi, N, breathe ), f1 ), packedPos( fi, N, pack, breathe ),
                   f2 );
    vec3  b = mix( mix( coilPos( fi + 1.0, N, breathe ), helixPos( fi + 1.0, N, breathe ), f1 ),
                   packedPos( fi + 1.0, N, pack, breathe ), f2 );
    a = centre + RY * ( a * 1.9 );
    b = centre + RY * ( b * 1.9 );
    float hydrophobic = step( 0.6, hash11( fi * 3.7 ) );
    // Bead (kind 0) and the bond to the next residue (kind 1, a thin quad).
    float sz = 0.17;
    emitQuad( a, vec3( sz, 0.0, 0.0 ), vec3( 0.0, sz, 0.0 ), fi, hydrophobic, 0.0, vec2( 0.0 ), vec2( 1.0 ) );
    if ( fi < N - 1.0 )
    {
        vec3 mid = ( a + b ) * 0.5, half_ = ( b - a ) * 0.5;
        vec3 side = normalize( cross( half_, normalize( -mid ) ) ) * 0.05;
        emitQuad( mid, half_, side, fi, hydrophobic, 1.0, vec2( 0.0 ), vec2( 1.0 ) );
    }
}
