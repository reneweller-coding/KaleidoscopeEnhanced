#version 430
/*****************************************************************************\
 *                              BioluminescentSwarm.comp
\*****************************************************************************/
/*! @file
 *
 *  @brief
 *  Compute kernel that simulates 4096 winged bioluminescent creatures flowing through an emergent double-torus
 *  murmuration in 3D space.
 *
 *  audioAdvance drives each creature's orbital angle and the murmuration's
 *  slow torus breathing; audioKick scatters creatures radially outward on
 *  each hit; audioSpectrum[] (one band per creature, picked from its random
 *  seed) drives that creature's individual emission glow, layered with a
 *  general audioKick boost; swarmP scales the orbit radius, speedP scales the
 *  orbital/torus speed, and glowP scales overall brightness. Each invocation
 *  emits one faceted diamond creature (two triangles, 6 vertices) into the
 *  shared vertex/command buffers, which the sibling BioluminescentSwarm.frag
 *  reads back and lights with a simple directional diffuse + specular term.
 *
 *  @author René Weller
 */

/// BioluminescentSwarm.comp — GPU Compute Simulation of 12,000 bioluminescent
/// creatures exhibiting emergent flocking and murmuration vortices in 3D.
layout( local_size_x = 4, local_size_y = 4, local_size_z = 4 ) in;

/// The output vertex buffer: eight floats per vertex (attribute A, attribute B) that the scene draws.
layout( std430, binding = 0 ) buffer Verts
{
    float verts[];
};
/// The indirect draw command: [0] the vertex count (counted up atomically), then the other draw arguments.
layout( std430, binding = 1 ) buffer Cmd
{
    uint cmd[];
};

uniform uint  maxVertices;       ///< Capacity of the vertex buffer (compute stage).
uniform float time;              ///< Seconds since this activation, plus a rolled start (see sceneTime).
uniform float sceneSeed;         ///< A random number fixed per activation.
uniform float audioAdvance;      ///< The music's advance: integrated tempo-weighted energy (never jumps, never runs
                                 ///< backwards).
uniform float audioLevel;        ///< Overall loudness, 0..1.
uniform float audioKick;         ///< Kick-drum envelope, 0..1 (fast attack, short decay).
uniform float audioSubBass;      ///< Sub-bass band level, 0..1.
uniform float audioHigh;         ///< High band level, 0..1.
uniform float audioSpectrum[32]; ///< Spectrum bands, 0..1.

uniform float swarmP; ///< Swarm knob, 0.5..1.8.
uniform float speedP; ///< Speed knob, 0..1.
uniform float glowP;  ///< Glow / afterglow knob, 0..1.

const int Creatures = 64 * 64; ///< 4096 boid creatures, each emitted as a 3D faceted diamond (6 vertices)
// Marine snow: 1,600 soft camera-facing motes hanging in the water BEHIND the
// swarm.  The murmuration is a band across the middle of the frame however
// large it gets -- a torus seen from outside always is -- so on its own it
// left the top and bottom of the picture black.  Only the seeds are made
// here; BioluminescentSwarm.vert places them across the frustum, because it
// is the stage that knows the aspect ratio.  glow = -1 is the marker.
const uint Snow = 1600u;                 ///< Number of marine-snow specks.
const uint SnowBase = uint( Creatures ); ///< Index of the first marine-snow speck (after the creatures).

/**  Pseudo-random number 0..1 from a float.
 *
 * @param n  The input. (in)
 *
 * @return
 *   A pseudo-random number 0..1.
 **/
float hash1( float n )
{
    return fract( sin( n * 123.456 ) * 43758.5453 );
}
/**  Pseudo-random vec3 (each 0..1) from a float.
 *
 * @param n  The input. (in)
 *
 * @return
 *   Pseudo-random numbers, each 0..1.
 **/
vec3 hash3( float n )
{
    return fract( sin( vec3( n * 91.34, n * 47.12, n * 73.56 ) ) * 43758.5453 );
}

/**  Writes one vertex into the output buffer (compute stage).
 *
 * @param slot  Index of the vertex in the buffer. (in)
 * @param p     Position. (in)
 * @param n     Normal. (in)
 * @param hue   Per-vertex value written to the buffer (the vertex stage gives it its meaning). (in)
 * @param glow  Per-vertex value written to the buffer (the vertex stage gives it its meaning). (in)
 **/
void writeVertex( uint slot, vec3 p, vec3 n, float hue, float glow )
{
    uint o = slot * 8u;
    verts[o + 0u] = p.x;
    verts[o + 1u] = p.y;
    verts[o + 2u] = p.z;
    verts[o + 3u] = hue;
    verts[o + 4u] = n.x;
    verts[o + 5u] = n.y;
    verts[o + 6u] = n.z;
    verts[o + 7u] = glow;
}

/**  Appends a boid (two triangles: a body with wings) to the output buffer.
 *
 * @param center   Centre of the boid. (in)
 * @param forward  Its heading (unit length). (in)
 * @param size     Size. (in)
 * @param hue      Per-vertex value written to the buffer (the vertex stage gives it its meaning). (in)
 * @param glow     Per-vertex value written to the buffer (the vertex stage gives it its meaning). (in)
 **/
void emitBoid( vec3 center, vec3 forward, float size, float hue, float glow )
{
    uint base = atomicAdd( cmd[4], 6u );
    if ( base + 6u > maxVertices )
        return;

    vec3 up = vec3( 0.0, 1.0, 0.0 );
    vec3 right = normalize( cross( forward, up ) );
    up = cross( right, forward );

    vec3 tip = center + forward * ( size * 1.5 );
    vec3 tail = center - forward * ( size * 0.8 );
    vec3 left_p = center - right * ( size * 0.6 );
    vec3 rgt_p = center + right * ( size * 0.6 );
    vec3 top_p = center + up * ( size * 0.5 );

    // Two triangles forming a 3D winged creature
    vec3 n1 = normalize( cross( tip - left_p, top_p - left_p ) );
    vec3 n2 = normalize( cross( rgt_p - tip, top_p - rgt_p ) );

    writeVertex( base + 0u, tip, n1, hue, glow );
    writeVertex( base + 1u, left_p, n1, hue, glow );
    writeVertex( base + 2u, top_p, n1, hue, glow );

    writeVertex( base + 3u, tip, n2, hue, glow );
    writeVertex( base + 4u, top_p, n2, hue, glow );
    writeVertex( base + 5u, rgt_p, n2, hue, glow );
}

/** Entry point of this shader stage (the file description says what it draws). */
void main()
{
    uvec3 g = gl_GlobalInvocationID;
    uint  id = g.x + 64u * ( g.y + 64u * g.z );
    if ( id >= SnowBase + Snow )
        return;

    // ---- MARINE SNOW --------------------------------------------------
    if ( id >= SnowBase )
    {
        float fh = float( id - SnowBase );
        vec3  hs3 = hash3( fh + 17.0 );
        float hs = hash1( fh * 3.191 + 2.29 );

        uint sbase = atomicAdd( cmd[4], 6u );
        if ( sbase + 6u > maxVertices )
            return;

        vec2 cn[6] = vec2[6]( vec2( 0.0, 0.0 ), vec2( 1.0, 0.0 ), vec2( 0.0, 1.0 ),
                              vec2( 1.0, 0.0 ), vec2( 1.0, 1.0 ), vec2( 0.0, 1.0 ) );
        for ( uint k = 0u; k < 6u; ++k )
            writeVertex( sbase + k, hs3, vec3( cn[k], hs ), hash1( fh * 1.7 + 0.9 ), -1.0 );
        return;
    }

    float i = float( id );
    vec3  seed = hash3( i );

    float swm = ( swarmP > 0.0 ) ? swarmP : 1.0;
    float spd = ( speedP > 0.0 ) ? speedP : 1.0;
    float glw = ( glowP > 0.0 ) ? glowP : 1.0;

    // Swarm dynamics: Emergent double-torus murmuration
    float orbit_radius = ( 8.0 + seed.x * 16.0 ) * swm;
    float orbit_speed = ( 0.4 + 0.3 * seed.y ) * spd;
    float angle = seed.z * 6.2831853 + time * orbit_speed + audioAdvance * 0.2;

    // 3D Toroidal flow equations
    float phi = seed.x * 6.2831853 + sin( time * 0.5 + seed.y * 3.0 ) * 1.5;
    float torus_r = 3.5 + 1.5 * sin( time * 0.8 + seed.z * 6.28 );

    // The murmuration was only +-7.5 units tall against a camera whose frame
    // is 29 units tall at that distance, so it read as a thin band with black
    // above and below it.  A real murmuration towers.
    vec3 boid_pos = vec3(
        ( orbit_radius + torus_r * cos( phi ) ) * cos( angle ),
        torus_r * sin( phi ) * 1.9 + sin( angle * 2.0 ) * 6.0,
        ( orbit_radius + torus_r * cos( phi ) ) * sin( angle ) );

    // Sudden scatter reaction on audioKick
    vec3 scatter_dir = normalize( seed - 0.5 );
    boid_pos += scatter_dir * audioKick * 4.0;

    // Velocity / Forward facing tangent
    vec3 forward = normalize( vec3(
        -sin( angle ) * ( orbit_radius + torus_r * cos( phi ) ),
        cos( angle * 2.0 ) * 2.0,
        cos( angle ) * ( orbit_radius + torus_r * cos( phi ) ) ) );

    // Audio-reactive bioluminescent emission waves
    int   band = int( clamp( seed.x * 31.0, 0.0, 31.0 ) );
    float spec_pulse = audioSpectrum[band];
    float boid_hue = fract( seed.x * 0.4 + time * 0.05 + audioAdvance * 0.02 );

    // Individual bioluminescent FLASH: sharp attack, exponential decay, on each
    // creature's own slow cycle. Without it every creature sat at the same
    // baseline emission on quiet material -- 4096 identical dim specks, which is
    // a swarm with no light in it (measured luma 0.023, contrast 0.054). The
    // cycle is per-creature, so nothing here is a full-field brightness change;
    // the rate is a constant coefficient on `time`, so it is anti-flicker safe.
    float flash_rate = 0.11 + 0.17 * seed.z;
    float flash_ph = fract( seed.y * 7.31 + time * flash_rate + audioAdvance * 0.05 );
    float flash = exp( -flash_ph * 5.5 ) * 2.4;

    float glow_amp = ( 0.55 + flash + spec_pulse * 2.0 + audioKick * 1.5 ) * glw;

    // Bigger creatures: at the 28-unit camera distance a 0.25-unit diamond is a
    // handful of pixels, so the swarm read as dust rather than as animals.
    float boid_size = 0.40 * ( 0.8 + 0.4 * seed.y );

    emitBoid( boid_pos, forward, boid_size, boid_hue, glow_amp );
}
