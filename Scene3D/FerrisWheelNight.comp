#version 430 core
/**
 * @file FerrisWheelNight.comp
 * @brief FERRIS WHEEL NIGHT: a great wheel at the fair, turning steadily
 * on the scene clock, its cabins (photo-textured) hanging level as the
 * wheel turns, its spokes strung with lamps that run patterns with the
 * spectrum bands (fragment).  No state; the wheel's angle is the clock.
 * The camera stands on the fairground.
 *
 * Per-instance: cabinsP, sizeP, hueP.
 */
layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;
layout(std430, binding = 0) buffer Verts { float verts[]; };
layout(std430, binding = 1) buffer Cmd   { uint cmd[];   };

uniform uint  maxVertices;
uniform float time;
uniform float sceneAdvance;
uniform float sceneTime;

uniform float cabinsP;
uniform float sizeP;
uniform float hueP;

float hash11(float p) { p = fract(p * 0.1031); p *= p + 33.33; p *= p + p; return fract(p); }

void emitQuad(vec3 c, vec3 ax, vec3 ay, float id, float lit, float kind, vec2 uv0, vec2 uv1)
{
    uint base = atomicAdd(cmd[4], 6u);
    if (base + 6u > maxVertices) return;
    vec3 p0 = c - ax - ay, p1 = c + ax - ay, p2 = c + ax + ay, p3 = c - ax + ay;
    vec3 pList[6]  = vec3[6](p0, p1, p2, p0, p2, p3);
    vec2 uvList[6] = vec2[6](vec2(uv0.x, uv0.y), vec2(uv1.x, uv0.y), vec2(uv1.x, uv1.y), vec2(uv0.x, uv0.y), vec2(uv1.x, uv1.y), vec2(uv0.x, uv1.y));
    for (uint i = 0u; i < 6u; ++i)
    {
        uint off = (base + i) * 8u;
        verts[off + 0u] = pList[i].x; verts[off + 1u] = pList[i].y; verts[off + 2u] = pList[i].z;
        verts[off + 3u] = id; verts[off + 4u] = lit; verts[off + 5u] = kind;
        verts[off + 6u] = uvList[i].x; verts[off + 7u] = uvList[i].y;
    }
}

void main()
{
    uvec3 g = gl_GlobalInvocationID;
    uint id = g.x + 64u * (g.y + 64u * g.z);
    uint nCabins = 16u + uint(clamp(cabinsP, 0.0, 1.0) * 8.0);
    float R = 7.5 * (sizeP > 0.05 ? sizeP : 1.0);
    vec3 hub = vec3(0.0, 2.2, 13.0);
    float clock = sceneAdvance * 0.15 + sceneTime * 0.03;
    float rot = clock;

    if (id == 0u)
    {
        emitQuad(vec3(0.0, 4.0, 40.0), vec3(60.0, 0.0, 0.0), vec3(0.0, 34.0, 0.0), 0.0, 0.0, -1.0, vec2(0.0), vec2(1.0));
        // The fairground: a ground quad (kind -2).
        emitQuad(vec3(0.0, hub.y - R - 0.6, 20.0), vec3(60.0, 0.0, 0.0), vec3(0.0, 0.0, 20.0), 0.0, 0.0, -2.0, vec2(0.0), vec2(1.0));
        // The hub and the two A-frame legs (kind 3).
        emitQuad(hub, vec3(0.5, 0.0, 0.0), vec3(0.0, 0.5, 0.0), 0.0, 0.0, 3.0, vec2(0.0), vec2(1.0));
        for (int s = -1; s <= 1; s += 2)
        {
            vec3 foot = vec3(float(s) * R * 0.6, hub.y - R - 0.5, hub.z + 0.3);
            vec3 mid = (hub + foot) * 0.5, half_ = (foot - hub) * 0.5;
            emitQuad(mid, half_, vec3(0.12, 0.0, 0.0), 0.0, 0.0, 3.0, vec2(0.0), vec2(1.0));
        }
        // The rim: 48 segments (kind 4), each carrying lamps (fragment).
        for (int s = 0; s < 48; ++s)
        {
            float a0 = float(s) / 48.0 * 6.2831853 + rot, a1 = float(s + 1) / 48.0 * 6.2831853 + rot;
            vec3 q0 = hub + vec3(cos(a0), sin(a0), 0.0) * R, q1 = hub + vec3(cos(a1), sin(a1), 0.0) * R;
            vec3 mid = (q0 + q1) * 0.5, half_ = (q1 - q0) * 0.5;
            emitQuad(mid, half_, vec3(0.0, 0.0, 0.0) + normalize(vec3(-half_.y, half_.x, 0.0)) * 0.08, float(s), float(s) / 48.0, 4.0, vec2(0.0), vec2(1.0));
        }
        return;
    }
    uint c = id - 1u;
    if (c >= nCabins) return;
    float fc = float(c);
    float a = fc / float(nCabins) * 6.2831853 + rot;
    vec3 rimPt = hub + vec3(cos(a), sin(a), 0.0) * R;
    // The spoke (kind 2): from the hub to the rim point, lamps along it.
    vec3 mid = (hub + rimPt) * 0.5, half_ = (rimPt - hub) * 0.5;
    emitQuad(mid, half_, normalize(vec3(-half_.y, half_.x, 0.0)) * 0.05, fc, a, 2.0, vec2(0.0), vec2(1.0));
    // The cabin (kind 0): hangs level below the rim point, the photo on it.
    vec3 cab = rimPt + vec3(0.0, -0.45, 0.0);
    emitQuad(cab, vec3(0.42, 0.0, 0.0), vec3(0.0, 0.32, 0.0), fc, hash11(fc * 3.3), 0.0, vec2(hash11(fc * 5.1) * 0.8, 0.0), vec2(hash11(fc * 5.1) * 0.8 + 0.2, 0.25));
    // The hanger (kind 3): a short bar from the rim to the cabin roof.
    emitQuad(rimPt + vec3(0.0, -0.1, 0.0), vec3(0.03, 0.0, 0.0), vec3(0.0, 0.1, 0.0), fc, 0.0, 3.0, vec2(0.0), vec2(1.0));
}
