#version 430
/**
 * @file SpectrumCity.comp
 * @brief Compute kernel that procedurally builds a night-city skyline whose
 * building heights encode the music's recent spectrogram history, emitting
 * finished box geometry (four walls plus a roof, no floor) into a shared
 * vertex buffer.
 *
 * One thread handles one potential building lot on a COLS x ROWS grid: a
 * lot's distance from the central avenue maps to frequency, its row maps to
 * a time offset into the scrolling spectrogram ring (sampled from
 * texSpectro at spectroHead, which advances continuously so the skyline
 * flows toward the camera), and the sampled band energy sets the tower's
 * height (scaled by heightP, punched by audioKick). densityP and avenueP
 * gate which lots are built on and how wide the central corridor is, and
 * sceneSeed reseeds the per-lot hash so each activation gets a different
 * layout. The emitted vertices are consumed by an indirect draw and shaded
 * by SpectrumCity.vert/.frag.
 */
// SpectrumCity.comp — a night city whose skyline is the music's history.
// -----------------------------------------------------------------------
// One thread per building lot.  Depth into the scene is TIME (rows of the
// spectrogram ring), distance from the avenue is FREQUENCY, and a building's
// height is the energy that band had when that row was written.  Because
// spectroHead advances continuously, the whole skyline flows toward the
// camera: a bar of music arrives at the horizon and marches down the avenue as
// a wave of rising and falling towers.
//
// The lots never move, which is what makes the shading possible: the fragment
// shader needs a stable per-building identity for its window pattern, and it
// gets one because the geometry is fixed and only the heights animate.
//
// A box needs a normal per face, but the vertex format has only two spare
// floats after position/uv/height, so the face is written as an INDEX and the
// normal is reconstructed in the vertex shader.  Box faces are axis-aligned, so
// that costs nothing in accuracy.
// -----------------------------------------------------------------------
/// Layout qualifiers of this stage (work-group size, or the primitive in or out).
layout( local_size_x = 4, local_size_y = 4, local_size_z = 4 ) in;

/// The output vertex buffer: eight floats per vertex (attribute A, attribute B) that the scene draws.
layout( std430, binding = 0 ) buffer Verts
{
    float verts[];
};
/// The indirect draw command: [0] the vertex count (counted up atomically), then the other draw arguments.
layout( std430, binding = 1 ) buffer Cmd
{
    uint cmd[];
};

uniform uint  maxVertices;  ///< Capacity of the vertex buffer (compute stage).
uniform float time;         ///< Seconds since the program started (never reset; see sceneTime).
uniform float sceneSeed;    ///< A random number fixed per activation.
uniform float audioAdvance; ///< The music's advance: integrated tempo-weighted energy (never jumps, never runs
                            ///< backwards).
uniform float audioLevel;   ///< Overall loudness, 0..1.
uniform float audioKick;    ///< Kick-drum envelope, 0..1 (fast attack, short decay).
uniform float audioSubBass; ///< Sub-bass band level, 0..1.

uniform sampler2D texSpectro;  ///< Spectrogram ring: band energies (x) over time (y).
uniform float     spectroHead; ///< T coordinate of "now", continuous
uniform float     spectroFill; ///< How full the spectrogram ring texSpectro is, 0..1 (after a scene start).

uniform float heightP;  ///< preset: tower height
uniform float densityP; ///< preset: how many lots are actually built on
uniform float avenueP;  ///< preset: width of the central avenue

const int   Cols = 40;      ///< lots across
const int   Rows = 46;      ///< lots into the distance
const float Spacing = 7.0;  ///< Spacing between neighbouring objects (world units).
const float Foot = 4.6;     ///< building footprint (the rest is street)
const float AgeSpan = 0.82; ///< how much of the ring the city spans

/**  Pseudo-random number 0..1 from a 2D point.
 *
 * @param p  The input. (in)
 *
 * @return
 *   A pseudo-random number 0..1.
 **/
float hash1( vec2 p )
{
    return fract( sin( dot( p, vec2( 41.317, 289.113 ) ) ) * 43758.5453 );
}

/**  Writes one vertex into the output buffer (compute stage).
 *
 * @param slot      Index of the vertex in the buffer. (in)
 * @param p         Position. (in)
 * @param faceU     Per-vertex value written to the buffer (the vertex stage gives it its meaning). (in)
 * @param faceIdx   Per-vertex value written to the buffer (the vertex stage gives it its meaning). (in)
 * @param upAmount  Per-vertex value written to the buffer (the vertex stage gives it its meaning). (in)
 * @param lotHash   Per-vertex value written to the buffer (the vertex stage gives it its meaning). (in)
 * @param energy    Per-vertex value written to the buffer (the vertex stage gives it its meaning). (in)
 **/
void writeVertex( uint slot, vec3 p, float faceU, float faceIdx,
                  float upAmount, float lotHash, float energy )
{
    uint o = slot * 8u;
    verts[o + 0u] = p.x;
    verts[o + 1u] = p.y;
    verts[o + 2u] = p.z;
    verts[o + 3u] = faceU;
    verts[o + 4u] = faceIdx;
    verts[o + 5u] = upAmount; // height above ground, in world units
    verts[o + 6u] = lotHash;
    verts[o + 7u] = energy;
}

/**  Appends a camera-facing quad (two triangles) to the output buffer (compute stage).
 *
 * @param a        First corner (the corners run around the quad). (in)
 * @param b        Second corner. (in)
 * @param c        Third corner. (in)
 * @param d        Fourth corner. (in)
 * @param wa       Per-vertex value written to the buffer (the vertex stage gives it its meaning). (in)
 * @param wb       Per-vertex value written to the buffer (the vertex stage gives it its meaning). (in)
 * @param face     Per-vertex value written to the buffer (the vertex stage gives it its meaning). (in)
 * @param h0       Per-vertex value written to the buffer (the vertex stage gives it its meaning). (in)
 * @param h1       Per-vertex value written to the buffer (the vertex stage gives it its meaning). (in)
 * @param lotHash  Per-vertex value written to the buffer (the vertex stage gives it its meaning). (in)
 * @param energy   Per-vertex value written to the buffer (the vertex stage gives it its meaning). (in)
 **/
void emitQuad( vec3 a, vec3 b, vec3 c, vec3 d, float wa, float wb,
               float face, float h0, float h1, float lotHash, float energy )
{
    uint base = atomicAdd( cmd[4], 6u );
    if ( base + 6u > maxVertices )
        return;
    writeVertex( base + 0u, a, wa, face, h0, lotHash, energy );
    writeVertex( base + 1u, b, wb, face, h0, lotHash, energy );
    writeVertex( base + 2u, c, wb, face, h1, lotHash, energy );
    writeVertex( base + 3u, a, wa, face, h0, lotHash, energy );
    writeVertex( base + 4u, c, wb, face, h1, lotHash, energy );
    writeVertex( base + 5u, d, wa, face, h1, lotHash, energy );
}

/** Entry point of this shader stage (the file description says what it draws). */
void main()
{
    uvec3 g = gl_GlobalInvocationID;
    uint  id = g.x + 64u * ( g.y + 64u * g.z );
    if ( id >= uint( Cols * Rows ) )
        return;

    int i = int( id ) % Cols; // across  -> frequency
    int j = int( id ) / Cols; // into the scene -> time

    vec2  lot = vec2( float( i ), float( j ) );
    float h1r = hash1( lot + sceneSeed * 13.0 );
    float h2r = hash1( lot + sceneSeed * 13.0 + 57.0 );

    // Empty lots, so the city has squares and gaps instead of a solid slab.
    if ( h1r > densityP )
        return;

    float cx = ( float( i ) - float( Cols - 1 ) * 0.5 ) * Spacing;
    float cz = float( j ) * Spacing + 6.0;

    // The avenue: a clear corridor straight down the middle of the frame,
    // which is what turns a field of boxes into a street you look along.
    if ( abs( cx ) < avenueP * Spacing * 1.5 )
        return;

    // Frequency from distance to the avenue, so the bass towers flank the view
    // and the treble runs off to the sides.
    float freq = clamp( abs( cx ) / ( float( Cols ) * 0.5 * Spacing ), 0.0, 1.0 );
    freq = 1.0 - freq; // 0 at the edges -> bass near the avenue

    // Frequency is symmetric about the avenue, so without this the two sides of
    // the street would be exact mirror images of each other.  Offsetting one
    // side by a fraction of a bar keeps the structure and kills the symmetry.
    float t = spectroHead - ( float( j ) / float( Rows ) ) * AgeSpan
              - ( ( cx > 0.0 ) ? 0.045 : 0.0 );
    float e = texture( texSpectro, vec2( freq, fract( t ) ) ).r;
    e *= smoothstep( 0.0, 0.12, spectroFill );

    float base = 2.0 + 9.0 * h2r; // every city has a low-rise floor
    float h = base + e * heightP * 46.0 * ( 0.55 + 0.75 * h2r );
    h *= 1.0 + 0.10 * audioKick;

    // NOT "half": that is a reserved GLSL keyword and the compiler rejects it
    // with a bare syntax error that names the token and nothing else.
    float half_w = Foot * 0.5 * ( 0.72 + 0.5 * h2r );
    float x0 = cx - half_w, x1 = cx + half_w;
    float z0 = cz - half_w, z1 = cz + half_w;
    float w = half_w * 2.0;

    // Four walls + a roof.  No floor: nothing can ever see it.
    //   face 0 = +x, 1 = -x, 2 = +z, 3 = -z, 4 = +y
    emitQuad( vec3( x1, 0.0, z0 ), vec3( x1, 0.0, z1 ), vec3( x1, h, z1 ), vec3( x1, h, z0 ),
              0.0, w, 0.0, 0.0, h, h1r, e );
    emitQuad( vec3( x0, 0.0, z1 ), vec3( x0, 0.0, z0 ), vec3( x0, h, z0 ), vec3( x0, h, z1 ),
              0.0, w, 1.0, 0.0, h, h1r, e );
    emitQuad( vec3( x1, 0.0, z1 ), vec3( x0, 0.0, z1 ), vec3( x0, h, z1 ), vec3( x1, h, z1 ),
              0.0, w, 2.0, 0.0, h, h1r, e );
    emitQuad( vec3( x0, 0.0, z0 ), vec3( x1, 0.0, z0 ), vec3( x1, h, z0 ), vec3( x0, h, z0 ),
              0.0, w, 3.0, 0.0, h, h1r, e );
    emitQuad( vec3( x0, h, z0 ), vec3( x1, h, z0 ), vec3( x1, h, z1 ), vec3( x0, h, z1 ),
              0.0, w, 4.0, h, h, h1r, e );
}
