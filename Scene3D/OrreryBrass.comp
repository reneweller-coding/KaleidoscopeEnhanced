#version 430 core
/**
 * @file OrreryBrass.comp
 * @brief ORRERY BRASS: a mechanical solar system in brass -- the sun lamp
 * at the centre, planets on arms turning at their Kepler rates on the
 * scene clock, moons on their own little arms, the arms and the base ring
 * engraved.  Every position is a function of the clock (no state); the
 * photo is wrapped on the planet spheres (fragment).  Camera fixed above
 * the table, looking down at an angle.
 *
 * Per-instance: planetsP, tiltP, hueP.
 */
layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;
layout(std430, binding = 0) buffer Verts { float verts[]; };
layout(std430, binding = 1) buffer Cmd   { uint cmd[];   };

uniform uint  maxVertices;
uniform float time;
uniform float sceneAdvance;
uniform float sceneTime;

uniform float planetsP;
uniform float tiltP;
uniform float hueP;

float hash11(float p) { p = fract(p * 0.1031); p *= p + 33.33; p *= p + p; return fract(p); }

void emitQuad(vec3 c, vec3 ax, vec3 ay, float id, float lit, float kind, vec2 uv0, vec2 uv1)
{
    uint base = atomicAdd(cmd[4], 6u);
    if (base + 6u > maxVertices) return;
    vec3 p0 = c - ax - ay, p1 = c + ax - ay, p2 = c + ax + ay, p3 = c - ax + ay;
    vec3 pList[6]  = vec3[6](p0, p1, p2, p0, p2, p3);
    vec2 uvList[6] = vec2[6](vec2(uv0.x, uv0.y), vec2(uv1.x, uv0.y), vec2(uv1.x, uv1.y), vec2(uv0.x, uv0.y), vec2(uv1.x, uv1.y), vec2(uv0.x, uv1.y));
    for (uint i = 0u; i < 6u; ++i)
    {
        uint off = (base + i) * 8u;
        verts[off + 0u] = pList[i].x; verts[off + 1u] = pList[i].y; verts[off + 2u] = pList[i].z;
        verts[off + 3u] = id; verts[off + 4u] = lit; verts[off + 5u] = kind;
        verts[off + 6u] = uvList[i].x; verts[off + 7u] = uvList[i].y;
    }
}

// Table space -> world: the table plane tilted toward the camera.
vec3 toWorld(vec3 t, float tilt)
{
    float c = cos(tilt), s = sin(tilt);
    vec3 r = vec3(t.x, t.y * c + t.z * s, -t.y * s + t.z * c);   // table normal (0, c, -s): up and toward the camera
    return r + vec3(0.0, -0.8, 9.5);
}

void main()
{
    uvec3 g = gl_GlobalInvocationID;
    uint id = g.x + 64u * (g.y + 64u * g.z);
    uint nPlanets = 4u + uint(clamp(planetsP, 0.0, 1.0) * 4.0);
    float tilt = 0.9 + 0.4 * clamp(tiltP, 0.0, 1.0);
    float clock = sceneAdvance * 0.3 + sceneTime * 0.06;
    // Table space: y up (out of the table), xz the table plane.

    if (id == 0u)
    {
        emitQuad(vec3(0.0, 3.0, 30.0), vec3(50.0, 0.0, 0.0), vec3(0.0, 28.0, 0.0), 0.0, 0.0, -1.0, vec2(0.0), vec2(1.0));
        // The base: a large brass disc (kind 2) on the table, and the sun lamp (kind 3).
        vec3 c = toWorld(vec3(0.0, 0.0, 0.0), tilt);
        vec3 ax = vec3(5.4, 0.0, 0.0);
        vec3 ay = toWorld(vec3(0.0, 0.0, 5.4), tilt) - c;
        emitQuad(c, ax, ay, 0.0, 0.0, 2.0, vec2(0.0), vec2(1.0));
        vec3 sun = toWorld(vec3(0.0, 0.5, 0.0), tilt);
        emitQuad(sun, vec3(0.6, 0.0, 0.0), vec3(0.0, 0.6, 0.0), 0.0, 0.0, 3.0, vec2(0.0), vec2(1.0));
        // The central column.
        emitQuad(toWorld(vec3(0.0, 0.25, 0.0), tilt), vec3(0.06, 0.0, 0.0), vec3(0.0, 0.25, 0.0), 0.0, 0.0, 4.0, vec2(0.0), vec2(1.0));
        return;
    }
    uint pl = (id - 1u) / 8u;
    uint part = (id - 1u) % 8u;
    if (pl >= nPlanets) return;
    float fp = float(pl);
    float a = 1.1 + fp * 0.55;                                   // orbit radius
    float period = pow(a, 1.5);                                  // Kepler
    float ang = clock * 2.0 / period + hash11(fp * 3.3) * 6.28;
    float h = 0.45 + fp * 0.05;                                  // arm height above the base
    vec3 planetT = vec3(cos(ang) * a, h, sin(ang) * a);
    float rad = 0.2 + 0.14 * hash11(fp * 5.7);
    if (part == 0u)
    {
        // The planet: a billboard sphere (kind 0), the photo on it.
        emitQuad(toWorld(planetT, tilt), vec3(rad, 0.0, 0.0), vec3(0.0, rad, 0.0), fp, ang, 0.0, vec2(0.0), vec2(1.0));
        return;
    }
    if (part == 1u)
    {
        // The arm: a thin brass bar from the column to the planet (kind 4).
        vec3 a0 = toWorld(vec3(0.0, h, 0.0), tilt), a1 = toWorld(vec3(cos(ang) * (a - rad), h, sin(ang) * (a - rad)), tilt);
        vec3 mid = (a0 + a1) * 0.5, half_ = (a1 - a0) * 0.5;
        vec3 side = normalize(cross(half_, normalize(-mid))) * 0.02;
        emitQuad(mid, half_, side, fp, 0.0, 4.0, vec2(0.0), vec2(1.0));
        return;
    }
    if (part == 2u)
    {
        // The orbit ring on the base: a thin circle (24 segments) -- this
        // invocation draws the whole ring cheaply as 24 quads.
        for (int s = 0; s < 24; ++s)
        {
            float b0 = float(s) / 24.0 * 6.2831853, b1 = float(s + 1) / 24.0 * 6.2831853;
            vec3 q0 = toWorld(vec3(cos(b0) * a, 0.02, sin(b0) * a), tilt), q1 = toWorld(vec3(cos(b1) * a, 0.02, sin(b1) * a), tilt);
            vec3 mid = (q0 + q1) * 0.5, half_ = (q1 - q0) * 0.5;
            vec3 side = normalize(cross(half_, normalize(-mid))) * 0.012;
            emitQuad(mid, half_, side, fp, 0.0, 5.0, vec2(0.0), vec2(1.0));
        }
        return;
    }
    // Moons: parts 3..7 are up to (1 + pl/2) moons on short arms (kind 1).
    uint moonIdx = part - 3u;
    uint nMoons = (pl >= 2u) ? min(1u + pl / 2u, 4u) : 0u;
    if (moonIdx >= nMoons) return;
    float fm = float(moonIdx);
    float ma = 0.34 + 0.12 * fm;
    float mang = clock * 6.0 / pow(ma * 3.0, 1.5) + fm * 2.0;
    vec3 moonT = planetT + vec3(cos(mang) * ma, 0.02, sin(mang) * ma);
    emitQuad(toWorld(moonT, tilt), vec3(0.06, 0.0, 0.0), vec3(0.0, 0.06, 0.0), fp * 4.0 + fm, 0.0, 1.0, vec2(0.0), vec2(1.0));
}
