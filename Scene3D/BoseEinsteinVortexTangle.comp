#version 430 core
/**
 * @file BoseEinsteinVortexTangle.comp
 * @brief Compute stage companion to BoseEinsteinVortexTangle.frag -- see that file's header for
 * this scene's description.
 */
// BoseEinsteinVortexTangle.comp — quantized vortex filaments in a BEC.
// -----------------------------------------------------------------------
// Emits ONE SMALL BILLBOARD QUAD (2 triangles, 6 vertices) per tangle point.
// The geom="indirect" path always issues glDrawArraysIndirect(GL_TRIANGLES),
// so a generator that writes one loose vertex per unit produces nothing
// usable -- the points have to be widened into real triangles here.
//
// The draw count MUST be published through atomicAdd(cmd[4], n): the shared
// Blend/IndirectClamp.comp runs after every generator and overwrites cmd[0]
// with min(cmd[4], maxVertices), so a generator that writes cmd[0] itself has
// its count zeroed and draws nothing.
// -----------------------------------------------------------------------
layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

layout(std430, binding = 0) buffer Verts { float verts[]; };
layout(std430, binding = 1) buffer Cmd   { uint  cmd[];   };

uniform uint  maxVertices;
uniform float time;
uniform float audioAdvance;
uniform float audioKick;
uniform float audioBass;
uniform float audioHigh;
uniform float becP;
uniform float vortexP;
uniform float speedP;

// The scene projection: 55 deg vertical FOV (see Scene3DShader::draw), and the
// camera distance the companion .vert applies.  A generator program gets no
// `resolution` uniform, so the layout assumes 16:9 -- the house fallback.
const float kTanY   = 0.5206;
const float kAspect = 1.7778;
const float kCam    = 6.4;

// The tangle used to be a cylinder barely 2 units across at 4.6 units out --
// a small knot floating in the middle of a frustum three times its size
// (measured occ 0.22).  More strands, over a far wider volume, plus a
// condensate speckle spread across the frustum to carry the corners.
const uint STRANDS   = 96u;
const uint PER_STR   = 128u;
const uint TANGLE    = STRANDS * PER_STR;    // 12288
const uint HAZE      = 6000u;
const uint POINTS    = TANGLE + HAZE;        // 18288 quads = 109728 vertices

float hash11(float p) {
    p = fract(p * 0.1031);
    p *= p + 33.33;
    p *= p + p;
    return fract(p);
}

// attrA = (pos.xyz, 1.0), attrB = (normal.xyz, phase) -- the 8-float stride
// Scene3DShader binds as attrA/attrB.
// corner: 0=(-1,-1) 1=(1,-1) 2=(1,1) 3=(-1,1).  The fragment shader needs a
// quad-local coordinate for its round sprite falloff -- gl_PointCoord is NOT
// available here because geom="indirect" draws GL_TRIANGLES, not GL_POINTS.
void writeVertex(uint slot, vec3 p, vec3 n, float phase, float corner)
{
    uint o = slot * 8u;
    verts[o + 0u] = p.x;  verts[o + 1u] = p.y;  verts[o + 2u] = p.z;
    verts[o + 3u] = corner;
    verts[o + 4u] = n.x;  verts[o + 5u] = n.y;  verts[o + 6u] = n.z;
    verts[o + 7u] = phase;
}

// A billboard sprite.  All six vertices carry the CENTRE and the sprite radius
// (packed into attrB.x); the vertex stage spreads the corners out in VIEW space
// after the camera transform, so the sprite faces the lens at every point of
// the orbit.
//
// Widening the quad HERE, in world space, only faced the camera while the view
// axis was still +z: the .vert yaws the whole tangle about y, and a quarter
// turn later every one of these XY quads was exactly edge-on and the scene
// drew nothing at all.  attrB.y carries the layer marker (negative = the
// surrounding thermal cloud).
void emitQuad(vec3 c, vec3 n, float phase, float r)
{
    uint base = atomicAdd(cmd[4], 6u);
    if (base + 6u > maxVertices) return;

    vec3 nn = vec3(r, n.z, 0.0);
    writeVertex(base + 0u, c, nn, phase, 0.0);
    writeVertex(base + 1u, c, nn, phase, 1.0);
    writeVertex(base + 2u, c, nn, phase, 2.0);
    writeVertex(base + 3u, c, nn, phase, 0.0);
    writeVertex(base + 4u, c, nn, phase, 2.0);
    writeVertex(base + 5u, c, nn, phase, 3.0);
}

void main() {
    uvec3 g = gl_GlobalInvocationID;
    uint idx = g.x + 64u * (g.y + 64u * g.z);
    if (idx >= POINTS) return;

    float t = time * 0.45 * (speedP > 0.0 ? speedP : 1.0) + audioAdvance * 0.22;

    // ------------------------------------------------------------------
    // CONDENSATE SPECKLE -- the thermal cloud the tangle is embedded in,
    // spread evenly over the FRUSTUM so no corner of the picture is empty.
    // Dimmer than the vortex cores (the fragment stage reads the negative
    // normal.z as the marker).
    // ------------------------------------------------------------------
    if (idx >= TANGLE) {
        float fi = float(idx - TANGLE);
        float h0 = hash11(fi * 1.731 + 0.13);
        float h1 = hash11(fi * 3.917 + 4.71);
        float h2 = hash11(fi * 7.311 + 9.27);
        float h3 = hash11(fi * 5.109 + 2.53);

        float dz    = 2.6 + 13.0 * h0;
        float halfH = dz * kTanY;
        float halfW = halfH * kAspect;
        // 1.0 fits the frustum exactly; 1.08 keeps the field just past all four
        // edges.
        float ph = h3 * 6.2831853 + t * 0.18;
        vec3 vp = vec3((h1 * 2.0 - 1.0) * halfW * 1.08 + 0.35 * cos(ph),
                       (h2 * 2.0 - 1.0) * halfH * 1.08 + 0.35 * sin(ph * 0.83),
                       dz);

        // The vertex stage orbits everything it is given (yaw about y, then a
        // nodding pitch) before pushing it out to kCam.  A cloud laid out in
        // view coordinates would be swung straight out of the frustum by that
        // orbit -- so undo it here.  The generator is handed the very same
        // `time` and `audioAdvance` the render program gets (Scene3DShader
        // uploads m_timeOffset + time*m_speedFactor to both), so the two
        // rotations cancel exactly.
        float yaw = time * 0.14 + audioAdvance * 0.07;
        float cy = cos(yaw), sy = sin(yaw);
        float pit = 0.35 * sin(time * 0.11);
        float cp = cos(pit), sp = sin(pit);

        // mat2(a,b,c,d) is COLUMN-major, so the .vert's two mat2s are R(-yaw)
        // and R(-pit); undo the pitch first, then the yaw.
        vec3 q = vec3(vp.x, vp.y, vp.z - kCam);
        q = vec3(q.x, cp * q.y - sp * q.z, sp * q.y + cp * q.z);   // pitch^-1
        q = vec3(cy * q.x - sy * q.z, q.y, sy * q.x + cy * q.z);   // yaw^-1

        float r = halfH * 0.011 * (0.55 + 0.9 * h3) * (1.0 + 0.3 * audioHigh);
        emitQuad(q, vec3(0.0, 0.0, -1.0), h1, r);
        return;
    }

    float pNorm = float(idx) / float(TANGLE);

    // 96 vortex strands
    uint strandID = idx / PER_STR;
    float zNorm = float(idx % PER_STR) / float(PER_STR);
    float z = (zNorm - 0.5) * 8.0;

    float angle = float(strandID) * (6.2831853 / float(STRANDS));
    // The strand radii now span the frustum's height rather than a 1-unit
    // cylinder; the sin() term still keeps the shells irregular.
    float rBase = (2.2 + 1.9 * sin(float(strandID) * 1.5)) * (becP > 0.0 ? becP : 1.0);

    // Quantized vortex tangle dynamics: helical rotation + reconnection kinks
    float helix = sin(z * 2.2 * (vortexP > 0.0 ? vortexP : 1.0) - t * 4.0 + float(strandID));
    float helixCos = cos(z * 2.2 * (vortexP > 0.0 ? vortexP : 1.0) - t * 4.0 + float(strandID));
    float kink = sin(z * 6.5 + t * 6.0) * (0.30 + 0.18 * audioKick);

    float x = cos(angle + t * 0.5) * rBase + helix * 0.75 + kink;
    float y = sin(angle + t * 0.5) * rBase + helixCos * 0.75 + kink;

    vec3 pos = vec3(x, y, z);
    vec3 normal = normalize(vec3(helix, helixCos, 0.5));

    // Core radius swells with the low end and snaps on kicks.  0.020 projected
    // to under three pixels at this distance -- the cores read as dust.
    float r = 0.055 * (1.0 + 0.9 * audioBass + 1.4 * audioKick + 0.5 * audioHigh);
    emitQuad(pos, normal, pNorm, r);
}
