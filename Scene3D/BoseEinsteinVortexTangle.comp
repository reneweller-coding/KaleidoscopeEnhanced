#version 430 core
/**
 * @file BoseEinsteinVortexTangle.comp
 * @brief Compute stage companion to BoseEinsteinVortexTangle.frag -- see that file's header for
 * this scene's description.
 */
// BoseEinsteinVortexTangle.comp — quantized vortex filaments in a BEC.
// -----------------------------------------------------------------------
// Emits ONE SMALL BILLBOARD QUAD (2 triangles, 6 vertices) per tangle point.
// The geom="indirect" path always issues glDrawArraysIndirect(GL_TRIANGLES),
// so a generator that writes one loose vertex per unit produces nothing
// usable -- the points have to be widened into real triangles here.
//
// The draw count MUST be published through atomicAdd(cmd[4], n): the shared
// Blend/IndirectClamp.comp runs after every generator and overwrites cmd[0]
// with min(cmd[4], maxVertices), so a generator that writes cmd[0] itself has
// its count zeroed and draws nothing.
// -----------------------------------------------------------------------
layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

layout(std430, binding = 0) buffer Verts { float verts[]; };
layout(std430, binding = 1) buffer Cmd   { uint  cmd[];   };

uniform uint  maxVertices;
uniform float time;
uniform float audioAdvance;
uniform float audioKick;
uniform float audioBass;
uniform float audioHigh;
uniform float becP;
uniform float vortexP;
uniform float speedP;

const uint POINTS = 4096u;      // 64 strands x 64 points

// attrA = (pos.xyz, 1.0), attrB = (normal.xyz, phase) -- the 8-float stride
// Scene3DShader binds as attrA/attrB.
// corner: 0=(-1,-1) 1=(1,-1) 2=(1,1) 3=(-1,1).  The fragment shader needs a
// quad-local coordinate for its round sprite falloff -- gl_PointCoord is NOT
// available here because geom="indirect" draws GL_TRIANGLES, not GL_POINTS.
void writeVertex(uint slot, vec3 p, vec3 n, float phase, float corner)
{
    uint o = slot * 8u;
    verts[o + 0u] = p.x;  verts[o + 1u] = p.y;  verts[o + 2u] = p.z;
    verts[o + 3u] = corner;
    verts[o + 4u] = n.x;  verts[o + 5u] = n.y;  verts[o + 6u] = n.z;
    verts[o + 7u] = phase;
}

// A camera-facing quad: the scene camera looks down -z, so an XY-plane quad
// always faces it without needing a view matrix in here.
void emitQuad(vec3 c, vec3 n, float phase, float r)
{
    uint base = atomicAdd(cmd[4], 6u);
    if (base + 6u > maxVertices) return;

    vec3 a = c + vec3(-r, -r, 0.0);
    vec3 b = c + vec3( r, -r, 0.0);
    vec3 d = c + vec3( r,  r, 0.0);
    vec3 e = c + vec3(-r,  r, 0.0);

    writeVertex(base + 0u, a, n, phase, 0.0);
    writeVertex(base + 1u, b, n, phase, 1.0);
    writeVertex(base + 2u, d, n, phase, 2.0);
    writeVertex(base + 3u, a, n, phase, 0.0);
    writeVertex(base + 4u, d, n, phase, 2.0);
    writeVertex(base + 5u, e, n, phase, 3.0);
}

void main() {
    uvec3 g = gl_GlobalInvocationID;
    uint idx = g.x + 64u * (g.y + 64u * g.z);
    if (idx >= POINTS) return;

    float pNorm = float(idx) / float(POINTS);
    float t = time * 0.45 * (speedP > 0.0 ? speedP : 1.0) + audioAdvance * 0.22;

    // 64 vortex strands with 64 points each
    uint strandID = idx / 64u;
    float zNorm = float(idx % 64u) / 64.0;
    float z = (zNorm - 0.5) * 4.5;

    float angle = float(strandID) * 0.09817477; // 2pi / 64
    float rBase = (0.6 + 0.4 * sin(float(strandID) * 1.5)) * (becP > 0.0 ? becP : 1.0);

    // Quantized vortex tangle dynamics: helical rotation + reconnection kinks
    float helix = sin(z * 4.0 * (vortexP > 0.0 ? vortexP : 1.0) - t * 4.0 + float(strandID));
    float helixCos = cos(z * 4.0 * (vortexP > 0.0 ? vortexP : 1.0) - t * 4.0 + float(strandID));
    float kink = sin(z * 12.0 + t * 6.0) * (0.08 + 0.05 * audioKick);

    float x = cos(angle + t * 0.5) * rBase + helix * 0.25 + kink;
    float y = sin(angle + t * 0.5) * rBase + helixCos * 0.25 + kink;

    vec3 pos = vec3(x, y, z);
    vec3 normal = normalize(vec3(helix, helixCos, 0.5));

    // Core radius swells with the low end and snaps on kicks.
    float r = 0.020 * (1.0 + 0.9 * audioBass + 1.4 * audioKick + 0.5 * audioHigh);
    emitQuad(pos, normal, pNorm, r);
}
