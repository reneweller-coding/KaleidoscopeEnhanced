#version 430 core
/**
 * @file OpticalLatticeAtoms.comp
 * @brief OPTICAL LATTICE ATOMS: ultracold atoms held in the standing-wave
 * lattice of crossed laser beams -- an egg-crate of light with one glowing
 * atom per site.  The atoms tunnel: each oscillates between its site and
 * a neighbour on its own continuous phase (a cosine, never a jump); the
 * lattice depth (the swell) sets how far they stray; the lattice beams
 * cross the volume as faint red lines.  The camera never moves.
 *
 * Audio Reactivity (generator stage):
 *   sceneAdvance -> tunnelling oscillations (continuous)
 *   audioSwell   -> lattice depth: less stray when deep (slow)
 *
 * Per-instance: pitchP (site spacing), fillP (filling fraction), hueP.
 */
layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;
layout(std430, binding = 0) buffer Verts { float verts[]; };
layout(std430, binding = 1) buffer Cmd   { uint cmd[];   };

uniform uint  maxVertices;
uniform float time;
uniform float sceneAdvance;
uniform float sceneTime;
uniform float audioSwell;

uniform float pitchP;
uniform float fillP;
uniform float hueP;

float hash11(float p) { p = fract(p * 0.1031); p *= p + 33.33; p *= p + p; return fract(p); }
vec3  hash31(float n) { return vec3(hash11(n), hash11(n + 17.3), hash11(n + 41.7)); }

void emitQuad(vec3 c, vec3 ax, vec3 ay, float id, float lit, float kind, vec2 uv0, vec2 uv1)
{
    uint base = atomicAdd(cmd[4], 6u);
    if (base + 6u > maxVertices) return;
    vec3 p0 = c - ax - ay, p1 = c + ax - ay, p2 = c + ax + ay, p3 = c - ax + ay;
    vec3 pList[6]  = vec3[6](p0, p1, p2, p0, p2, p3);
    vec2 uvList[6] = vec2[6](vec2(uv0.x, uv0.y), vec2(uv1.x, uv0.y), vec2(uv1.x, uv1.y), vec2(uv0.x, uv0.y), vec2(uv1.x, uv1.y), vec2(uv0.x, uv1.y));
    for (uint i = 0u; i < 6u; ++i)
    {
        uint off = (base + i) * 8u;
        verts[off + 0u] = pList[i].x; verts[off + 1u] = pList[i].y; verts[off + 2u] = pList[i].z;
        verts[off + 3u] = id; verts[off + 4u] = lit; verts[off + 5u] = kind;
        verts[off + 6u] = uvList[i].x; verts[off + 7u] = uvList[i].y;
    }
}

void main()
{
    uvec3 g = gl_GlobalInvocationID;
    uint id = g.x + 64u * (g.y + 64u * g.z);
    const uint NX = 14u, NY = 9u, NZ = 6u;
    float pitch = 0.9 + 0.5 * clamp(pitchP, 0.0, 1.0);
    vec3 origin = vec3(-float(NX - 1u) * 0.5 * pitch, -float(NY - 1u) * 0.5 * pitch, 8.0);
    float clock = sceneAdvance * 0.8 + sceneTime * 0.2;
    float depth = clamp(audioSwell, 0.0, 1.0);

    if (id == 0u)
    {
        emitQuad(vec3(0.0, 0.0, 30.0), vec3(50.0, 0.0, 0.0), vec3(0.0, 28.0, 0.0), 0.0, 0.0, -1.0, vec2(0.0), vec2(1.0));
        // Lattice beams (kind 2): lines along x for each (y,z) row and along y for each (x,z) column.
        for (uint j = 0u; j < NY; ++j) for (uint k = 0u; k < NZ; ++k)
        {
            vec3 c = origin + vec3(float(NX - 1u) * 0.5 * pitch, float(j) * pitch, float(k) * pitch);
            emitQuad(c, vec3(float(NX) * 0.55 * pitch, 0.0, 0.0), vec3(0.0, 0.03, 0.0), 0.0, 0.0, 2.0, vec2(0.0), vec2(1.0));
        }
        for (uint i = 0u; i < NX; ++i) for (uint k = 0u; k < NZ; ++k)
        {
            vec3 c = origin + vec3(float(i) * pitch, float(NY - 1u) * 0.5 * pitch, float(k) * pitch);
            emitQuad(c, vec3(0.03, 0.0, 0.0), vec3(0.0, float(NY) * 0.55 * pitch, 0.0), 0.0, 0.0, 2.0, vec2(0.0), vec2(1.0));
        }
        return;
    }
    uint site = id - 1u;
    if (site >= NX * NY * NZ) return;
    uint ix = site % NX; uint iy = (site / NX) % NY; uint iz = site / (NX * NY);
    float fs = float(site);
    vec3 h = hash31(fs * 3.7 + 1.0);
    float fill = 0.5 + 0.5 * clamp(fillP, 0.0, 1.0);
    if (h.x > fill) return;                                     // empty site (fixed per activation)
    vec3 sitePos = origin + vec3(float(ix), float(iy), float(iz)) * pitch;
    // Tunnelling: a cosine oscillation toward one neighbour direction; the
    // amplitude shrinks when the lattice is deep (high swell).
    vec3 dirs[6] = vec3[6](vec3(1, 0, 0), vec3(-1, 0, 0), vec3(0, 1, 0), vec3(0, -1, 0), vec3(0, 0, 1), vec3(0, 0, -1));
    vec3 dir = dirs[int(h.y * 5.99)];
    float phase = clock * (0.5 + 0.5 * h.z) + h.x * 6.28;
    float stray = (0.45 - 0.3 * depth) * pitch;
    vec3 pos = sitePos + dir * stray * 0.5 * (1.0 - cos(phase));
    float sz = 0.2 + 0.08 * (1.0 - depth);
    float cls = mod(float(ix + iy * 5u + iz * 7u), 12.0);
    emitQuad(pos, vec3(sz, 0.0, 0.0), vec3(0.0, sz, 0.0), cls, 0.5 + 0.5 * sin(phase), 0.0, vec2(0.0), vec2(1.0));
}
