#version 430 core
/**
 * @file SmokeRingChorus.comp
 * @brief SMOKE RING CHORUS: smoke rings blown from a ring of mouths toward
 * the camera, expanding and thinning as they travel.  Each mouth blows on
 * its own continuous phase of the scene clock (no ring is born on an
 * onset -- that would be a cut -- the onsets only light the rings), so the
 * chorus is a steady round.  A ring is a torus of quads; its transparency
 * is resolved by the OIT pass (the fragment stage declares oitPass), the
 * dark room behind is drawn opaque.  The camera never moves.
 *
 * Audio Reactivity (generator stage):
 *   sceneAdvance -> ring travel and expansion (continuous)
 *   audioSwell   -> ring size (slow)
 *
 * Per-instance: mouthsP, thickP, hueP.
 */
layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;
layout(std430, binding = 0) buffer Verts { float verts[]; };
layout(std430, binding = 1) buffer Cmd   { uint cmd[];   };

uniform uint  maxVertices;
uniform float time;
uniform float sceneAdvance;
uniform float sceneTime;
uniform float audioSwell;

uniform float mouthsP;
uniform float thickP;
uniform float hueP;

float hash11(float p) { p = fract(p * 0.1031); p *= p + 33.33; p *= p + p; return fract(p); }
vec3  hash31(float n) { return vec3(hash11(n), hash11(n + 17.3), hash11(n + 41.7)); }

void emitQuadN(vec3 p0, vec3 p1, vec3 p2, vec3 p3, vec3 n0, vec3 n1, vec3 n2, vec3 n3, float id, float life, float kind)
{
    // Each vertex carries its own normal packed in the uv slots + lit:
    // layout: pos xyz, id, life, kind, u, v  -> we store normal.xy in uv and
    // normal.z sign in the id fraction is overkill; instead store (u,v) as
    // the torus angles and rebuild the normal in the vertex stage.
    uint base = atomicAdd(cmd[4], 6u);
    if (base + 6u > maxVertices) return;
    vec3 pList[6]  = vec3[6](p0, p1, p2, p0, p2, p3);
    vec3 nList[6]  = vec3[6](n0, n1, n2, n0, n2, n3);
    for (uint i = 0u; i < 6u; ++i)
    {
        uint off = (base + i) * 8u;
        verts[off + 0u] = pList[i].x; verts[off + 1u] = pList[i].y; verts[off + 2u] = pList[i].z;
        verts[off + 3u] = id; verts[off + 4u] = life; verts[off + 5u] = kind;
        verts[off + 6u] = nList[i].x; verts[off + 7u] = nList[i].y;      // normal xy; z = sqrt(1-x2-y2) * sign(kind side)
    }
}

void main()
{
    uvec3 g = gl_GlobalInvocationID;
    uint id = g.x + 64u * (g.y + 64u * g.z);
    const uint kSeg = 40u;   // segments around the ring
    const uint kSide = 10u;  // segments around the tube
    uint mouths = 6u + uint(clamp(mouthsP, 0.0, 1.0) * 6.0);
    const uint kRingsPerMouth = 4u;
    uint nRings = mouths * kRingsPerMouth;
    uint quadsPerRing = kSeg * kSide;

    if (id == 0u)
    {
        // The room: a dark back wall (kind -1), opaque.
        uint base = atomicAdd(cmd[4], 6u);
        if (base + 6u <= maxVertices)
        {
            vec3 c = vec3(0.0, 0.0, 30.0), ax = vec3(50.0, 0.0, 0.0), ay = vec3(0.0, 28.0, 0.0);
            vec3 p0 = c - ax - ay, p1 = c + ax - ay, p2 = c + ax + ay, p3 = c - ax + ay;
            vec3 pList[6]  = vec3[6](p0, p1, p2, p0, p2, p3);
            vec2 uvList[6] = vec2[6](vec2(0.0, 0.0), vec2(1.0, 0.0), vec2(1.0, 1.0), vec2(0.0, 0.0), vec2(1.0, 1.0), vec2(0.0, 1.0));
            for (uint i = 0u; i < 6u; ++i)
            {
                uint off = (base + i) * 8u;
                verts[off + 0u] = pList[i].x; verts[off + 1u] = pList[i].y; verts[off + 2u] = pList[i].z;
                verts[off + 3u] = 0.0; verts[off + 4u] = 0.0; verts[off + 5u] = -1.0;
                verts[off + 6u] = uvList[i].x; verts[off + 7u] = uvList[i].y;
            }
        }
        return;
    }
    uint q = id - 1u;
    if (q >= nRings * quadsPerRing) return;
    uint ring = q / quadsPerRing;
    uint qi = q - ring * quadsPerRing;
    uint si = qi / kSide;           // segment around the ring
    uint ti = qi - si * kSide;      // segment around the tube
    uint mouth = ring / kRingsPerMouth;
    uint sub = ring - mouth * kRingsPerMouth;

    float fm = float(mouth), fs = float(sub);
    vec3 h = hash31(fm * 3.7 + 1.0);
    float clock = sceneAdvance * 0.5 + sceneTime * 0.12;
    // Mouth position: a ring of mouths far ahead, facing the camera.
    float ma = fm / float(mouths) * 6.2831853;
    vec3 mouthPos = vec3(cos(ma) * 5.0, sin(ma) * 3.0, 24.0);
    // Life of this ring: continuous phase, staggered per sub-ring.
    float period = 1.0;
    float life = fract(clock * (0.12 + 0.05 * h.x) + fs / float(kRingsPerMouth) + h.y);
    // Travel toward the camera, expanding, slowing.
    float travel = 20.0 * (1.0 - pow(1.0 - life, 1.6));
    float R = (0.6 + 2.4 * life) * (0.8 + 0.5 * clamp(audioSwell, 0.0, 1.0));
    float r = (0.18 + 0.28 * clamp(thickP, 0.0, 1.0)) * (0.5 + 1.2 * life);
    vec3 centre = mouthPos + vec3(0.0, 0.0, -travel) + vec3(0.4 * sin(life * 5.0 + h.z * 6.28), 0.3 * cos(life * 4.0), 0.0);
    // Torus geometry: axis along z; quad (si, ti) -> (si+1, ti+1).
    float a0 = float(si) / float(kSeg) * 6.2831853, a1 = float(si + 1u) / float(kSeg) * 6.2831853;
    float b0 = float(ti) / float(kSide) * 6.2831853, b1 = float(ti + 1u) / float(kSide) * 6.2831853;
    vec3 P[4]; vec3 N[4];
    float aa[4] = float[4](a0, a1, a1, a0);
    float bb[4] = float[4](b0, b0, b1, b1);
    for (int k = 0; k < 4; ++k)
    {
        vec3 ringDir = vec3(cos(aa[k]), sin(aa[k]), 0.0);
        vec3 n = ringDir * cos(bb[k]) + vec3(0.0, 0.0, 1.0) * sin(bb[k]);
        P[k] = centre + ringDir * R + n * r;
        N[k] = n;
    }
    // Store the normal's xy and the sign of z in kind (0 = +z, 1 = -z).
    emitQuadN(P[0], P[1], P[2], P[3], N[0], N[1], N[2], N[3], float(ring), life, (N[0].z >= 0.0) ? 0.0 : 1.0);
}
