#version 430 core
/**
 * @file StarlingMurmuration.comp
 * @brief MURMURATION: a starling flock of 40,000 birds as one breathing body.
 * No particle state is kept between frames: every bird's place is a function
 * of its seed, a slowly deforming cloud shape and a curl-noise flow field
 * advanced on sceneAdvance -- so the flock is deterministic per frame, never
 * drifts away, and still reads as a living swarm because the noise field
 * folds the cloud into the waves and knots real murmurations show.
 *
 * Audio Reactivity (generator stage):
 *   audioOnset    -> a fright wave: birds near a random point scatter outward
 *   audioSwell    -> the flock compacts (builds pull it together)
 *   audioKick     -> a body-wide pulse
 *   sceneAdvance  -> the flow field turns; the flock wanders
 *   audioCentroid -> flight height (bright mixes lift the flock)
 *
 * Per-instance: birdsP (fraction of the 40k drawn), spreadP (cloud size),
 *               speedP (flow rate), hueP.
 */
layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;
layout(std430, binding = 0) buffer Verts { float verts[]; };
layout(std430, binding = 1) buffer Cmd   { uint cmd[];   };

uniform uint  maxVertices;
uniform float time;
uniform float sceneAdvance;
uniform float sceneTime;
uniform float audioOnset;
uniform float audioSwell;
uniform float audioKick;
uniform float audioLevel;
uniform float audioCentroid;
uniform float audioBarPhase;

uniform float birdsP;
uniform float spreadP;
uniform float speedP;
uniform float hueP;

float hash11(float p) { p = fract(p * 0.1031); p *= p + 33.33; p *= p + p; return fract(p); }
vec3  hash31(float n) { return vec3(hash11(n), hash11(n + 17.3), hash11(n + 41.7)); }

float noise3(vec3 p)
{
    vec3 i = floor(p), f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    float n = i.x + i.y * 57.0 + i.z * 113.0;
    return mix(mix(mix(hash11(n), hash11(n + 1.0), f.x), mix(hash11(n + 57.0), hash11(n + 58.0), f.x), f.y),
               mix(mix(hash11(n + 113.0), hash11(n + 114.0), f.x), mix(hash11(n + 170.0), hash11(n + 171.0), f.x), f.y), f.z);
}

// Curl of the noise field: divergence-free, so the flock folds instead of
// inflating.
vec3 curl(vec3 p)
{
    const float e = 0.12;
    float x1 = noise3(p + vec3(0.0, e, 0.0)) - noise3(p - vec3(0.0, e, 0.0));
    float x2 = noise3(p + vec3(0.0, 0.0, e)) - noise3(p - vec3(0.0, 0.0, e));
    float y1 = noise3(p + vec3(0.0, 0.0, e)) - noise3(p - vec3(0.0, 0.0, e));
    float y2 = noise3(p + vec3(e, 0.0, 0.0)) - noise3(p - vec3(e, 0.0, 0.0));
    float z1 = noise3(p + vec3(e, 0.0, 0.0)) - noise3(p - vec3(e, 0.0, 0.0));
    float z2 = noise3(p + vec3(0.0, e, 0.0)) - noise3(p - vec3(0.0, e, 0.0));
    return vec3(x1 - x2, y1 - y2, z1 - z2) / (2.0 * e);
}

// Where bird `id` is at flow time t: a home point on a squashed ellipsoid,
// carried by the curl field.  Two evaluations a moment apart give heading.
vec3 birdPos(float id, float t, float spread, float compact, vec3 fright, float frightAmt)
{
    vec3 h = hash31(id) * 2.0 - 1.0;
    // Home cloud: an ellipsoid wider than tall, denser toward the middle.
    vec3 home = normalize(h + vec3(1e-4)) * pow(length(h), 0.6) * vec3(2.1, 0.8, 1.2) * spread;
    home *= mix(1.0, 0.55, compact);
    // Flow: the curl field at the bird's home, advanced in time; each bird
    // rides it with its own gain so the cloud has internal motion.
    float own = 0.6 + 0.8 * hash11(id * 3.1);
    vec3 flow = curl(home * 0.9 + vec3(0.0, t * 0.35, t * 0.2)) * 0.85 * own;
    vec3 p = home + flow + vec3(0.0, 0.25 * sin(t * 0.7 + home.x), 0.0);
    // Fright: birds near the fright point scatter away from it.
    vec3 d = p - fright;
    float near = exp(-dot(d, d) * 1.8);
    p += normalize(d + vec3(1e-4)) * near * frightAmt * 0.9;
    return p;
}

void main()
{
    uvec3 g = gl_GlobalInvocationID;
    uint id = g.x + 64u * (g.y + 64u * g.z);
    const uint kBirds = 40000u;

    // An indirect scene has no background shell, so the sky is a single
    // huge quad emitted by the first thread: density -1 marks it for the
    // vertex/fragment stages, which paint a dusk gradient from the photo.
    if (id == 0u)
    {
        uint sb = atomicAdd(cmd[4], 6u);
        if (sb + 6u <= maxVertices)
        {
            // +z is IN FRONT of the camera (the vertex stage negates z for the
            // projection); at -9 the sky sat behind the viewer and the flock
            // flew over black.
            vec3 s0 = vec3(-14.0, -8.0, 9.0), s1 = vec3(14.0, -8.0, 9.0), s2 = vec3(14.0, 8.0, 9.0), s3 = vec3(-14.0, 8.0, 9.0);
            vec3 sp[6] = vec3[6](s0, s1, s2, s0, s2, s3);
            vec2 su[6] = vec2[6](vec2(0.0, 0.0), vec2(1.0, 0.0), vec2(1.0, 1.0), vec2(0.0, 0.0), vec2(1.0, 1.0), vec2(0.0, 1.0));
            for (uint i = 0u; i < 6u; ++i)
            {
                uint off = (sb + i) * 8u;
                verts[off + 0u] = sp[i].x; verts[off + 1u] = sp[i].y; verts[off + 2u] = sp[i].z;
                verts[off + 3u] = -1.0; verts[off + 4u] = 0.0; verts[off + 5u] = -1.0;
                verts[off + 6u] = su[i].x; verts[off + 7u] = su[i].y;
            }
        }
    }
    float frac = (birdsP > 0.01) ? birdsP : 1.0;
    if (id >= uint(float(kBirds) * clamp(frac, 0.05, 1.0))) return;

    float spread = (spreadP > 0.05) ? spreadP : 1.0;
    float spd    = (speedP > 0.05) ? speedP : 1.0;
    float t = sceneAdvance * 0.6 * spd + sceneTime * 0.15 * spd;
    float compact = clamp(audioSwell, 0.0, 1.0);

    // Fright point wanders with the bar; the onset is the fright.
    vec3 fright = vec3(1.2 * sin(audioBarPhase * 6.2831853), 0.3 * cos(audioBarPhase * 12.566), 0.8 * cos(audioBarPhase * 6.2831853));
    float frightAmt = clamp(audioOnset, 0.0, 1.0);

    float fid = float(id);
    vec3 p0 = birdPos(fid, t, spread, compact, fright, frightAmt);
    vec3 p1 = birdPos(fid, t + 0.02, spread, compact, fright, frightAmt);
    vec3 heading = p1 - p0;
    float sp = length(heading);
    heading = (sp > 1e-5) ? heading / sp : vec3(1.0, 0.0, 0.0);

    // Flight height with the centroid; kick pulses the whole body.
    // Flight height on the slow swell only: a per-frame centroid bobbed the
    // whole flock (V7d).
    p0.y += 0.25 * clamp(audioSwell, 0.0, 1.0) - 0.1 + 0.05 * audioKick * sin(fid);

    // A bird is a thin quad along its heading: 6 vertices, two triangles.
    // Wing axis is perpendicular to the heading in the horizontal plane.
    vec3 wing = normalize(cross(heading, vec3(0.0, 1.0, 0.0)) + vec3(1e-4));
    float len = 0.055 + 0.03 * hash11(fid * 7.7);
    float span = 0.045 + 0.03 * hash11(fid * 9.1);
    // Wing flap: a per-bird phase, faster when the flock is excited.
    float flap = sin(t * 30.0 * (0.8 + 0.5 * hash11(fid * 5.3)) + fid) * (0.5 + 0.8 * frightAmt);
    vec3 up = vec3(0.0, 1.0, 0.0) * span * 0.35 * flap;

    vec3 a = p0 - heading * len * 0.5 - wing * span + up;
    vec3 b = p0 + heading * len * 0.5;
    vec3 c = p0 - heading * len * 0.5 + wing * span + up;
    vec3 d = p0 - heading * len * 0.35;   // tail notch

    uint base = atomicAdd(cmd[4], 6u);
    if (base + 6u > maxVertices) return;

    vec3 pList[6]  = vec3[6](a, b, d, d, b, c);
    vec2 uvList[6] = vec2[6](vec2(0.0, 0.0), vec2(0.5, 1.0), vec2(0.5, 0.2), vec2(0.5, 0.2), vec2(0.5, 1.0), vec2(1.0, 0.0));
    float seed = hash11(fid * 1.7);
    float density = exp(-dot(p0.xz, p0.xz) * 0.15);   // how deep in the flock
    for (uint i = 0u; i < 6u; ++i)
    {
        uint off = (base + i) * 8u;
        verts[off + 0u] = pList[i].x;
        verts[off + 1u] = pList[i].y;
        verts[off + 2u] = pList[i].z;
        verts[off + 3u] = fid;
        verts[off + 4u] = seed;
        verts[off + 5u] = density;
        verts[off + 6u] = uvList[i].x;
        verts[off + 7u] = uvList[i].y;
    }
}
