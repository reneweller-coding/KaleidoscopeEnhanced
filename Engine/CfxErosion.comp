#version 430
// CfxErosion.comp — droplet-based hydraulic erosion.
// -----------------------------------------------------------------------
// Each invocation is a rain droplet: it runs downhill along the terrain
// gradient, picking up sediment where it accelerates and dropping it where
// it slows.  Both the pickup and the deposit are writes to texels the
// droplet only discovers as it travels — the same scatter that makes DLA
// and particle splatting compute-only work.
//
// Races between droplets touching the same texel are benign here (they are
// small increments on a smooth field) and are the standard trade-off in GPU
// erosion; the alternative would be an atomic per texel per step.
// -----------------------------------------------------------------------
layout(local_size_x = 256) in;

layout(rgba16f, binding = 0) uniform image2D imgLand;   // R=height, G=water, B=sediment

uniform ivec2 size;
uniform uint  count;
uniform uint  frame;
uniform float rain;        // erosion strength
uniform float capacityK;   // how much sediment the water can carry

const int STEPS = 64;

uint pcg(inout uint s)
{
    s = s * 747796405u + 2891336453u;
    uint w = ((s >> ((s >> 28) + 4u)) ^ s) * 277803737u;
    return (w >> 22) ^ w;
}
float rnd(inout uint s) { return float(pcg(s)) * (1.0 / 4294967296.0); }

float hAt(ivec2 p) { return imageLoad(imgLand, clamp(p, ivec2(0), size - ivec2(1))).r; }

// Only the HEIGHT is written back.  An accumulated "water" channel was the
// obvious idea and the wrong one: droplets keep visiting the same texels and
// nothing ever drains it, so within seconds the whole map reads as flooded.
// The display derives wetness from the terrain's own concavity instead.
// Spread over a 3x3 kernel.  Applying erosion to the single texel the droplet
// stands on is a positive feedback at PIXEL scale — a texel that gets cut is
// lower, so the next droplet cuts it again — and the terrain dissolves into
// per-pixel noise instead of valleys.  The kernel low-passes that feedback,
// which is why every serious droplet-erosion implementation uses one.
void addAt(ivec2 p, float dh)
{
    for (int oy = -1; oy <= 1; ++oy)
    for (int ox = -1; ox <= 1; ++ox)
    {
        float wt = (ox == 0 && oy == 0) ? 0.25
                 : ((ox == 0 || oy == 0) ? 0.125 : 0.0625);
        ivec2 q = clamp(p + ivec2(ox, oy), ivec2(0), size - ivec2(1));
        vec4 v = imageLoad(imgLand, q);
        v.r = clamp(v.r + dh * wt, 0.0, 2.0);
        imageStore(imgLand, q, v);
    }
}

void main()
{
    uint id = gl_GlobalInvocationID.x;
    if (id >= count) return;

    uint rs = id * 2654435761u + frame * 2246822519u + 17u;
    pcg(rs);

    vec2  pos = vec2(rnd(rs), rnd(rs)) * vec2(size);
    vec2  dir = vec2(0.0);
    float water = 1.0;
    float sed = 0.0;

    for (int s = 0; s < STEPS; ++s)
    {
        ivec2 ip = ivec2(pos);
        float h = hAt(ip);
        // Central difference over 2 px: on a 512-wide map a smooth slope is
        // only ~0.002 per pixel, so treating the raw gradient as a VELOCITY
        // leaves the droplet parked on its own texel, eroding one pixel into
        // noise.  Take a fixed one-pixel step along steepest descent instead
        // and let inertia carry it around bends.
        vec2 grad = vec2(hAt(ip + ivec2(1, 0)) - hAt(ip - ivec2(1, 0)),
                         hAt(ip + ivec2(0, 1)) - hAt(ip - ivec2(0, 1)));

        vec2 want = -grad;
        float gl = length(want);
        if (gl < 1e-6) { want = dir; gl = length(want) + 1e-6; }
        dir = normalize(mix(dir, want / gl, 0.45) + 1e-6);

        float sp = clamp(gl * 260.0, 0.15, 2.0);     // steeper = faster
        pos += dir;
        if (pos.x < 2.0 || pos.y < 2.0 ||
            pos.x > float(size.x) - 3.0 || pos.y > float(size.y) - 3.0) break;

        float hNew = hAt(ivec2(pos));
        float drop = h - hNew;                       // > 0 = running downhill

        // Carrying capacity grows with slope and speed: fast water on a steep
        // slope cuts, slow water on the flat drops its load.  That single rule
        // is what carves valleys and builds the alluvial fans at their mouth.
        float cap = max(drop, 0.0) * sp * water * capacityK;

        // Small rates: 16k droplets x 64 steps hit the map a million times per
        // frame, so anything bigger grinds the terrain into noise in seconds.
        if (sed > cap)
        {
            float dep = (sed - cap) * 0.10;
            sed -= dep;
            addAt(ivec2(pos), dep);
        }
        else
        {
            float ero = min((cap - sed) * 0.05 * rain, max(drop, 0.0) * 0.6);
            sed += ero;
            addAt(ivec2(pos), -ero);
        }

        water *= 0.985;
        if (water < 0.05) break;
    }
}
