#version 430
/**
 * @file CfxNSDiv.comp
 * @brief Step 2 of the Navier-Stokes solve: computes velocity-field divergence and resets pressure to zero.
 *
 * Reads the advected velocity field written by CfxNSAdvect.comp (image binding
 * 0) and writes a pressure texture (binding 1) where R holds the central-
 * difference divergence at each texel and G is initialised to 0.0 as the
 * starting guess for the Jacobi pressure solve. CfxNSJacobi.comp iterates on
 * this output next, reading the same R channel as its unchanging divergence
 * term on every iteration while relaxing G toward the true pressure.
 */
layout(local_size_x = 16, local_size_y = 16) in;

layout(rgba16f, binding = 0) readonly  uniform image2D velSrc;
layout(rgba16f, binding = 1) writeonly uniform image2D prsDst;

uniform ivec2 size;

vec2 vAt(ivec2 p) { return imageLoad(velSrc, clamp(p, ivec2(0), size - ivec2(1))).rg; }

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= size.x || p.y >= size.y) return;

    float div = 0.5 * ((vAt(p + ivec2(1, 0)).x - vAt(p - ivec2(1, 0)).x)
                     + (vAt(p + ivec2(0, 1)).y - vAt(p - ivec2(0, 1)).y));

    imageStore(prsDst, p, vec4(div, 0.0, 0.0, 1.0));
}
