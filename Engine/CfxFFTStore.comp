#version 430
/**
 * @file CfxFFTStore.comp
 * @brief Writes the filtered complex field back out as a displayable texture, completing the FFT-filter pipeline.
 *
 * Final stage after CfxFFT.comp's inverse transform. Reads the `Data` SSBO
 * (binding 0), undoes CfxFFTLoad.comp's checkerboard sign flip to recover
 * the filtered luminance, and re-samples `texSrc` to compute the original
 * luminance for comparison. Stores the result to `imgOut` (binding 0): R =
 * filtered luma, G = absolute difference from the original ("edge energy"
 * the display uses to tint where the mask changed the image most), B =
 * original luma.
 */
// CfxFFTStore.comp — filtered luminance back into a texture.
// R = the filtered luma, G = |filtered - original| (an "edge energy" channel
// the display uses to tint where the filter is doing the most work).
layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, binding = 0) buffer Data { vec2 z[]; };
layout(rgba16f, binding = 0) writeonly uniform image2D imgOut;
uniform sampler2D texSrc;
uniform int N;

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= N || p.y >= N) return;

    float sign = (((p.x + p.y) & 1) == 0) ? 1.0 : -1.0;
    float l = z[p.y * N + p.x].x * sign;

    vec3 c = texture(texSrc, (vec2(p) + 0.5) / float(N)).rgb;
    float l0 = dot(c, vec3(0.299, 0.587, 0.114));

    imageStore(imgOut, p, vec4(l, abs(l - l0), l0, 1.0));
}
