#version 430
/**
 * @file CfxClothInit.comp
 * @brief Clears both displacement images to a flat sheet at rest, seeding the cloth simulation for CfxCloth.comp.
 *
 * Runs once before CfxCloth.comp's per-frame Verlet updates begin. Writes
 * zero displacement (RGB = 0, A = 1) to both `imgCur` and `imgPrev`
 * (bindings 0/1) so the first simulated frame starts with zero velocity
 * (current equals previous) and every grid node at its rest position.
 */
// CfxClothInit.comp — a flat sheet at rest.
// Each texel is one cloth particle: RGB = displacement from its rest
// position, A unused.  Keeping the cloth on a GRID means the display can
// shade it directly as a surface — no scatter needed for rendering, only
// for the physics.
layout(local_size_x = 16, local_size_y = 16) in;

layout(rgba16f, binding = 0) writeonly uniform image2D imgCur;
layout(rgba16f, binding = 1) writeonly uniform image2D imgPrev;

uniform ivec2 size;

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= size.x || p.y >= size.y) return;
    imageStore(imgCur,  p, vec4(0.0, 0.0, 0.0, 1.0));
    imageStore(imgPrev, p, vec4(0.0, 0.0, 0.0, 1.0));
}
