#version 430
/*****************************************************************************\
 *                              CfxHistogram.comp
\*****************************************************************************/
/*! @file
 *
 *  @brief
 *  Builds a 256-bin luminance histogram of the rendered frame and derives a percentile-based auto-exposure gain
 *  from it.
 *
 *  Standalone pass used by PresentPass's GPU percentile auto-exposure step
 *  (see Source/PresentPass.cpp), not chained to another CfxHistogram sibling.
 *  Two dispatches of this program a frame (`stage`).  Stage 0: one work group
 *  per 64 x 64 tile of `texFrame` counts the tile's top-left 16 x 16 pixels in
 *  a shared-memory histogram (sqrt-remapped bins so low luminances get more
 *  resolution) and adds it to the frame's histogram (`Bins`, binding 4).
 *  Stage 1: one work group takes the frame's histogram (and clears it for the
 *  next frame), then invocation 0 finds the 50th and 98th percentiles and
 *  computes a new exposure gain that pulls the median toward `target` while
 *  never letting the 98th-percentile highlight clip, slewed by `slew` per
 *  frame. Result is written to the four-float `Result` SSBO (binding 3:
 *  exposure, p50, p98, pad) that the present pass reads back to grade the
 *  frame, avoiding a costly CPU readback of the whole image.
 *
 *  @author René Weller
 */
// CfxHistogram.comp — luminance histogram of the finished frame, then the
// exposure that frame deserves.
// -----------------------------------------------------------------------
// The photosensitivity limiter previously worked off the frame's MEAN
// luminance, which a few blown highlights drag around and which darkens the
// whole picture to fix a local problem.  A histogram gives percentiles: the
// 50th says where the body of the image sits and the 98th says whether the
// highlights are really clipping, so the exposure can be corrected without
// touching contrast.
//
// 256 bins, atomics in shared memory.  Reading back a whole
// frame per histogram would cost a full GPU sync; here it stays on the GPU
// and the result lands in a 4-float buffer the present pass reads.
//
// Until 27.11.2026 ONE work group walked all the samples (1 in 16 pixels,
// 292,000 at 2880 x 1620): 0.20 ms of every frame on an RTX 5090, a single
// multiprocessor busy while the others idled -- more than the scene of a
// simple 2D effect.  Now every 64 x 64 tile has its own work group (stage 0)
// and the same pixels are counted, so the histogram -- integer counts -- and
// with it the exposure are exactly what they were.
// -----------------------------------------------------------------------
/// Layout qualifiers of this stage (work-group size, or the primitive in or out).
layout( local_size_x = 16, local_size_y = 16 ) in;

/// Binding 3, matching what PresentPass binds and what Present.frag reads.
/// This said 0 for as long as the pass existed, so every frame's exposure went
/// to whatever SSBO happened to be bound at slot 0 -- a ComputeFX canvas or a
/// Scene3D vertex buffer -- while Present.frag kept reading the four initial
/// values the C++ side uploads once. The startup line said "Auto-exposure:
/// histogram (GPU)" throughout and the gain never left 1.0: the pass was a
/// no-op that also scribbled 16 bytes into a stranger's buffer every frame.
layout( std430, binding = 3 ) buffer Result
{
    float exposureOut;
    float p50;
    float p98;
    float pad;
};
/// Binding 4: the frame's histogram, summed by the work groups of stage 0, read and cleared by stage 1.
layout( std430, binding = 4 ) buffer Bins
{
    uint bins[256];
};
uniform int       stage;    ///< 0: count the tiles into Bins (one work group per 64 x 64 tile); 1: the exposure.
uniform sampler2D texFrame; ///< The finished frame.
uniform ivec2     size;     ///< Size of the simulation grid in cells.
uniform float     target;   ///< where the median should sit
uniform float     maxGain;  ///< Largest gain the auto exposure may apply.
uniform float     slew;     ///< how fast the exposure may move (per frame)
uniform float     smoothK;  ///< EMA weight for the percentiles this frame (dt/tau)
uniform float     slewDown; ///< like slew, but for DARKENING -- may be faster

shared uint hist[256]; ///< Histogram of the work group (256 bins).

/** Entry point of this shader stage (the file description says what it draws). */
void main()
{
    uint lid = gl_LocalInvocationIndex;
    if ( stage == 1 )
    {
        // The frame's histogram into shared memory, and Bins cleared for the next frame.
        hist[lid] = bins[lid];
        bins[lid] = 0u;
        barrier();
    }
    else
    {
        hist[lid] = 0u;
        barrier();
        // The pixels sampled are 1 in 16: the top-left 16 x 16 of every 64 x 64 tile, one invocation each -- the
        // pixels the single work group's strided walk (x, y = its invocation + 64 k) counted until 27.11.2026.
        ivec2 p = ivec2( gl_WorkGroupID.xy ) * 64 + ivec2( gl_LocalInvocationID.xy );
        if ( p.x < size.x && p.y < size.y )
        {
            vec3  c = texelFetch( texFrame, p, 0 ).rgb;
            float l = dot( c, vec3( 0.299, 0.587, 0.114 ) );
            // 16-bit intermediates (KALEIDO_HDR_BUFFERS) keep a scene's stray NaN, which would pick no defined bin;
            // light above 1 falls into the top bin, as white does.
            l = isnan( l ) ? 0.0 : l;
            uint b = uint( clamp( sqrt( max( l, 0.0 ) ), 0.0, 0.999 ) * 256.0 );
            atomicAdd( hist[b], 1u );
        }
        barrier();
        if ( hist[lid] != 0u )
            atomicAdd( bins[lid], hist[lid] );
        return;
    }

    if ( lid != 0u )
        return;

    uint total = 0u;
    for ( int i = 0; i < 256; ++i )
        total += hist[i];
    if ( total == 0u )
        return;

    uint  acc = 0u;
    float m50 = 0.5, m98 = 1.0;
    bool  got50 = false;
    for ( int i = 0; i < 256; ++i )
    {
        acc += hist[i];
        float f = float( acc ) / float( total );
        float v = float( i ) / 256.0;
        v = v * v; // undo the sqrt binning
        if ( !got50 && f >= 0.50 )
        {
            m50 = v;
            got50 = true;
        }
        if ( f >= 0.98 )
        {
            m98 = v;
            break;
        }
    }

    // The percentiles are SMOOTHED before anything is derived from them.
    // Raw m50/m98 describe this FRAME: a beat flash or a specular glint moves
    // m98 by half its range within two frames, and an exposure that follows
    // raw percentiles follows the flash -- the whole picture pumps with the
    // music, hardest in the first second of a scene while the slew is still
    // fast for the scene change. The exposure's job is the SCENE's lighting;
    // smoothing the measurement (about 1.75 s standing, near-instant during a
    // scene fade, set by the host through smoothK) keeps flashes in the
    // picture where they belong instead of in the exposure.
    float s50 = ( p50 > 0.0 ) ? mix( p50, m50, smoothK ) : m50;
    float s98 = ( p98 > 0.0 ) ? mix( p98, m98, smoothK ) : m98;

    // Aim the MEDIAN at the target, but never so hard that the 98th
    // percentile clips: highlights win the argument.
    float want = ( s50 > 1e-4 ) ? clamp( target / s50, 1.0 / maxGain, maxGain ) : 1.0;
    if ( s98 * want > 1.0 )
        want = min( want, 1.0 / max( s98, 1e-4 ) );

    float prev = ( exposureOut > 0.0 ) ? exposureOut : 1.0;
    // Fast attack, slow release -- the classic exposure asymmetry, and the
    // direction matters here: when a BRIGHT scene fades in over a dark one,
    // the gain is still pinned high from the dark scene and every frame it
    // lags is a frame of the new scene OVERSHOT into glare, ended by a
    // visible drop. Downward correction therefore moves faster than upward.
    // It cannot pump: want is computed from the SMOOTHED percentiles above,
    // so in a standing scene it barely moves in the first place.
    exposureOut = prev + clamp( want - prev, -slewDown, slew );
    p50 = s50;
    p98 = s98;
}
