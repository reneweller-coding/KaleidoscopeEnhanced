#version 430
// CfxNSProject.comp — subtract the pressure gradient, and publish the result.
// The output texture carries the dye (RGB) plus the speed (A) so the display
// can shade the flow without a second sampler.
//
// NOTE: no vorticity confinement here.  It needs the neighbours' PRE-update
// velocities, and this pass writes velocity in place — a confinement term
// added here would read a mixture of old and new values depending on
// scheduling.  It belongs in its own pass; the solve is correct without it.
layout(local_size_x = 16, local_size_y = 16) in;

layout(rgba16f, binding = 0) uniform image2D velIO;
layout(rgba16f, binding = 1) readonly uniform image2D prsSrc;
layout(rgba16f, binding = 2) readonly uniform image2D dyeSrc;
layout(rgba16f, binding = 3) writeonly uniform image2D imgOut;

uniform ivec2 size;

float pAt(ivec2 q) { return imageLoad(prsSrc, clamp(q, ivec2(0), size - ivec2(1))).g; }

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= size.x || p.y >= size.y) return;

    vec2 v = imageLoad(velIO, p).rg;
    v -= 0.5 * vec2(pAt(p + ivec2(1, 0)) - pAt(p - ivec2(1, 0)),
                    pAt(p + ivec2(0, 1)) - pAt(p - ivec2(0, 1)));

    if (p.x <= 1 || p.x >= size.x - 2) v.x = 0.0;
    if (p.y <= 1 || p.y >= size.y - 2) v.y = 0.0;

    imageStore(velIO, p, vec4(v, 0.0, 1.0));

    vec4 d = imageLoad(dyeSrc, p);
    imageStore(imgOut, p, vec4(d.rgb, length(v) * 6.0));
}
