#version 330 core
/*****************************************************************************\
 *                              Final_ChainLabTunnel.frag
\*****************************************************************************/
/*! @file
 *
 *  @brief
 *  The lab with its chain run as passes by the app (EffectShader chain runner); the chain coordinate comes from
 *  texChain.
 *
 *  GENERATED by Tools/scenegen/make_chainpass.py from Scene2D/ChainLabTunnel.frag.
 *
 *  @author René Weller
 */
uniform sampler2D texChain; ///< The chain coordinate per pixel, computed by the chain passes.
uniform vec2      chainOff; ///< Offset of this pixel grid in the chain texture (in pixels).
// @chainbake 2048
out vec4          fragColor;     ///< The pixel's colour (output).
uniform vec2      resolution;    ///< Size of the render target in pixels.
uniform sampler2D tex0;          ///< The current photo.
uniform sampler2D tex1;          ///< The next photo (cross-faded in by interpolation).
uniform float     interpolation; ///< Cross-fade between the photos: 1 = tex0, 0 = tex1.
uniform float     sceneTime;     ///< Seconds since this scene was activated.
uniform float     sceneAdvance;  ///< The music's advance since this scene was activated (integrated, never jumps).
uniform float     audioAdvance;  ///< The music's advance: integrated tempo-weighted energy (never jumps, never runs
                                 ///< backwards).
uniform float audioLevel;        ///< Overall loudness, 0..1.
uniform float audioPhase;        ///< Rotation phase driven by the music (integrated, never jumps).
uniform float audioSpread;       ///< Spectral spread, 0..1.
uniform float audioKick;         ///< Kick-drum envelope, 0..1 (fast attack, short decay).
uniform float audioMode;         ///< Mode of the music: 0 minor .. 1 major.
uniform float audioSwell;        ///< Slow loudness envelope, 0..1 (seconds).
uniform float depthP;            ///< Depth knob, 0..1.
uniform float styleP;            ///< Look knob, 0..1.
uniform float speedP;            ///< Speed knob, 0..1.
uniform float detailP;           ///< Detail knob, 0..1.
uniform float paletteP;          ///< Palette knob: photo colours .. colour field, 0..1.
uniform float hueP;              ///< Hue knob (radians), usually the music's chroma hue plus a rolled offset.
/**  The scene's chain of transforms: a coordinate in, the transformed coordinate out.
 *
 * @param p  The coordinate. (in)
 *
 * @return
 *   The coordinate after the chain.
 **/
vec2 chain( vec2 p )
{
    return texture( texChain, p ).xy;
}
/**  Mirrored repeat of a coordinate into 0..1 (seamless at every edge).
 *
 * @param uv  The coordinate, any range. (in)
 *
 * @return
 *   The coordinate mirror-repeated into 0..1.
 **/
vec2 mirrorUV( vec2 uv )
{
    return 1.0 - abs( fract( uv * 0.5 ) * 2.0 - 1.0 );
}
/**  The photo at a mip level, mirrored at its edges: lod 0 full detail, ~4 a soft field, ~7 broad masses.
 *
 * @param uv   Coordinate in the photo (mirror-repeated outside 0..1). (in)
 * @param lod  Mip level of the photo (0 = full detail). (in)
 *
 * @return
 *   The cross-faded photo colour (RGB).
 **/
vec3 imgLod( vec2 uv, float lod )
{
    uv = mirrorUV( uv );
    return ( interpolation * textureLod( tex0, uv, lod ) + ( 1.0 - interpolation ) * textureLod( tex1, uv, lod ) ).rgb;
}
/**  Luminance of a colour (Rec. 601 weights).
 *
 * @param c  The colour. (in)
 *
 * @return
 *   The luminance.
 **/
float luma( vec3 c )
{
    return dot( c, vec3( 0.299, 0.587, 0.114 ) );
}
/**  HSV (all 0..1) to RGB.
 *
 * @param c  Hue, saturation and value, all 0..1. (in)
 *
 * @return
 *   The RGB colour.
 **/
vec3 hsv2rgb( vec3 c )
{
    vec3 k = clamp( abs( mod( c.x * 6.0 + vec3( 0.0, 4.0, 2.0 ), 6.0 ) - 3.0 ) - 1.0, 0.0, 1.0 );
    return c.z * mix( vec3( 1.0 ), k, c.y );
}
/**  The pixel's position, centred and aspect-corrected (y spans -0.5..0.5).
 *
 * @return
 *   The pixel's centred coordinate (y in -0.5..0.5, x scaled by the aspect).
 **/
vec2 screenP()
{
    return ( gl_FragCoord.xy / resolution - 0.5 ) * vec2( resolution.x / resolution.y, 1.0 );
}
/**  Writes the pixel: loudness brightness and a soft highlight roll-off.
 *
 * @param col  The scene's colour; written to fragColor after the finish. (in)
 **/
void finish( vec3 col )
{
    col *= 0.9 + 0.2 * audioLevel;
    vec3 t = max( col, 0.0 );
    t /= 1.0 + 0.35 * max( t.r, max( t.g, t.b ) );
    fragColor = vec4( clamp( t, 0.0, 1.0 ), 1.0 );
}
/** @{ */
float gT, gTC, gSpread, gRot, gMw, gH; ///< gT: The chain's (or scene's) time this frame; gTC: The chain's time for this
                                       ///< pixel (gT plus the tilt across the picture); gSpread: The spectral spread
                                       ///< this frame, 0..1; gRot: The rotation phase this frame; gMw: The chain's
                                       ///< morph position this frame (integrated); gH: Depth of the wall relief this
                                       ///< frame (at most 0.59: the axis stays free).
/** @} */
/** @{ */
vec2 gCw, gCt; ///< gCw: Centre of the wandering transforms this frame (drifts slowly); gCt: Second centre of the
               ///< wandering transforms this frame.
/** @} */
/** @{ */
uniform vec3 walkA, walkB, walkC, walkD, walkS; ///< walkA: Stage A of the app's walk: (shown class, target class,
                                                ///< fade); walkB: Stage B of the app's walk: (shown class, target
                                                ///< class, fade); walkC: Stage C of the app's walk: (shown class,
                                                ///< target class, fade); walkD: Stage D of the app's walk: (shown
                                                ///< class, target class, fade); walkS: The style of the app's walk:
                                                ///< (shown class, target class, fade).
/** @} */
uniform float     walkHost;     ///< 1 when the app walks this lab's stages (walk uniforms valid).
uniform float     glowP;        ///< Glow / afterglow knob, 0..1.
uniform sampler2D texPrevFrame; ///< The last frame, fully composited (feedback).
/**  Afterglow: the brighter of the colour and the decayed previous frame (from glowP 0.15).
 *
 * @param col  The frame's colour. (in)
 *
 * @return
 *   The colour with the afterglow.
 **/
vec3 chainAfterglow( vec3 col )
{
    if ( glowP <= 0.15 )
        return col;
    vec3 prev = texture( texPrevFrame, gl_FragCoord.xy / resolution ).rgb;
    return max( col, prev * ( 0.78 * smoothstep( 0.15, 1.0, glowP ) ) );
}
/**  The tube's axis winds slowly: the vanishing point wanders.
 *
 * @param z  Depth along the tube. (in)
 *
 * @return
 *   The axis's x/y offset.
 **/
vec2 axisXY( float z )
{
    return vec2( 0.35 * sin( z * 0.11 ) + 0.15 * sin( z * 0.27 + 1.0 ),
                 0.3 * sin( z * 0.087 + 0.6 ) + 0.12 * cos( z * 0.21 ) );
}
/**  Wall coordinates: angle around (jumps by a whole mirror period at the atan cut, so mirrorUV makes it seamless)
 * and depth along.
 *
 * @param q  The point. (in)
 *
 * @return
 *   The wall coordinate (mirrored into 0..1).
 **/
vec2 wallUV( vec3 q )
{
    vec2 d = q.xy - axisXY( q.z );
    return mirrorUV( vec2( atan( d.y, d.x ) / 3.14159265, q.z * 0.32 ) );
}
/**  Distance to the wall: radius 1 minus the relief (the chain's smooth brightness).
 *
 * @param w  The wall coordinate. (in)
 * @param c  The chain's coordinate there. (in)
 *
 * @return
 *   The relief height, 0..1.
 **/
float wallHeight( vec2 w, vec2 c )
{
    float J = length( mirrorUV( chain( w + vec2( 0.01, 0.01 ) ) ) - mirrorUV( c ) ) / 0.0141;
    return luma( imgLod( c, 4.0 + clamp( log2( max( J, 1.0 ) ), 0.0, 5.0 ) ) );
}
/**  Distance to the tube's wall: radius 1 minus the relief.
 *
 * @param q  The point. (in)
 * @param c  Receives the chain's coordinate there. (out)
 *
 * @return
 *   The distance.
 **/
float tunnelD( vec3 q, out vec2 c )
{
    vec2 w = wallUV( q );
    c = chain( w );


    return ( 1.0 - gH * luma( imgLod( c, 5.0 ) ) ) - length( q.xy - axisXY( q.z ) );
}
/** Entry point of this shader stage (the file description says what it draws). */
void main()
{
    vec2  p = screenP();
    float kick = clamp( audioKick, 0.0, 1.0 );
    float swell = clamp( audioSwell, 0.0, 1.0 );
    float mode = clamp( audioMode, 0.0, 1.0 );
    gT = ( 0.3 + 0.5 * clamp( speedP, 0.0, 1.0 ) ) * sceneTime + 2.0 * audioAdvance;
    gTC = ( 0.03 + 0.06 * clamp( speedP, 0.0, 1.0 ) ) * sceneTime + 0.25 * audioAdvance;
    gSpread = clamp( audioSpread, 0.0, 1.0 );
    gRot = 0.02 * sceneTime + 0.2 * audioPhase;
    gMw = 0.012 * sceneTime + 0.15 * sceneAdvance;
    gCw = vec2( 0.5 ) + 0.15 * vec2( sin( 0.017 * sceneTime ), cos( 0.013 * sceneTime ) );
    gCt = vec2( 0.5 )
          + vec2( 0.22 * sin( 0.023 * sceneTime + 0.3 * sin( 0.011 * sceneTime ) ), 0.16 * cos( 0.019 * sceneTime ) );
    gH = ( 0.15 + 0.3 * clamp( depthP, 0.0, 1.0 ) ) * ( 0.8 + 0.3 * swell );

    vec3  ro = vec3( axisXY( gT ), gT );
    vec3  ta = vec3( axisXY( gT + 2.5 ), gT + 2.5 );
    vec3  fw = normalize( ta - ro );
    vec3  rt = normalize( cross( vec3( 0.0, 1.0, 0.0 ), fw ) );
    vec3  rd = mat3( rt, cross( fw, rt ), fw ) * normalize( vec3( p, 1.2 ) );
    float t = 0.05;
    float d = 1.0;
    vec2  c = vec2( 0.5 );
    bool  hit = false;



    for ( int i = 0; i < 64; ++i )
    {
        vec3  q = ro + rd * t;
        float db = ( 1.0 - gH ) - length( q.xy - axisXY( q.z ) );
        if ( db < 0.01 || t > 28.0 )
            break;
        t += db * 0.8;
    }

    for ( int i = 0; i < 90; ++i )
    {
        d = tunnelD( ro + rd * t, c );
        if ( d < 0.0015 * t )
        {
            hit = true;
            break;
        }
        t += d * 0.55;
        if ( t > 28.0 )
            break;
    }
    float hue_f = hueP * 0.159 + 0.12 * audioPhase + 0.004 * sceneTime + 0.3 * mode;
    vec3  fog_c = hsv2rgb( vec3( fract( hue_f + 0.5 ), 0.5, 1.0 ) ) * ( 0.04 + 0.08 * swell );
    vec3  col = fog_c;
    if ( hit )
    {
        vec3 q = ro + rd * t;
        vec2 cc;
        vec2 e = vec2( 1.0, -1.0 ) * max( 0.004, 0.003 * t );
        vec3 n = normalize( e.xyy * tunnelD( q + e.xyy, cc ) + e.yyx * tunnelD( q + e.yyx, cc )
                            + e.yxy * tunnelD( q + e.yxy, cc ) + e.xxx * tunnelD( q + e.xxx, cc ) );




        float px_w = t * 2.0 / resolution.y * 0.32;
        float px_z = px_w / max( abs( dot( normalize( vec3( q.xy - axisXY( q.z ), 0.0 ) ), rd ) ), 0.03 );
        vec2  w0 = wallUV( q );
        vec2  m0c = mirrorUV( c );
        float fx = min( length( mirrorUV( chain( w0 + vec2( px_w, 0.0 ) ) ) - m0c ),
                        length( m0c - mirrorUV( chain( w0 - vec2( px_w, 0.0 ) ) ) ) );
        float fy = min( length( mirrorUV( chain( w0 + vec2( 0.0, px_z ) ) ) - m0c ),
                        length( m0c - mirrorUV( chain( w0 - vec2( 0.0, px_z ) ) ) ) );
        float lod = clamp( log2( max( max( fx, fy ) * 1024.0, 1.0 ) ) + 1.0 - 1.2 * clamp( detailP, 0.0, 1.0 ), 0.0,
                           9.0 );


        vec3 n_tube = -normalize( vec3( q.xy - axisXY( q.z ), 0.0 ) );
        n = normalize(
            mix( n_tube, n, clamp( 1.0 - ( log2( max( max( fx, fy ) * 1024.0, 1.0 ) ) - 4.0 ) / 2.5, 0.0, 1.0 ) ) );
        vec3  ph = imgLod( c, lod );
        float m0 = luma( ph );
        float hgt = wallHeight( wallUV( q ), c );
        vec2  cm = mirrorUV( c );


        float hue_w = clamp( 1.0 - ( log2( max( max( fx, fy ) * 1024.0, 1.0 ) ) - 3.0 ) / 3.0, 0.0, 1.0 );


        float h = hue_f + hue_w * 0.13 * ( 0.6 * sin( 6.2831853 * cm.x ) + 0.4 * sin( 6.2831853 * cm.y + 1.3 ) )
                  + 0.03 * m0;
        vec3  field = hsv2rgb( vec3( fract( h ), 0.55 + 0.25 * swell, 1.0 ) ) * ( 0.35 + 1.3 * m0 );
        vec3  tex = mix( max( ( ph - m0 ) * 1.35 + m0, 0.0 ), field, 0.15 + 0.45 * clamp( paletteP, 0.0, 1.0 ) );
        vec3  lc = mix( vec3( 0.75, 0.88, 1.1 ), vec3( 1.12, 0.92, 0.72 ), mode );

        vec3  lh = normalize( ro + vec3( 0.0, 0.0, 1.5 ) - q );
        float la = 0.13 * sceneTime;
        vec3  lk = normalize( vec3( cos( la ), sin( la ), 0.4 ) );
        float diff = 0.55 * max( dot( n, lh ), 0.0 ) + 0.35 * ( 0.5 + 0.5 * dot( n, lk ) );
        float spec = pow( max( dot( reflect( -lh, n ), -rd ), 0.0 ), 24.0 );
        float ao = 0.45 + 0.55 * hgt;
        vec3  surf = tex * lc * ( 0.5 + 1.25 * diff ) * ao + lc * spec * ( 0.15 + 0.35 * swell );

        float crest = smoothstep( 0.45, 0.85, hgt );
        float fres = pow( 1.0 - abs( dot( n, -rd ) ), 3.0 );


        vec3  phc = imgLod( c, lod + 4.5 );
        float pmx = max( phc.r, max( phc.g, phc.b ) );
        float psat = ( pmx - min( phc.r, min( phc.g, phc.b ) ) ) / max( pmx, 0.25 );
        vec3  own = pow( mix( vec3( 1.0 ), phc / max( pmx, 1e-3 ), clamp( psat * 2.0, 0.0, 1.0 ) ), vec3( 1.5 ) );
        float own_w = ( 0.5 + 0.4 * smoothstep( 0.06, 0.3, psat ) ) * ( 1.0 - 0.5 * clamp( paletteP, 0.0, 1.0 ) );
        vec3  glow = mix( hsv2rgb( vec3( fract( h ), 0.5 + 0.2 * swell, 1.0 ) ), own, own_w )
                     * ( crest * ( 0.6 + 1.2 * kick ) + fres * 0.5 );
        float st = clamp( styleP, 0.0, 1.0 );
        vec3  sc = mix( surf + glow * 0.25 * ( 0.5 + kick ), glow + surf * 0.55, smoothstep( 0.35, 0.65, st ) );
        col = mix( fog_c, sc, exp( -t * ( 0.07 + 0.03 * swell ) ) );
    }
    if ( walkHost < -1.0 )
        col += vec3( walkA.x + walkB.x + walkC.x + walkD.x ); // keeps the walk uniforms
    finish( chainAfterglow( col ) );
}
