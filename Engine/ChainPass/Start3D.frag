#version 330 core
/*****************************************************************************\
 *                              Start3D.frag
\*****************************************************************************/
/*! @file
 *
 *  @brief
 *  The 3D lab: one plane's chain input.
 *
 *  GENERATED by Tools/scenegen/make_chainpass.py.
 *
 *  @author René Weller
 */
out vec4          fragColor; ///< The pixel's colour (output).
uniform sampler2D texGPos;   ///< Position buffer of the 3D lab (world position per pixel).
uniform int       plane;     ///< Which projection plane: 0 yz, 1 zx, 2 xy.
uniform float     solidP;    ///< Solid-texture knob, 0..1.
/** Entry point of this shader stage (the file description says what it draws). */
void main()
{
    vec4  g = texelFetch( texGPos, ivec2( gl_FragCoord.xy ), 0 );
    vec3  fp = g.xyz;
    float sd = solidP >= 0.5 ? 1.0 : 0.0;
    vec2  uv = plane == 0 ? fp.yz : ( plane == 1 ? fp.zx : fp.xy );
    float depth = plane == 0 ? fp.x : ( plane == 1 ? fp.y : fp.z );
    fragColor = vec4( uv * 0.35 + 0.5, depth * sd, 0.0 );
}
