/**  Mirrored repeat of a coordinate into 0..1 (seamless at every edge).
 *
 * @param uv  The coordinate, any range. (in)
 *
 * @return
 *   The coordinate mirror-repeated into 0..1.
 **/
vec2 mirrorUV( vec2 uv )
{
    return 1.0 - abs( fract( uv * 0.5 ) * 2.0 - 1.0 );
}
/**  The pixel's position, centred and aspect-corrected (y spans -0.5..0.5).
 *
 * @return
 *   The pixel's centred coordinate (y in -0.5..0.5, x scaled by the aspect).
 **/
vec2 screenP()
{
    return ( gl_FragCoord.xy / resolution - 0.5 ) * vec2( resolution.x / resolution.y, 1.0 );
}
/**  The complex number e^(i a).
 *
 * @param a  The angle in radians. (in)
 *
 * @return
 *   The unit complex number (cos a, sin a).
 **/
vec2 cexpi( float a )
{
    return vec2( cos( a ), sin( a ) );
}
/**  Complex multiplication.
 *
 * @param a  One complex number. (in)
 * @param b  The other. (in)
 *
 * @return
 *   The product a b.
 **/
vec2 cmul( vec2 a, vec2 b )
{
    return vec2( a.x * b.x - a.y * b.y, a.x * b.y + a.y * b.x );
}
/**  One term r^e (cos d th, sin d th) of a Farris rosette.
 *
 * @param r   Radius. (in)
 * @param th  Angle (radians). (in)
 * @param d   Angular frequency. (in)
 * @param e   Exponent of the radius. (in)
 *
 * @return
 *   The complex term.
 **/
vec2 rosetteTerm( float r, float th, float d, float e )
{
    return pow( r, e ) * vec2( cos( d * th ), sin( d * th ) );
}
/**  Farris rosette: a p-fold symmetric wave pattern about c.
 *
 * @param uv  The coordinate. (in)
 * @param c   Centre of the transform. (in)
 * @param p   Symmetry order of the rosette. (in)
 * @param k   Base frequency of the wave terms. (in)
 * @param t   Phase of the terms. (in)
 *
 * @return
 *   The transformed coordinate.
 **/
vec2 tRosette( vec2 uv, vec2 c, float p, float k, float t )
{
    vec2  d0 = ( uv - c ) * 1.7;
    float r = length( d0 ), th = atan( d0.y, d0.x );
    float d1 = k + p, d2 = k - p;
    vec2  f = cmul( cexpi( t * 0.6 ), rosetteTerm( r, th, d1, abs( d1 ) ) )
              + cmul( cexpi( -t * 0.4 + 1.0 ), rosetteTerm( r, th, d2, abs( d2 ) ) ) * 0.8
              + cmul( cexpi( t * 0.3 + 2.0 ), rosetteTerm( r, th, k, abs( k ) + 2.0 ) ) * 0.6;
    return c + f * 0.6;
}
float gVar = 0.0; ///< The variant of the class in use: -1 for variant 0 (the original look), else a hash of its number,
                  ///< 0..1.
vec4 gVa = vec4( 0.5 ); ///< The variant's first four pseudo-random numbers, 0..1 (all 0.5 for variant 0).
vec4 gVb = vec4( 0.5 ); ///< The variant's last four pseudo-random numbers, 0..1 (all 0.5 for variant 0).
/**  Sets the variant a stage's sub-variant stands for (gVar, gVa, gVb).
 *
 * @param v  The sub-variant 0..1 of the stage. (in)
 * @param k  The class's branch number. (in)
 **/
void chainSetVar( float v, int k )
{
    float vi = floor( clamp( v, 0.0, 0.9999 ) * 100.0 );
    if ( vi < 0.5 )
    {
        gVar = -1.0;
        gVa = vec4( 0.5 );
        gVb = vec4( 0.5 );
        return;
    }
    gVar = fract( sin( vi * 12.9898 + float( k ) * 78.233 ) * 43758.5453 );
    gVa = fract( sin( gVar * 127.1 + 17.0 + vec4( 0.0, 311.7, 623.4, 935.1 ) ) * 43758.5453 );
    gVb = fract( sin( gVar * 127.1 + 17.0 + vec4( 1246.8, 1558.5, 1870.2, 2181.9 ) ) * 43758.5453 );
}
/** @{ */
float gT, gSpread, gRot, gMw; ///< gT: The chain's (or scene's) time this frame; gSpread: The spectral spread this
                              ///< frame, 0..1; gRot: The rotation phase this frame; gMw: The chain's morph position
                              ///< this frame (integrated).
/** @} */
/** @{ */
vec2 gCw, gCt; ///< gCw: Centre of the wandering transforms this frame (drifts slowly); gCt: Second centre of the
               ///< wandering transforms this frame.
/** @} */
uniform float walkHost; ///< 1 when the app walks this lab's stages (walk uniforms valid).
uniform float tiltP;    ///< Tilt knob, 0..1.
uniform float tiltA;    ///< The time tilt's direction (radians) while the app walks the lab (walkHost).
/**  Time tilt of the chain: a linear ramp across the picture, along the tilt direction.
 *
 * @param q  The pixel's coordinate. (in)
 *
 * @return
 *   The tilt offset (added to the chain's time).
 **/
float chainTiltZ( vec2 q )
{
    float k = smoothstep( 0.15, 1.0, tiltP ) * 0.6 * ( 0.55 + 0.45 * clamp( audioSwell, 0.0, 1.0 ) );
    float a = walkHost > 0.5 ? tiltA : 0.011 * sceneTime;
    return k * dot( vec2( cos( a ), sin( a ) ), q );
}
/**  One class of this stage: the transform the stage applies for knob value v.
 *
 * @param uv  The coordinate. (in)
 * @param v   The stage's knob value (its class and sub-variant). (in)
 *
 * @return
 *   The transformed coordinate.
 **/
vec2 cls( vec2 uv, float v )
{
    chainSetVar( v, 9 );
    return tRosette( uv, gCw, 3.0 + floor( v * 5.99 ), fract( v * 6.0 ) < 0.5 ? 0.0 : 1.0, gT * 1.5 );
    return uv;
}

/** Entry point of this shader stage (the file description says what it draws). */
