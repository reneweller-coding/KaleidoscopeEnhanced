uniform sampler2D texIn;        ///< The previous pass's chain coordinate per pixel (RG32F).
uniform int       firstPass;    ///< 1: start from the screen position instead of texIn.
uniform float     subV;         ///< The class's sub-variant, 0..1 (mirrors, arms, lattice ...).
uniform vec2      chainOff;     ///< the target viewport's origin (gl_FragCoord of the lab = pass pixel + chainOff)
uniform float     bakeSize;     ///< > 0: the chain baked over [0,1]^2 (a lab that reads it at arbitrary points)
