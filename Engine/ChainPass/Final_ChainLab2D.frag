uniform vec4 photoFocus;         ///< Subject centre of the photo in tex0 (xy) and tex1 (zw), texture coordinates.
uniform vec4 photoSubject; ///< Depth threshold (subject = depth >= it) and confidence of the photo in tex0 (xy), tex1
