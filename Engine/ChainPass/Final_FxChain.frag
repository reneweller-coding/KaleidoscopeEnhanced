#version 330 core
/*****************************************************************************\
 *                              Final_FxChain.frag
\*****************************************************************************/
/*! @file
 *
 *  @brief
 *  The lab with its chain run as passes by the app (EffectShader chain runner); the chain coordinate comes from
 *  texChain.
 *
 *  GENERATED by Tools/scenegen/make_chainpass.py from FX/FxChain.frag.
 *
 *  @author René Weller
 */
uniform sampler2D texChain;      ///< The chain coordinate per pixel, computed by the chain passes.
uniform vec2      chainOff;      ///< Offset of this pixel grid in the chain texture (in pixels).
uniform float     chainScale;    ///< the chain's grid relative to the frame (0 = 1)
out vec4          fragColor;     ///< The pixel's colour (output).
uniform vec2      resolution;    ///< Size of the render target in pixels.
uniform sampler2D tex0;          ///< The current photo.
uniform sampler2D tex1;          ///< The next photo (cross-faded in by interpolation).
uniform float     interpolation; ///< Cross-fade between the photos: 1 = tex0, 0 = tex1.
uniform float     sceneTime;     ///< Seconds since this scene was activated.
uniform float     sceneAdvance;  ///< The music's advance since this scene was activated (integrated, never jumps).
uniform float     audioAdvance;  ///< The music's advance: integrated tempo-weighted energy (never jumps, never runs
                                 ///< backwards).
uniform float audioLevel;        ///< Overall loudness, 0..1.
uniform float audioPhase;        ///< Rotation phase driven by the music (integrated, never jumps).
uniform float audioSpread;       ///< Spectral spread, 0..1.
uniform float audioKick;         ///< Kick-drum envelope, 0..1 (fast attack, short decay).
uniform float audioMode;         ///< Mode of the music: 0 minor .. 1 major.
uniform float audioSwell;        ///< Slow loudness envelope, 0..1 (seconds).
uniform float chainAP;           ///< Stage A class knob of the chain (global map), 0..1.
uniform float chainBP;           ///< Stage B class knob (symmetry), 0..1.
uniform float chainCP;           ///< Stage C class knob (second map), 0..1.
uniform float chainDP;           ///< Stage D class knob (warp), 0..1.
uniform float morphP;            ///< Morph knob: how the scene changes over time, 0..1.
uniform float styleP;            ///< Look knob, 0..1.
uniform float speedP;            ///< Speed knob, 0..1.
uniform float detailP;           ///< Detail knob, 0..1.
uniform float paletteP;          ///< Palette knob: photo colours .. colour field, 0..1.
uniform float hueP;              ///< Hue knob (radians), usually the music's chroma hue plus a rolled offset.
/**  The scene's chain of transforms: a coordinate in, the transformed coordinate out.
 *
 * @param p  The coordinate. (in)
 *
 * @return
 *   The coordinate after the chain.
 **/
vec2 chain( vec2 p )
{
    vec2 fp = gl_FragCoord.xy - chainOff;
    if ( chainScale <= 0.0 || ( chainScale >= 0.999 && chainScale < 1.5 ) )
        return texelFetch( texChain, ivec2( fp ), 0 ).xy;
    vec2  q = fp * chainScale - 0.5;
    ivec2 i0 = ivec2( floor( q ) ), mx = textureSize( texChain, 0 ) - 1;
    vec2  f = q - vec2( i0 );
    vec2  a = texelFetch( texChain, clamp( i0, ivec2( 0 ), mx ), 0 ).xy;
    vec2  b = texelFetch( texChain, clamp( i0 + ivec2( 1, 0 ), ivec2( 0 ), mx ), 0 ).xy;
    vec2  c = texelFetch( texChain, clamp( i0 + ivec2( 0, 1 ), ivec2( 0 ), mx ), 0 ).xy;
    vec2  d = texelFetch( texChain, clamp( i0 + ivec2( 1, 1 ), ivec2( 0 ), mx ), 0 ).xy;
    float gap = max( max( length( a - b ), length( a - c ) ), max( length( b - d ), length( c - d ) ) );
    if ( gap > 0.08 )
        return f.y < 0.5 ? ( f.x < 0.5 ? a : b ) : ( f.x < 0.5 ? c : d );
    return mix( mix( a, b, f.x ), mix( c, d, f.x ), f.y );
}
/**  Sub-sample i (0..3) of this pixel on the doubled grid (chainScale 2).
 *
 * @param i  Index of the sub-sample (0..3). (in)
 *
 * @return
 *   The chain coordinate there.
 **/
vec2 chainSub( int i )
{
    ivec2 b = ivec2( gl_FragCoord.xy - chainOff ) * 2 + ivec2( i & 1, i >> 1 );
    return texelFetch( texChain, clamp( b, ivec2( 0 ), textureSize( texChain, 0 ) - 1 ), 0 ).xy;
}
/**  Pseudo-random number 0..1 from a float.
 *
 * @param n  The input value. (in)
 *
 * @return
 *   A pseudo-random number 0..1.
 **/
float hash11( float n )
{
    return fract( sin( n * 127.1 ) * 43758.5453 );
}
/**  Pseudo-random number 0..1 from a 2D point.
 *
 * @param p  The point. (in)
 *
 * @return
 *   A pseudo-random number 0..1.
 **/
float hash21( vec2 p )
{
    vec3 p3 = fract( vec3( p.xyx ) * 0.1031 );
    p3 += dot( p3, p3.yzx + 33.33 );
    return fract( ( p3.x + p3.y ) * p3.z );
}
/**  Smooth 2D value noise, 0..1.
 *
 * @param p  The point. (in)
 *
 * @return
 *   The noise value, 0..1.
 **/
float noise2( vec2 p )
{
    vec2 i = floor( p ), f = fract( p );
    f = f * f * ( 3.0 - 2.0 * f );
    return mix( mix( hash21( i ), hash21( i + vec2( 1.0, 0.0 ) ), f.x ),
                mix( hash21( i + vec2( 0.0, 1.0 ) ), hash21( i + vec2( 1.0, 1.0 ) ), f.x ), f.y );
}
/**  Fractal noise of three octaves, 0..1.
 *
 * @param p  The point. (in)
 *
 * @return
 *   The fractal noise value, 0..1.
 **/
float fbm3( vec2 p )
{
    float v = 0.0, a = 0.5;
    for ( int i = 0; i < 3; ++i )
    {
        v += a * noise2( p );
        p = mat2( 1.6, 1.2, -1.2, 1.6 ) * p + 2.3;
        a *= 0.5;
    }
    return v;
}
/**  Mirrored repeat of a coordinate into 0..1 (seamless at every edge).
 *
 * @param uv  The coordinate, any range. (in)
 *
 * @return
 *   The coordinate mirror-repeated into 0..1.
 **/
vec2 mirrorUV( vec2 uv )
{
    return 1.0 - abs( fract( uv * 0.5 ) * 2.0 - 1.0 );
}
/**  The photo at a mip level, mirrored at its edges: lod 0 full detail, ~4 a soft field, ~7 broad masses.
 *
 * @param uv   Coordinate in the photo (mirror-repeated outside 0..1). (in)
 * @param lod  Mip level of the photo (0 = full detail). (in)
 *
 * @return
 *   The cross-faded photo colour (RGB).
 **/
vec3 imgLod( vec2 uv, float lod )
{
    uv = mirrorUV( uv );
    return ( interpolation * textureLod( tex0, uv, lod ) + ( 1.0 - interpolation ) * textureLod( tex1, uv, lod ) ).rgb;
}
/**  Luminance of a colour (Rec. 601 weights).
 *
 * @param c  The colour. (in)
 *
 * @return
 *   The luminance.
 **/
float luma( vec3 c )
{
    return dot( c, vec3( 0.299, 0.587, 0.114 ) );
}
/**  HSV (all 0..1) to RGB.
 *
 * @param c  Hue, saturation and value, all 0..1. (in)
 *
 * @return
 *   The RGB colour.
 **/
vec3 hsv2rgb( vec3 c )
{
    vec3 k = clamp( abs( mod( c.x * 6.0 + vec3( 0.0, 4.0, 2.0 ), 6.0 ) - 3.0 ) - 1.0, 0.0, 1.0 );
    return c.z * mix( vec3( 1.0 ), k, c.y );
}
/**  Saturation of a colour, 0..1.
 *
 * @param c  The colour. (in)
 *
 * @return
 *   The saturation, 0..1.
 **/
float satOf( vec3 c )
{
    float mx = max( c.r, max( c.g, c.b ) );
    return ( mx - min( c.r, min( c.g, c.b ) ) ) / max( mx, 1e-3 );
}
/**  A glowing colour for a place: the photo's own hue where it has one, a wandering hue field where it is grey.
 *
 * @param photo  The photo's colour at the place. (in)
 * @param q      The place; drives the wandering hue field. (in)
 * @param hue0   Anchor hue, 0..1. (in)
 *
 * @return
 *   The glow colour (RGB, bright).
 **/
vec3 glowColour( vec3 photo, vec2 q, float hue0 )
{
    vec3 field = hsv2rgb( vec3( fract( hue0 + 0.55 * fbm3( q * 0.8 ) + 0.03 * audioAdvance ), 0.85, 1.0 ) );
    vec3 own = photo / max( max( photo.r, max( photo.g, photo.b ) ), 1e-3 );
    own = own * own * own;
    return mix( field, own, smoothstep( 0.12, 0.35, satOf( photo ) ) );
}
/**  A colour normalised to its maximum and raised to a power: a saturated neon of it.
 *
 * @param c  The colour. (in)
 * @param k  Exponent: the higher, the purer (and darker) the neon. (in)
 *
 * @return
 *   The saturated colour.
 **/
vec3 neonOf( vec3 c, float k )
{
    vec3 n = c / max( max( c.r, max( c.g, c.b ) ), 1e-3 );
    return pow( n, vec3( k ) );
}
/**  The pixel's position, centred and aspect-corrected (y spans -0.5..0.5).
 *
 * @return
 *   The pixel's centred coordinate (y in -0.5..0.5, x scaled by the aspect).
 **/
vec2 screenP()
{
    return ( gl_FragCoord.xy / resolution - 0.5 ) * vec2( resolution.x / resolution.y, 1.0 );
}
/**  Writes the pixel: loudness brightness and a soft highlight roll-off.
 *
 * @param col  The scene's colour; written to fragColor after the finish. (in)
 **/
void finish( vec3 col )
{
    col *= 0.9 + 0.2 * audioLevel;
    vec3 t = max( col, 0.0 );
    t /= 1.0 + 0.35 * max( t.r, max( t.g, t.b ) );
    fragColor = vec4( clamp( t, 0.0, 1.0 ), 1.0 );
}
/** @{ */
vec2 gChainM, gChainDx, gChainDy; ///< gChainM: The mirrored chain coordinate of this pixel; gChainDx: Its screen
                                  ///< derivative in x; gChainDy: Its screen derivative in y.
/** @} */
/**  The photo through the chain, with its footprint-correct mip level and the luma gradient.
 *
 * @param p     The pixel's centred coordinate. (in)
 * @param bias  Bias added to the footprint's mip level. (in)
 * @param grad  Receives the luma gradient of the photo there. (out)
 *
 * @return
 *   The photo colour through the chain (RGB).
 **/
vec3 imgChain( vec2 p, float bias, out vec2 grad )
{
    vec2 c0 = chain( p );
    vec2 m0 = mirrorUV( c0 );



    vec2 dx = dFdx( m0 ), dy = dFdy( m0 );
    gChainM = m0;
    gChainDx = dx;
    gChainDy = dy;
    float lod = clamp( log2( max( max( length( dx ), length( dy ) ) * 1024.0, 1.0 ) ) + bias, 0.0, 9.0 );
    vec3  col;
    if ( chainScale > 1.5 )
    {
        float ls = max( lod - 1.0, 0.0 );
        col = 0.25
              * ( imgLod( chainSub( 0 ), ls ) + imgLod( chainSub( 1 ), ls ) + imgLod( chainSub( 2 ), ls )
                  + imgLod( chainSub( 3 ), ls ) );
    }
    else
    {
        col = imgLod( c0, lod );
    }
    float l = luma( col );
    grad = vec2( dFdx( l ), dFdy( l ) ) * 1.5;
    return col;
}
/** @{ */
float gT, gSpread, gRot, gMw; ///< gT: The chain's (or scene's) time this frame; gSpread: The spectral spread this
                              ///< frame, 0..1; gRot: The rotation phase this frame; gMw: The chain's morph position
                              ///< this frame (integrated).
/** @} */
/** @{ */
vec2 gCw, gCt; ///< gCw: Centre of the wandering transforms this frame (drifts slowly); gCt: Second centre of the
               ///< wandering transforms this frame.
/** @} */
/**  Class position of a knob value (n classes).
 *
 * @param x  The knob value, 0..1. (in)
 * @param n  Number of classes. (in)
 *
 * @return
 *   The class, 0..n-1.
 **/
int pickStage( float x, int n )
{
    return int( min( floor( clamp( x, 0.0, 1.0 ) * float( n ) ), float( n - 1 ) ) );
}
/**  The style classes in order of energy (calm .. energetic).
 *
 * @param i  Position on the energy scale. (in)
 *
 * @return
 *   The style class at that position.
 **/
int ords( int i )
{
    if ( i == 0 )
        return 0;
    if ( i == 1 )
        return 1;
    if ( i == 2 )
        return 3;
    if ( i == 3 )
        return 4;
    return 2;
}
/** @{ */
uniform vec3 walkA, walkB, walkC, walkD, walkS; ///< walkA: Stage A of the app's walk: (shown class, target class,
                                                ///< fade); walkB: Stage B of the app's walk: (shown class, target
                                                ///< class, fade); walkC: Stage C of the app's walk: (shown class,
                                                ///< target class, fade); walkD: Stage D of the app's walk: (shown
                                                ///< class, target class, fade); walkS: The style of the app's walk:
                                                ///< (shown class, target class, fade).
/** @} */
uniform float walkHost; ///< 1 when the app walks this lab's stages (walk uniforms valid).
/**  Chain walk.
 *
 * @return
 *   True if every stage walks (morphP from 0.5).
 **/
bool walkAll()
{
    return clamp( morphP, 0.0, 1.0 ) >= 0.5;
}
/**  The transform (k) and sub-variant (v) shown in walk cycle c; cycle 0 is the rolled one.
 *
 * @param c     The walk cycle (0 = the rolled pick). (in)
 * @param k0    The rolled transform. (in)
 * @param v0    The rolled sub-variant. (in)
 * @param n     Number of transforms of the stage. (in)
 * @param salt  Per-stage salt of the hash. (in)
 * @param k     Receives the transform. (out)
 * @param v     Receives the sub-variant. (out)
 **/
void walkPick( float c, int k0, float v0, int n, float salt, out int k, out float v )
{
    if ( c < 0.5 )
    {
        k = k0;
        v = v0;
        return;
    }
    float s = salt + 17.0 * ( chainAP + 2.0 * chainBP + 3.0 * chainCP + 5.0 * chainDP );
    k = int( min( floor( hash11( c * 7.31 + s ) * float( n ) ), float( n - 1 ) ) );
    v = hash11( c * 3.17 + s * 1.7 + 0.5 );
}
uniform vec3      walkO;        ///< The stage order of the app's walk: (shown order, target order, fade).
uniform float     glowP;        ///< Glow / afterglow knob, 0..1.
uniform sampler2D texPrevFrame; ///< The last frame, fully composited (feedback).
/**  Afterglow: the brighter of the colour and the decayed previous frame (from glowP 0.15).
 *
 * @param col  The frame's colour. (in)
 *
 * @return
 *   The colour with the afterglow.
 **/
vec3 chainAfterglow( vec3 col )
{
    if ( glowP <= 0.15 )
        return col;
    vec3 prev = texture( texPrevFrame, gl_FragCoord.xy / resolution ).rgb;
    return max( col, prev * ( 0.78 * smoothstep( 0.15, 1.0, glowP ) ) );
}
/** Entry point of this shader stage (the file description says what it draws). */
void main()
{
    vec2  p = screenP();
    float kick = clamp( audioKick, 0.0, 1.0 );
    float swell = clamp( audioSwell, 0.0, 1.0 );
    float mode = clamp( audioMode, 0.0, 1.0 );
    gT = ( 0.03 + 0.06 * clamp( speedP, 0.0, 1.0 ) ) * sceneTime + 0.25 * audioAdvance;
    gSpread = clamp( audioSpread, 0.0, 1.0 );
    gRot = 0.02 * sceneTime + 0.2 * audioPhase;
    gMw = 0.012 * sceneTime + 0.15 * sceneAdvance;
    gCw = vec2( 0.5 ) + 0.15 * vec2( sin( 0.017 * sceneTime ), cos( 0.013 * sceneTime ) );
    gCt = vec2( 0.5 )
          + vec2( 0.22 * sin( 0.023 * sceneTime + 0.3 * sin( 0.011 * sceneTime ) ), 0.16 * cos( 0.019 * sceneTime ) );
    vec2  grad;
    vec3  ph = imgChain( p, 1.0 - 1.2 * clamp( detailP, 0.0, 1.0 ), grad );
    float m = luma( ph );


    vec2  cm = gChainM;
    float h = hueP * 0.159 + 0.9 * cm.x + 0.6 * cm.y + 0.25 * m + 0.12 * audioPhase + 0.004 * sceneTime + 0.3 * mode;
    vec3  field = hsv2rgb( vec3( fract( h ), 0.6 + 0.35 * swell, 1.0 ) ) * ( 0.35 + 1.3 * m );
    vec3  photo = max( ( ph - m ) * 1.4 + m, 0.0 );
    photo = mix( photo, field, 0.7 * clamp( paletteP, 0.0, 1.0 ) );

    float la = 0.1 * sceneTime;
    float relief = clamp( 0.5 + dot( grad, vec2( cos( la ), sin( la ) ) ) * 5.0, 0.0, 1.0 );
    vec3  relief_c = photo * ( 0.3 + 1.2 * relief )
                     + vec3( 1.0 ) * pow( relief, 6.0 ) * ( 0.1 + 0.3 * swell + 0.35 * kick );

    vec3  gc = mix( glowColour( ph, p, hueP * 0.159 ), neonOf( field + 1e-3, 2.0 ), clamp( paletteP, 0.0, 1.0 ) );
    float edge = smoothstep( 0.01, 0.14, length( grad ) );
    vec3  neon = gc * edge * ( 1.6 + 1.6 * kick ) + photo * 0.22;

    float xi = m * 12.0 - gT * 6.0;
    float pxi = fwidth( xi ) + 1e-4;
    float iso = smoothstep( pxi * 1.5, 0.0, abs( fract( xi ) - 0.5 ) - 0.5 + pxi * 1.5 );
    vec3  iso_c = gc * iso * ( 1.3 + kick ) + photo * 0.12;




    int   s0, s1;
    float sf = 0.0, dummy;
    s0 = pickStage( styleP, 5 );
    s1 = s0;
    if ( walkHost > 0.5 && walkAll() )
    {
        s0 = pickStage( walkS.x, 5 );
        s1 = pickStage( walkS.y, 5 );
        sf = smoothstep( 0.0, 1.0, walkS.z );
    }
    else if ( walkAll() )
    {
        float kf = 0.2 * gMw + 0.6, c = floor( kf );
        walkPick( c, s0, 0.0, 5, 23.0, s0, dummy );
        walkPick( c + 1.0, pickStage( styleP, 5 ), 0.0, 5, 23.0, s1, dummy );
        sf = smoothstep( 0.7, 1.0, fract( kf ) );
    }



    vec3 flow_c = photo * 0.25;
    if ( ords( s0 ) == 4 || ( ords( s1 ) == 4 && sf > 0.0 ) )
    {
        vec2  fd = vec2( -grad.y, grad.x );
        float gl = length( fd );
        fd /= max( gl, 1e-5 );
        float hpx = 3.0 / resolution.y;
        float ph = gT * 25.0;
        float acc = 0.0, wsum = 0.0;
        for ( int k = -6; k <= 6; ++k )
        {
            float fk = float( k );
            float nz = noise2( ( gChainM + ( gChainDx * fd.x + gChainDy * fd.y ) * fk * 3.0 ) * 70.0 );
            float w = 1.0 + 0.8 * sin( fk * 0.7 - ph );
            acc += nz * w;
            wsum += w;
        }
        float lic = smoothstep( 0.38, 0.72, acc / wsum ) * smoothstep( 0.004, 0.04, gl );
        flow_c = gc * lic * ( 1.3 + kick ) + photo * 0.25;
    }
    vec3 looks[5] = vec3[5]( photo, relief_c, neon, iso_c, flow_c );
    s0 = ords( s0 );
    s1 = ords( s1 );
    vec3 col = mix( looks[s0], looks[s1], sf );
    col *= mix( vec3( 0.9, 0.97, 1.08 ), vec3( 1.08, 0.98, 0.9 ), mode );
    col += gc * edge * kick * 0.55 * ( ( s0 <= 1 ? 1.0 - sf : 0.0 ) + ( s1 <= 1 ? sf : 0.0 ) );
    if ( walkHost < -1.0 )
        col += vec3( walkA.x + walkB.x + walkC.x + walkD.x + walkO.x ); // keeps the walk uniforms
    finish( chainAfterglow( col ) );
}
