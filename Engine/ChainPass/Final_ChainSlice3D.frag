    finish(chainAfterglow(col));
    // keeps the walk uniforms: the app finds the lab's stages by their locations
    if (walkHost < -1.0) col += vec3(walkA.x + walkB.x + walkC.x + walkD.x + walkS.x + walkSpace.x + walkCore.x + walkBody.x);
    finish(col);
}
