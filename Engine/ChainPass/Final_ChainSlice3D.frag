        vec3 r1 = cross(dpy, n), r2 = cross(n, dpx);
        float det = dot(dpx, r1);
        vec3 sg = (dhx * r1 + dhy * r2) / (abs(det) > 1e-14 ? det : 1e-14);
        sg = sg / max(1.0, length(sg) * 0.1);                    // silhouettes: no spikes
        n = normalize(n - sg * 0.05 * smoothstep(0.3, 1.0, reliefP));
    }
    if (hit) {
        vec3 nGeo = n;                                          
        vec3 tex = tex0;
        float tm = luma(tex);
        tex = max((tex - tm) * 1.5 + tm, 0.0) * 1.5;           
        vec3 L = sL;
        float diff = 0.5 + 0.5 * dot(n, L);   
        float ao = gn.w;
        float fres = pow(1.0 - abs(dot(n, -rd)), 3.0);
        vec3 surf = tex * lc * (0.35 + 0.9 * diff) * ao;
        vec3 rimC = glowColour(tex, fp.xy, hueP * 0.159);
