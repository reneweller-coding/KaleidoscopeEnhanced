 * @param k  The class's branch number. (in)
 **/
void chainSetVar( float v, int k )
{
    float vi = floor( clamp( v, 0.0, 0.9999 ) * 100.0 );
    if ( vi < 0.5 )
    {
        gVar = -1.0;
        gVa = vec4( 0.5 );
        gVb = vec4( 0.5 );
        return;
