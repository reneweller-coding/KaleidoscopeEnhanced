out vec4          fragColor;    ///< The pixel's colour (output).
uniform sampler2D texIn;        ///< The previous pass's chain coordinate per pixel (RG32F).
uniform int       firstPass;    ///< 1: start from the screen position instead of texIn.
uniform float     subV;         ///< The class's sub-variant, 0..1 (mirrors, arms, lattice ...).
uniform vec2      chainOff;     ///< the target viewport's origin (gl_FragCoord of the lab = pass pixel + chainOff)
uniform float     bakeSize;     ///< > 0: the chain baked over [0,1]^2 (a lab that reads it at arbitrary points)
uniform sampler2D texStart;     ///< useStart: the chain's input per pixel (xy) and its time offset (z)
uniform int       useStart;     ///< 1: start from texStart (a 3D lab's plane input) instead of the screen.
uniform float     passScale;    ///< the pass grid relative to the frame (chainScale; 0 = 1)
uniform vec2      resolution;   ///< Size of the render target in pixels.
uniform float     sceneTime;    ///< Seconds since this scene was activated.
uniform float     audioAdvance; ///< The music's advance: integrated tempo-weighted energy (never jumps, never runs
                                ///< backwards).
uniform float audioPhase;       ///< Rotation phase driven by the music (integrated, never jumps).
uniform float audioSpread;      ///< Spectral spread, 0..1.
uniform float audioSwell;       ///< Slow loudness envelope, 0..1 (seconds).
uniform float speedP;           ///< Speed knob, 0..1.
/**  Mirrored repeat of a coordinate into 0..1 (seamless at every edge).
 *
 * @param uv  The coordinate, any range. (in)
 *
 * @return
 *   The coordinate mirror-repeated into 0..1.
 **/
vec2 mirrorUV( vec2 uv )
{
    return 1.0 - abs( fract( uv * 0.5 ) * 2.0 - 1.0 );
}
/**  The pixel's position, centred and aspect-corrected (y spans -0.5..0.5).
 *
 * @return
 *   The pixel's centred coordinate (y in -0.5..0.5, x scaled by the aspect).
 **/
vec2 screenP()
{
    return ( gl_FragCoord.xy / resolution - 0.5 ) * vec2( resolution.x / resolution.y, 1.0 );
}
/**  The {p,q} reflection folding inside the unit disk (shared by the disk and the band model).
 *
 * @param z  The point inside the unit disc. (in)
 * @param p  Sides of each polygon of the {p,q} tiling. (in)
 * @param q  Polygons meeting at each vertex. (in)
 *
 * @return
 *   The point folded into the tiling's fundamental triangle.
 **/
vec2 poincareFold( vec2 z, float p, float q )
{
    float a = 3.14159265 / p;
    float cq = cos( 3.14159265 / q ), sa = sin( a );
    float R = 1.0 / sqrt( max( cq * cq / ( sa * sa ) - 1.0, 1e-4 ) );
    vec2  cc = vec2( R * cq / sa, 0.0 );
    for ( int i = 0; i < 14; ++i )
    {
        float an = atan( z.y, z.x );
        an = abs( mod( an, 2.0 * a ) - a );
        z = length( z ) * vec2( cos( an ), sin( an ) );
        vec2  d = z - cc;
        float dd = dot( d, d );
        if ( dd < R * R )
            z = cc + d * ( R * R / dd );
    }
    return z;
}
/**  Complex division.
 *
 * @param a  The numerator. (in)
 * @param b  The denominator. (in)
 *
 * @return
 *   The quotient a / b.
 **/
vec2 cdiv( vec2 a, vec2 b )
{
    return vec2( a.x * b.x + a.y * b.y, a.y * b.x - a.x * b.y ) / max( dot( b, b ), 1e-8 );
}
/**  The hyperbolic plane in the upper half-plane, a {p,q} tiling crawling along the horizon.
 *
 * @param uv      The coordinate. (in)
 * @param c       Centre of the transform. (in)
 * @param p       Sides of each polygon of the {p,q} tiling. (in)
 * @param q       Polygons meeting at each vertex. (in)
 * @param scale   Scale of the half-plane. (in)
 * @param travel  Horizontal shift (an exact parabolic motion). (in)
 *
 * @return
 *   The transformed coordinate.
 **/
vec2 tHalfPlane( vec2 uv, vec2 c, float p, float q, float scale, float travel )
{
    vec2 w = ( uv - c ) * scale;
    w.y = abs( w.y ) + 0.04;
    w.x += travel;
    vec2 z = cdiv( w - vec2( 0.0, 1.0 ), w + vec2( 0.0, 1.0 ) );
    return c + poincareFold( z, p, q ) * 0.9;
}
/** @{ */
float gT, gSpread, gRot, gMw; ///< gT: The chain's (or scene's) time this frame; gSpread: The spectral spread this
                              ///< frame, 0..1; gRot: The rotation phase this frame; gMw: The chain's morph position
                              ///< this frame (integrated).
/** @} */
/** @{ */
vec2 gCw, gCt; ///< gCw: Centre of the wandering transforms this frame (drifts slowly); gCt: Second centre of the
               ///< wandering transforms this frame.
/** @} */
uniform float walkHost; ///< 1 when the app walks this lab's stages (walk uniforms valid).
uniform float tiltP;    ///< Tilt knob, 0..1.
uniform float tiltA;    ///< The time tilt's direction (radians) while the app walks the lab (walkHost).
/**  Time tilt of the chain: a linear ramp across the picture, along the tilt direction.
 *
 * @param q  The pixel's coordinate. (in)
 *
 * @return
 *   The tilt offset (added to the chain's time).
 **/
float chainTiltZ( vec2 q )
{
    float k = smoothstep( 0.15, 1.0, tiltP ) * 0.6 * ( 0.55 + 0.45 * clamp( audioSwell, 0.0, 1.0 ) );
    float a = walkHost > 0.5 ? tiltA : 0.011 * sceneTime;
    return k * dot( vec2( cos( a ), sin( a ) ), q );
}
/**  One class of this stage: the transform the stage applies for knob value v.
 *
 * @param uv  The coordinate. (in)
 * @param v   The stage's knob value (its class and sub-variant). (in)
 *
 * @return
 *   The transformed coordinate.
 **/
vec2 cls( vec2 uv, float v )
{
    int  j = int( floor( v * 2.99 ) );
    vec2 pq = j == 0 ? vec2( 5.0, 4.0 ) : j == 1 ? vec2( 7.0, 3.0 )
                                                 : vec2( 4.0, 6.0 );
    return tHalfPlane( uv, gCt, pq.x, pq.y, 3.0 + 2.0 * v, gT * 0.8 );
    return uv;
}

/** Entry point of this shader stage (the file description says what it draws). */
void main()
{
    gT = ( 0.03 + 0.06 * clamp( speedP, 0.0, 1.0 ) ) * sceneTime + 0.25 * audioAdvance;
    gSpread = clamp( audioSpread, 0.0, 1.0 );
    gRot = 0.02 * sceneTime + 0.2 * audioPhase;
    gCw = vec2( 0.5 ) + 0.15 * vec2( sin( 0.017 * sceneTime ), cos( 0.013 * sceneTime ) );
    gCt = vec2( 0.5 )
          + vec2( 0.22 * sin( 0.023 * sceneTime + 0.3 * sin( 0.011 * sceneTime ) ), 0.16 * cos( 0.019 * sceneTime ) );
    if ( useStart == 0 && tiltP > 0.0 )
    { // the time tilt (chainTiltZ): the same shift in every pass of this pixel
        vec2  sp0 = ( ( gl_FragCoord.xy / ( passScale > 0.0 ? passScale : 1.0 ) + chainOff ) / resolution - 0.5 )
                    * vec2( resolution.x / resolution.y, 1.0 );
        float tz = chainTiltZ( bakeSize > 0.0 ? gl_FragCoord.xy / bakeSize * 2.0 - 1.0 : sp0 );
        gT += tz;
        gRot += 0.5 * tz;
    }
    vec4 st = useStart == 1 ? texelFetch( texStart, ivec2( gl_FragCoord.xy ), 0 ) : vec4( 0.0 );
    gT += 0.3 * st.z; // the solid look: the depth along the normal is the chain's time
    gRot += 0.15 * st.z;
    vec2 fc = gl_FragCoord.xy / ( passScale > 0.0 ? passScale : 1.0 ) + chainOff; // the lab's own pixel position
                                                                                  // (screenP)
    vec2 sp = ( fc / resolution - 0.5 ) * vec2( resolution.x / resolution.y, 1.0 );
    vec2 uv0 = useStart == 1 ? st.xy : ( bakeSize > 0.0 ? gl_FragCoord.xy / bakeSize : sp * 0.5 + 0.5 );
    vec2 uv = firstPass == 1 ? uv0 : mirrorUV( texelFetch( texIn, ivec2( gl_FragCoord.xy ), 0 ).xy );
    fragColor = vec4( cls( uv, subV ), 0.0, 1.0 );
}
