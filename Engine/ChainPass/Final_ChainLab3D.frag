\*****************************************************************************/
/*! @file
 *
 *  @brief
 *  The 3D lab's last pass: colour, relief, light and fog from the G-buffer.
 *
 *  GENERATED by Tools/scenegen/make_chainpass.py.
 *
 *  @author René Weller
 */
// @chain3d
out vec4 fragColor; ///< The pixel's colour (output).
/** @{ */
uniform sampler2D texGPos, texGNrm; ///< the geometry pass
/** @} */
/** @{ */
uniform sampler2D texChain0, texChain1, texChain2; ///< the colour chain per projection plane
/** @} */
uniform vec2      chainOff;      ///< Offset of this pixel grid in the chain texture (in pixels).
uniform vec2      resolution;    ///< Size of the render target in pixels.
uniform float     time;          ///< Seconds since this activation, plus a rolled start (see sceneTime).
uniform sampler2D tex0;          ///< The current photo.
uniform sampler2D tex1;          ///< The next photo (cross-faded in by interpolation).
uniform float     interpolation; ///< Cross-fade between the photos: 1 = tex0, 0 = tex1.
uniform float     sceneTime;     ///< Seconds since this scene was activated.
uniform float     sceneAdvance;  ///< The music's advance since this scene was activated (integrated, never jumps).
uniform float     audioAdvance;  ///< The music's advance: integrated tempo-weighted energy (never jumps, never runs
                                 ///< backwards).
uniform float audioLevel;        ///< Overall loudness, 0..1.
uniform float audioPhase;        ///< Rotation phase driven by the music (integrated, never jumps).
uniform float audioSpread;       ///< Spectral spread, 0..1.
uniform float audioKick;         ///< Kick-drum envelope, 0..1 (fast attack, short decay).
uniform float audioMode;         ///< Mode of the music: 0 minor .. 1 major.
uniform float audioSwell;        ///< Slow loudness envelope, 0..1 (seconds).
uniform float reliefP;           ///< Relief knob, 0..1.
uniform float styleP;            ///< Look knob, 0..1.
uniform float speedP;            ///< Speed knob, 0..1.
uniform float detailP;           ///< Detail knob, 0..1.
uniform float paletteP;          ///< Palette knob: photo colours .. colour field, 0..1.
uniform float camP;              ///< Camera knob, 0..1.
uniform float hueP;              ///< Hue knob (radians), usually the music's chroma hue plus a rolled offset.
/**  Mirrored repeat of a coordinate into 0..1 (seamless at every edge).
 *
 * @param uv  The coordinate, any range. (in)
 *
 * @return
 *   The coordinate mirror-repeated into 0..1.
 **/
vec2 mirrorUV( vec2 uv )
{
    return 1.0 - abs( fract( uv * 0.5 ) * 2.0 - 1.0 );
}
/**  The photo at a mip level, mirrored at its edges: lod 0 full detail, ~4 a soft field, ~7 broad masses.
 *
 * @param uv   Coordinate in the photo (mirror-repeated outside 0..1). (in)
 * @param lod  Mip level of the photo (0 = full detail). (in)
 *
 * @return
 *   The cross-faded photo colour (RGB).
 **/
vec3 imgLod( vec2 uv, float lod )
{
    uv = mirrorUV( uv );
    return ( interpolation * textureLod( tex0, uv, lod ) + ( 1.0 - interpolation ) * textureLod( tex1, uv, lod ) ).rgb;
}
/**  Luminance of a colour (Rec. 601 weights).
 *
 * @param c  The colour. (in)
 *
 * @return
 *   The luminance.
 **/
float luma( vec3 c )
{
    return dot( c, vec3( 0.299, 0.587, 0.114 ) );
}
/**  HSV (all 0..1) to RGB.
 *
 * @param c  Hue, saturation and value, all 0..1. (in)
 *
 * @return
 *   The RGB colour.
 **/
vec3 hsv2rgb( vec3 c )
{
    vec3 k = clamp( abs( mod( c.x * 6.0 + vec3( 0.0, 4.0, 2.0 ), 6.0 ) - 3.0 ) - 1.0, 0.0, 1.0 );
    return c.z * mix( vec3( 1.0 ), k, c.y );
}
/**  2D rotation matrix.
 *
 * @param a  The angle in radians. (in)
 *
 * @return
 *   The rotation matrix.
 **/
mat2 rot2( float a )
{
    float c = cos( a ), s = sin( a );
    return mat2( c, -s, s, c );
}
/**  A kaleidoscope of the coordinate around a slowly wandering centre.
 *
 * @param uv     Coordinate in the photo. (in)
 * @param sides  Number of mirror wedges (whole). (in)
 *
 * @return
 *   The folded coordinate.
 **/
vec2 kaleidoUV( vec2 uv, float sides )
{
    vec2  c = vec2( 0.5 ) + 0.2 * vec2( sin( 0.0107 * sceneTime ), cos( 0.0131 * sceneTime ) );
    vec2  d = uv - c;
    float r = length( d );
    float sec = 6.2831853 / sides;
    float a = abs( mod( atan( d.y, d.x ), sec ) - 0.5 * sec );
    a += 0.03 * sceneTime + 0.25 * audioPhase;
    return c + r * vec2( cos( a ), sin( a ) );
}
/**  The photo through the scene's kaleidoscope.
 *
 * @param uv   Coordinate in the photo. (in)
 * @param lod  Mip level of the photo (0 = full detail). (in)
 *
 * @return
 *   The photo colour through the kaleidoscope (RGB).
 **/
vec3 imgK( vec2 uv, float lod )
{
    return imgLod( kaleidoUV( uv, 6.0 ), lod );
}
/**  The pixel's position, centred and aspect-corrected (y spans -0.5..0.5).
 *
 * @return
 *   The pixel's centred coordinate (y in -0.5..0.5, x scaled by the aspect).
 **/
vec2 screenP()
{
    return ( gl_FragCoord.xy / resolution - 0.5 ) * vec2( resolution.x / resolution.y, 1.0 );
}
/**  Writes the pixel: loudness brightness and a soft highlight roll-off.
 *
 * @param col  The scene's colour; written to fragColor after the finish. (in)
 **/
void finish( vec3 col )
{
    col *= 0.9 + 0.2 * audioLevel;
    vec3 t = max( col, 0.0 );
    t /= 1.0 + 0.35 * max( t.r, max( t.g, t.b ) );
    fragColor = vec4( clamp( t, 0.0, 1.0 ), 1.0 );
}
const bool ChainPhotoOnly = true; ///< Only the photos' own textures: the line looks and the colour field are not used.
vec3       gCam = vec3( 0.0 );    ///< The camera position this frame.
float      gPathAmp = 1.0;        ///< Amplitude of the camera path's wander.
float      gTube = 0.45;          ///< Radius of the flight tube this frame.
float      gSide = 0.0;           ///< Share of the side walls this frame (from the walk).
float      gWorldK = 1.0;         ///< The world's scale: the field's structures 1/gWorldK as large around the camera.
float      gThin = 0.0;           ///< How far the matter is thinned on the flight path (fading out over 1.4 units).
/**  The camera path's x/y offset at depth z.
 *
 * @param z  Depth along the flight. (in)
 *
 * @return
 *   The path's x/y offset.
 **/
vec2 camPathXY( float z )
{
    return gPathAmp
           * vec2( 1.1 * sin( z * 0.11 ) + 0.4 * sin( z * 0.23 + 1.3 ),
                   0.8 * sin( z * 0.083 + 0.7 ) + 0.3 * cos( z * 0.19 ) );
}
/**  The camera frame at depth z: on the path, looking at the path ahead.
 *
 * @param z   Depth along the flight. (in)
 * @param ro  Receives the camera position. (out)
 *
 * @return
 *   The camera frame (right, up, forward), banked into the curves.
 **/
mat3 camFrame( float z, out vec3 ro )
{
    ro = vec3( camPathXY( z ), z );
    vec3 ta = vec3( camPathXY( z + 2.0 ), z + 2.0 );
    vec3 fw = normalize( ta - ro );


    vec2  curv = camPathXY( z + 1.5 ) - 2.0 * camPathXY( z ) + camPathXY( z - 1.5 );
    float roll = clamp( -curv.x * 1.6, -0.3, 0.3 );
    vec3  up = vec3( sin( roll ), cos( roll ), 0.0 );
    vec3  rt = normalize( cross( up, fw ) );
    return mat3( rt, cross( fw, rt ), fw );
}
uniform float camHost; ///< 1 when the app drives the camera (camZ, camGaze).
uniform float camZ;    ///< Flight position along the camera path (integrated by the app).
uniform vec3  camGaze; ///< Gaze shown, gaze panned to, pan progress.
/**  (yaw, pitch, ortho, carve the tube only near the camera)
 *
 * @param k     Gaze variant (taken modulo 7). (in)
 * @param time  The scene's time. (in)
 *
 * @return
 *   Yaw, pitch, orthographic share, and whether to carve the tube only near the camera.
 **/
vec3 gazeAngles( float k, float time )
{
    float i = mod( k, 7.0 );

    if ( i > 5.5 )
        return vec3( 0.6, 0.32, 1.0 );
    if ( i > 4.5 )
        return vec3( 1.0 * sin( 0.017 * time ), 0.25 + 0.15 * sin( 0.019 * time ), 1.0 );
    if ( i > 3.5 )
        return vec3( -0.3, 0.5, 0.0 );
    if ( i > 2.5 )
        return vec3( -0.8, 0.06, 1.0 );
    if ( i > 1.5 )
        return vec3( 0.3, -0.5, 0.0 );
    if ( i > 0.5 )
        return vec3( 0.8, -0.06, 1.0 );
    return vec3( 0.0 );
}
/**  Turns a direction by the gaze angles (yaw, pitch).
 *
 * @param v  The direction. (in)
 * @param a  The gaze angles (yaw, pitch) in radians. (in)
 *
 * @return
 *   The turned direction.
 **/
vec3 gazeTurn( vec3 v, vec2 a )
{
    v.yz = rot2( a.y ) * v.yz;
    v.xz = rot2( -a.x ) * v.xz;
    return v;
}
/**  The camera's flight position (the app's integrated one, or gT).
 *
 * @param gt  The scene's own time (used without a host camera). (in)
 *
 * @return
 *   The camera's position along the flight.
 **/
float camFlight( float gt )
{
    return camHost > 0.5 ? camZ : gt;
}
/**  The ray direction of pixel p: the camera frame turned by the gaze (the host's, or one of seven).
 *
 * @param p     The pixel's centred coordinate. (in)
 * @param cam   The gaze knob, 0..1 (without a host camera). (in)
 * @param time  The scene's time. (in)
 * @param cf    The camera frame. (in)
 *
 * @return
 *   The ray direction (unit length).
 **/
vec3 gazeDir( vec2 p, float cam, float time, mat3 cf )
{
    float k0, k1, f;
    if ( camHost > 0.5 )
    {
        k0 = camGaze.x;
        k1 = camGaze.y;
        f = smoothstep( 0.0, 1.0, camGaze.z );
    }
    else
    {
        float g = floor( clamp( cam, 0.0, 0.999 ) * 7.0 ) + 0.004 * time;
        k0 = floor( g );
        k1 = k0 + 1.0;
        f = smoothstep( 0.75, 1.0, fract( g ) );
    }
    vec3 a0 = gazeAngles( k0, time ), a1 = gazeAngles( k1, time );
    a1.x += 6.2831853 * floor( ( a0.x - a1.x ) / 6.2831853 + 0.5 );
    vec3 a = mix( a0, a1, f );
    a.xy += vec2( 0.12 * sin( 0.031 * time ), 0.08 * sin( 0.023 * time + 1.0 ) );
    gSide = a.z;
    return cf * gazeTurn( normalize( vec3( p, 1.1 ) ), a.xy );
}
/** @{ */
float gT, gTC, gSpread, gRot, gMw; ///< gT: The chain's (or scene's) time this frame; gTC: The chain's time for this
                                   ///< pixel (gT plus the tilt across the picture); gSpread: The spectral spread this
                                   ///< frame, 0..1; gRot: The rotation phase this frame; gMw: The chain's morph
                                   ///< position this frame (integrated).
/** @} */
/** @{ */
vec2 gCw, gCt; ///< gCw: Centre of the wandering transforms this frame (drifts slowly); gCt: Second centre of the
               ///< wandering transforms this frame.
/** @} */
/**  A mirror count 5..9 from a sub-variant.
 *
 * @param v  The sub-variant, 0..1. (in)
 *
 * @return
 *   The mirror count, 5..9.
 **/
float sides( float v )
{
    return 5.0 + floor( v * 4.99 );
}
/** @{ */
uniform vec3 walkA, walkB, walkC, walkD, walkS; ///< walkA: Stage A of the app's walk: (shown class, target class,
                                                ///< fade); walkB: Stage B of the app's walk: (shown class, target
                                                ///< class, fade); walkC: Stage C of the app's walk: (shown class,
                                                ///< target class, fade); walkD: Stage D of the app's walk: (shown
                                                ///< class, target class, fade); walkS: The style of the app's walk:
                                                ///< (shown class, target class, fade).
/** @} */
uniform float     walkHost;     ///< 1 when the app walks this lab's stages (walk uniforms valid).
uniform float     glowP;        ///< Glow / afterglow knob, 0..1.
uniform sampler2D texPrevFrame; ///< The last frame, fully composited (feedback).
/**  Afterglow: the brighter of the colour and the decayed previous frame (from glowP 0.15).
 *
 * @param col  The frame's colour. (in)
 *
 * @return
 *   The colour with the afterglow.
 **/
vec3 chainAfterglow( vec3 col )
{
    if ( glowP <= 0.15 )
        return col;
    vec3 prev = texture( texPrevFrame, gl_FragCoord.xy / resolution ).rgb;
    return max( col, prev * ( 0.78 * smoothstep( 0.15, 1.0, glowP ) ) );
}
/** @{ */
uniform vec3 walkSpace, walkCore, walkBody; ///< walkSpace: The 3D lab's space as the app walks it: (shown, target,
                                            ///< fade); walkCore: The 3D lab's core as the app walks it: (shown, target,
                                            ///< fade); walkBody: The 3D lab's body as the app walks it: (shown, target,
                                            ///< fade).
/** @} */
/**  The palette's base hue: the knob, wandering with the music, shifted by the mode.
 *
 * @return
 *   The base hue, in turns (unwrapped).
 **/
float chainHue0()
{
    return hueP * 0.159 + 0.06 * audioPhase + 0.004 * sceneTime + 0.3 * clamp( audioMode, 0.0, 1.0 );
}
/**  A glow colour of the base hue with a little of the surface's own colour.
 *
 * @param own  The surface's own colour, a little of which the glow keeps. (in)
 * @param dh   Offset from the base hue, in turns. (in)
 *
 * @return
 *   The glow colour (RGB).
 **/
vec3 calmGlow( vec3 own, float dh )
{

    float mx = max( own.r, max( own.g, own.b ) );
    float s = ( mx - min( own.r, min( own.g, own.b ) ) ) / max( mx, 0.25 );
    vec3  o = mix( vec3( 1.0 ), own / max( mx, 1e-3 ), clamp( s * 2.0, 0.0, 1.0 ) );
    if ( ChainPhotoOnly )
        return o;
    vec3 g = hsv2rgb( vec3( fract( chainHue0() + dh ), 0.5 + 0.2 * clamp( audioSwell, 0.0, 1.0 ), 1.0 ) );
    return mix( g, o, 0.5 + 0.4 * smoothstep( 0.06, 0.3, s ) );
}
/**  How much of the colour field the surfaces take (none with chainPhotoOnly: the photos' own textures).
 *
 * @return
 *   The colour field's share, 0..0.9.
 **/
float chainPal()
{
    return ChainPhotoOnly ? 0.0 : 0.2 + 0.7 * clamp( paletteP, 0.0, 1.0 );
}
/**  A dark photo lifted: its mean brightness (the last mip) brought toward 0.32, at most 1.8 times.
 *
 * @return
 *   The factor on the photo's colour, 1..1.8 (1 without chainPhotoOnly).
 **/
float photoGain()
{
    return ChainPhotoOnly ? clamp( 0.32 / max( luma( imgLod( vec2( 0.5 ), 9.0 ) ), 0.04 ), 1.0, 1.8 ) : 1.0;
}
/**  Colour of a chain coordinate: the photo, shifted toward a hue that follows the music.
 *
 * @param c    The chain coordinate. (in)
 * @param lod  Mip level of the photo. (in)
 * @param pal  Share of the palette colour, 0..1. (in)
 *
 * @return
 *   The colour (RGB).
 **/
vec3 chainPlaneC( vec2 c, float lod, float pal )
{
    vec3 ph = imgLod( c, lod );
    vec2 m = mirrorUV( c );




    float h = chainHue0() + 0.13 * ( 0.6 * sin( 6.2831853 * m.x ) + 0.4 * sin( 6.2831853 * m.y + 1.3 ) )
              + 0.03 * luma( ph );
    float sat = 0.38 + 0.22 * clamp( audioSwell, 0.0, 1.0 );
    vec3  fc = hsv2rgb( vec3( fract( h ), sat, 1.0 ) ) * ( 0.35 + 1.3 * luma( ph ) )
               * ( 1.0 + 0.4 * clamp( audioKick, 0.0, 1.0 ) );
    return mix( ph, fc, pal );
}

/**  Colour of a surface point from the three planes' chain coordinates, weighted by its normal.
 *
 * @param n    The normal. (in)
 * @param lod  Mip level of the photo. (in)
 * @param pal  Share of the palette colour, 0..1. (in)
 *
 * @return
 *   The colour (RGB).
 **/
vec3 colour3T( vec3 n, float lod, float pal )
{
    // the three projection planes' chain coordinates, weighted by the normal (tiny weights skipped)
    vec3 w = max( pow( abs( n ), vec3( 4.0 ) ) - 0.03, 0.0 );
    w /= ( w.x + w.y + w.z );
    ivec2 ip = ivec2( gl_FragCoord.xy - chainOff );
    vec3  c = vec3( 0.0 );
    if ( w.x > 0.0 )
        c += chainPlaneC( texelFetch( texChain0, ip, 0 ).xy, lod, pal ) * w.x;
    if ( w.y > 0.0 )
        c += chainPlaneC( texelFetch( texChain1, ip, 0 ).xy, lod, pal ) * w.y;
    if ( w.z > 0.0 )
        c += chainPlaneC( texelFetch( texChain2, ip, 0 ).xy, lod, pal ) * w.z;
    return c;
}
/** Entry point of this shader stage (the file description says what it draws). */
void main()
{

    vec2  p = screenP();
    float kick = clamp( audioKick, 0.0, 1.0 );
    float swell = clamp( audioSwell, 0.0, 1.0 );
    float mode = clamp( audioMode, 0.0, 1.0 );
    gT = ( 0.15 + 0.25 * clamp( speedP, 0.0, 1.0 ) ) * sceneTime + 1.5 * audioAdvance;
    gRot = 0.02 * sceneTime + 0.2 * audioPhase;
    gSpread = clamp( audioSpread, 0.0, 1.0 );
    gTC = ( 0.03 + 0.06 * clamp( speedP, 0.0, 1.0 ) ) * sceneTime + 0.25 * audioAdvance;
    gMw = 0.012 * sceneTime + 0.15 * sceneAdvance;
    gCw = vec2( 0.5 ) + 0.15 * vec2( sin( 0.017 * sceneTime ), cos( 0.013 * sceneTime ) );
    gCt = vec2( 0.5 )
          + vec2( 0.22 * sin( 0.023 * sceneTime + 0.3 * sin( 0.011 * sceneTime ) ), 0.16 * cos( 0.019 * sceneTime ) );


    gWorldK = 2.0;
    gPathAmp = 1.0 / gWorldK;
    gThin = 0.25;
    vec3 ro;
    mat3 cf = camFrame( camFlight( gT ), ro );
    gCam = ro;
    gTube = 0.4 + 0.15 * swell;
    vec3  rd = gazeDir( p, camP, sceneTime, cf );
    ivec2 ip = ivec2( gl_FragCoord.xy - chainOff );
    vec4  gp = texelFetch( texGPos, ip, 0 ), gn = texelFetch( texGNrm, ip, 0 );
    float t = gp.w;
    bool  hit = t >= 0.0;
    vec3  fp = gp.xyz;
    vec3  lc = ChainPhotoOnly ? vec3( 1.0 ) : mix( vec3( 0.7, 0.85, 1.1 ), vec3( 1.15, 0.9, 0.7 ), mode );


    vec3 fog_pal = hsv2rgb( vec3( fract( chainHue0() + 0.08 ), 0.4, 1.0 ) );


    vec3 fog_c = mix( calmGlow( imgK( vec2( 0.5 ) + 0.2 * p, 5.0 ), 0.04 ), fog_pal,
                      ChainPhotoOnly ? 0.0 : 0.8 * clamp( paletteP, 0.0, 1.0 ) )
                 * ( 0.08 + 0.1 * swell );
    vec3 col = fog_c;
    // colour and relief for every pixel: the derivatives must not sit in a pixel branch
    vec3  q = ro + rd * max( t, 0.0 );
    vec3  n = normalize( gn.xyz + vec3( 1e-6 ) );
    float lod = clamp( log2( max( t, 0.05 ) * gWorldK * 2.0 ) + 1.5 * ( 1.0 - clamp( detailP, 0.0, 1.0 ) ), 0.0, 7.0 );
    vec3  n_geo = n; // texture on the geometric normal, light on the bumped one
    vec3  tex0 = colour3T( n_geo, lod, chainPal() );
    // relief: the colour chain's brightness as height; its slope on the surface from the
    // screen-space derivatives (bump mapping without tangents, Mikkelsen 2010)
    float hgt = luma( tex0 );
    vec3  dpx = dFdx( q ), dpy = dFdy( q );
    float dhx = dFdx( hgt ), dhy = dFdy( hgt );
    if ( !ChainPhotoOnly && reliefP > 0.3 )
    {
        vec3  r1 = cross( dpy, n ), r2 = cross( n, dpx );
        float det = dot( dpx, r1 );
        vec3  sg = ( dhx * r1 + dhy * r2 ) / ( abs( det ) > 1e-14 ? det : 1e-14 );
        sg = sg / max( 1.0, length( sg ) * 0.1 ); // silhouettes: no spikes
        n = normalize( n - sg * 0.05 * smoothstep( 0.3, 1.0, reliefP ) );
    }
    if ( hit )
    {
        vec3  n_geo = n;
        vec3  tex = tex0;
        float tm = luma( tex );


        tex = max( ( tex - tm ) * ( ChainPhotoOnly ? 1.0 : 1.1 ) + tm, 0.0 ) * ( ChainPhotoOnly ? 1.9 : 1.5 )
              * photoGain();
        vec3  L = normalize( vec3( 0.5, 0.7, -0.4 ) );
        float diff = max( dot( n, L ), 0.0 );
        float ao = gn.w;
        float fres = pow( 1.0 - abs( dot( n, -rd ) ), 3.0 );



        float lamp = max( dot( n, -rd ), 0.0 ) / ( 1.0 + 0.15 * t * t );
        float drift = 0.8
                      + 0.4
                            * smoothstep( -0.6, 0.6,
                                          sin( 0.45 * q.x + 0.8 * sin( 0.21 * q.z ) )
                                              * sin( 0.38 * q.y + 0.17 * q.z + 1.3 ) );
        vec3  surf = tex * lc * ( 0.3 + 0.75 * diff + 0.45 * lamp ) * ao * drift;
        vec3  rim_c = calmGlow( tex, 0.05 * sin( fp.x + fp.y ) );
        vec3  rim = rim_c * fres * ( 0.7 + 1.5 * kick ) + surf * 0.4;
        float st = ChainPhotoOnly ? 0.0 : clamp( styleP, 0.0, 1.0 );
        vec3  sc = mix( surf + rim_c * fres * ( ChainPhotoOnly ? 0.0 : 0.15 + 0.6 * kick ),
                        rim * 1.3 + rim_c * 0.12 * ao, smoothstep( 0.5, 1.0, st ) );
        col = mix( fog_c, sc, exp( -t * ( 0.09 + 0.04 * swell ) ) );
    }
    finish( chainAfterglow( col ) );
    // keeps the walk uniforms: the app finds the lab's stages by their locations
    if ( walkHost < -1.0 )
        col += vec3( walkA.x + walkB.x + walkC.x + walkD.x + walkS.x + walkSpace.x + walkCore.x + walkBody.x );
    finish( col );
}
