#elif SPEC_SP0 == 3
    q = fOcta(fRepeat(p, vec3(1.5)));
#elif SPEC_SP0 == 4
    q = fRepeat(fRot(p, vec3(0.0, 0.0, 1.0), 0.3 * sin(gRot)), vec3(1.2, 1.2, 1.8));
#elif SPEC_SP0 == 5
