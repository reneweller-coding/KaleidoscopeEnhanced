float field3(vec3 p)
{
    float xs = spaceP, xc = coreP, xb = bodyP, ys = xs, yc = xc, yb = xb, f = 0.0;
    if (walkHost > 0.5 && walkAll()) {
        xs = walkSpace.x; xc = walkCore.x; xb = walkBody.x;
        ys = walkSpace.y; yc = walkCore.y; yb = walkBody.y;
        f = smoothstep(0.0, 1.0, max(walkSpace.z, max(walkCore.z, walkBody.z)));   
    }
    float d0 = fieldK_0(p, xs, xc, xb, 0);
#if SPEC_SP0 == SPEC_SP1 && SPEC_CO0 == SPEC_CO1 && SPEC_BO0 == SPEC_BO1
    return d0;
#else
    if (f <= 0.0) return d0;
    vec3 p0 = gP;
    float d1 = fieldK_1(p, ys, yc, yb, 1);
    gP = mix(p0, gP, f);
    return mix(d0, d1, f);
#endif
}
/// @brief Entry point of this shader stage (the file description says what it draws).
void main()
{

    vec2 p = screenP();
