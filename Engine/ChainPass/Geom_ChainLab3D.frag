    d = sdNeovius(q * (3.0 / bs), 0.4 + 0.8 * gSpread) * bs / 3.0;
#elif SPEC_BO1 == 13
    d = sdLidinoid(q * (3.0 / bs), 0.05 + 0.05 * gSpread) * bs / 3.0;
#elif SPEC_BO1 == 8
    d = min(min(length(q.xy), length(q.yz)), length(q.zx)) - 0.1 * bs * th;
#elif SPEC_BO1 == 14
    d = min(sdTetra3(q, 0.4 * bs * th), sdTetra3(-q, 0.4 * bs * th));
#elif SPEC_BO1 == 15
