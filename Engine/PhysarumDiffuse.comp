#version 430
/**
 * @file PhysarumDiffuse.comp
 * @brief Compute-shader port of PhysarumDiffuse.frag (the migration's proof of
 * the GL 4.3 compute path): 3x3 mean blur (pheromone diffusion) x decay
 * (evaporation), one invocation per trail texel, result written via image
 * store instead of an FBO pass.  The math mirrors the fragment version
 * exactly — texture() at texel centers with fract() wrap — so both paths
 * produce identical trails and the host can fall back transparently.
 */

layout(local_size_x = 16, local_size_y = 16) in;
layout(rgba16f, binding = 0) writeonly uniform image2D imgTrail;

uniform sampler2D texTrail;
uniform vec2  resolution;      // trail-map size
uniform float decay;

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= int(resolution.x) || p.y >= int(resolution.y))
        return;

    vec2 uv = (vec2(p) + 0.5) / resolution;
    vec2 px = 1.0 / resolution;

    vec2 sum = vec2(0.0);
    for (int y = -1; y <= 1; ++y)
        for (int x = -1; x <= 1; ++x)
            sum += texture(texTrail, fract(uv + vec2(float(x), float(y)) * px)).rg;
    sum /= 9.0;

    imageStore(imgTrail, p, vec4(sum * decay, 0.0, 1.0));
}
