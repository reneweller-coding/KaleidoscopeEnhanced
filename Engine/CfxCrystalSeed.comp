#version 430
/**
 * @file CfxCrystalSeed.comp
 * @brief Clears the crystal field image and stamps five solid seed nuclei that CfxCrystal.comp's random walkers will grow from.
 *
 * Runs once before CfxCrystal.comp's per-frame diffusion-limited-aggregation
 * steps. Writes to `imgField` (binding 0): one central nucleus plus four
 * scattered ones (positions hashed from `seed`) so multiple branch
 * structures grow toward each other and eventually knit together, versus a
 * single edge-aligned seed line which would grow a flat Eden-growth wall
 * instead of DLA branching.
 */
// CfxCrystalSeed.comp — clear the crystal field and drop the seed nuclei.
// R = solid, G = unused, B = hue index.
//
// Radial nuclei rather than a seed LINE along one edge: a line grows into a
// flat advancing wall (Eden growth), which fills the frame with uniform noise
// and has none of the branching that makes DLA worth the compute.
layout(local_size_x = 16, local_size_y = 16) in;
layout(rgba16f, binding = 0) uniform image2D imgField;

uniform ivec2 size;
uniform uint  seed;
uniform float hue;

uint pcg(inout uint s)
{
    s = s * 747796405u + 2891336453u;
    uint w = ((s >> ((s >> 28) + 4u)) ^ s) * 277803737u;
    return (w >> 22) ^ w;
}
float rnd(inout uint s) { return float(pcg(s)) * (1.0 / 4294967296.0); }

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= size.x || p.y >= size.y) return;

    vec2 uv = (vec2(p) + 0.5) / vec2(size);
    vec2 ar = vec2(float(size.x) / float(size.y), 1.0);

    bool solid = false;
    // Five nuclei: one central, four scattered, so several crystals grow
    // toward each other and eventually knit together.
    for (int i = 0; i < 5; ++i)
    {
        uint rs = seed + uint(i) * 7919u;
        pcg(rs);
        vec2 cpos = (i == 0) ? vec2(0.5, 0.5)
                             : vec2(0.18 + 0.64 * rnd(rs), 0.18 + 0.64 * rnd(rs));
        if (length((uv - cpos) * ar) < 0.006) solid = true;
    }

    imageStore(imgField, p, solid ? vec4(1.0, 0.0, hue, 1.0)
                                  : vec4(0.0, 0.0, 0.0, 1.0));
}
