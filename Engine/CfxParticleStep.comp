#version 430
/*****************************************************************************\
 *                              CfxParticleStep.comp
\*****************************************************************************/
/*! @file
 *
 *  @brief
 *  Advects the particle swarm through a divergence-free curl-noise field and splats each particle's photo colour
 *  into the accumulator.
 *
 *  Reads and updates the Parts buffer (binding 1, xy = position, zw =
 *  velocity) seeded by CfxParticleInit.comp. Velocity is the curl of a
 *  layered value-noise potential (curl guarantees zero divergence, so
 *  particles swirl without bunching into sinks), nudged by audio level and
 *  blown outward on a kick. A small fraction of particles is re-seeded to a
 *  random position each frame so the field keeps drawing fresh colour from
 *  texPhoto instead of draining into the vortices. Each particle samples its
 *  own colour from texPhoto, brightens with speed, and additively splats
 *  (atomicAdd) into the uint accumulator at binding 0, which CfxResolve.comp
 *  later tonemaps into the display texture.
 *
 *  @author René Weller
 */
// -----------------------------------------------------------------------
// Velocity comes from the CURL of a scalar noise potential, so the field is
// divergence-free by construction: particles swirl and never bunch up into
// sinks.  Each particle carries the colour of the photo at its birth spot,
// which makes the picture dissolve into flowing silk instead of being
// replaced by an abstract pattern.
//
// The splat is the reason this needs compute: every thread writes to the
// pixel its particle happens to be over, which a fragment shader cannot do.
// -----------------------------------------------------------------------

/// Layout qualifiers of this stage (work-group size, or the primitive in or out).
layout( local_size_x = 256 ) in;

/// The accumulation buffer: colour and coverage per pixel, added atomically; the present pass resolves it.
layout( std430, binding = 0 ) buffer Accum
{
    uint acc[];
};
/// The particles: position (xy) and velocity (zw).
layout( std430, binding = 1 ) buffer Parts
{
    vec4 part[];
};

uniform sampler2D texPhoto;  ///< The photo.
uniform ivec2     size;      ///< Size of the simulation grid in cells.
uniform uint      count;     ///< Number of elements (boids, particles, walkers ...).
uniform float     dt;        ///< Time step of the simulation (seconds).
uniform float     flow;      ///< integrated travel phase
uniform float     curlPhase; ///< integrated field-morph phase
uniform float     kick;      ///< Kick envelope, 0..1.
uniform float     level;     ///< The music's level, 0..1.
uniform float     hue;       ///< Hue offset of the palette.
uniform float     drop;      ///< Drop envelope, 0..1.
uniform uint      frame;     ///< Frame counter (seeds the random numbers).
uniform float     partDepth; ///< The photo relief's amount (the scene's partDepthP); 0 = the old step.
uniform sampler2D texPhotoB; ///< The photo of the second slot (bound only while partDepth > 0).
uniform float     photoMix;  ///< Cross-fade between the photos: 1 = texPhoto, 0 = texPhotoB.
uniform vec2      photoMap;  ///< Whether texPhoto (x) / texPhotoB (y) carry a depth map in alpha: 1 or 0.

const float Scale = 256.0; ///< Fixed-point scale of the accumulation buffer (colour times Scale, added as integers).

/**  PCG random step: advances the state, returns 32 random bits.
 *
 * @param s  The state; advanced. (in,out)
 *
 * @return
 *   32 random bits.
 **/
uint pcg( inout uint s )
{
    s = s * 747796405u + 2891336453u;
    uint w = ( ( s >> ( ( s >> 28 ) + 4u ) ) ^ s ) * 277803737u;
    return ( w >> 22 ) ^ w;
}
/**  Random number 0..1 from a PCG state.
 *
 * @param s  The PCG state; advanced. (in,out)
 *
 * @return
 *   A random number 0..1.
 **/
float rnd( inout uint s )
{
    return float( pcg( s ) ) * ( 1.0 / 4294967296.0 );
}

/**  Pseudo-random number 0..1 from a 2D point.
 *
 * @param p  The point. (in)
 *
 * @return
 *   A pseudo-random number 0..1.
 **/
float hash21( vec2 p )
{
    p = fract( p * vec2( 123.34, 456.21 ) );
    p += dot( p, p + 45.32 );
    return fract( p.x * p.y );
}

/**  Smooth value noise, 0..1.
 *
 * @param p  The point. (in)
 *
 * @return
 *   The noise value, 0..1.
 **/
float vnoise( vec2 p )
{
    vec2 i = floor( p ), f = fract( p );
    f = f * f * ( 3.0 - 2.0 * f );
    float a = hash21( i ), b = hash21( i + vec2( 1, 0 ) );
    float c = hash21( i + vec2( 0, 1 ) ), d = hash21( i + vec2( 1, 1 ) );
    return mix( mix( a, b, f.x ), mix( c, d, f.x ), f.y );
}

/**  Scalar stream function; its curl is the (divergence-free) velocity.
 *
 * @param p  The point. (in)
 *
 * @return
 *   The stream function's value.
 **/
float potential( vec2 p )
{
    float s = vnoise( p * 2.3 + vec2( curlPhase, -curlPhase * 0.7 ) ) * 1.0
              + vnoise( p * 5.1 - vec2( curlPhase * 1.3, curlPhase ) ) * 0.45
              + vnoise( p * 11.0 + vec2( curlPhase * 0.4, curlPhase * 1.7 ) ) * 0.18;
    // A slow global rotation keeps the whole frame in motion even in quiet
    // passages (the noise alone can locally stall).
    float r = length( p - 0.5 );
    return s + 0.55 * sin( flow * 0.5 + r * 6.0 );
}

/**  Curl of a scalar potential: a divergence-free velocity field.
 *
 * @param p  The point. (in)
 *
 * @return
 *   The velocity.
 **/
vec2 curl( vec2 p )
{
    const float e = 0.0035;
    float       dx = potential( p + vec2( e, 0.0 ) ) - potential( p - vec2( e, 0.0 ) );
    float       dy = potential( p + vec2( 0.0, e ) ) - potential( p - vec2( 0.0, e ) );
    return vec2( dy, -dx ) / ( 2.0 * e );
}

/**  The photo relief at a point: the two photo slots' depth (alpha, 1 = near, 0 = far) blended with the cross-fade; a
 * slot without a map counts as flat and far, so a photo change never jumps.
 *
 * @param p  The point, 0..1. (in)
 *
 * @return
 *   The relief's height, 0 (far, or no map) .. 1 (near).
 **/
float relief( vec2 p )
{
    // mip 2: the forms, not the terraces of the 8-bit map (their steps would put noise into the force)
    return photoMix * photoMap.x * textureLod( texPhoto, p, 2.0 ).a
           + ( 1.0 - photoMix ) * photoMap.y * textureLod( texPhotoB, p, 2.0 ).a;
}

/**  A bird gets a small CROSS footprint, not a single texel.
 *
 * @param uv   Position in the field, 0..1. (in)
 * @param col  The colour. (in)
 * @param w    The weight of the centre texel. (in)
 **/
void splat( vec2 uv, vec3 col, float w )
{
    ivec2 ip = ivec2( uv * vec2( size ) );
    if ( ip.x < 0 || ip.y < 0 || ip.x >= size.x || ip.y >= size.y )
        return;
    uint i = uint( ip.y * size.x + ip.x ) * 4u;
    vec3 c = max( col, vec3( 0.0 ) ) * w;
    atomicAdd( acc[i + 0u], uint( c.r * Scale ) );
    atomicAdd( acc[i + 1u], uint( c.g * Scale ) );
    atomicAdd( acc[i + 2u], uint( c.b * Scale ) );
    atomicAdd( acc[i + 3u], uint( w * Scale ) );
}

/** Entry point of this shader stage (the file description says what it draws). */
void main()
{
    uint i = gl_GlobalInvocationID.x;
    if ( i >= count )
        return;

    vec4 s = part[i];
    vec2 pos = s.xy;
    vec2 vel = s.zw;

    // Recycle a slice of the population every frame so the field keeps being
    // re-seeded from the photo instead of slowly emptying into the vortices.
    uint rs = i * 2246822519u + frame * 2654435761u;
    pcg( rs );
    if ( rnd( rs ) < 0.004 + 0.02 * drop )
    {
        pos = vec2( rnd( rs ), rnd( rs ) );
        vel = vec2( 0.0 );
    }

    vec2 f = curl( pos ) * ( 0.045 + 0.075 * level );
    // Kicks blow the swarm radially outward from the centre.
    vec2 rad = pos - 0.5;
    f += normalize( rad + 1e-5 ) * kick * 0.55;

    // Plan 27.11. P7: the photo's depth as a landscape. The slope is a force -- the particles drift downhill into
    // the far regions and gather there (this part of the field has divergence on purpose) -- and the near regions
    // deflect them like soft obstacles: the part of the velocity that climbs a slope is taken away where the
    // ground is near, so the swarm slides around the subject along its contour. partDepth 0: the old step.
    if ( partDepth > 0.0 )
    {
        const float e = 0.006; // ~3 texels of a 512 map: the slope of the forms, not of the map's noise
        vec2        g = vec2( relief( pos + vec2( e, 0.0 ) ) - relief( pos - vec2( e, 0.0 ) ),
                              relief( pos + vec2( 0.0, e ) ) - relief( pos - vec2( 0.0, e ) ) )
                        / ( 2.0 * e );
        float       gLen = length( g );
        // Soft-limited: a depth edge (slope 20 and more) pushes at most ~0.2 of the picture a second.
        f -= g / ( 1.0 + 0.15 * gLen ) * 0.03 * partDepth;
        vec2  up = g / ( gLen + 1e-4 );
        float nearK = smoothstep( 0.45, 0.85, relief( pos ) ) * smoothstep( 0.2, 1.5, gLen );
        f -= up * max( dot( f, up ), 0.0 ) * nearK * min( partDepth, 1.0 );
    }

    vel = mix( vel, f, clamp( dt * 5.0, 0.0, 1.0 ) );
    pos += vel * dt;
    pos = fract( pos + 1.0 ); // seamless wrap

    part[i] = vec4( pos, vel );

    // Photo colour at the particle, warmed by its own speed.
    vec3  photo = texture( texPhoto, pos ).rgb;
    float sp = clamp( length( vel ) * 2.2, 0.0, 1.5 );
    vec3  tint = 0.5 + 0.5 * cos( 6.2831853 * ( sp * 0.35 + vec3( 0.0, 0.33, 0.67 ) ) + hue );
    // Brightness rides hard on SPEED: slow particles stay dark so only the
    // convergence lines of the flow field light up as filaments.  A flat
    // brightness turned the whole field into an even wash of paint.
    float lum = pow( sp, 1.4 );
    vec3  col = mix( photo, photo * tint * 1.9, 0.60 ) * ( 0.16 + 1.8 * lum );

    splat( pos, col, 0.13 + 0.85 * lum );
}
