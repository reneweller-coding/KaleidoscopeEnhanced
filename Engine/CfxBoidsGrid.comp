#version 430
/**
 * @file CfxBoidsGrid.comp
 * @brief Bins every boid into a uniform spatial-hash grid via atomic counters, rebuilt fresh each frame.
 *
 * Runs between CfxBoidsInit.comp (one-time seeding) and CfxBoidsStep.comp
 * (per-frame update) in the boids pipeline. Reads the position half of the
 * `Boids` SSBO (binding 1) and writes cell occupancy into the `Grid` SSBO
 * (binding 2), a `[count, idx0..idx(perCell-1)]` slot per cell; the host
 * clears the grid buffer to zero before dispatch. CfxBoidsStep.comp then
 * uses this grid to test each boid against only its 3x3 neighbouring cells
 * instead of the full population.
 */
// CfxBoidsGrid.comp — bin every boid into a uniform grid with atomics.
// This is what buys the flock a REAL neighbourhood: without a spatial index
// each boid would have to test all 131k others (1.7e10 pairs per frame).
layout(local_size_x = 256) in;

layout(std430, binding = 1) buffer Boids { vec4 boid[]; };
layout(std430, binding = 2) buffer Grid  { uint cell[]; };

uniform uint count;
uniform int  gridN;
uniform int  perCell;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= count) return;

    vec2 p = fract(boid[i].xy);
    ivec2 g = clamp(ivec2(p * float(gridN)), ivec2(0), ivec2(gridN - 1));
    uint base = uint(g.y * gridN + g.x) * uint(perCell + 1);

    uint slot = atomicAdd(cell[base], 1u);
    if (slot < uint(perCell))
        cell[base + 1u + slot] = i;
}
