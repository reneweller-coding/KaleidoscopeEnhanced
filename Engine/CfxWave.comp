#version 430
/**
 * @file CfxWave.comp
 * @brief First half of the caustics effect: integrates a damped 2D wave equation to produce the water's height field.
 *
 * Reads the previous height field (image binding 0: R = h(t), G = h(t-1)) and
 * writes the next step (binding 1) via explicit second-order integration of
 * the wave equation over a 5-point Laplacian stencil, damped each step. An
 * audio kick or an explicit dropPos/dropAmp adds a smooth Gaussian dimple
 * ("stone") rather than a hard spike, keeping the wavefront band-limited so
 * it doesn't alias into checkerboard noise. Uses an 18x18 shared-memory tile
 * (16x16 workgroup plus a one-texel halo) so each texel is fetched once per
 * workgroup rather than once per stencil sample. CfxPhoton.comp reads this
 * height field next to refract photons onto the pool floor.
 */
layout(local_size_x = 16, local_size_y = 16) in;

layout(rgba16f, binding = 0) readonly  uniform image2D imgSrc;
layout(rgba16f, binding = 1) writeonly uniform image2D imgDst;

uniform ivec2 size;
uniform float damp;
uniform float speed;       // c^2 * dt^2 / dx^2, keep < 0.5 for stability
uniform float kick;
uniform vec2  dropPos;
uniform float dropAmp;

shared float tile[18][18];

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 l = ivec2(gl_LocalInvocationID.xy) + ivec2(1);

    ivec2 c = clamp(p, ivec2(0), size - ivec2(1));
    tile[l.y][l.x] = imageLoad(imgSrc, c).r;

    // Halo: the edge lanes also fetch the ring around the tile.
    if (gl_LocalInvocationID.x == 0u)
        tile[l.y][0] = imageLoad(imgSrc, clamp(c - ivec2(1, 0), ivec2(0), size - 1)).r;
    if (gl_LocalInvocationID.x == 15u)
        tile[l.y][17] = imageLoad(imgSrc, clamp(c + ivec2(1, 0), ivec2(0), size - 1)).r;
    if (gl_LocalInvocationID.y == 0u)
        tile[0][l.x] = imageLoad(imgSrc, clamp(c - ivec2(0, 1), ivec2(0), size - 1)).r;
    if (gl_LocalInvocationID.y == 15u)
        tile[17][l.x] = imageLoad(imgSrc, clamp(c + ivec2(0, 1), ivec2(0), size - 1)).r;

    barrier();

    if (p.x >= size.x || p.y >= size.y) return;

    vec4  s     = imageLoad(imgSrc, p);
    float h     = s.r;
    float hprev = s.g;

    float lap = tile[l.y][l.x - 1] + tile[l.y][l.x + 1]
              + tile[l.y - 1][l.x] + tile[l.y + 1][l.x] - 4.0 * h;

    float hNew = (2.0 * h - hprev + speed * lap) * damp;

    // Stone: a smooth dimple, so the wave front stays band-limited (a hard
    // spike would alias into checkerboard noise on the very first step).
    if (dropAmp > 0.001)
    {
        vec2 uv = (vec2(p) + 0.5) / vec2(size);
        float d = length((uv - dropPos) * vec2(float(size.x) / float(size.y), 1.0));
        hNew += dropAmp * exp(-d * d * 900.0);
    }

    imageStore(imgDst, p, vec4(clamp(hNew, -4.0, 4.0), h, 0.0, 1.0));
}
