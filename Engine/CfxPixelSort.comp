#version 430
/**
 * @file CfxPixelSort.comp
 * @brief Sorts every row of the source image by luminance (the pixel-sort glitch-art effect), one workgroup per row.
 *
 * One workgroup handles one image row: it histograms the row's pixels into
 * 256 luminance buckets in shared memory using atomics, computes an exclusive
 * prefix sum over the histogram on a single thread, then scatters each pixel
 * to the output position (image binding 0) its bucket has earned. Samples
 * texSrc rather than an image binding for input. The bias uniform rotates the
 * sort key over time so the melt direction drifts, and reverse flips
 * dark-to-bright versus bright-to-dark; the display/combine stage decides
 * where in the frame the sorted result is revealed.
 */
// -----------------------------------------------------------------------
// A counting sort in SHARED MEMORY: histogram the row's 256 luminance
// buckets with atomics, prefix-sum them, then SCATTER each pixel to the
// position its bucket has earned.  Both the histogram and the scatter are
// operations a fragment shader has no way to express — it would have to
// know, for its own pixel, how many pixels in the row are darker, which is
// a reduction over the whole row per pixel.
//
// Rows are sorted whole; WHERE the sorted version is revealed is decided by
// the display shader, so the melt can spread and retreat with the music.
// -----------------------------------------------------------------------

layout(local_size_x = 256) in;

layout(rgba16f, binding = 0) writeonly uniform image2D imgOut;
uniform sampler2D texSrc;

uniform ivec2 size;
uniform float bias;        // rotates the sort key so the melt direction drifts
uniform int   reverse;     // 1 = bright-to-dark

shared uint hist[256];
shared uint ofs[256];

void main()
{
    int y = int(gl_WorkGroupID.x);
    if (y >= size.y) return;
    uint lid = gl_LocalInvocationID.x;

    hist[lid] = 0u;
    barrier();

    // --- histogram ---
    for (int x = int(lid); x < size.x; x += 256)
    {
        vec3 c = texture(texSrc, (vec2(x, y) + 0.5) / vec2(size)).rgb;
        float l = fract(dot(c, vec3(0.299, 0.587, 0.114)) + bias);
        uint b = uint(clamp(l, 0.0, 0.999) * 256.0);
        if (reverse == 1) b = 255u - b;
        atomicAdd(hist[b], 1u);
    }
    barrier();

    // --- exclusive prefix sum (256 entries: one thread is plenty) ---
    if (lid == 0u)
    {
        uint run = 0u;
        for (int i = 0; i < 256; ++i) { ofs[i] = run; run += hist[i]; }
    }
    barrier();

    // --- scatter ---
    for (int x = int(lid); x < size.x; x += 256)
    {
        vec3 c = texture(texSrc, (vec2(x, y) + 0.5) / vec2(size)).rgb;
        float l = fract(dot(c, vec3(0.299, 0.587, 0.114)) + bias);
        uint b = uint(clamp(l, 0.0, 0.999) * 256.0);
        if (reverse == 1) b = 255u - b;
        uint pos = atomicAdd(ofs[b], 1u);
        if (pos < uint(size.x))
            imageStore(imgOut, ivec2(int(pos), y), vec4(c, 1.0));
    }
}
