#version 430
/**
 * @file CfxFerro.comp
 * @brief Advances a ferrofluid height field one step via the (symmetry-broken) Swift-Hohenberg pattern-forming equation, producing hexagonal Rosensweig-instability spikes.
 *
 * Self-contained per-frame update: reads the previous height field from
 * `imgSrc` (binding 0) and writes the new one to `imgDst` (binding 1),
 * expecting the host to ping-pong the two images across frames. Evaluates a
 * 13-point stencil to approximate the biharmonic operator needed by
 * (1+laplacian)^2, adds a quadratic term that breaks the +/-h symmetry so
 * the field settles into hexagonal peaks rather than a labyrinth pattern,
 * and injects PCG-hashed noise each frame (scaled by `seedAmp`, boosted by
 * `kick`) so the instability has something to amplify. `rParam` (bass-driven)
 * is the bifurcation control: below zero the surface stays flat, above it
 * spikes stand up.
 */
// CfxFerro.comp — ferrofluid spikes via the Swift-Hohenberg equation.
// -----------------------------------------------------------------------
//   dh/dt = r*h - (1 + laplacian)^2 h - h^3
// This is the canonical pattern-forming PDE: it selects ONE wavelength and
// grows a hexagonal lattice of peaks out of noise, which is exactly the
// Rosensweig instability a real ferrofluid shows in a magnetic field.  The
// bass drives r — below the threshold the surface is flat, above it the
// spikes stand up.
//
// Expanding (1 + lap)^2 needs the BIHARMONIC, so this is a 13-point stencil.
// -----------------------------------------------------------------------
layout(local_size_x = 16, local_size_y = 16) in;

layout(rgba16f, binding = 0) readonly  uniform image2D imgSrc;
layout(rgba16f, binding = 1) writeonly uniform image2D imgDst;

uniform ivec2 size;
uniform float rParam;      // control parameter: < 0 flat, > 0 patterned
uniform float qScale;      // 1/spacing^2: sets the selected WAVELENGTH
uniform float gQuad;       // quadratic term: stripes (0) -> hexagonal spikes
uniform float dt;
uniform float kick;
uniform float seedAmp;
uniform uint  frame;

float hAt(ivec2 p) { return imageLoad(imgSrc, clamp(p, ivec2(0), size - ivec2(1))).r; }

uint pcg(inout uint s)
{
    s = s * 747796405u + 2891336453u;
    uint w = ((s >> ((s >> 28) + 4u)) ^ s) * 277803737u;
    return (w >> 22) ^ w;
}
float rnd(inout uint s) { return float(pcg(s)) * (1.0 / 4294967296.0); }

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= size.x || p.y >= size.y) return;

    float h = hAt(p);

    float n = hAt(p + ivec2(1, 0)) + hAt(p - ivec2(1, 0))
            + hAt(p + ivec2(0, 1)) + hAt(p - ivec2(0, 1));
    float diag = hAt(p + ivec2(1, 1)) + hAt(p + ivec2(1, -1))
               + hAt(p + ivec2(-1, 1)) + hAt(p + ivec2(-1, -1));
    float far = hAt(p + ivec2(2, 0)) + hAt(p - ivec2(2, 0))
              + hAt(p + ivec2(0, 2)) + hAt(p - ivec2(0, 2));

    // The Swift-Hohenberg operator selects k = 1 in the units of its
    // Laplacian.  On a raw pixel grid that is a SIX PIXEL wavelength, which
    // at display scale is indistinguishable from noise — qScale stretches
    // the spacing so the spikes come out at a visible size.
    float lap  = (n - 4.0 * h) * qScale;
    // Standard 13-point biharmonic.
    float lap2 = (20.0 * h - 8.0 * n + 2.0 * diag + 1.0 * far) * qScale * qScale;

    // The QUADRATIC term is what makes spikes instead of stripes: pure
    // Swift-Hohenberg (r*h - (1+lap)^2 h - h^3) is symmetric under h -> -h and
    // settles into a labyrinth.  Breaking that symmetry with +g*h^2 selects the
    // hexagonal peak lattice a real ferrofluid forms in a magnetic field.
    float dh = rParam * h - (h + 2.0 * lap + lap2)
             + gQuad * h * h - h * h * h;

    // Kicks inject fresh noise, which is what the instability amplifies into
    // new spikes; without a seed a perfectly flat field never breaks symmetry.
    uint rs = uint(p.y * size.x + p.x) * 2654435761u + frame * 2246822519u;
    pcg(rs);
    dh += (rnd(rs) - 0.5) * seedAmp;

    float hNew = clamp(h + dt * dh, -3.0, 3.0);
    imageStore(imgDst, p, vec4(hNew, h, 0.0, 1.0));
}
