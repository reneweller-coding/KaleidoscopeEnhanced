#version 430
/**
 * @file CfxNBodyStep.comp
 * @brief Integrates one frame of the N-body galaxy collision and splats stars into the accumulator.
 *
 * Reads and updates the position (binding 1) and velocity (binding 2) buffers
 * seeded by CfxNBodyInit.comp. Gravity is evaluated against a strided sample of
 * the population (every 32nd body) using workgroup shared memory to tile the
 * O(n^2) force loop, so it stays affordable while remaining time-averaged
 * correct; bass tightens the gravity constant and a kick adds outward pressure
 * from the barycentre. Each body is then projected through a slowly tumbling
 * camera and additively splatted (atomicAdd) into the uint accumulator at
 * binding 0, which CfxResolve.comp later tonemaps into the display texture.
 * Star colour is derived from speed (fast/deep-well stars read blue-white,
 * slow outer stars read warm) rather than a free hue cycle.
 */
// -----------------------------------------------------------------------
// The textbook use of workgroup shared memory: each tile of 256 bodies is
// loaded ONCE per workgroup and reused by all 256 threads, turning a
// bandwidth-bound O(n^2) loop into a compute-bound one.
//
// Forces are evaluated against a strided SAMPLE of the population (offset
// rotates per frame, mass scaled by the stride) so the cost stays affordable
// on weak GPUs while the time-averaged field stays correct.  Spiral arms and
// tidal tails form on their own; a drop is what launches the collision.
// -----------------------------------------------------------------------

layout(local_size_x = 256) in;

layout(std430, binding = 0) buffer Accum { uint acc[]; };
layout(std430, binding = 1) buffer Pos   { vec4 pos[]; };
layout(std430, binding = 2) buffer Vel   { vec4 vel[]; };

uniform ivec2 size;
uniform uint  count;
uniform float dt;
uniform float bass;
uniform float kick;
uniform float hue;
uniform float level;

const float SCALE   = 256.0;
const uint  STRIDE  = 32u;         // force sample: every 32nd body
const float SOFTEN  = 0.11;        // generous: hard close encounters slingshot
                                   // stars out as straight radial spikes

shared vec4 tile[256];

void splat(vec2 uv, vec3 col, float w)
{
    ivec2 ip = ivec2(uv * vec2(size));
    if (ip.x < 0 || ip.y < 0 || ip.x >= size.x || ip.y >= size.y) return;
    uint i = uint(ip.y * size.x + ip.x) * 4u;
    vec3 c = max(col, vec3(0.0)) * w;
    atomicAdd(acc[i + 0u], uint(c.r * SCALE));
    atomicAdd(acc[i + 1u], uint(c.g * SCALE));
    atomicAdd(acc[i + 2u], uint(c.b * SCALE));
    atomicAdd(acc[i + 3u], uint(w * SCALE));
}

void main()
{
    uint gid = gl_GlobalInvocationID.x;
    uint lid = gl_LocalInvocationID.x;

    vec4 me = pos[min(gid, count - 1u)];
    vec3 p  = me.xyz;
    vec3 a  = vec3(0.0);

    // Gravity from a strided sample; G is scaled by STRIDE to compensate.
    uint sampled = count / STRIDE;
    for (uint base = 0u; base < sampled; base += 256u)
    {
        uint src = (base + lid) * STRIDE;
        tile[lid] = (src < count) ? pos[src] : vec4(0.0);
        barrier();

        for (uint j = 0u; j < 256u; ++j)
        {
            vec3 d = tile[j].xyz - p;
            float r2 = dot(d, d) + SOFTEN;
            a += d * (tile[j].w * inversesqrt(r2 * r2 * r2));
        }
        barrier();
    }

    if (gid >= count) return;

    // Gravity constant, derived rather than guessed: with the per-body mass
    // set so the TOTAL mass is 32768, one galaxy holds 16384.  A circular
    // orbit at r=1 then needs v = sqrt(kG*16384), and the disc initialiser
    // hands out v(1) = 0.62 -> kG = 0.62^2/16384.  Guessing this constant is
    // how the first version ended up 70x too strong: the discs did not orbit,
    // they free-fell through the core and sprayed across the whole frame.
    const float kG = 2.35e-5;
    // Bass tightens gravity (the discs visibly contract on heavy passages);
    // a kick adds a short outward pressure pulse from the barycentre.
    float G = kG * float(STRIDE) * (0.85 + 0.45 * clamp(bass, 0.0, 2.0));
    a *= G;
    a -= normalize(p + 1e-5) * kick * 0.015;

    vec4 v = vel[gid];
    v.xyz += a * dt;
    v.xyz *= 0.9995;                       // a whisper of drag keeps it bounded
    p     += v.xyz * dt;

    pos[gid] = vec4(p, me.w);
    vel[gid] = v;

    // Project: a slowly tumbling camera, weak perspective.
    float ca = cos(0.35), sa = sin(0.35);
    vec3 q = vec3(p.x, p.y * ca - p.z * sa, p.y * sa + p.z * ca);
    float persp = 1.0 / (1.0 + 0.16 * (q.z + 2.5));
    vec2 uv = q.xy * 0.20 * persp + 0.5;

    // Star colour follows ASTROPHYSICS, not a rainbow palette: fast stars sit
    // deep in the potential well and read blue-white, slow outer-disc stars
    // read warm.  A free-running cosine palette here produced green/magenta
    // arms that looked like neon tubing rather than a galaxy.
    float sp = clamp(length(v.xyz) * 0.75, 0.0, 1.0);
    vec3 warm = vec3(1.20, 0.86, 0.52);
    vec3 hot  = vec3(0.78, 0.88, 1.20);
    vec3 col  = mix(warm, hot, smoothstep(0.15, 0.85, sp));
    // Music still tints it, but bounded through a sine so a full-turn
    // chromaHue can only nudge the colour temperature, never invert it.
    col *= 1.0 + 0.14 * sin(hue + v.w * 6.2831853);
    col *= 0.40 + 0.85 * sp + 0.45 * level;

    splat(uv, col, 0.5 * persp * (0.7 + 0.6 * sp));
}
