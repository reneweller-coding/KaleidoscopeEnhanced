#version 430
/**
 * @file CfxParticleInit.comp
 * @brief Scatters the particle-flow buffer uniformly across UV space, at rest.
 *
 * Writes vec4(pos.xy, 0, 0) for every particle in the Parts buffer (binding
 * 1), using a per-invocation PCG hash so the distribution is uniform and seed-
 * stable. Runs once at start; CfxParticleStep.comp then advects these
 * particles frame to frame through a divergence-free curl-noise field and
 * periodically re-seeds a fraction of them back to random positions.
 */
layout(local_size_x = 256) in;

layout(std430, binding = 1) buffer Parts { vec4 part[]; };   // xy = pos, zw = vel

uniform uint count;

uint pcg(inout uint s)
{
    s = s * 747796405u + 2891336453u;
    uint w = ((s >> ((s >> 28) + 4u)) ^ s) * 277803737u;
    return (w >> 22) ^ w;
}
float rnd(inout uint s) { return float(pcg(s)) * (1.0 / 4294967296.0); }

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= count) return;
    uint rs = i * 2654435761u + 12345u;
    pcg(rs);
    part[i] = vec4(rnd(rs), rnd(rs), 0.0, 0.0);
}
