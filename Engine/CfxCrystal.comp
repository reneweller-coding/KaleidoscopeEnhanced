#version 430
/**
 * @file CfxCrystal.comp
 * @brief Advances one diffusion-limited-aggregation step per random-walker thread, freezing walkers onto the growing crystal structure on contact.
 *
 * Per-frame step following CfxCrystalSeed.comp's initial nuclei. Each
 * invocation owns one walker in the `Walkers` SSBO (binding 1, xy =
 * position) and takes several random sub-steps (with a weak inward drift)
 * against the `imgField` image (binding 0, R = solid occupancy, G = freeze
 * time, B = hue); on touching an already-solid neighbour it probabilistically
 * freezes into `imgField` at its own discovered position — a scatter write a
 * fragment shader cannot express — then respawns on an outer ring to keep
 * the walker population constant.
 */
// CfxCrystal.comp — diffusion-limited aggregation (frost / coral growth).
// -----------------------------------------------------------------------
// Random walkers drift until they touch the existing structure, then FREEZE
// into it.  Freezing is a write to a texel the thread only discovers while
// running — the defining scatter operation, impossible in a fragment shader
// (which can only ever write its own pixel).
//
// The characteristic DLA branching comes out on its own: tips screen the
// interior, so walkers almost never reach the fjords between branches.
// -----------------------------------------------------------------------

layout(local_size_x = 256) in;

layout(std430, binding = 1) buffer Walkers { vec4 walker[]; };   // xy = pos
layout(rgba16f, binding = 0) uniform image2D imgField;

uniform ivec2 size;
uniform uint  count;
uniform uint  frame;
uniform float now;         // normalised clock, stored as the freeze time
uniform float hue;
uniform float stickiness;  // 0..1, chance of actually freezing on contact
uniform float drift;       // downward/upward bias (music driven)

const int STEPS = 9;

uint pcg(inout uint s)
{
    s = s * 747796405u + 2891336453u;
    uint w = ((s >> ((s >> 28) + 4u)) ^ s) * 277803737u;
    return (w >> 22) ^ w;
}
float rnd(inout uint s) { return float(pcg(s)) * (1.0 / 4294967296.0); }

// Walkers are (re)born on a ring well outside the current structure — the
// standard DLA sampling.  Respawning them in a band along one edge biases
// growth into a wall instead of a dendrite.
vec2 respawn(inout uint s, float radius)
{
    float a = rnd(s) * 6.2831853;
    return vec2(0.5) + vec2(cos(a), sin(a)) * radius * vec2(0.56, 1.0);
}

bool solidAt(ivec2 p)
{
    if (p.x < 0 || p.y < 0 || p.x >= size.x || p.y >= size.y) return false;
    return imageLoad(imgField, p).r > 0.5;
}

void main()
{
    uint id = gl_GlobalInvocationID.x;
    if (id >= count) return;

    uint rs = id * 2654435761u + frame * 2246822519u + 3u;
    pcg(rs);

    vec2 p = walker[id].xy;
    // Respawn walkers that have wandered off or were just consumed.
    if (p.x < 0.0 || p.y < 0.0 || p.x > 1.0 || p.y > 1.0)
        p = respawn(rs, 0.62);

    for (int s = 0; s < STEPS; ++s)
    {
        ivec2 ip = ivec2(p * vec2(size));

        // Contact test against the 4-neighbourhood.
        if (solidAt(ip + ivec2(1, 0)) || solidAt(ip + ivec2(-1, 0)) ||
            solidAt(ip + ivec2(0, 1)) || solidAt(ip + ivec2(0, -1)))
        {
            if (rnd(rs) < stickiness &&
                ip.x >= 0 && ip.y >= 0 && ip.x < size.x && ip.y < size.y)
            {
                // Freeze: the hue drifts slowly along the structure so the
                // crystal reads as having grown over time, not all at once.
                imageStore(imgField, ip, vec4(1.0, now, hue, 1.0));
            }
            p = respawn(rs, 0.62);                     // start a fresh walker
            continue;
        }

        float a = rnd(rs) * 6.2831853;
        // Random step plus a weak pull toward the centre: without it a walker
        // released on the ring almost never finds the cluster and the crystal
        // grows at a crawl.
        vec2 inward = normalize(vec2(0.5) - p + 1e-5);
        p += vec2(cos(a), sin(a)) * 0.0055 + inward * drift * 0.0016;
        if (p.x < -0.05 || p.x > 1.05 || p.y < -0.05 || p.y > 1.05)
            p = respawn(rs, 0.62);
    }

    walker[id] = vec4(p, 0.0, 0.0);
}
