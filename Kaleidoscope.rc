// Kaleidoscope.rc - Windows resources: the .exe's own icon (Explorer, Start
// Menu, Alt-Tab, taskbar pin, installer) plus basic version info (shown in
// the file's Properties > Details tab). The RUNNING window's taskbar icon
// is set separately at runtime (QIcon in Source/main.cpp) since Qt doesn't
// read this resource automatically.
101 ICON "icon.ico"

#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "reneweller"
            VALUE "FileDescription", "Kaleidoscope Enhanced - Audio-Reactive Music Visualizer"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "Kaleidoscope"
            VALUE "OriginalFilename", "Kaleidoscope.exe"
            VALUE "ProductName", "Kaleidoscope Enhanced"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
