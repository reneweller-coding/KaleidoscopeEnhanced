# Visual Studio local / per-user caches (never commit)
.vs/
*.VC.db
*.VC.opendb
*.sdf
*.vcxproj.user

# Visual Studio profiler sessions
*.psess
*.vsp

# Build output directories (regenerated by every build - never track)
/Debug/
/Release/

# Build intermediates (object/pdb dirs not already tracked)
x64/
*.CppClean.log

# Nested build-output copy
/Kaleidoscope/

# Deployment output (generated by deploy.ps1)
/dist/
*.zip

# Runtime-generated files
kaleidoscope.log*
kaleidoscope_settings.ini
recordings/
ThumbCache/

# Preset editor build artifacts (moc output + build dir)
PresetEditor/moc_*.cpp
PresetEditor/build/

# Setup tool build artifacts
SetupTool/build/

# Android remote app: build output + local signing key
AndroidRemote/build/
AndroidRemote/debug.keystore

# Claude Code per-user local settings + editor/tool scratch files (never commit)
.claude/settings.local.json
.claude/*.new

# Qt moc-generated files (top-level build output, not PresetEditor's own moc/)
/moc/

# verify.ps1 artifacts
Tools/broadband120.wav
Tools/probe_*.jpg
cache/
indirect_diag.log

# render_catalog_images.ps1 artifacts
Tools/catalog_scan.wav
Tools/catalog_batch.log
Docs/Catalog/rendered/
Configurations/_catalog.xml
Configurations/_verify.xml

# Szenen-Katalog: PDF ist generiert (Katalog.md + img/ sind die Quelle)
Docs/Catalog/Katalog.pdf
Docs/Catalog/Katalog.html

# Doxygen-Ausgabe ist generiert (Doxyfile + Kommentare im Quelltext sind die Quelle)
Docs/Doxygen/
__pycache__/

# Generated by Tools/scene_metrics.py -- a measurement result, not source.
Tools/scene_metrics.json

# Written at runtime by SHIFT+SPACE / the web remote -- user data, not source.
Configurations/Marked.xml
# Throwaway review filter written by Tools/make_sweep_config.py for a single
# pass; the checked-in equivalent for the whole catalogue is TestAlle.
Configurations/MeshSweep.xml

# Visual Studio per-user solution options (binary, per-developer)
*.suo
*.opensdf

# Raw 3D-Generator tool output (concept art, turntables, latents.npz, the
# full-resolution render/ meshes -- several GB) staged here ad hoc. The meshes
# the engine uses are decimated out of render/ into Models/ instead.
/3D-Objects/

# 3D models are OPTIONAL EXTRA CONTENT, published as a GitHub release asset
# rather than committed. Together they run to roughly a gigabyte -- an order
# of magnitude more than the rest of the repository -- and git keeps blobs
# forever, so committing them could never be undone. Configuration.cpp skips
# any geom="mesh" scene whose model is absent, so a plain clone builds and
# runs; it simply has fewer scenes until the pack is unpacked into Models/.
# Tools/make_model_pack.ps1 builds the archive.
/Models/

# The bundled photo library is OPTIONAL EXTRA CONTENT, published as a GitHub
# release asset rather than committed -- 977 licence-free 1024x1024 textures,
# roughly 600 MB, which is ten times the rest of the repository and would be in
# git's history forever. RenderPipeline::traverse() falls back to a procedural
# texture when the folder is empty, so a plain clone builds and runs; the photo
# scenes simply have nothing of their own to show until the pack is unpacked
# into Images/. Tools/make_image_pack.ps1 builds the archive.
/Images/

# Wegwerf-Konfigs der Sweep-/Katalog-Harness (Tools/... erzeugt sie neu)
Configurations/ZZ*.xml

# Messbericht von Tools/catalog_check.py (wird bei jedem Lauf neu erzeugt)
Tools/catalog_check.json

# Arbeitsverzeichnis von Tools/screen.py (Messwerte, Logs, WAV)
.screen/
