# Visual Studio local / per-user caches (never commit)
.vs/
*.VC.db
*.VC.opendb
*.sdf
*.vcxproj.user

# Visual Studio profiler sessions
*.psess
*.vsp

# Build output directories (regenerated by every build - never track)
/Debug/
/Release/

# Build intermediates (object/pdb dirs not already tracked)
x64/
*.CppClean.log

# Nested build-output copy
/Kaleidoscope/

# Deployment output (generated by deploy.ps1)
/dist/
*.zip

# Runtime-generated files
kaleidoscope.log*
kaleidoscope_settings.ini
recordings/
ThumbCache/

# Preset editor build artifacts (moc output + build dir)
PresetEditor/moc_*.cpp
PresetEditor/build/

# Setup tool build artifacts
SetupTool/build/

# Android remote app: build output + local signing key
AndroidRemote/build/
AndroidRemote/debug.keystore

# Claude Code per-user local settings + editor/tool scratch files (never commit)
.claude/settings.local.json
.claude/*.new

# Qt moc-generated files (top-level build output, not PresetEditor's own moc/)
/moc/

# verify.ps1 artifacts
Tools/broadband120.wav
Tools/probe_*.jpg
cache/
indirect_diag.log

# render_catalog_images.ps1 artifacts
Tools/catalog_scan.wav
Tools/catalog_batch.log
Docs/Catalog/rendered/
Configurations/_catalog.xml
Configurations/_verify.xml

# Szenen-Katalog: PDF ist generiert (Katalog.md + img/ sind die Quelle)
Docs/Catalog/Katalog.pdf
Docs/Catalog/Katalog.html

# Doxygen-Ausgabe ist generiert (Doxyfile + Kommentare im Quelltext sind die Quelle)
Docs/Doxygen/
__pycache__/

# Generated by Tools/scene_metrics.py -- a measurement result, not source.
Tools/scene_metrics.json

# Written at runtime by SHIFT+SPACE / the web remote -- user data, not source.
Configurations/Marked.xml
